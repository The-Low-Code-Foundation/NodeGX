      "id": "ndCheck",
      "type": "JavaScriptFunction",
      "label": "Has something been written?",
      "parameters": {
        "functionScript": "var t = String(Inputs.text || '').trim();\nOutputs.ok = t !== '';\nOutputs.note = t;"
      },
      "x": 470,
      "y": 1120,
      "ports": [
        {
          "name": "in-text",
          "displayName": "text",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-ok",
          "displayName": "ok",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-note",
          "displayName": "note",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
