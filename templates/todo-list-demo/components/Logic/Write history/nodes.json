    {
      "id": "whDecide",
      "type": "JavaScriptFunction",
      "label": "A new line, or extend the last one?",
      "parameters": {
        "functionScript": "var MERGE = [\"moved\",\"action-moved\",\"deadline\",\"action-described\"];\nvar last = Inputs.last || {};\nvar now = Date.now();\nvar kind = String(Inputs.kind || '');\nvar key = kind + '|' + String(Inputs.taskId || '') + '|' + String(Inputs.mergeKey || '');\nvar merge = MERGE.indexOf(kind) >= 0 && last.key === key && !!last.id && now - last.at < 120000;\nvar from = merge && kind === 'moved' ? last.from : Inputs.from;\nvar summary = String(Inputs.summary || '');\nif (kind === 'moved') summary = from === Inputs.to ? 'Moved back to #' + Inputs.to : 'Moved #' + from + ' → #' + Inputs.to;\nOutputs.summary = summary;\nOutputs.body = String(Inputs.body || '');\nOutputs.at = new Date(now).toISOString();\nOutputs.mergeId = merge ? last.id : '';\n// A fresh object every run: Outputs publish only on change.\nOutputs.pending = { key: key, at: now, from: from };\nif (merge) Outputs.update(); else Outputs.create();",
        "runOnChange-in-taskId": false,
        "runOnChange-in-kind": false,
        "runOnChange-in-summary": false,
        "runOnChange-in-body": false,
        "runOnChange-in-from": false,
        "runOnChange-in-to": false,
        "runOnChange-in-mergeKey": false,
        "runOnChange-in-last": false
      },
