          "displayName": "summary",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "AddtaskCreate",
      "type": "JavaScriptFunction",
      "label": "Add the task, in this browser",
      "parameters": {
        "functionScript": "var DEMO_KEY = \"nodegx-todo-list-demo-v1\";\nfunction demoLoad() {\n  var raw = null;\n  try { raw = window.localStorage.getItem(DEMO_KEY); } catch (e) { raw = null; }\n  if (raw === null && typeof window.__todoListDemo === 'string') raw = window.__todoListDemo;\n  if (raw === null) return null;\n  try { return JSON.parse(raw); } catch (e) { return null; }\n}\nfunction demoSave(store) {\n  var raw = JSON.stringify(store);\n  window.__todoListDemo = raw;\n  try { window.localStorage.setItem(DEMO_KEY, raw); } catch (e) {}\n}\nvar store = demoLoad() || { Task: [], Action: [], Event: [] };\nvar list = store[\"Task\"] || (store[\"Task\"] = []);\nvar now = new Date().toISOString();\nvar record = { id: 'd' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8), createdAt: now, updatedAt: now };\nrecord.title = Inputs.title;\nrecord.position = Inputs.position;\nrecord.status = Inputs.status;\nrecord.deadline = Inputs.deadline;\nrecord.closingNote = Inputs.closingNote;\nrecord.closedAt = Inputs.closedAt;\nlist.push(record);\ntry { demoSave(store); } catch (e) { Outputs.failure(); return; }\nOutputs.id = record.id;\nOutputs.done();",
        "runOnChange-in-title": false,
        "runOnChange-in-position": false,
        "runOnChange-in-status": false,
        "runOnChange-in-deadline": false,
        "runOnChange-in-closingNote": false,
        "runOnChange-in-closedAt": false
      },
      "x": 40,
      "y": 400,
      "ports": [
        {
          "name": "in-title",
          "displayName": "title",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
