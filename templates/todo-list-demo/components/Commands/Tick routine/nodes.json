    {
      "id": "TickroutinCreate",
      "type": "JavaScriptFunction",
      "label": "Log it as done, in this browser",
      "parameters": {
        "functionScript": "var DEMO_KEY = \"nodegx-todo-list-demo-v1\";\nfunction demoLoad() {\n  var raw = null;\n  try { raw = window.localStorage.getItem(DEMO_KEY); } catch (e) { raw = null; }\n  if (raw === null && typeof window.__todoListDemo === 'string') raw = window.__todoListDemo;\n  if (raw === null) return null;\n  try { return JSON.parse(raw); } catch (e) { return null; }\n}\nfunction demoSave(store) {\n  var raw = JSON.stringify(store);\n  window.__todoListDemo = raw;\n  try { window.localStorage.setItem(DEMO_KEY, raw); } catch (e) {}\n}\nvar store = demoLoad() || { Task: [], Action: [], Event: [] };\nvar list = store[\"RoutineCheck\"] || (store[\"RoutineCheck\"] = []);\nvar now = new Date().toISOString();\nvar record = { id: 'd' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8), createdAt: now, updatedAt: now };\nrecord.routineId = Inputs.routineId;\nrecord.date = Inputs.date;\nrecord.time = Inputs.time;\nrecord.doneAt = Inputs.doneAt;\nrecord.note = Inputs.note;\nlist.push(record);\ntry { demoSave(store); } catch (e) { Outputs.failure(); return; }\nOutputs.id = record.id;\nOutputs.done();",
        "runOnChange-in-routineId": false,
        "runOnChange-in-date": false,
        "runOnChange-in-time": false,
        "runOnChange-in-doneAt": false,
        "runOnChange-in-note": false
      },
