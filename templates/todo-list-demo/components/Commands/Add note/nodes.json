{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "d9ccc804-1bc2-5b40-885b-663c2f143bd5",
  "version": 1,
  "nodes": [
    {
      "id": "AddnoteIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "taskId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "text",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "AddnoteOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "AddnoteGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.taskId || '');\nvar t = String(Inputs.text || '').trim();\nif (id === '' || t === '') return;\nOutputs.body = t;\nOutputs.summary = 'Note';\nOutputs.go();",
        "runOnChange-in-taskId": false,
        "runOnChange-in-text": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-taskId",
          "displayName": "taskId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-text",
          "displayName": "text",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-body",
          "displayName": "body",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-summary",
          "displayName": "summary",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "AddnoteHistory",
      "type": "/Logic/Write history",
      "label": "Write the history line",
      "parameters": {
        "kind": "note"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "AddnoteProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "todoProblem",
        "setWith": "string",
        "value": "That change did not save in this browser. Try again, or reset the demo."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 520
    }
  ]
}
