    {
      "id": "StoproutinGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.routineId || '');\nvar note = String(Inputs.note || '').trim();\nif (id === '' || note === '') return;\nOutputs.status = 'stopped';\nOutputs.at = new Date().toISOString();\nOutputs.note = note;\nOutputs.summary = 'Stopped';\nOutputs.go();",
        "runOnChange-in-routineId": false,
        "runOnChange-in-note": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-routineId",
          "displayName": "routineId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-note",
          "displayName": "note",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-status",
          "displayName": "status",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-at",
          "displayName": "at",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-note",
          "displayName": "note",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-summary",
          "displayName": "summary",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "StoproutinWrite",
      "type": "JavaScriptFunction",
      "label": "Stop it, in this browser",
      "parameters": {
        "functionScript": "var DEMO_KEY = \"nodegx-todo-list-demo-v1\";\nfunction demoLoad() {\n  var raw = null;\n  try { raw = window.localStorage.getItem(DEMO_KEY); } catch (e) { raw = null; }\n  if (raw === null && typeof window.__todoListDemo === 'string') raw = window.__todoListDemo;\n  if (raw === null) return null;\n  try { return JSON.parse(raw); } catch (e) { return null; }\n}\nfunction demoSave(store) {\n  var raw = JSON.stringify(store);\n  window.__todoListDemo = raw;\n  try { window.localStorage.setItem(DEMO_KEY, raw); } catch (e) {}\n}\nvar id = String(Inputs.modelId || '');\nvar store = demoLoad();\nvar list = (store && store[\"Routine\"]) || [];\nvar record = null;\nfor (var i = 0; i < list.length; i++) if (list[i] && list[i].id === id) record = list[i];\nif (!record) { Outputs.failure(); return; }\nrecord.status = Inputs.status;\nrecord.stoppedAt = Inputs.stoppedAt;\nrecord.stopNote = Inputs.stopNote;\nrecord.updatedAt = new Date().toISOString();\ntry { demoSave(store); } catch (e) { Outputs.failure(); return; }\nOutputs.id = id;\nOutputs.done();",
        "runOnChange-in-status": false,
        "runOnChange-in-stoppedAt": false,
        "runOnChange-in-stopNote": false,
        "runOnChange-in-modelId": false
      },
      "x": 40,
      "y": 400,
      "ports": [
        {
          "name": "in-modelId",
          "displayName": "modelId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-status",
          "displayName": "status",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-stoppedAt",
          "displayName": "stoppedAt",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-stopNote",
          "displayName": "stopNote",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-failure",
          "displayName": "failure",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-done",
          "displayName": "done",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-id",
          "displayName": "id",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "StoproutinHistory",
      "type": "/Logic/Write history",
