    {
      "id": "RenameactiGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "function findRow(rows, id) {\n  for (var i = 0; i < rows.length; i++) if (rows[i] && rows[i].id === id) return rows[i];\n  return null;\n}\nvar row = findRow(Inputs.rows || [], String(Inputs.actionId || ''));\nif (!row) return;\nvar old = String(row.title || '');\nvar t = String(Inputs.newTitle || '').trim();\nif (t === '' || t === old) return;\nOutputs.title = t;\nOutputs.summary = 'Next action renamed from “' + old + '”';\nOutputs.go();",
        "runOnChange-in-rows": false,
        "runOnChange-in-actionId": false,
        "runOnChange-in-newTitle": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-rows",
          "displayName": "rows",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-actionId",
          "displayName": "actionId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-newTitle",
          "displayName": "newTitle",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-title",
          "displayName": "title",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-summary",
          "displayName": "summary",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "RenameactiWrite",
      "type": "JavaScriptFunction",
      "label": "Rename the next action, in this browser",
      "parameters": {
        "functionScript": "var DEMO_KEY = \"nodegx-todo-list-demo-v1\";\nfunction demoLoad() {\n  var raw = null;\n  try { raw = window.localStorage.getItem(DEMO_KEY); } catch (e) { raw = null; }\n  if (raw === null && typeof window.__todoListDemo === 'string') raw = window.__todoListDemo;\n  if (raw === null) return null;\n  try { return JSON.parse(raw); } catch (e) { return null; }\n}\nfunction demoSave(store) {\n  var raw = JSON.stringify(store);\n  window.__todoListDemo = raw;\n  try { window.localStorage.setItem(DEMO_KEY, raw); } catch (e) {}\n}\nvar id = String(Inputs.modelId || '');\nvar store = demoLoad();\nvar list = (store && store[\"Action\"]) || [];\nvar record = null;\nfor (var i = 0; i < list.length; i++) if (list[i] && list[i].id === id) record = list[i];\nif (!record) { Outputs.failure(); return; }\nrecord.title = Inputs.title;\nrecord.updatedAt = new Date().toISOString();\ntry { demoSave(store); } catch (e) { Outputs.failure(); return; }\nOutputs.id = id;\nOutputs.done();",
        "runOnChange-in-title": false,
        "runOnChange-in-modelId": false
      },
      "x": 40,
      "y": 400,
      "ports": [
        {
          "name": "in-modelId",
          "displayName": "modelId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-title",
          "displayName": "title",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-failure",
