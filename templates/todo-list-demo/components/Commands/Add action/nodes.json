      "id": "AddactionGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.taskId || '');\nvar t = String(Inputs.title || '').trim();\nif (id === '' || t === '') return;\nOutputs.taskId = id;\nOutputs.title = t;\nOutputs.position = Number(Inputs.position) || 1;\nOutputs.done = false;\nOutputs.empty = '';\nOutputs.summary = 'Next action added: “' + t + '”';\nOutputs.go();",
        "runOnChange-in-taskId": false,
        "runOnChange-in-title": false,
        "runOnChange-in-position": false
      },
      "x": 40,
      "y": 280,
