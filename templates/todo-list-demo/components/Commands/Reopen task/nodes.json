      "id": "ReopentaskGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.taskId || '');\nvar note = String(Inputs.note || '').trim();\nif (id === '' || note === '') return;\nOutputs.status = 'open';\nOutputs.position = Number(Inputs.position) || 1;\nOutputs.empty = '';\nOutputs.note = note;\nOutputs.summary = 'Reopened at #' + (Number(Inputs.rank) || 1);\nOutputs.go();",
        "runOnChange-in-taskId": false,
        "runOnChange-in-note": false,
        "runOnChange-in-position": false,
        "runOnChange-in-rank": false
      },
      "x": 40,
