        "functionScript": "var mode = String(Inputs.mode || '');\nif (mode !== 'done' && mode !== 'change' && mode !== 'add') return;\nvar taskId = String(Inputs.taskId || '');\nif (mode === 'change' && taskId === '') return;\nOutputs.mode = mode === 'add' ? 'new' : mode === 'done' && taskId === '' ? 'new' : mode;\nOutputs.go();",
