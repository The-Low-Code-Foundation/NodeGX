    {
      "id": "wm_words",
      "type": "JavaScriptFunction",
      "label": "Word the objectives",
      "x": 1300,
      "y": 360,
      "parameters": {
        "functionScript": "/*\n * WORD THE OBJECTIVES (TASK-L168 §1). Fills the coach's sentences from what\n * Logic/Dossier already emits — it computes nothing about an objective.\n *\n * PORTED: DeliverablesTab.tsx (the read half of a row) and ObjectivesPanel.tsx\n * (the project, and \"What they have told us\"). Every line the product renders\n * only when it has something to say is `has*`-gated here the same way:\n * `d.description &&`, `expectedCoreFields.length > 0 &&`, `dossier &&`.\n *\n * NOTHING IS COUNTED. No \"3 of 4\", no \"2 answered\" — L114's guard and\n * this task's DO NOT. The ORDER is the data's: segments arrive in position\n * order, as the product's query returns them, and are not re-sorted here.\n *\n * No Run wire: this runs whenever an input changes, which is what a value-\n * driven Function is for. (L165's runOnChange rule is about RUN-driven ones.)\n */\nfunction plain(x) {\n  if (x === null || x === undefined) return x;\n  if (Array.isArray(x)) return x.map(plain);\n  if (typeof x === 'object') {\n    if (typeof x.get === 'function' && x.data && typeof x.data === 'object') return plain(x.data);\n    if (Array.isArray(x.items)) return plain(x.items);\n    const out = {};\n    for (const k of Object.keys(x)) out[k] = plain(x[k]);\n    return out;\n  }\n  return x;\n}\nconst fill = (t, v) => String(t || '').replace(/\\{(\\w+)\\}/g, (m, k) => (k in v ? String(v[k]) : m));\n\n/* Not arrived yet is not wired wrong (L164): an absent copy waits; a copy that\n   arrives without the namespace is a named failure. */\nif (Inputs.copy === undefined || Inputs.copy === null) return;\nconst W = (plain(Inputs.copy) || {}).dossierCoach;\nif (!W || !W.filedUnder || !W.toldUs) {\n  throw new Error('People/What they must produce: no `dossierCoach` copy. Wire Data/Strings.copy into Copy (TASK-L168).');\n}\nif (Inputs.segments === undefined || Inputs.segments === null) return;\n\nconst segments = plain(Inputs.segments) || [];\nconst told = plain(Inputs.toldUs) || [];\n\nconst rows = segments.map((s) => {\n  const asks = s.asksFor || [];\n  const needs = (s.requires || []).map((r) => r.title);\n  return {\n    id: s.slug,\n    title: s.label,\n    archived: !!s.archived,\n    archivedLabel: W.archived,\n    filedUnder: fill(W.filedUnder, { slug: s.slug }),\n    description: s.description || '',\n    hasDescription: !!s.description,\n    expecting: fill(W.expecting, { fields: asks.join(', ') }),\n    hasExpecting: asks.length > 0,\n    needs: fill(W.needs, { concepts: needs.join(', ') }),\n    hasNeeds: needs.length > 0\n  };\n});\n\nconst projectName = String(Inputs.projectName || '');\nOutputs.hasProject = projectName !== '';\nOutputs.projectName = projectName;\nOutputs.problemStatement = String(Inputs.problemStatement || '');\nOutputs.heading = W.heading;\nOutputs.intro = W.intro;\nOutputs.rows = rows;\nOutputs.hasRows = rows.length > 0;\n/* The product's empty sentence is \"Nothing set yet. Add the first thing you\n   have agreed they will produce.\" Its second half points at a composer that\n   is not on this page, so it is not carried (L81's rung, as copy). */\nOutputs.emptyText = W.nothingSet;\nOutputs.hasEmpty = rows.length === 0;\nOutputs.toldUsHeading = W.toldUs;\nOutputs.told = told;\nOutputs.hasTold = told.length > 0;\nOutputs.toldEmptyText = W.toldUsEmpty;\nOutputs.hasToldEmpty = told.length === 0;\n"
      },
      "metadata": {
        "comment": "Words, not facts: every value it fills in came out of Logic/Dossier."
      },
