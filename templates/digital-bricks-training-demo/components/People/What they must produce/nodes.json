      "id": "wm_dossier",
      "type": "/Logic/Dossier",
      "label": "What each objective holds — the one owner, shared with the learner's meter",
      "x": 900,
      "y": 360,
      "metadata": {
        "comment": "The SAME component the learner's meter reads (L166). With audience 'coach' it keeps archived objectives on the list and emits toldUs; nothing here re-derives a segment."
      }
