{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "18990468-fc51-5b1a-8ef8-d80ff54d97bc",
  "version": 1,
  "nodes": [
    {
      "id": "EndmoneyitIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "itemId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "until",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "EndmoneyitOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "EndmoneyitGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var until = String(Inputs.until || '');\nif (String(Inputs.itemId || '') === '' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(until)) return;\nOutputs.until = until;\nOutputs.go();",
        "runOnChange-in-itemId": false,
        "runOnChange-in-until": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-until",
          "displayName": "until",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-itemId",
          "displayName": "itemId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-until",
          "displayName": "until",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "EndmoneyitWrite",
      "type": "SetDbModelProperties",
      "label": "End the item",
      "parameters": {
        "collectionName": "MoneyItem",
        "idSource": "explicit"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "EndmoneyitProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "plannerProblem",
        "setWith": "string",
        "value": "That change did not save. Check your connection, then try again."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 520
    }
  ]
}
