      },
      {
        "name": "body",
        "type": "String"
      },
      {
        "name": "clip",
        "type": "Object"
      },
      {
        "name": "options",
        "type": "Array"
      },
      {
        "name": "revealsAfter",
        "type": "Number"
      },
      {
        "name": "conversation",
        "type": "Pointer",
        "targetClass": "Conversation",
        "required": true,
        "whenTargetGoes": "blocks",
        "description": "each message is in one conversation"
      }
    ],
    "checks": [
      {
        "field": "from",
        "oneOf": [
          "rick",
          "learner"
        ]
      },
      {
        "field": "origin",
        "oneOf": [
          "cut",
          "typed",
          "drafted",
          "dictated"
        ]
      },
      {
        "field": "kind",
        "oneOf": [
          "text",
          "clip",
          "choice",
          "question",
          "paste",
          "learner"
        ]
      }
    ],
    "indexes": []
