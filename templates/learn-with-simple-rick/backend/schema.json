[
  {
    "action": "createTable",
    "table": "Learner",
    "description": "I'll find the learners, I'll get their needs and I'll produce the pedagogic content. I'll add lots of info about the learner to each new user, to help Claude have the context it might need. Probably best just a free typed text, not a form.",
    "columns": [
      {
        "name": "name",
        "type": "String"
      },
      {
        "name": "email",
        "type": "String"
      },
      {
        "name": "language",
        "type": "String"
      },
      {
        "name": "prefs",
        "type": "Object"
      },
      {
        "name": "aliases",
        "type": "Object"
      },
      {
        "name": "inviteToken",
        "type": "String"
      },
      {
        "name": "package",
        "type": "String"
      },
      {
        "name": "meetCode",
        "type": "String"
      },
      {
        "name": "notes",
        "type": "String"
      },
      {
        "name": "login",
        "type": "Pointer",
        "targetClass": "_User",
        "description": "a learner is who signs in"
      }
    ],
    "checks": [
      {
        "field": "language",
        "oneOf": [
          "en",
          "fr"
        ]
      }
    ],
    "indexes": []
  },
  {
    "action": "createTable",
    "table": "LearnerHistory",
    "description": "who changed what on a learner, and when: one record per change Not kept by the database yet: every change to a learner is written to its history.",
    "columns": [
      {
        "name": "learner",
        "type": "Pointer",
        "targetClass": "Learner",
        "required": true,
        "whenTargetGoes": "goes-too",
        "description": "the learner that changed"
      },
      {
        "name": "at",
        "type": "Date",
        "required": true,
        "description": "when"
      },
      {
        "name": "who",
        "type": "Pointer",
        "targetClass": "_User",
        "description": "who changed it"
      },
      {
        "name": "changed",
        "type": "Object",
        "description": "what changed: each detail, before and after"
      }
    ],
    "checks": [],
    "indexes": []
  },
  {
    "action": "createTable",
    "table": "Conversation",
    "description": "I can imagine being able to open the 'conversations' on the left side with Rick and reviewing old ones. Resetting them if I want to start from the beginning and advance message by message. Not kept by the database yet: no conversation sits under itself.",
    "columns": [
      {
        "name": "title",
        "type": "String"
      },
      {
        "name": "kind",
        "type": "String"
      },
      {
        "name": "state",
        "type": "String"
      },
      {
        "name": "language",
        "type": "String"
      },
      {
        "name": "dubbed",
        "type": "Boolean"
      },
      {
        "name": "summary",
        "type": "String"
      },
      {
        "name": "dueBefore",
        "type": "Date"
      },
      {
        "name": "shareable",
        "type": "Boolean"
      },
      {
        "name": "run",
        "type": "Number"
      },
      {
        "name": "learner",
        "type": "Pointer",
        "targetClass": "Learner",
        "required": true,
        "whenTargetGoes": "blocks",
        "description": "each conversation is with one learner"
      },
      {
        "name": "parent",
        "type": "Pointer",
        "targetClass": "Conversation",
        "whenTargetGoes": "blocks",
        "description": "The what to do before next time should link to a new conversation, so we keep them linked but separate"
      }
    ],
    "checks": [
      {
        "field": "kind",
        "oneOf": [
          "lesson",
          "session-review",
          "follow-up"
        ]
      },
      {
        "field": "state",
        "oneOf": [
          "open",
          "done",
          "archived"
        ]
      },
      {
        "field": "language",
        "oneOf": [
          "en",
          "fr"
        ]
      }
    ],
    "indexes": []
  },
