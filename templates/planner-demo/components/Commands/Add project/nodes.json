    {
      "id": "AddprojectWrite",
      "type": "JavaScriptFunction",
      "label": "Add the project, in this browser",
      "parameters": {
        "functionScript": "var DEMO_KEY = \"nodegx-planner-demo-v1\";\nfunction demoEmpty() { return {\"Block\":[],\"CashEvent\":[],\"MonthPlan\":[],\"Project\":[],\"Settings\":[]}; }\nfunction demoLoad() {\n  var raw = null;\n  try { raw = window.localStorage.getItem(DEMO_KEY); } catch (e) { raw = null; }\n  if (raw === null && typeof window.__plannerDemo === 'string') raw = window.__plannerDemo;\n  if (raw === null) return null;\n  try { return JSON.parse(raw); } catch (e) { return null; }\n}\nfunction demoSave(store) {\n  var raw = JSON.stringify(store);\n  window.__plannerDemo = raw;\n  try { window.localStorage.setItem(DEMO_KEY, raw); } catch (e) {}\n}\nvar store = demoLoad() || demoEmpty();\nvar list = store[\"Project\"] || (store[\"Project\"] = []);\nvar now = new Date().toISOString();\nvar record = { id: 'd' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8), createdAt: now, updatedAt: now };\nrecord.name = Inputs.name;\nrecord.sub = Inputs.sub;\nrecord.kind = Inputs.kind;\nrecord.rate = Inputs.rate;\nrecord.move = Inputs.move;\nrecord.moveWorth = Inputs.moveWorth;\nrecord.moveWhen = Inputs.moveWhen;\nrecord.moveDue = Inputs.moveDue;\nrecord.moveStop = Inputs.moveStop;\nrecord.rung = Inputs.rung;\nrecord.say = Inputs.say;\nrecord.position = Inputs.position;\nlist.push(record);\ntry { demoSave(store); } catch (e) { Outputs.failure(); return; }\nOutputs.id = record.id;\nOutputs.done();",
        "runOnChange-in-name": false,
        "runOnChange-in-sub": false,
        "runOnChange-in-kind": false,
        "runOnChange-in-rate": false,
        "runOnChange-in-move": false,
