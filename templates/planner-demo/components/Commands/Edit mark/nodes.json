    {
      "id": "EditmarkWrite",
      "type": "JavaScriptFunction",
      "label": "Change the mark, in this browser",
      "parameters": {
        "functionScript": "var DEMO_KEY = \"nodegx-planner-demo-v3\";\nfunction demoEmpty() { return {\"BalanceReading\":[],\"Block\":[],\"MoneyItem\":[],\"MoneyMark\":[],\"MonthPlan\":[],\"Project\":[],\"Settings\":[]}; }\nfunction demoLoad() {\n  var raw = null;\n  try { raw = window.localStorage.getItem(DEMO_KEY); } catch (e) { raw = null; }\n  if (raw === null && typeof window.__plannerDemo === 'string') raw = window.__plannerDemo;\n  if (raw === null) return null;\n  try { return JSON.parse(raw); } catch (e) { return null; }\n}\nfunction demoSave(store) {\n  var raw = JSON.stringify(store);\n  window.__plannerDemo = raw;\n  try { window.localStorage.setItem(DEMO_KEY, raw); } catch (e) {}\n}\nvar id = String(Inputs.modelId || '');\nvar store = demoLoad();\nvar list = (store && store[\"MoneyMark\"]) || [];\nvar record = null;\nfor (var i = 0; i < list.length; i++) if (list[i] && list[i].id === id) record = list[i];\nif (!record) { Outputs.failure(); return; }\nrecord.itemId = Inputs.itemId;\nrecord.occurs = Inputs.occurs;\nrecord.amount = Inputs.amount;\nrecord.date = Inputs.date;\nrecord.skip = Inputs.skip;\nrecord.payments = Inputs.payments;\nrecord.doneOn = Inputs.doneOn;\nrecord.doneAmount = Inputs.doneAmount;\nrecord.lostOn = Inputs.lostOn;\nrecord.sentOn = Inputs.sentOn;\nrecord.note = Inputs.note;\nrecord.updatedAt = new Date().toISOString();\ntry { demoSave(store); } catch (e) { Outputs.failure(); return; }\nOutputs.id = id;\nOutputs.done();",
        "runOnChange-in-itemId": false,
        "runOnChange-in-occurs": false,
        "runOnChange-in-amount": false,
