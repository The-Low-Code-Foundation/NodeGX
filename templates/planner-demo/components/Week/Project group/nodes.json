{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "e49a3536-f56a-552c-8cac-1bc682d56ada",
  "version": 1,
  "nodes": [
    {
      "id": "pgIn",
      "type": "Component Inputs",
      "label": "The group",
      "ports": [
        {
          "name": "name",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "hours",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "color",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "rows",
          "plug": "output",
          "type": "array"
        }
      ],
      "x": 410,
      "y": 280
    },
    {
      "id": "pgOut",
      "type": "Component Outputs",
      "label": "Picked",
      "ports": [
        {
          "name": "pick",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "id",
          "plug": "input",
          "type": "string"
        }
      ],
      "x": 410,
      "y": 520
    },
    {
      "id": "pgRoot",
      "type": "Group",
      "label": "Project group",
      "parameters": {
        "flexDirection": "column",
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "rowGap": "var(--space-1)"
      },
      "children": [
        "pgHead",
        "pgEach"
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "pgHead",
      "type": "Group",
      "label": "Group head",
      "parent": "pgRoot",
      "parameters": {
        "flexDirection": "row",
        "alignItems": "center",
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "columnGap": "var(--space-2)",
        "justifyContent": "space-between"
      },
      "children": [
        "pgName",
        "pgHours"
      ],
      "x": 100,
      "y": 160
    },
    {
      "id": "pgName",
      "type": "Text",
      "label": "Group name",
      "parent": "pgHead",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "color": "var(--muted-foreground)",
        "letterSpacing": {
          "value": 0.06,
          "unit": "em"
        },
        "textTransform": "uppercase",
        "sizeMode": "contentSize"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "pgHours",
      "type": "Text",
      "label": "Hours this week",
      "parent": "pgHead",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--foreground)",
        "fontVariantNumeric": "tabular-nums",
        "sizeMode": "contentSize"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "pgEach",
      "type": "For Each",
      "label": "One row per project",
      "parent": "pgRoot",
      "parameters": {
        "template": "/Week/Project list row",
        "templateType": "explicit"
      },
      "x": 100,
      "y": 520
    }
  ],
  "visualRoots": [
    "pgRoot"
  ]
}
