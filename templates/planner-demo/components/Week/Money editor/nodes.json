      "id": "edClosing",
      "type": "JavaScriptFunction",
      "label": "Clear the boxes on close; tick the two boxes to match the item",
      "parameters": {
        "functionScript": "var shown = Inputs.shown === true;\nif (this.wasShown && !shown) Outputs.closed();\nvar monthEndWant = shown ? Inputs.monthEnd === true : null;\nif (monthEndWant !== null && (!this.wasShown || this.monthEndLast !== monthEndWant)) { if (monthEndWant) Outputs.monthEndOn(); else Outputs.monthEndOff(); }\nthis.monthEndLast = monthEndWant;\nvar fromHoursWant = shown ? Inputs.fromHours === true : null;\nif (fromHoursWant !== null && (!this.wasShown || this.fromHoursLast !== fromHoursWant)) { if (fromHoursWant) Outputs.fromHoursOn(); else Outputs.fromHoursOff(); }\nthis.fromHoursLast = fromHoursWant;\nthis.wasShown = shown;"
