    {
      "id": "bsOpened",
      "type": "JavaScriptFunction",
      "label": "Clear the boxes on close; tick Done to match the block",
      "parameters": {
        "functionScript": "var shown = Inputs.shown === true;\nif (this.wasShown && !shown) Outputs.closed();\nvar doneWant = shown ? Inputs.done === true : null;\nif (doneWant !== null && (!this.wasShown || this.doneLast !== doneWant)) { if (doneWant) Outputs.doneOn(); else Outputs.doneOff(); }\nthis.doneLast = doneWant;\nthis.wasShown = shown;"
      },
      "x": 590,
      "y": 2560,
      "ports": [
        {
          "name": "in-shown",
          "displayName": "shown",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
