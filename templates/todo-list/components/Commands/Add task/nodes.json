{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "d8048e94-3852-5851-837b-ac9ad44db406",
  "version": 1,
  "nodes": [
    {
      "id": "AddtaskIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "position",
          "plug": "output",
          "type": "number"
        },
        {
          "name": "summary",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "AddtaskOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "AddtaskGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var t = String(Inputs.title || '').trim();\nif (t === '') return;\nOutputs.title = t;\nOutputs.position = Number(Inputs.position) || 1;\nOutputs.status = 'open';\nOutputs.empty = '';\nOutputs.summary = String(Inputs.summary || '');\nOutputs.go();",
        "runOnChange-in-title": false,
        "runOnChange-in-position": false,
        "runOnChange-in-summary": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-title",
          "displayName": "title",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-position",
          "displayName": "position",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-summary",
          "displayName": "summary",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-title",
          "displayName": "title",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-position",
          "displayName": "position",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-status",
          "displayName": "status",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-empty",
          "displayName": "empty",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-summary",
          "displayName": "summary",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "AddtaskCreate",
      "type": "NewDbModelProperties",
      "label": "Add the task",
      "parameters": {
        "collectionName": "Task"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "AddtaskHistory",
      "type": "/Logic/Write history",
      "label": "Write the history line",
      "parameters": {
        "kind": "created"
      },
      "x": 40,
      "y": 520
    },
    {
      "id": "AddtaskProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "todoProblem",
        "setWith": "string",
        "value": "That change did not save. Check your connection, then try again."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 640
    }
  ]
}
