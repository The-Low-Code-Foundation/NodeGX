    {
      "id": "DescribeacGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "function findRow(rows, id) {\n  for (var i = 0; i < rows.length; i++) if (rows[i] && rows[i].id === id) return rows[i];\n  return null;\n}\nvar row = findRow(Inputs.rows || [], String(Inputs.actionId || ''));\nif (!row) return;\nvar t = String(Inputs.text || '').trim();\nif (t === String(row.description || '')) return;\nOutputs.description = t;\nOutputs.summary = 'Description changed on “' + row.title + '”';\nOutputs.go();",
        "runOnChange-in-rows": false,
        "runOnChange-in-actionId": false,
        "runOnChange-in-text": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-rows",
          "displayName": "rows",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-actionId",
          "displayName": "actionId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-text",
