{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "89378bf9-3ece-5b64-877e-03267bb23285",
  "version": 1,
  "nodes": [
    {
      "id": "StoproutinIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "routineId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "note",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "StoproutinOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "StoproutinGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.routineId || '');\nvar note = String(Inputs.note || '').trim();\nif (id === '' || note === '') return;\nOutputs.status = 'stopped';\nOutputs.at = new Date().toISOString();\nOutputs.note = note;\nOutputs.summary = 'Stopped';\nOutputs.go();",
        "runOnChange-in-routineId": false,
        "runOnChange-in-note": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-routineId",
          "displayName": "routineId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-note",
          "displayName": "note",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-status",
          "displayName": "status",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-at",
          "displayName": "at",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-note",
          "displayName": "note",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-summary",
          "displayName": "summary",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "StoproutinWrite",
      "type": "SetDbModelProperties",
      "label": "Stop it",
      "parameters": {
        "collectionName": "Routine",
        "idSource": "explicit"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "StoproutinHistory",
      "type": "/Logic/Write history",
      "label": "Write the history line",
      "parameters": {
        "kind": "routine-stopped"
      },
      "x": 40,
      "y": 520
    },
    {
      "id": "StoproutinProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "todoProblem",
        "setWith": "string",
        "value": "That change did not save. Check your connection, then try again."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 640
    }
  ]
}
