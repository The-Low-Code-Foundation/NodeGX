{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "f8b1fb7f-910e-527a-85bc-1b22061346f5",
  "version": 1,
  "nodes": [
    {
      "id": "ClosetaskIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "rows",
          "plug": "output",
          "type": "array"
        },
        {
          "name": "taskId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "note",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "ClosetaskOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "ClosetaskGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var rows = Inputs.rows || [];\nvar id = String(Inputs.taskId || '');\nvar note = String(Inputs.note || '').trim();\nif (id === '' || note === '') return;\nvar rank = 0;\nfor (var k = 0; k < rows.length; k++) if (rows[k] && rows[k].id === id) rank = k + 1;\nOutputs.status = 'done';\nOutputs.note = note;\nOutputs.at = new Date().toISOString();\nOutputs.summary = rank > 0 ? 'Closed from #' + rank : 'Closed';\nOutputs.go();",
        "runOnChange-in-rows": false,
        "runOnChange-in-taskId": false,
        "runOnChange-in-note": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-rows",
          "displayName": "rows",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-taskId",
          "displayName": "taskId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-note",
          "displayName": "note",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-status",
          "displayName": "status",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-note",
          "displayName": "note",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-at",
          "displayName": "at",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-summary",
          "displayName": "summary",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "ClosetaskWrite",
      "type": "SetDbModelProperties",
      "label": "Close the task",
      "parameters": {
        "collectionName": "Task",
        "idSource": "explicit"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "ClosetaskHistory",
      "type": "/Logic/Write history",
      "label": "Write the history line",
      "parameters": {
        "kind": "closed"
      },
      "x": 40,
      "y": 520
    },
    {
      "id": "ClosetaskProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "todoProblem",
        "setWith": "string",
        "value": "That change did not save. Check your connection, then try again."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 640
    }
  ]
}
