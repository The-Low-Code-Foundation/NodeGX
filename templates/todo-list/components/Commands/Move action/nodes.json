    {
      "id": "MoveactionGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var rows = Inputs.rows || [];\nvar id = String(Inputs.itemId || '');\nvar dir = String(Inputs.direction || '');\nvar i = -1;\nfor (var k = 0; k < rows.length; k++) if (rows[k] && rows[k].id === id) i = k;\nif (i < 0) return;\nvar j = dir === 'up' ? i - 1 : dir === 'down' ? i + 1 : 0;\nif (j < 0 || j >= rows.length || j === i) return;\nOutputs.firstId = id;\nOutputs.from = i + 1;\nOutputs.to = j + 1;\nif (dir === 'top') {\n  // Above whatever is first now. Nobody else's row is rewritten.\n  Outputs.firstPosition = Number(rows[0].position) - 1;\n  Outputs.hasSecond = false;\n} else {\n  // Swap with the neighbour.\n  Outputs.firstPosition = Number(rows[j].position);\n  Outputs.secondId = rows[j].id;\n  Outputs.secondPosition = Number(rows[i].position);\n  Outputs.hasSecond = true;\n}\nOutputs.summary = 'Next actions reordered';\nOutputs.go();",
        "runOnChange-in-rows": false,
        "runOnChange-in-direction": false,
        "runOnChange-in-itemId": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-rows",
          "displayName": "rows",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-itemId",
          "displayName": "itemId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-direction",
          "displayName": "direction",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-firstId",
          "displayName": "firstId",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-from",
          "displayName": "from",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-to",
          "displayName": "to",
          "plug": "output",
