          "group": "Outputs"
        },
        {
          "name": "out-secondId",
          "displayName": "secondId",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-secondPosition",
          "displayName": "secondPosition",
          "plug": "output",
