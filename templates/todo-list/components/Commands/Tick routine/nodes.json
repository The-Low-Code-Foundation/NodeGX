        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "TickroutinGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "function findRow(rows, id) {\n  for (var i = 0; i < rows.length; i++) if (rows[i] && rows[i].id === id) return rows[i];\n  return null;\n}\nvar row = findRow(Inputs.rows || [], String(Inputs.rowId || ''));\nif (!row || !row.isRoutine || !row.routineId || !row.date || !row.time) return;\nOutputs.routineId = row.routineId;\nOutputs.date = row.date;\nOutputs.time = row.time;\nOutputs.doneAt = new Date().toISOString();\nOutputs.note = String(Inputs.note || '').trim();\nOutputs.summary = 'Done (' + row.time + ')';\nOutputs.go();",
        "runOnChange-in-rows": false,
        "runOnChange-in-rowId": false,
        "runOnChange-in-note": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-rows",
          "displayName": "rows",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-rowId",
          "displayName": "rowId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-note",
          "displayName": "note",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-routineId",
          "displayName": "routineId",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-date",
          "displayName": "date",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-time",
          "displayName": "time",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-doneAt",
          "displayName": "doneAt",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-note",
          "displayName": "note",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-summary",
