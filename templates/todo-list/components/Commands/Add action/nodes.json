{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "5476352c-8497-5abf-8d66-0da1fd86d200",
  "version": 1,
  "nodes": [
    {
      "id": "AddactionIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "taskId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "position",
          "plug": "output",
          "type": "number"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "AddactionOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "AddactionGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.taskId || '');\nvar t = String(Inputs.title || '').trim();\nif (id === '' || t === '') return;\nOutputs.taskId = id;\nOutputs.title = t;\nOutputs.position = Number(Inputs.position) || 1;\nOutputs.done = false;\nOutputs.empty = '';\nOutputs.summary = 'Next action added: “' + t + '”';\nOutputs.go();",
        "runOnChange-in-taskId": false,
        "runOnChange-in-title": false,
        "runOnChange-in-position": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-taskId",
          "displayName": "taskId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-title",
          "displayName": "title",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-position",
          "displayName": "position",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-taskId",
          "displayName": "taskId",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-title",
          "displayName": "title",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-position",
          "displayName": "position",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-done",
          "displayName": "done",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-empty",
          "displayName": "empty",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-summary",
          "displayName": "summary",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "AddactionCreate",
      "type": "NewDbModelProperties",
      "label": "Add the next action",
      "parameters": {
        "collectionName": "Action"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "AddactionHistory",
      "type": "/Logic/Write history",
      "label": "Write the history line",
      "parameters": {
        "kind": "action-added"
      },
      "x": 40,
      "y": 520
    },
    {
      "id": "AddactionProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "todoProblem",
        "setWith": "string",
        "value": "That change did not save. Check your connection, then try again."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 640
    }
  ]
}
