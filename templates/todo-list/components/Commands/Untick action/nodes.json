    {
      "id": "UntickactiGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "function findRow(rows, id) {\n  for (var i = 0; i < rows.length; i++) if (rows[i] && rows[i].id === id) return rows[i];\n  return null;\n}\nvar row = findRow(Inputs.rows || [], String(Inputs.actionId || ''));\nvar note = String(Inputs.note || '').trim();\nif (!row || note === '') return;\nOutputs.done = false;\nOutputs.empty = '';\nOutputs.position = Number(Inputs.position) || 1;\nOutputs.note = note;\nOutputs.summary = 'Unticked “' + row.title + '”';\nOutputs.go();",
        "runOnChange-in-rows": false,
        "runOnChange-in-actionId": false,
        "runOnChange-in-note": false,
        "runOnChange-in-position": false
      },
      "x": 40,
      "y": 280,
      "ports": [
