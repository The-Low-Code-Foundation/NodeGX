{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "e56ad240-0bb9-54fa-8740-17137a48964b",
  "version": 1,
  "nodes": [
    {
      "id": "RenametaskIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "taskId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "oldTitle",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "newTitle",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "RenametaskOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "RenametaskGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.taskId || '');\nvar old = String(Inputs.oldTitle || '');\nvar t = String(Inputs.newTitle || '').trim();\nif (id === '' || t === '' || t === old) return;\nOutputs.title = t;\nOutputs.summary = 'Renamed from “' + old + '”';\nOutputs.go();",
        "runOnChange-in-taskId": false,
        "runOnChange-in-oldTitle": false,
        "runOnChange-in-newTitle": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-taskId",
          "displayName": "taskId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-oldTitle",
          "displayName": "oldTitle",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-newTitle",
          "displayName": "newTitle",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-title",
          "displayName": "title",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-summary",
          "displayName": "summary",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "RenametaskWrite",
      "type": "SetDbModelProperties",
      "label": "Rename the task",
      "parameters": {
        "collectionName": "Task",
        "idSource": "explicit"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "RenametaskHistory",
      "type": "/Logic/Write history",
      "label": "Write the history line",
      "parameters": {
        "kind": "renamed"
      },
      "x": 40,
      "y": 520
    },
    {
      "id": "RenametaskProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "todoProblem",
        "setWith": "string",
        "value": "That change did not save. Check your connection, then try again."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 640
    }
  ]
}
