{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "d67f1b6a-7bec-55a3-8f7d-e14561c4d3bf",
  "version": 1,
  "nodes": [
    {
      "id": "ReopentaskIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "taskId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "note",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "position",
          "plug": "output",
          "type": "number"
        },
        {
          "name": "rank",
          "plug": "output",
          "type": "number"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "ReopentaskOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "ReopentaskGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.taskId || '');\nvar note = String(Inputs.note || '').trim();\nif (id === '' || note === '') return;\nOutputs.status = 'open';\nOutputs.position = Number(Inputs.position) || 1;\nOutputs.empty = '';\nOutputs.note = note;\nOutputs.summary = 'Reopened at #' + (Number(Inputs.rank) || 1);\nOutputs.go();",
        "runOnChange-in-taskId": false,
        "runOnChange-in-note": false,
        "runOnChange-in-position": false,
        "runOnChange-in-rank": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-taskId",
          "displayName": "taskId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-note",
          "displayName": "note",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-position",
          "displayName": "position",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-rank",
          "displayName": "rank",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-status",
          "displayName": "status",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-position",
          "displayName": "position",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-empty",
          "displayName": "empty",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-note",
          "displayName": "note",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-summary",
          "displayName": "summary",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "ReopentaskWrite",
      "type": "SetDbModelProperties",
      "label": "Reopen the task",
      "parameters": {
        "collectionName": "Task",
        "idSource": "explicit"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "ReopentaskHistory",
      "type": "/Logic/Write history",
      "label": "Write the history line",
      "parameters": {
        "kind": "reopened"
      },
      "x": 40,
      "y": 520
    },
    {
      "id": "ReopentaskProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "todoProblem",
        "setWith": "string",
        "value": "That change did not save. Check your connection, then try again."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 640
    }
  ]
}
