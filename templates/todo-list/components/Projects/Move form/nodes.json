    {
      "id": "mfCheck",
      "type": "JavaScriptFunction",
      "label": "What the form says",
      "parameters": {
        "functionScript": "function pick(typed, start) {\n  if (typed !== undefined && typed !== null) return String(typed);\n  return start === undefined || start === null ? '' : String(start);\n}\nvar title = pick(Inputs.typedTitle, Inputs.title).trim();\nvar who = pick(Inputs.typedWho, Inputs.who).trim();\nvar deadline = pick(Inputs.pickedDeadline, Inputs.deadline).trim();\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(deadline)) deadline = '';\nvar error = title === '' && Inputs.titleOptional !== true ? 'The move needs a few words.' : '';\nOutputs.error = error;\nOutputs.hasError = error !== '';\nif (error) return;\nOutputs.title = title;\nOutputs.waitingOn = who;\nOutputs.deadline = deadline;\nOutputs.go();",
        "runOnChange-in-title": false,
        "runOnChange-in-who": false,
        "runOnChange-in-deadline": false,
        "runOnChange-in-titleOptional": false,
        "runOnChange-in-typedTitle": false,
        "runOnChange-in-typedWho": false,
        "runOnChange-in-pickedDeadline": false
      },
