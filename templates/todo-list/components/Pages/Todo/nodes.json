      "label": "Which project is the selected task part of?",
      "parameters": {
        "functionScript": "var sel = String(Inputs.selectedId || ''), tasks = Inputs.tasks || [], names = Inputs.projectNames || {};\nvar pid = '';\nfor (var i = 0; i < tasks.length; i++) if (tasks[i] && tasks[i].id === sel && tasks[i].projectId && names[tasks[i].projectId]) pid = String(tasks[i].projectId);\nOutputs.projectId = pid;\nOutputs.projectValue = pid || 'none';\nOutputs.showProject = Inputs.showTab === true;\nOutputs.hasProject = pid !== '' && Inputs.showTab === true;"
      },
      "x": 650,
      "y": 3160,
      "ports": [
        {
          "name": "in-selectedId",
          "displayName": "selectedId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
