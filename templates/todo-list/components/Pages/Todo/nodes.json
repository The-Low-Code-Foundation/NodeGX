      "parameters": {
        "functionScript": "var id = '';\ntry {\n  id = window.sessionStorage.getItem(\"todo-open-task\") || '';\n  window.sessionStorage.removeItem(\"todo-open-task\");\n} catch (e) {}\nif (!id) {\n  var m = /[?&]task=([^&#]*)/.exec(window.location.search || '');\n  if (m) { try { id = decodeURIComponent(m[1]); } catch (e) { id = ''; } }\n}\nif (!id) return;\nOutputs.taskId = id;\nOutputs.open();"
      },
