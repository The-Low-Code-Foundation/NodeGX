    {
      "id": "tdPickDay",
      "type": "JavaScriptFunction",
      "label": "Pick or unpick a day",
      "parameters": {
        "functionScript": "var key = String(Inputs.key || '');\nif (key === '') return;\nvar list = String(Inputs.days || '').split(',').filter(function (d) { return d !== ''; });\nvar at = list.indexOf(key);\nif (at >= 0) list.splice(at, 1); else list.push(key);\nOutputs.days = list.join(',');\nOutputs.go();",
        "runOnChange-in-key": false,
        "runOnChange-in-days": false
      },
      "x": 650,
      "y": 3760,
      "ports": [
        {
          "name": "in-key",
          "displayName": "key",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
