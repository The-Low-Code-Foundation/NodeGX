      "id": "tdNextFor",
      "type": "JavaScriptFunction",
      "label": "Was it a project’s task?",
      "parameters": {
        "functionScript": "var id = String(Inputs.taskId || '');\nvar tasks = Inputs.tasks || [];\nvar names = Inputs.projectNames || {};\nfor (var i = 0; i < tasks.length; i++) {\n  var t = tasks[i];\n  if (!t || t.id !== id || !t.projectId || !names[t.projectId]) continue;\n  Outputs.projectId = String(t.projectId);\n  Outputs.projectName = String(names[t.projectId]);\n  Outputs.show();\n  return;\n}",
        "runOnChange-in-taskId": false,
        "runOnChange-in-tasks": false,
        "runOnChange-in-projectNames": false
      },
      "x": 650,
      "y": 1000,
      "ports": [
        {
