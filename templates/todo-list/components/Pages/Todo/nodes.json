    {
      "id": "tdLayout",
      "type": "JavaScriptFunction",
      "label": "One pane or two?",
      "parameters": {
        "functionScript": "var narrow = (Inputs.width || 1200) < 820;\nvar found = !!Inputs.found || !!Inputs.routineFound;\nOutputs.narrow = narrow;\nOutputs.found = found;\nOutputs.nothing = !found;\nOutputs.showLeft = !(narrow && found);\nOutputs.showRight = !narrow || found;"
      },
      "x": 650,
      "y": 880,
      "ports": [
        {
          "name": "in-width",
          "displayName": "width",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-found",
          "displayName": "found",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
