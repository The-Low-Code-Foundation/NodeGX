    {
      "id": "tdClock",
      "type": "JavaScriptFunction",
      "label": "A minute clock, and a wake when the app comes back into view",
      "parameters": {
        "functionScript": "if (this.clockStarted) return;\nthis.clockStarted = true;\nfunction tick() {\n  try { Outputs.now = Date.now(); } catch (e) {}\n}\ntick();\nsetInterval(tick, 60000);\ntry {\n  document.addEventListener('visibilitychange', function () {\n    if (document.visibilityState !== 'visible') return;\n    tick();\n    try { Outputs.wake(); } catch (e) {}\n  });\n} catch (e) {}"
      },
      "ports": [
        {
          "name": "out-now",
          "plug": "output",
          "type": "number",
          "displayName": "now",
          "group": "Outputs"
        },
        {
          "name": "out-wake",
          "plug": "output",
          "type": "signal",
          "displayName": "wake",
          "group": "Outputs"
        }
      ],
      "x": 650,
      "y": 6160
    },
