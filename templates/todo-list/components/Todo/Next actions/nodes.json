      "parent": "naRoot",
      "parameters": {
        "flexDirection": "column",
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "rowGap": "var(--space-0)"
      },
      "children": [
        "naEach"
      ],
      "x": 100,
      "y": 280
    },
    {
      "id": "naEach",
      "type": "For Each",
      "label": "One row per next action",
      "parent": "naRows",
      "parameters": {
        "template": "/Todo/Action row",
        "templateType": "explicit"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "naAdd",
      "type": "Group",
      "label": "Add a next action",
      "parent": "naRoot",
      "parameters": {
        "flexDirection": "row",
        "alignItems": "center",
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "columnGap": "var(--space-2)"
      },
      "children": [
        "naField",
        "naButton"
      ],
      "x": 100,
      "y": 520
    },
    {
      "id": "naField",
      "type": "net.noodl.controls.textinput",
      "label": "New next action",
      "parent": "naAdd",
      "parameters": {
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "type": "text",
        "backgroundColor": "var(--background)",
        "color": "var(--foreground)",
        "fontSize": "var(--text-base)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-control)",
        "borderRadius": "var(--radius-md)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)",
        "paddingLeft": "var(--space-3)",
        "paddingRight": "var(--space-3)",
        "placeholder": "Add a next action"
      },
      "x": 160,
      "y": 640
    },
    {
      "id": "naButton",
      "type": "net.noodl.controls.button",
      "label": "Add",
      "parent": "naAdd",
      "parameters": {
        "backgroundColor": "transparent",
        "color": "var(--foreground)",
        "borderRadius": "var(--radius-md)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-control)",
        "paddingLeft": "var(--space-4)",
        "paddingRight": "var(--space-4)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "sizeMode": "contentSize",
        "label": "Add"
      },
      "x": 160,
      "y": 760
    },
    {
      "id": "naSubmit",
      "type": "JavaScriptFunction",
      "label": "The title, if one was typed",
      "parameters": {
        "functionScript": "var t = String(Inputs.text || '').trim();\nif (t === '') return;\nOutputs.text = t;\nOutputs.go();",
        "runOnChange-in-text": false
      },
      "x": 410,
      "y": 640,
      "ports": [
        {
          "name": "in-text",
          "displayName": "text",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-text",
          "displayName": "text",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    }
