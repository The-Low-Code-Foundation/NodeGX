    {
      "id": "naRoot",
      "type": "Group",
      "label": "Next actions",
      "parameters": {
        "flexDirection": "column",
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "rowGap": "var(--space-2)"
      },
      "children": [
        "naHeading",
        "naRows",
        "naAdd"
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "naHeading",
      "type": "Text",
      "label": "Heading",
      "parent": "naRoot",
      "parameters": {
        "text": "Next actions",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "color": "var(--muted-foreground)",
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "as": "h2"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "naRows",
      "type": "Group",
