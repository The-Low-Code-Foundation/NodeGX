    {
      "id": "zlWalk",
      "type": "JavaScriptFunction",
      "label": "Where the monster stands now: walking off the clock, or resting",
      "parameters": {
        "functionScript": "var from = Number(Inputs.walkFrom) || 0;\nvar left = Number(Inputs.left);\nvar walking = Inputs.walking === true && from > 0 && left >= 0 && left <= 100;\nvar at = walking ? from * left / 100 : Number(Inputs.rest);\nif (!(at >= 0)) at = 1;\nOutputs.width = Math.round(Math.min(1, at) * 1000) / 10;\nOutputs.moverClass = walking ? 'rkt-mover' : 'rkt-mover rkt-mover-glide';"
      },
      "x": 470,
      "y": 760,
