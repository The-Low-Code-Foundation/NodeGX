    {
      "id": "leFill",
      "type": "JavaScriptFunction",
      "label": "The list to edit, or an empty one",
      "parameters": {
        "functionScript": "var sets = Array.isArray(Inputs.sets) ? Inputs.sets : [];\nvar id = String(Inputs.setId || '');\nvar set = null;\nfor (var i = 0; i < sets.length; i++) if (sets[i] && sets[i].id === id) set = sets[i];\nOutputs.name = set ? String(set.name || '') : '';\nOutputs.text = set ? (set.items || []).map(function (it) { return it.q + ' = ' + it.a; }).join('\\n') : '';\nOutputs.both = !!(set && set.both === true);\nOutputs.id = set ? String(set.id) : '';",
        "runOnChange-in-sets": false,
        "runOnChange-in-setId": false
      },
