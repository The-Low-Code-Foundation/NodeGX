      "type": "JavaScriptFunction",
      "label": "How many, in words",
      "parameters": {
        "functionScript": "var n = Math.max(0, Math.floor(Number(Inputs.n) || 0));\nOutputs.line = n ? String(Inputs.word || '{n}').replace('{n}', n) : String(Inputs.empty || '');"
