        {
          "name": "at",
          "plug": "output",
          "type": "number"
        },
        {
          "name": "glyph",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "kind",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "edge",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "me",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "species",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "colour",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "grown",
          "plug": "output",
          "type": "number"
        },
        {
          "name": "hat",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "eyes",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "neck",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "back",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "form",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 410,
      "y": 400
    },
    {
      "id": "ttCell",
      "type": "Group",
      "label": "The tile",
      "children": [
        "ttGlyph",
        "ttMeBox"
      ],
      "parameters": {
        "sizeMode": "explicit",
        "width": {
          "value": 48,
          "unit": "px"
        },
        "height": {
          "value": 48,
          "unit": "px"
        },
        "alignItems": "center",
        "justifyContent": "center",
        "borderRadius": "var(--radius-md)",
        "borderStyle": "solid",
        "borderWidth": {
          "value": 2,
          "unit": "px"
        },
        "borderColor": "var(--foreground)"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "ttGlyph",
      "type": "Text",
      "label": "What lies here",
      "parent": "ttCell",
      "parameters": {
        "text": "",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-2xl)",
        "color": "var(--foreground)",
        "textAlignX": "center"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "ttMeBox",
      "type": "Group",
      "label": "The alien, here",
      "parent": "ttCell",
      "children": [
        "ttAlien"
      ],
      "parameters": {
        "sizeMode": "contentSize",
        "mounted": false
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "ttAlien",
      "type": "game-kit.Alien",
      "label": "The walking alien",
      "parent": "ttMeBox",
      "parameters": {
        "size": 42
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "ttKind",
      "type": "States",
      "label": "Fog, plain, water, crater or home",
      "parameters": {
        "states": "fog,plain,water,crater,home",
        "values": "ground",
        "useTransitions": false,
        "type-ground": "color",
        "value-fog-ground": "var(--muted)",
        "value-plain-ground": "var(--surface)",
        "value-water-ground": "var(--alien-sky)",
        "value-crater-ground": "var(--border-subtle)",
        "value-home-ground": "var(--accent)"
      },
      "x": 410,
      "y": 40
    },
    {
      "id": "ttClass",
      "type": "Expression",
      "label": "Fog, and the edge, as classes",
      "parameters": {
        "expression": "(kind === 'fog' ? 'rkt-trip-fog ' : '') + (edge === 'near' ? 'rkt-trip-near' : edge === 'here' ? 'rkt-trip-here' : 'rkt-trip-far')"
      },
      "x": 410,
      "y": 160
    },
    {
      "id": "ttGlyphShown",
      "type": "Expression",
      "label": "Nothing drawn under the alien",
      "parameters": {
        "expression": "me !== true"
      },
      "x": 410,
      "y": 520
    },
    {
      "id": "ttOut",
      "type": "Component Outputs",
      "label": "Tapped",
      "ports": [
        {
          "name": "tapped",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "at",
          "plug": "input",
          "type": "number"
        }
      ],
      "x": 410,
      "y": 280
    }
  ],
  "visualRoots": [
    "ttCell"
  ]
