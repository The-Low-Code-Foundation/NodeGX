{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "fc90c4a3-4913-5caf-88ef-d5ba72e3a318",
  "version": 1,
  "nodes": [
    {
      "id": "nhPage",
      "type": "Page",
      "label": "Hunt",
      "children": [
        "nhOuter"
      ],
      "parameters": {
        "title": "Number Hunt",
        "urlPath": "hunt"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "nhOuter",
      "type": "Group",
      "label": "The ground",
      "parent": "nhPage",
      "children": [
        "nhWrap"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "center"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "nhWrap",
      "type": "Group",
      "label": "The screen",
      "parent": "nhOuter",
      "children": [
        "nhHeader",
        "nhTitle",
        "nhPlay"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "stretch",
        "rowGap": "var(--space-4)",
        "paddingTop": "var(--space-4)",
        "paddingBottom": "var(--space-8)",
        "paddingLeft": "var(--space-4)",
        "paddingRight": "var(--space-4)",
        "maxWidth": {
          "value": 960,
          "unit": "px"
        }
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "nhHeader",
      "type": "/Game/Header",
      "label": "The bar",
      "parent": "nhWrap",
      "parameters": {
        "showHome": true,
        "showHangar": true
      },
      "x": 220,
      "y": 400
    },
    {
      "id": "nhTitle",
      "type": "Text",
      "label": "Number Hunt",
      "parent": "nhWrap",
      "parameters": {
        "text": "",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-3xl)",
        "fontWeight": "var(--font-extrabold)",
        "lineHeight": "var(--leading-tight)",
        "letterSpacing": "var(--tracking-tight)",
        "color": "var(--foreground)",
        "as": "h2",
        "fontFamily": "Grandstander"
      },
      "x": 220,
      "y": 520
    },
    {
      "id": "nhPlay",
      "type": "/Hunt/Play",
      "label": "The game",
      "parent": "nhWrap",
      "x": 220,
      "y": 640
    },
    {
      "id": "nhStore",
      "type": "/Logic/App store",
      "label": "The store",
      "x": 470,
      "y": 400
    },
    {
      "id": "nhMe",
      "type": "/Logic/Active profile",
      "label": "Who is playing",
      "x": 470,
      "y": 520
    },
    {
      "id": "nhWords",
      "type": "/Data/Words",
      "label": "The words",
      "x": 470,
      "y": 1360
    },
    {
      "id": "nhT",
      "type": "/Logic/Translate words",
      "label": "In their language",
      "x": 470,
      "y": 1000
    },
    {
      "id": "nhCurriculum",
      "type": "/Data/Curriculum",
      "label": "The skills",
      "x": 470,
      "y": 1480
    },
    {
      "id": "nhWordLists",
      "type": "/Data/Word lists",
      "label": "The typing words",
      "x": 470,
      "y": 1600
    },
    {
      "id": "nhSave",
      "type": "/Logic/Save model",
      "label": "Remember the stars",
      "x": 470,
      "y": 1120
    },
    {
      "id": "nhNoOne",
      "type": "Expression",
      "label": "Nobody signed in?",
      "parameters": {
        "expression": "has === false"
      },
      "x": 470,
      "y": 1720
    },
    {
      "id": "nhGuard",
      "type": "Condition",
