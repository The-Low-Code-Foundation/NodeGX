      "parameters": {
        "router": "Main",
        "target": "/Pages/Profiles"
      },
      "x": 470,
      "y": 640
    },
    {
      "id": "nhGoHome",
      "type": "RouterNavigate",
      "label": "Home",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Home"
      },
      "x": 470,
      "y": 760
    },
    {
      "id": "nhGoHangar",
      "type": "RouterNavigate",
      "label": "To the hangar",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Hangar"
      },
      "x": 470,
      "y": 880
    },
    {
      "id": "nhSounds",
      "type": "/Logic/Play sounds",
      "label": "The fanfare",
      "x": 470,
      "y": 1240
    }
