    {
      "id": "stOpened",
      "type": "JavaScriptFunction",
      "label": "Clear the boxes on close; tick the days to match",
      "parameters": {
        "functionScript": "var shown = Inputs.shown === true;\nif (this.wasShown && !shown) Outputs.closed();\nvar day1Want = shown ? Inputs.day1 === true : null;\nif (day1Want !== null && (!this.wasShown || this.day1Last !== day1Want)) { if (day1Want) Outputs.day1On(); else Outputs.day1Off(); }\nthis.day1Last = day1Want;\nvar day2Want = shown ? Inputs.day2 === true : null;\nif (day2Want !== null && (!this.wasShown || this.day2Last !== day2Want)) { if (day2Want) Outputs.day2On(); else Outputs.day2Off(); }\nthis.day2Last = day2Want;\nvar day3Want = shown ? Inputs.day3 === true : null;\nif (day3Want !== null && (!this.wasShown || this.day3Last !== day3Want)) { if (day3Want) Outputs.day3On(); else Outputs.day3Off(); }\nthis.day3Last = day3Want;\nvar day4Want = shown ? Inputs.day4 === true : null;\nif (day4Want !== null && (!this.wasShown || this.day4Last !== day4Want)) { if (day4Want) Outputs.day4On(); else Outputs.day4Off(); }\nthis.day4Last = day4Want;\nvar day5Want = shown ? Inputs.day5 === true : null;\nif (day5Want !== null && (!this.wasShown || this.day5Last !== day5Want)) { if (day5Want) Outputs.day5On(); else Outputs.day5Off(); }\nthis.day5Last = day5Want;\nvar day6Want = shown ? Inputs.day6 === true : null;\nif (day6Want !== null && (!this.wasShown || this.day6Last !== day6Want)) { if (day6Want) Outputs.day6On(); else Outputs.day6Off(); }\nthis.day6Last = day6Want;\nvar day0Want = shown ? Inputs.day0 === true : null;\nif (day0Want !== null && (!this.wasShown || this.day0Last !== day0Want)) { if (day0Want) Outputs.day0On(); else Outputs.day0Off(); }\nthis.day0Last = day0Want;\nthis.wasShown = shown;"
