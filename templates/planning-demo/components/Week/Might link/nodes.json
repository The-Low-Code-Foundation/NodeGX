        "flexDirection": "row",
        "alignItems": "flex-start",
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "columnGap": "var(--space-1)"
      },
      "children": [
        "mlName",
        "mlOdds",
        "mlMove"
      ],
      "x": 40,
      "y": 40
