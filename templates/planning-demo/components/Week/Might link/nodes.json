        {
          "name": "projectId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "name",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "odds",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "move",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 350,
      "y": 160
    },
    {
      "id": "mlOut",
      "type": "Component Outputs",
      "label": "Opened",
      "ports": [
        {
          "name": "open",
          "plug": "input",
