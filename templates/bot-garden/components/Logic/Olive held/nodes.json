    {
      "id": "oliveheldFn",
      "type": "JavaScriptFunction",
      "label": "Olive held",
      "parameters": {
        "functionScript": "var { langOf, nameOf, wordMap } = Scripts.words;\nvar ORDER = [\"say-thanks\",\"read\",\"is-it-a\"];\nvar BAND = {\"say-thanks\":2,\"read\":2,\"is-it-a\":2};\nvar TITLE = {\"say-thanks\":\"rungSayThanks\",\"read\":\"rungRead\",\"is-it-a\":\"rungIsItA\"};\nvar lang = langOf(Inputs.lang), band = Number(Inputs.band) === 1 ? 1 : 2;\nvar w = wordMap(Inputs.words, lang, nameOf(Inputs.botName));\nvar rungs = Inputs.exam && Inputs.exam.rungs && typeof Inputs.exam.rungs === 'object' ? Inputs.exam.rungs : {};\nvar held = [];\nfor (var i = 0; i < ORDER.length; i++) { var id = ORDER[i]; if (BAND[id] <= band && rungs[id] && rungs[id].pass === false) held.push(id); }\nvar names = [];\nfor (var j = 0; j < held.length; j++) names.push(w[TITLE[held[j]]] || held[j]);\nOutputs.held = held;\nOutputs.show = held.length > 0;\nOutputs.text = held.length ? (w.oliveCant || '') + (lang === 'fr' ? ' : ' : ': ') + names.join(', ') : '';\n",
        "uses": "words.js"
      },
      "x": 40,
      "y": 160,
      "ports": [
        {
          "name": "in-lang",
          "displayName": "lang",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
