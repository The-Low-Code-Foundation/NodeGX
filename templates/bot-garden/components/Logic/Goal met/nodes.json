      "id": "goalmetFn",
      "type": "JavaScriptFunction",
      "label": "Goal met",
      "parameters": {
        "functionScript": "var { goalMet, worldOf } = Scripts.engine;\nvar w = worldOf(Inputs.world);\nvar run = Inputs.run && typeof Inputs.run === 'object' ? Inputs.run : { robotId: Inputs.robotId, handled: {}, said: 0 };\nvar g = goalMet(w, run, Inputs.program, Inputs.goal);\nOutputs.met = g.met;\nOutputs.missing = g.missing;\nOutputs.done = g.done;\nOutputs.total = g.total;\n",
        "runOnChange-in-goal": false,
        "runOnChange-in-program": false,
        "runOnChange-in-robotId": false,
        "runOnChange-in-run": false,
        "runOnChange-in-world": false,
        "uses": "engine.js"
      },
