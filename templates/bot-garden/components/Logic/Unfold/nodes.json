{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "219ffd70-d1b5-534c-87bb-868b4e826f90",
  "version": 1,
  "nodes": [
    {
      "id": "unfoldIn",
      "type": "Component Inputs",
      "label": "What the caller gives",
      "ports": [
        {
          "name": "go",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "program",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "repeatId",
          "plug": "output",
          "type": "*"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "unfoldFn",
      "type": "JavaScriptFunction",
      "label": "Unfold",
      "parameters": {
        "functionScript": "var { maxId, parentListOf, reId } = Scripts.fold;\nvar program = JSON.parse(JSON.stringify(Array.isArray(Inputs.program) ? Inputs.program : []));\nvar repeatId = Number(Inputs.repeatId);\nvar host = parentListOf(program, repeatId);\nvar unfolded = false;\nif (host) {\n  var at = -1;\n  for (var i = 0; i < host.length; i++) if (host[i] && host[i].id === repeatId) at = i;\n  var rep = host[at];\n  if (rep && rep.t === 'repeat') {\n    var next = { n: maxId(program) + 1 }, body = Array.isArray(rep.body) ? rep.body : [], n = Math.max(0, Math.floor(Number(rep.n)) || 0), out = [];\n    for (var k = 0; k < n; k++) for (var j = 0; j < body.length; j++) out.push(reId(body[j], next));\n    host.splice.apply(host, [at, 1].concat(out));\n    unfolded = true;\n  }\n}\nOutputs.program = program;\nOutputs.unfolded = unfolded;\n",
        "runOnChange-in-program": false,
        "runOnChange-in-repeatId": false,
        "uses": "fold.js"
      },
      "x": 40,
      "y": 160,
      "ports": [
        {
          "name": "in-program",
          "displayName": "program",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-repeatId",
          "displayName": "repeatId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-program",
          "displayName": "program",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-unfolded",
          "displayName": "unfolded",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "unfoldOut",
      "type": "Component Outputs",
      "label": "What it answers",
      "ports": [
        {
          "name": "program",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "unfolded",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "ran",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 280
    }
  ]
