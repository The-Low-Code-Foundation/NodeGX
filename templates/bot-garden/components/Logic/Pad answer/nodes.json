{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "2e028d80-cfbb-55d2-8f22-b97484b0b060",
  "version": 1,
  "nodes": [
    {
      "id": "padanswerIn",
      "type": "Component Inputs",
      "label": "What the caller gives",
      "ports": [
        {
          "name": "go",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "answer",
          "plug": "output",
          "type": "object"
        },
        {
          "name": "run",
          "plug": "output",
          "type": "object"
        },
        {
          "name": "stepMs",
          "plug": "output",
          "type": "number"
        },
        {
          "name": "world",
          "plug": "output",
          "type": "object"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "padanswerFn",
      "type": "JavaScriptFunction",
      "label": "Pad answer",
      "parameters": {
        "functionScript": "var { clone, step, worldOf } = Scripts.engine;\nvar pend = Inputs.run && typeof Inputs.run === 'object' ? clone(Inputs.run) : null;\nvar a = Inputs.answer && typeof Inputs.answer === 'object' ? Inputs.answer : null;\nvar text = '';\nif (pend && a && pend.waiting) {\n  var st = step(pend, worldOf(Inputs.world), a);\n  text = st.delta && st.delta.sayText ? String(st.delta.sayText) : '';\n}\nvar ms = (Number(Inputs.stepMs) > 0 ? Number(Inputs.stepMs) : 380) * 3;\nif (text) Outputs.bubble = { robot: 0, text: text, style: 'olive', ms: ms, n: 'pad:olive:' + (a && a.seq !== undefined ? a.seq : '') + ':' + Math.random().toString(36).slice(2, 8) };\nOutputs.said = text;\n",
        "runOnChange-in-answer": false,
        "runOnChange-in-run": false,
        "runOnChange-in-stepMs": false,
        "runOnChange-in-world": false,
        "uses": "engine.js"
      },
      "x": 40,
      "y": 160,
      "ports": [
        {
          "name": "in-run",
          "displayName": "run",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-answer",
          "displayName": "answer",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-world",
          "displayName": "world",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-stepMs",
          "displayName": "stepMs",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-bubble",
          "displayName": "bubble",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-said",
          "displayName": "said",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "padanswerOut",
      "type": "Component Outputs",
      "label": "What it answers",
      "ports": [
        {
          "name": "bubble",
