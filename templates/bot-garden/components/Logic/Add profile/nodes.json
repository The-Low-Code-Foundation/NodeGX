    {
      "id": "addprofileFn",
      "type": "JavaScriptFunction",
      "label": "Add profile",
      "parameters": {
        "functionScript": "var { MAX_PROFILES, activate, modelOf, profileOf } = Scripts.save;\nvar model = modelOf(Inputs.model);\nvar name = String(Inputs.name || '').trim().slice(0, 24);\nvar ok = false, profileId = '', error = '';\nif (!name) error = 'name';\nelse if (model.profiles.length >= MAX_PROFILES) error = 'full';\nelse {\n  var p = profileOf({ name: name, band: Inputs.band, lang: Inputs.lang, face: Inputs.face, robot: { name: Inputs.robotName, color: Inputs.color, eye: Inputs.eye, hat: 'none' } });\n  model.profiles.push(p);\n  activate(model, p.id);\n  profileId = p.id;\n  ok = true;\n}\nOutputs.model = model;\nOutputs.ok = ok;\nOutputs.error = error;\nOutputs.profileId = profileId;\nOutputs.count = model.profiles.length;\n",
        "runOnChange-in-band": false,
        "runOnChange-in-color": false,
        "runOnChange-in-eye": false,
        "runOnChange-in-face": false,
        "runOnChange-in-lang": false,
        "runOnChange-in-model": false,
        "runOnChange-in-name": false,
        "runOnChange-in-robotName": false,
        "uses": "save.js"
      },
      "x": 40,
      "y": 160,
      "ports": [
        {
          "name": "in-model",
          "displayName": "model",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-name",
          "displayName": "name",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
