{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "0b3a5341-67aa-5d75-8897-06f5cf67ab7e",
  "version": 1,
  "nodes": [
    {
      "id": "findrobotsIn",
      "type": "Component Inputs",
      "label": "What the caller gives",
      "ports": [
        {
          "name": "go",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "findrobotsFn",
      "type": "JavaScriptFunction",
      "label": "Find robots",
      "parameters": {
        "functionScript": "\nvar found = 0;\nif (typeof document !== 'undefined') {\n  var box = document.querySelector('.bg-isle-scroll');\n  var bots = box ? box.querySelectorAll('.gd-bot') : [];\n  found = bots.length;\n  if (bots.length && bots[0].scrollIntoView) bots[0].scrollIntoView({ block: 'nearest', inline: 'center' });\n  if (box) {\n    box.classList.remove('bg-isle-found');\n    void box.offsetWidth;\n    box.classList.add('bg-isle-found');\n  }\n}\nOutputs.found = found;\n"
      },
      "x": 40,
      "y": 160,
      "ports": [
        {
          "name": "out-found",
          "displayName": "found",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "findrobotsOut",
      "type": "Component Outputs",
      "label": "What it answers",
      "ports": [
        {
          "name": "found",
          "plug": "input",
          "type": "boolean"
        },
        {
          "name": "ran",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 280
    }
  ]
}