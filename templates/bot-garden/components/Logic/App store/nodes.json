{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "e60b4745-9392-5285-8b18-572a3417f50f",
  "version": 1,
  "nodes": [
    {
      "id": "asIn",
      "type": "Component Inputs",
      "label": "What the caller gives",
      "ports": [
        {
          "name": "write",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "model",
          "plug": "output",
          "type": "object"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "asStore",
      "type": "net.noodl.GlobalStore",
      "label": "The persisted store",
      "parameters": {
        "storeName": "garden",
        "persist": true,
        "storageKey": "bot-garden"
      },
      "x": 40,
      "y": 160
    },
    {
      "id": "asRead",
      "type": "net.noodl.GlobalStore.Subscribe",
      "label": "Read the family",
      "parameters": {
        "storeName": "garden",
        "keys": "model"
      },
      "x": 40,
      "y": 280
    },
    {
      "id": "asWrite",
      "type": "net.noodl.GlobalStore.Set",
      "label": "Write the family",
      "parameters": {
        "storeName": "garden",
        "key": "model",
        "merge": false
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "asKeep",
      "type": "game-kit.KeepStorage",
      "label": "Ask the browser to keep it",
      "x": 40,
      "y": 520
    },
    {
      "id": "asOut",
      "type": "Component Outputs",
      "label": "What it answers",
      "ports": [
        {
          "name": "model",
          "plug": "input",
          "type": "object"
        },
        {
          "name": "changed",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "written",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "ready",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "error",
          "plug": "input",
          "type": "string"
        }
      ],
      "x": 40,
      "y": 640
    }
  ]
}
