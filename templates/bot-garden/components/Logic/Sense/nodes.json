  "version": 1,
  "nodes": [
    {
      "id": "senseIn",
      "type": "Component Inputs",
      "label": "What the caller gives",
      "ports": [
        {
          "name": "answer",
          "plug": "output",
          "type": "object"
        },
        {
          "name": "arg",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "count",
