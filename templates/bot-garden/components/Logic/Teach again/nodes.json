      "id": "teachagainFn",
      "type": "JavaScriptFunction",
      "label": "Teach again",
      "parameters": {
        "functionScript": "var { islStale } = Scripts.island;\nvar { fill, langOf, nameOf, wordMap } = Scripts.words;\nvar lang = langOf(Inputs.lang), name = nameOf(Inputs.botName);\nvar w = wordMap(Inputs.words, lang, name);\nvar reqs = Array.isArray(Inputs.requests) ? Inputs.requests : [];\nvar id = String(Inputs.requestId || '');\nvar plots = Inputs.plots && typeof Inputs.plots === 'object' ? Inputs.plots : {};\nvar req = null;\nfor (var i = 0; i < reqs.length; i++) if (reqs[i] && reqs[i].id === id) req = reqs[i];\nvar sv = req ? plots[id] : null;\nvar stale = !!req && !!sv && Array.isArray(sv.program) && islStale(req, sv.program, null, null);\nOutputs.show = stale;\nOutputs.text = stale ? fill(w.iw3bTeachAgain, { b: name }) : '';\n",
        "uses": "engine.js,island.js,words.js"
      },
      "x": 40,
      "y": 160,
      "ports": [
        {
          "name": "in-lang",
          "displayName": "lang",
