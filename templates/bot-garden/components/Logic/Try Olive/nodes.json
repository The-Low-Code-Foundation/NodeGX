        },
        {
          "name": "slots",
          "plug": "output",
          "type": "*"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "tryoliveFn",
      "type": "JavaScriptFunction",
      "label": "Try Olive",
      "parameters": {
        "functionScript": "\nvar lang = String(Inputs.lang) === 'fr' ? 'fr' : 'en';\nvar written = String(Inputs.fallback || '');\nvar body = { rung: String(Inputs.rung || 'say-thanks'), slots: Inputs.slots && typeof Inputs.slots === 'object' ? Inputs.slots : {}, lang: lang, shape: 'sentence', temperature: 0.8 };\nvar text = written, ok = false;\ntry {\n  if (typeof fetch === 'function') {\n    var ctl = typeof AbortController === 'function' ? new AbortController() : null;\n    var timer = ctl ? setTimeout(function () { ctl.abort(); }, 20000) : null;\n    var res = await fetch('/__garden/olive', { method: 'POST', headers: { 'content-type': 'application/json', 'x-garden': '1' }, body: JSON.stringify(body), signal: ctl ? ctl.signal : undefined });\n    if (timer) clearTimeout(timer);\n    if (res && res.ok) {\n      var a = await res.json();\n      if (a && a.ok && (a.text || a.value !== undefined)) { text = String(a.text !== undefined ? a.text : a.value); ok = true; }\n    }\n  }\n} catch (e) { ok = false; }\nOutputs.text = text;\nOutputs.ok = ok;\nOutputs.fallback = !ok;\n",
        "runOnChange-in-fallback": false,
        "runOnChange-in-lang": false,
        "runOnChange-in-rung": false,
        "runOnChange-in-slots": false
      },
      "x": 40,
      "y": 160,
      "ports": [
