    {
      "id": "readprogramFn",
      "type": "JavaScriptFunction",
      "label": "Read program",
      "parameters": {
        "functionScript": "\nvar raw = Inputs.program, list = [];\nif (Array.isArray(raw)) list = raw;\nelse if (typeof raw === 'string' && raw) { try { var parsed = JSON.parse(raw); if (Array.isArray(parsed)) list = parsed; } catch (e) { list = []; } }\nfunction count(l) { var n = 0; for (var i = 0; i < l.length; i++) { if (!l[i]) continue; n++; if (Array.isArray(l[i].body)) n += count(l[i].body); } return n; }\nvar copy = JSON.parse(JSON.stringify(list));\nOutputs.program = copy;\nOutputs.blocks = count(copy);\nOutputs.text = JSON.stringify(copy);\nOutputs.empty = copy.length === 0;\n"
      },
      "x": 40,
      "y": 160,
      "ports": [
        {
          "name": "in-program",
          "displayName": "program",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-program",
          "displayName": "program",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
