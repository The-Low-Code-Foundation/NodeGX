  "version": 1,
  "nodes": [
    {
      "id": "varmonitorIn",
      "type": "Component Inputs",
      "label": "What the caller gives",
      "ports": [
        {
          "name": "botName",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "lang",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "run",
          "plug": "output",
          "type": "object"
        },
        {
          "name": "words",
          "plug": "output",
          "type": "array"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "varmonitorFn",
      "type": "JavaScriptFunction",
      "label": "Var monitor",
      "parameters": {
        "functionScript": "var { fill, langOf, nameOf, wordMap } = Scripts.words;\nvar run = Inputs.run && typeof Inputs.run === 'object' ? Inputs.run : null;\nvar vars = run && run.vars && typeof run.vars === 'object' ? run.vars : {};\nvar W = wordMap(Inputs.words, langOf(Inputs.lang), nameOf(Inputs.botName));\nvar parts = [];\nfor (var k in vars) if (Object.prototype.hasOwnProperty.call(vars, k)) parts.push(fill(W.iw4Monitor || '{name} = {v}', { name: k, v: vars[k] }));\nOutputs.show = parts.length > 0;\nOutputs.text = parts.length ? (W.iw4VarsH ? W.iw4VarsH + ': ' : '') + parts.join(' · ') : '';\n",
        "uses": "words.js"
      },
      "x": 40,
      "y": 160,
      "ports": [
        {
          "name": "in-run",
          "displayName": "run",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-words",
          "displayName": "words",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-lang",
          "displayName": "lang",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-botName",
          "displayName": "botName",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-show",
          "displayName": "show",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-text",
          "displayName": "text",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "varmonitorOut",
      "type": "Component Outputs",
      "label": "What it answers",
      "ports": [
        {
          "name": "show",
          "plug": "input",
          "type": "boolean"
        },
        {
          "name": "text",
          "plug": "input",
          "type": "string"
        },
        {
          "name": "ran",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 280
    }
  ]
