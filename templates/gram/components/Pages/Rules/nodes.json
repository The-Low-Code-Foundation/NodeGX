      "id": "ruGather",
      "type": "JavaScriptFunction",
      "label": "The rules, as one save",
      "parameters": {
        "functionScript": "var typed = Inputs.rules === undefined ? Inputs.rules0 : Inputs.rules;\nvar rules = String(typed || '').trim();\nif (!rules) { Outputs.problem = 'Write the rules first.'; Outputs.held(); return; }\nif (rules.length > 5000) { Outputs.problem = 'Rules of 5,000 characters or fewer. These have ' + rules.length.toLocaleString('en-GB') + '.'; Outputs.held(); return; }\nOutputs.problem = '';\nOutputs.save = { rules: rules };\nOutputs.go();",
        "runOnChange-in-rules": false,
        "runOnChange-in-rules0": false
      },
