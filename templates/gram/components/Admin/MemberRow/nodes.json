        "width": {
          "value": 34,
          "unit": "px"
        },
        "height": {
          "value": 34,
          "unit": "px"
        },
        "sizeMode": "explicit",
        "cssClassName": "gm-av"
      },
      "children": [
        "mrInitials"
      ],
