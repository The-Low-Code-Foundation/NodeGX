    {
      "id": "nmChanged",
      "type": "Set Variable",
      "label": "The members changed",
      "parameters": {
        "name": "membersChanged",
        "setWith": "string"
      },
      "metadata": {
        "comment": "Shared on purpose: a member was let in, turned away or made an admin: the list reads again, whichever row changed it."
      },
