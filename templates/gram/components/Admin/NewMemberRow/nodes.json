    {
      "id": "nmLetInGather",
      "type": "JavaScriptFunction",
      "label": "Let this person in",
      "parameters": {
        "functionScript": "Outputs.letIn = { memberId: Inputs.id, appUrl: typeof window !== 'undefined' ? window.location.origin : '' };\nOutputs.go();",
        "runOnChange-in-id": false
      },
      "ports": [
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "in-id",
          "displayName": "id",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-letIn",
          "displayName": "letIn",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ],
      "x": 470,
      "y": 880
    },
    {
      "id": "nmLetInCall",
      "type": "CloudFunction2",
      "label": "letIn(letIn)",
      "parameters": {
        "function": "letIn"
      },
      "x": 470,
      "y": 1120
    },
    {
      "id": "nmLetInNote",
      "type": "JavaScriptFunction",
      "label": "Say who is in, and whether they were told",
      "parameters": {
        "functionScript": "Outputs.note = Inputs.emailed === 'yes'\n  ? Inputs.name + ' is in, and has been sent a message to say so.'\n  : Inputs.name + ' is in. The message didn’t go: email isn’t set up on the backend yet, so tell them yourself.';\nOutputs.at = String(Date.now());\nOutputs.go();",
        "runOnChange-in-name": false,
        "runOnChange-in-emailed": false
      },
      "ports": [
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "in-emailed",
          "displayName": "emailed",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-name",
          "displayName": "name",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-note",
          "displayName": "note",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-at",
          "displayName": "at",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ],
      "x": 470,
      "y": 1480
    },
