        "role:admin"
      ],
      "rateLimit": {
        "ratePerMinute": 10,
        "burst": 5
      }
    },
    "hide": {
      "call": [
        "role:member",
        "role:admin"
      ],
      "rateLimit": {
        "ratePerMinute": 20,
        "burst": 10
      }
    },
    "block": {
      "call": "role:admin"
    },
    "writeRules": {
      "call": "role:admin"
    }
  },
  "files": {
