          }
        }
      }
    },
    "Prayed": {
      "permissions": {
        "find": [
          "role:admin",
          {
            "path": {
              "hops": [
                {
                  "from": "Member",
                  "by": "login"
                },
                {
                  "from": "Post",
                  "by": "member"
                },
                {
                  "from": "Prayed",
                  "by": "post"
                }
              ],
              "maxDepth": 3
            }
          },
          {
            "path": {
              "hops": [
                {
                  "from": "Prayed",
                  "by": "doneBy"
                }
              ],
              "maxDepth": 1
            }
          }
        ],
        "get": [
          "role:admin",
          {
            "path": {
              "hops": [
                {
                  "from": "Member",
                  "by": "login"
                },
                {
                  "from": "Post",
                  "by": "member"
                },
                {
                  "from": "Prayed",
                  "by": "post"
                }
              ],
              "maxDepth": 3
            }
          },
          {
            "path": {
              "hops": [
                {
                  "from": "Prayed",
                  "by": "doneBy"
                }
              ],
              "maxDepth": 1
            }
          }
        ],
        "create": "nobody",
        "update": "nobody",
        "delete": "nobody"
      },
      "onlyWhile": {
        "update": {
          "frozen": {
            "fields": "*"
          }
        }
      }
    },
    "Report": {
      "permissions": {
        "find": "role:admin",
        "get": "role:admin",
        "create": "nobody",
        "update": "nobody",
        "delete": "nobody"
      },
      "onlyWhile": {
        "update": {
          "frozen": {
            "fields": "*"
          }
        },
        "delete": "never"
      }
    },
    "CommentReport": {
      "permissions": {
        "find": "role:admin",
        "get": "role:admin",
        "create": "nobody",
        "update": "nobody",
        "delete": "nobody"
      },
      "onlyWhile": {
        "update": {
          "frozen": {
            "fields": "*"
          }
        },
        "delete": "never"
      }
    }
