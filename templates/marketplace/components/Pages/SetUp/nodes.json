    {
      "id": "suGather",
      "type": "JavaScriptFunction",
      "label": "The form, as one setup",
      "parameters": {
        "functionScript": "Outputs.setup = { setupToken: Inputs.token || '', marketplace: Inputs.marketplace || '', name: Inputs.name || '', email: Inputs.email || '', password: Inputs.password || '' };\nOutputs.go();",
        "runOnChange-in-token": false,
        "runOnChange-in-marketplace": false,
        "runOnChange-in-name": false,
        "runOnChange-in-email": false,
        "runOnChange-in-password": false
      },
