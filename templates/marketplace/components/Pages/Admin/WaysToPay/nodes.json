    {
      "id": "wpLoad",
      "type": "JavaScriptFunction",
      "label": "The countries and the ways to pay",
      "parameters": {
        "runOnChange-in-changed": true,
        "functionScript": "function idOf(v) { return v && typeof v === 'object' ? String(v.objectId || v.id || '') : v ? String(v) : ''; }\nfunction ptr(c, id) { return { __type: 'Pointer', className: c, objectId: String(id) }; }\nasync function all(c, where) { return Noodl.Records.query(c, where || {}, { plain: true, limit: 1000 }); }\nfunction why(e) { var m = e && (e.error || e.message) || String(e || ''); if (/admin’s/.test(m)) return m; return /session|auth|permission|forbidden|401|403/i.test(m) ? 'Sign in to see this page.' : 'This page could not be read: ' + m; }\nasync function adminOnly() {\n  var me = (await Noodl.CloudFunctions.run('whoAmI', {})).me;\n  if (!me || me.role !== 'admin') throw { error: 'This page is the admin’s. Sign in as the admin to see it.' };\n}\nfunction thumb(f, size) { var u = f && f.url ? String(f.url) : ''; return u ? u + (u.indexOf('?') < 0 ? '?' : '&') + 'thumb=' + size : ''; }\nfunction money(n, cur) { try { return new Intl.NumberFormat(undefined, { style: 'currency', currency: cur || 'GHS', currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 }).format(Number(n) || 0); } catch (e) { return (cur || '') + ' ' + n; } }\n\nfunction symbolOf(cur) {\n  try {\n    var part = new Intl.NumberFormat('en', { style: 'currency', currency: cur, currencyDisplay: 'narrowSymbol' }).formatToParts(0).filter(function (x) { return x.type === 'currency'; })[0];\n    return part ? part.value : cur;\n  } catch (e) { return cur; }\n}\nfunction currencyName(cur) { try { return new Intl.DisplayNames(['en'], { type: 'currency' }).of(cur) || cur; } catch (e) { return cur; } }\nfunction day(iso) { try { return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); } catch (e) { return ''; } }\nfunction stamp() { return String(Date.now()); }\n\nvar BUILT = {\"on-delivery\":\"Pay on delivery\",\"bank-transfer\":\"Bank transfer\",\"whatsapp\":\"Order on WhatsApp\",\"paystack\":\"Card or mobile money\"};\nvar WORDS = {\"on-delivery\":\"Pay the seller’s rider when it arrives, in cash or by mobile money.\",\"bank-transfer\":\"The seller gives you their account when they confirm. Use your order number as the reference.\",\"whatsapp\":\"Finish the order in a chat with the seller.\",\"paystack\":\"Pay here by card, mobile money or bank through Paystack, once the sellers confirm delivery. Each seller is paid their share.\"};\nvoid Inputs.changed;\ntry {\n  await adminOnly();\n  var countries = await all('Country');\n  var ways = await all('WayToPay');\n  var onIn = {};\n  for (var i = 0; i < ways.length; i++) onIn[ways[i].method] = (await all('Country', { relatedTo: { id: ways[i].objectId, key: 'country', className: 'WayToPay' } })).map(function (c) { return c.objectId; });\n} catch (e) { Outputs.problem = why(e); Outputs.refused = true; Outputs.ok = false; return; }\ncountries.sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); });\nvar byMethod = {};\nways.forEach(function (w) { byMethod[w.method] = w; });\nOutputs.countries = countries.length ? countries.map(function (c) { return c.name + ' · ' + c.currency; }).join(',  ') : 'No countries yet. Add the first one: sellers, prices and ways to pay all belong to a country.';\nOutputs.rows = Object.keys(BUILT).map(function (m) {\n  var w = byMethod[m], on = onIn[m] || [];\n  return {\n    id: m,\n    method: m,\n    name: w ? w.name : BUILT[m],\n    instructions: w ? w.instructions || '' : WORDS[m],\n    onIds: on,\n    where: on.length ? 'On in ' + countries.filter(function (c) { return on.indexOf(c.objectId) >= 0; }).map(function (c) { return c.name; }).join(', ') + '.' : 'Not on anywhere yet.',\n    toggles: countries.map(function (c) { return { id: m + ':' + c.objectId, method: m, countryId: c.objectId, name: c.name, isOn: on.indexOf(c.objectId) >= 0, onIds: on, instructions: w ? w.instructions || '' : WORDS[m] }; })\n  };\n});\nOutputs.hasCountries = countries.length > 0;\nOutputs.refused = false;\nOutputs.ok = true;"
      },
