    {
      "id": "asLoad",
      "type": "JavaScriptFunction",
      "label": "Every seller, with its country and counts",
      "parameters": {
        "functionScript": "function idOf(v) { return v && typeof v === 'object' ? String(v.objectId || v.id || '') : v ? String(v) : ''; }\nfunction ptr(c, id) { return { __type: 'Pointer', className: c, objectId: String(id) }; }\nasync function all(c, where) { return Noodl.Records.query(c, where || {}, { plain: true, limit: 1000 }); }\nfunction why(e) { var m = e && (e.error || e.message) || String(e || ''); if (/admin’s/.test(m)) return m; return /session|auth|permission|forbidden|401|403/i.test(m) ? 'Sign in to see this page.' : 'This page could not be read: ' + m; }\nasync function adminOnly() {\n  var me = (await Noodl.CloudFunctions.run('whoAmI', {})).me;\n  if (!me || me.role !== 'admin') throw { error: 'This page is the admin’s. Sign in as the admin to see it.' };\n}\nfunction thumb(f, size) { var u = f && f.url ? String(f.url) : ''; return u ? u + (u.indexOf('?') < 0 ? '?' : '&') + 'thumb=' + size : ''; }\nfunction money(n, cur) { try { return new Intl.NumberFormat(undefined, { style: 'currency', currency: cur || 'GHS', currencyDisplay: 'narrowSymbol', maximumFractionDigits: 0 }).format(Number(n) || 0); } catch (e) { return (cur || '') + ' ' + n; } }\n\ntry {\n  await adminOnly();\n  var sellers = await all('Seller');\n  var countries = await all('Country');\n  var products = await all('Product');\n  var people = await all('Person');\n} catch (e) { Outputs.problem = why(e); Outputs.refused = true; Outputs.ok = false; return; }\nvar countryName = {};\ncountries.forEach(function (c) { countryName[c.objectId] = c.name || ''; });\nvar count = function (rows, field, id) { return rows.filter(function (r) { return idOf(r[field]) === id; }).length; };\nvar plural = function (n, one, many) { return n + ' ' + (n === 1 ? one : many); };\nOutputs.rows = sellers\n  .sort(function (a, b) { return String(a.name || '').localeCompare(String(b.name || '')); })\n  .map(function (s) {\n    var stopped = !!s.endedAt;\n    return {\n      id: s.objectId,\n      name: s.name || '',\n      logo: thumb(s.logo, 'sm'),\n      hasLogo: !!(s.logo && s.logo.url),\n      place: (countryName[idOf(s.country)] || '') + ' · ' + plural(count(products, 'seller', s.objectId), 'product', 'products') + ' · ' + plural(count(people, 'seller', s.objectId), 'login', 'logins'),\n      status: stopped ? 'Stopped' : 'Selling',\n      stopped: stopped,\n      selling: !stopped,\n      stopLabel: stopped ? 'Bring back' : 'Stop'\n    };\n  });\nOutputs.empty = sellers.length === 0;\nOutputs.refused = false;\nOutputs.ok = true;"
      },
      "ports": [
        {
          "name": "out-problem",
          "displayName": "problem",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-refused",
          "displayName": "refused",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-ok",
          "displayName": "ok",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-rows",
          "displayName": "rows",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-empty",
          "displayName": "empty",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ],
