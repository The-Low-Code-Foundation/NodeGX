        "flexDirection": "column",
        "backgroundColor": "var(--background)",
        "minHeight": {
          "value": 100,
          "unit": "vh"
        },
        "alignItems": "center",
        "cssClassName": "mk-app"
      },
      "children": [
        "siBar",
        "siBody"
