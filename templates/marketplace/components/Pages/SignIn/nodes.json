        "fontWeight": "var(--font-bold)",
        "color": "var(--foreground)",
        "cssClassName": "mk-display",
        "as": "h1"
      },
      "x": 220,
      "y": 640
    },
    {
      "id": "siLead",
      "type": "Text",
      "label": "Who signs in here",
