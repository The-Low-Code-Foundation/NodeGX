      "x": 220,
      "y": 400
    },
    {
      "id": "siBody",
      "type": "Group",
      "label": "The page",
      "parent": "siRoot",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "maxWidth": {
          "value": 480,
          "unit": "px"
        },
        "paddingLeft": "var(--space-4)",
        "paddingRight": "var(--space-4)",
        "paddingTop": "var(--space-4)",
        "paddingBottom": "var(--space-8)",
        "rowGap": "var(--space-4)"
      },
      "children": [
        "siTitle",
        "siLead",
        "siEmail",
        "siPassword",
        "siGo",
        "siError",
