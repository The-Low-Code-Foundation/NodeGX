          "group": "Outputs"
        },
        {
          "name": "out-isStopped",
          "displayName": "isStopped",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-rows",
          "displayName": "rows",
          "plug": "output",
