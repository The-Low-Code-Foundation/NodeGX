        "functionScript": "Outputs.move = { partId: String(Inputs.id || ''), to: 'confirmed', deliveryCost: Inputs.cost === undefined ? '' : String(Inputs.cost), deliveryNote: Inputs.when === undefined ? '' : String(Inputs.when) };\nOutputs.go();",
