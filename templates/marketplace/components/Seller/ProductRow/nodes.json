      "id": "prGather",
      "type": "JavaScriptFunction",
      "label": "Off sale or back on",
      "parameters": {
        "functionScript": "Outputs.sale = { productId: String(Inputs.id || ''), off: Inputs.onSale === true };\nOutputs.go();",
        "runOnChange-in-id": false,
        "runOnChange-in-onSale": false
      },
