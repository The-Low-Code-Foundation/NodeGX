          "name": "in-id",
          "displayName": "id",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-onSale",
          "displayName": "onSale",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-sale",
          "displayName": "sale",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
