{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "77673e50-3f4d-551c-80e0-8b0c5b614346",
  "version": 1,
  "nodes": [
    {
      "id": "rrRoot",
      "type": "Group",
      "label": "A rate",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "row",
        "alignItems": "center",
        "columnGap": "var(--space-3)",
        "flexWrap": "wrap",
        "justifyContent": "space-between",
        "rowGap": "var(--space-1)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)"
      },
      "children": [
        "rrWords",
        "rrValue"
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "rrWords",
      "type": "Group",
      "label": "The currency, and when it changed",
      "parent": "rrRoot",
      "parameters": {
        "width": {
          "value": 260,
          "unit": "px"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "rowGap": "var(--space-0-5)"
      },
      "children": [
        "rrLabel",
        "rrChanged"
      ],
      "x": 100,
      "y": 160
    },
    {
      "id": "rrLabel",
      "type": "Text",
      "label": "The currency",
      "parent": "rrWords",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)",
        "fontWeight": "var(--font-bold)",
        "color": "var(--foreground)"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "rrChanged",
      "type": "Text",
      "label": "When it changed",
      "parent": "rrWords",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "rrValue",
      "type": "net.noodl.controls.textinput",
      "label": "Rate",
      "parent": "rrRoot",
      "parameters": {
        "useLabel": false,
        "sizeMode": "contentHeight",
        "width": {
          "value": 140,
          "unit": "px"
        },
        "backgroundColor": "var(--surface)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-control)",
        "borderRadius": "var(--radius-md)",
        "paddingLeft": "var(--space-3)",
        "paddingRight": "var(--space-3)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)",
        "fontSize": "var(--text-base)",
        "color": "var(--foreground)",
        "placeholder": "Rate",
        "inputMode": "decimal",
        "mounted": false
      },
      "x": 100,
      "y": 520
    },
    {
      "id": "rrIn",
      "type": "Component Inputs",
      "label": "One currency",
      "ports": [
        {
          "name": "currency",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "label",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "value",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "changed",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "notOwn",
          "plug": "output",
          "type": "boolean"
        }
      ],
      "x": 410,
      "y": 280
    },
    {
      "id": "rrTypedNow",
      "type": "Variable2",
      "label": "The rates typed so far",
      "parameters": {
        "name": "ratesTyped"
      },
      "metadata": {
        "comment": "Shared on purpose: the rates typed so far: one map for every row, saved together."
      },
      "x": 410,
      "y": 640
    },
    {
      "id": "rrTyped",
      "type": "JavaScriptFunction",
      "label": "Keep what was typed",
      "parameters": {
        "runOnChange-in-value": true,
        "functionScript": "var m = {};\ntry { m = JSON.parse(Inputs.typed || '{}') || {}; } catch (e) { m = {}; }\nif (!Inputs.currency) return;\nm[String(Inputs.currency)] = String(Inputs.value === undefined ? '' : Inputs.value);\nOutputs.typed = JSON.stringify(m);\nOutputs.go();",
        "runOnChange-in-typed": false,
        "runOnChange-in-currency": false
      },
      "ports": [
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "in-typed",
          "displayName": "typed",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-currency",
          "displayName": "currency",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-value",
          "displayName": "value",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-typed",
          "displayName": "typed",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ],
      "x": 410,
      "y": 520
    },
    {
      "id": "rrSetTyped",
      "type": "Set Variable",
      "label": "The rates typed so far",
      "parameters": {
        "name": "ratesTyped",
        "setWith": "string"
      },
      "metadata": {
        "comment": "Shared on purpose: the rates typed so far: one map for every row, saved together."
      },
      "x": 410,
      "y": 760
    }
  ],
  "visualRoots": [
    "rrRoot"
  ]
}
