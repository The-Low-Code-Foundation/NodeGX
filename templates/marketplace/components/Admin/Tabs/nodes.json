    {
      "id": "tbIn",
      "type": "Component Inputs",
      "label": "Which tab",
      "ports": [
        {
          "name": "on",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 350,
      "y": 1120
    },
    {
      "id": "tbLook",
      "type": "JavaScriptFunction",
      "label": "Which tab is this page",
      "parameters": {
        "functionScript": "var on = String(Inputs.on || '');\nOutputs.sellers = on === 'sellers' ? 'mk-tab mk-tab-on' : 'mk-tab';\nOutputs.orders = on === 'orders' ? 'mk-tab mk-tab-on' : 'mk-tab';\nOutputs.enquiries = on === 'enquiries' ? 'mk-tab mk-tab-on' : 'mk-tab';\nOutputs.pay = on === 'pay' ? 'mk-tab mk-tab-on' : 'mk-tab';\nOutputs.rates = on === 'rates' ? 'mk-tab mk-tab-on' : 'mk-tab';\nOutputs.shelves = on === 'shelves' ? 'mk-tab mk-tab-on' : 'mk-tab';"
      },
      "ports": [
        {
          "name": "in-on",
          "displayName": "on",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-sellers",
          "displayName": "sellers",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-orders",
          "displayName": "orders",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-enquiries",
          "displayName": "enquiries",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-pay",
          "displayName": "pay",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-rates",
          "displayName": "rates",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-shelves",
          "displayName": "shelves",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ],
      "x": 350,
      "y": 160
    },
    {
      "id": "tbShow",
      "type": "JavaScriptFunction",
      "label": "Bring this page’s tab into view",
      "parameters": {
        "functionScript": "var on = String(Inputs.on || '');\nif (on === 'sellers') Outputs.sellers();\nif (on === 'orders') Outputs.orders();\nif (on === 'enquiries') Outputs.enquiries();\nif (on === 'pay') Outputs.pay();\nif (on === 'rates') Outputs.rates();\nif (on === 'shelves') Outputs.shelves();",
        "runOnChange-in-on": false
      },
      "ports": [
        {
          "name": "out-sellers",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "out-orders",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "out-enquiries",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "out-pay",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "out-rates",
          "plug": "output",
          "type": "signal"
        },
        {
