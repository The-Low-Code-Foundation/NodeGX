{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "344f59d2-c44e-5756-8095-0993e02a4310",
  "version": 1,
  "nodes": [
    {
      "id": "in",
      "type": "Component Inputs",
      "label": "One login",
      "ports": [
        {
          "name": "Do",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "loginId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "disabled",
          "plug": "output",
          "type": "boolean"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "switch",
      "type": "noodl.cloud.updateuser",
      "label": "Switch it",
      "parameters": {
        "properties": "disabled"
      },
      "x": 40,
      "y": 160
    },
    {
      "id": "out",
      "type": "Component Outputs",
      "label": "Switched",
      "ports": [
        {
          "name": "Success",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "Failure",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 280
    }
  ]
}
