    {
      "id": "ceOpened",
      "type": "JavaScriptFunction",
      "label": "Clear the boxes on close; tick Every month to match the event",
      "parameters": {
        "functionScript": "var shown = Inputs.formShown === true;\nif (this.wasShown && !shown) Outputs.closed();\nvar monthlyWant = shown ? Inputs.monthly === true : null;\nif (monthlyWant !== null && (!this.wasShown || this.monthlyLast !== monthlyWant)) { if (monthlyWant) Outputs.monthlyOn(); else Outputs.monthlyOff(); }\nthis.monthlyLast = monthlyWant;\nthis.wasShown = shown;"
      },
