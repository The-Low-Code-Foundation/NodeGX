      "type": "JavaScriptFunction",
      "label": "Clear the boxes when the pane closes",
      "parameters": {
        "functionScript": "var shown = Inputs.shown === true;\nif (this.wasShown && !shown) Outputs.closed();\n\nthis.wasShown = shown;"
