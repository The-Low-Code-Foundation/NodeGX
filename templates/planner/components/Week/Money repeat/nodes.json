    {
      "id": "rpShort",
      "type": "JavaScriptFunction",
      "label": "Is it less than was due?",
      "parameters": {
        "functionScript": "var typed = String(Inputs.typed === undefined || Inputs.typed === null ? '' : Inputs.typed).trim();\nvar v = Number(typed), left = Math.abs(Number(Inputs.remaining) || 0);\nvar short = typed !== '' && isFinite(v) && v >= 0 && v < left - 0.005;\nOutputs.short = short;\nvar rest = Math.round((left - (isFinite(v) ? v : 0)) * 100) / 100;\nOutputs.restLine = short ? 'That is \\u20ac' + rest + ' less than was due. The other \\u20ac' + rest + ' is:' : '';"
      },
      "x": 590,
