      "id": "AddmarkGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.itemId || '');\nif (id === '' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(String(Inputs.occurs || ''))) return;\nvar list = Inputs.payments || [];\nvar pays = [];\nfor (var i = 0; i < list.length; i++) if (list[i] && isFinite(Number(list[i].amount))) pays.push({ day: String(list[i].day || ''), amount: Number(list[i].amount) });\nOutputs.itemId = id;\nOutputs.occurs = String(Inputs.occurs);\nOutputs.amount = Inputs.amount === undefined || Inputs.amount === null ? '' : Inputs.amount;\nOutputs.date = String(Inputs.date || '');\nOutputs.skip = Inputs.skip === true;\nOutputs.payments = pays;\nOutputs.doneOn = String(Inputs.doneOn || '');\nOutputs.doneAmount = Inputs.doneAmount === undefined || Inputs.doneAmount === null ? '' : Inputs.doneAmount;\nOutputs.lostOn = String(Inputs.lostOn || '');\nOutputs.sentOn = String(Inputs.sentOn || '');\nOutputs.note = String(Inputs.note || '');\nOutputs.go();",
        "runOnChange-in-itemId": false,
        "runOnChange-in-occurs": false,
        "runOnChange-in-amount": false,
        "runOnChange-in-date": false,
        "runOnChange-in-skip": false,
        "runOnChange-in-payments": false,
        "runOnChange-in-doneOn": false,
        "runOnChange-in-doneAmount": false,
        "runOnChange-in-lostOn": false,
        "runOnChange-in-sentOn": false,
        "runOnChange-in-note": false
      },
