{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "bfec9b3b-d880-54ff-8fe4-7bf1a598a40d",
  "version": 1,
  "nodes": [
    {
      "id": "UnlogblockIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "blockId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "UnlogblockOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "UnlogblockGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.blockId || '');\nif (id === '') return;\nOutputs.done = false;\nOutputs.empty = '';\nOutputs.go();",
        "runOnChange-in-blockId": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-blockId",
          "displayName": "blockId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-done",
          "displayName": "done",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-empty",
          "displayName": "empty",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "UnlogblockWrite",
      "type": "SetDbModelProperties",
      "label": "Put it back to not done",
      "parameters": {
        "collectionName": "Block",
        "idSource": "explicit"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "UnlogblockProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "plannerProblem",
        "setWith": "string",
        "value": "That change did not save. Check your connection, then try again."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 520
    }
  ]
}
