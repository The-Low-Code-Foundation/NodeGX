{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "021704d2-c4af-5fce-89b0-3f0071efb185",
  "version": 1,
  "nodes": [
    {
      "id": "DropblockIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "blockId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "DropblockOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "DropblockGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "var id = String(Inputs.blockId || '');\nif (id === '') return;\nOutputs.go();",
        "runOnChange-in-blockId": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-blockId",
          "displayName": "blockId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "DropblockWrite",
      "type": "DeleteDbModelProperties",
      "label": "Drop it",
      "parameters": {
        "collectionName": "Block"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "DropblockProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "plannerProblem",
        "setWith": "string",
        "value": "That change did not save. Check your connection, then try again."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 520
    }
  ]
}
