{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "36b01d96-b41e-501b-8725-bb1ec82fca32",
  "version": 1,
  "nodes": [
    {
      "id": "AgreemoneyIn",
      "type": "Component Inputs",
      "label": "What to do",
      "ports": [
        {
          "name": "itemId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "do",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "AgreemoneyOut",
      "type": "Component Outputs",
      "label": "Done",
      "ports": [
        {
          "name": "done",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "AgreemoneyGuard",
      "type": "JavaScriptFunction",
      "label": "Is there anything to write?",
      "parameters": {
        "functionScript": "if (String(Inputs.itemId || '') === '') return;\nOutputs.likelihood = 100;\nOutputs.go();",
        "runOnChange-in-itemId": false
      },
      "x": 40,
      "y": 280,
      "ports": [
        {
          "name": "in-itemId",
          "displayName": "itemId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-go",
          "displayName": "go",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-likelihood",
          "displayName": "likelihood",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "AgreemoneyWrite",
      "type": "SetDbModelProperties",
      "label": "It is agreed",
      "parameters": {
        "collectionName": "MoneyItem",
        "idSource": "explicit"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "AgreemoneyProblem",
      "type": "Set Variable",
      "label": "Say it did not save",
      "parameters": {
        "name": "plannerProblem",
        "setWith": "string",
        "value": "That change did not save. Check your connection, then try again."
      },
      "metadata": {
        "comment": "Shared on purpose: this is the one sentence the Problem banner shows, whichever command failed."
      },
      "x": 40,
      "y": 520
    }
  ]
}
