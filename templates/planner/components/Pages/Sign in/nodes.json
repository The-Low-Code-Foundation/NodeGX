        {
          "name": "in-text",
          "displayName": "text",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-shown",
          "displayName": "shown",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
