    {
      "id": "cv_shape",
      "type": "JavaScriptFunction",
      "label": "Rows, in keys and values",
      "x": 520,
      "y": 880,
      "parameters": {
        "functionScript": "/*\n * One row per message, oldest first (DBU-07). Times in the reader's zone (their profile, else the\n * browser's). The coach's messages sit on the live tint on both sides. A file opens with fileLink\n * for the learner (her own files) and fileLinkAsCoach for the coach.\n */\nconst coach = Inputs.mode === 'coach';\nconst loaded = Array.isArray(Inputs.messages);\nconst list = loaded ? Inputs.messages : [];\nlet tz = String((Inputs.me && Inputs.me.timezone) || '');\ntry { new Date().toLocaleString('en-GB', { timeZone: tz || undefined }); } catch (e) { tz = ''; }\nconst zone = tz || Intl.DateTimeFormat().resolvedOptions().timeZone;\nconst when = (iso) => {\n  const d = new Date(iso);\n  if (!iso || isNaN(d)) return '';\n  return d.toLocaleDateString('en-GB', { timeZone: zone, weekday: 'short', day: 'numeric', month: 'short' }) + ', ' +\n    d.toLocaleTimeString('en-GB', { timeZone: zone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });\n};\nconst you = String(Inputs.you || '');\nOutputs.items = list.map((m) => {\n  const fromCoach = coach ? m.mine === true : m.mine !== true;\n  const files = (Array.isArray(m.attachments) ? m.attachments : []).filter((a) => a && a.file)\n    .map((a, j) => ({ id: m.id + '-file-' + j, file: a.file, fileName: a.fileName, mode: coach ? 'coach' : 'own' }));\n  const tag = Inputs.tagged === true && m.stepTitle ? String(m.stepTitle) : '';\n  return {\n    id: m.id,\n    who: m.mine === true ? you : String(m.who || ''),\n    when: when(m.at),\n    isNew: m.isNew === true,\n    tag,\n    hasTag: !!tag,\n    body: String(m.body || ''),\n    hasBody: !!String(m.body || '').trim(),\n    files,\n    hasFiles: files.length > 0,\n    bg: fromCoach ? 'var(--live-bg)' : 'var(--surface)',\n    edge: fromCoach ? 'var(--live-border)' : 'var(--border)'\n  };\n});\nOutputs.hasMessages = list.length > 0;\nOutputs.none = loaded && list.length === 0;\nconst off = Inputs.emailOn === false;\nOutputs.showPref = loaded && !coach && Inputs.showEmailPref === true;\nOutputs.offCoach = loaded && coach && off;\nOutputs.prefKey = off ? 'messages.emailOff' : 'messages.emailOn';\nOutputs.prefButtonKey = off ? 'messages.startEmails' : 'messages.stopEmails';\nOutputs.nextState = off ? 'on' : 'off';\nOutputs.first = String((Inputs.learner && Inputs.learner.first) || '');\nOutputs.hasTitle = !!Inputs.titleKey;\nOutputs.canAttach = !coach;\nOutputs.labelKey = coach ? 'messages.replyTo' : 'messages.yourMessage';"
      },
      "ports": [
