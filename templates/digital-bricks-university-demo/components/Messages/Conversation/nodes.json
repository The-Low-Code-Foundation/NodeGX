    {
      "id": "cv_go",
      "type": "JavaScriptFunction",
      "label": "Read again: as the learner, or as the coach",
      "x": 520,
      "y": 160,
      "parameters": {
        "runOnChange-in-mode": false,
        "runOnChange-in-stepId": true,
        "runOnChange-in-learnerId": true,
        "functionScript": "// On mount, on a doorbell, after sending, after the email switch, and when the homework (stepId) or the learner changes.\n// scoped: one homework's thread only, so never read (and mark read) the whole conversation before stepId arrives.\nif (Inputs.mode === 'coach') { if (Inputs.learnerId) Outputs.readCoach(); }\nelse if (Inputs.scoped !== true || Inputs.stepId) Outputs.readLearner();",
        "runOnChange-in-scoped": false
      },
      "ports": [
        {
          "name": "in-stepId",
          "displayName": "stepId",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
