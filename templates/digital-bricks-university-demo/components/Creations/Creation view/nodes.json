        "functionScript": "// saveCreation and handIn only take http(s) links. noopener: the opened page gets no handle on this one.\nconst url = String(Inputs.url || '');\nif (url.startsWith('https://') || url.startsWith('http://')) window.open(url, '_blank', 'noopener,noreferrer');\n"
