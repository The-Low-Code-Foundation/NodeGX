{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "c4d53d98-3c24-54c3-820e-92f6936aed1f",
  "version": 1,
  "nodes": [
    {
      "id": "hr_root",
      "type": "Group",
      "label": "Homework row",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "row",
        "flexWrap": "wrap",
        "alignItems": "center",
        "columnGap": "var(--space-3)",
        "rowGap": "var(--space-2)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "borderBottomStyle": "solid",
        "borderBottomWidth": "var(--border-1)",
        "borderBottomColor": "var(--border)",
        "dataAttributes": "data-testid"
      },
      "children": [
        "hr_words",
        "hr_status",
        "hr_open"
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "hr_words",
      "type": "Group",
      "label": "Number, due date and title",
      "parent": "hr_root",
      "parameters": {
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "minWidth": {
          "value": 200,
          "unit": "px"
        },
        "flexDirection": "column",
        "rowGap": "var(--space-0-5)",
        "styleCss": "flex: 1 1 240px;"
      },
      "children": [
        "hr_head",
        "hr_title"
      ],
      "x": 100,
      "y": 160
    },
    {
      "id": "hr_head",
      "type": "Text",
      "label": "Homework 2 · due Fri 6 Nov",
      "parent": "hr_words",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-xs)",
        "fontWeight": "var(--font-medium)",
        "color": "var(--muted-foreground)"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "hr_title",
      "type": "Text",
      "label": "Title",
      "parent": "hr_words",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)",
        "fontWeight": "var(--font-medium)",
        "lineHeight": "var(--leading-snug)",
        "color": "var(--foreground)"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "hr_status",
      "type": "/Plan/Chip",
      "label": "Status",
      "parent": "hr_root",
      "x": 100,
      "y": 520
    },
    {
      "id": "hr_open",
      "type": "net.noodl.controls.button",
      "label": "Open",
      "parent": "hr_root",
      "parameters": {
        "label": "",
        "sizeMode": "contentSize",
        "backgroundColor": "var(--surface)",
        "color": "var(--foreground)",
        "fontWeight": "var(--font-medium)",
        "fontSize": "var(--text-sm)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-control)",
        "paddingLeft": "var(--space-4)",
        "paddingRight": "var(--space-4)",
        "minHeight": "var(--space-11)"
      },
      "x": 100,
      "y": 640
    },
    {
      "id": "hr_in",
      "type": "Component Inputs",
      "label": "The homework",
      "ports": [
        {
          "name": "id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "headKey",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "n",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "date",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "statusKey",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "statusBg",
          "plug": "output",
          "type": "color"
        },
        {
          "name": "statusFg",
          "plug": "output",
          "type": "color"
        }
      ],
      "x": 410,
      "y": 400
    },
    {
      "id": "hr_t_head",
      "type": "Translation",
      "label": "Homework {n} · due {date}",
      "parameters": {
        "Namespace": "pages"
      },
      "x": 410,
      "y": 880
    },
    {
      "id": "hr_fill",
      "type": "String Format",
      "label": "Number and due date",
      "parameters": {
        "format": "{n} {date}"
      },
      "x": 410,
      "y": 280
    },
    {
      "id": "hr_t_open",
      "type": "Translation",
      "label": "Open",
      "parameters": {
        "Namespace": "pages",
        "Key": "homework.open"
      },
      "x": 410,
      "y": 640
    },
    {
      "id": "hr_go",
      "type": "RouterNavigate",
      "label": "→ This homework",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Homework"
      },
      "x": 410,
      "y": 760
    },
    {
      "id": "hr_testid",
      "type": "String Format",
      "label": "homework-{id}, for tests",
      "parameters": {
        "format": "homework-{id}"
      },
      "x": 410,
      "y": 40
    }
  ],
  "visualRoots": [
    "hr_root"
  ]
}