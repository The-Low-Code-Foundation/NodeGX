    {
      "id": "ri_open_fn",
      "type": "JavaScriptFunction",
      "label": "Open the link in a new tab",
      "parameters": {
        "runOnChange-in-url": false,
        "functionScript": "// saveStep only keeps http(s) links. noopener: the opened page gets no handle on this one.\nconst url = String(Inputs.url || '');\nif (url.startsWith('https://') || url.startsWith('http://')) window.open(url, '_blank', 'noopener,noreferrer');"
      },
      "ports": [
        {
          "name": "in-url",
          "plug": "input",
          "type": "*"
        }
      ],
      "x": 410,
      "y": 1000
