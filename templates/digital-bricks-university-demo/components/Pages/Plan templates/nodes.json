    {
      "id": "pt_shape",
      "type": "JavaScriptFunction",
      "label": "Template rows, in words",
      "x": 700,
      "y": 160,
      "parameters": {
        "functionScript": "// One row per template, in the reader's words; archived ones only when asked for.\nif (Inputs.templates === undefined || Inputs.meta === undefined) return;\nconst fill = (s, v) => Object.keys(v).reduce((out, k) => out.split('{' + k + '}').join(String(v[k])), String(s || ''));\nconst all = Array.isArray(Inputs.templates) ? Inputs.templates : [];\nconst shown = all.filter((t) => Inputs.showArchived === true || !t.archived);\nOutputs.rows = shown.map((t) => {\n  const items = t.items || [];\n  const live = items.filter((i) => i.kind === 'live').length;\n  const days = items.reduce((m, i) => Math.max(m, Number(i.dayOffset) || 0), 0);\n  return {\n    id: t.id,\n    title: t.title,\n    description: t.description || '',\n    archived: t.archived === true,\n    meta: fill(days ? Inputs.meta : Inputs.metaNoDays, { steps: items.length, live, days })\n  };\n});\nOutputs.hasRows = shown.length > 0;\nOutputs.none = shown.length === 0;\n"
      },
      "ports": [
        {
          "name": "in-templates",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-showArchived",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-meta",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-metaNoDays",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-rows",
          "plug": "output",
          "type": "array"
        },
        {
          "name": "out-hasRows",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-none",
          "plug": "output",
          "type": "boolean"
        }
      ]
    },
