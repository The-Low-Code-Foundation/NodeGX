        }
      ]
    },
    {
      "id": "pt_pick_fn",
      "type": "JavaScriptFunction",
      "label": "The template the row asked to edit",
      "x": 1000,
      "y": 1000,
      "parameters": {
        "runOnChange-in-templates": false,
        "runOnChange-in-itemId": false,
        "functionScript": "const t = (Inputs.templates || []).find((x) => x.id === Inputs.itemId);\nif (!t) return;\nOutputs.template = t;\nOutputs.open();\n"
      },
      "ports": [
        {
          "name": "in-templates",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-itemId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-template",
          "plug": "output",
          "type": "object"
        },
        {
          "name": "out-open",
          "plug": "output",
          "type": "signal"
        }
      ]
    },
    {
      "id": "pt_arch_fn",
      "type": "JavaScriptFunction",
      "label": "Archive or restore: whichever it is not",
      "x": 1000,
      "y": 1240,
      "parameters": {
        "runOnChange-in-templates": false,
        "runOnChange-in-itemId": false,
        "runOnChange-in-archivedSaid": false,
        "runOnChange-in-restoredSaid": false,
        "functionScript": "const t = (Inputs.templates || []).find((x) => x.id === Inputs.itemId);\nif (!t) return;\nconst archived = t.archived !== true;\nOutputs.id = t.id;\nOutputs.archived = archived;\nOutputs.say = String(archived ? Inputs.archivedSaid : Inputs.restoredSaid).split('{title}').join(t.title);\nOutputs.go();\n"
      },
      "ports": [
        {
          "name": "in-templates",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-itemId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-archivedSaid",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-restoredSaid",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-archived",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-say",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        }
      ]
    },
