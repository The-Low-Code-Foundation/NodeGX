      "type": "PageInputs",
      "label": "?step= from the email or Home",
      "parameters": {
        "queryParams": "step"
      },
      "x": 530,
      "y": 1960
    },
    {
      "id": "ci_step_fn",
      "type": "JavaScriptFunction",
      "label": "When ?step= changes, read again",
      "parameters": {
        "functionScript": "// The email link and Home's Answer button both open /checkin?step=<id>.\nOutputs.stepId = String(Inputs.step || '');\nOutputs.go();"
      },
      "ports": [
        {
          "name": "in-step",
          "plug": "input",
          "type": "string"
        },
        {
          "name": "out-stepId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 530,
      "y": 280
    },
    {
      "id": "ci_read",
      "type": "CloudFunction2",
      "label": "myCheckin (only my shared check-in)",
      "parameters": {
        "function": "myCheckin"
      },
      "x": 530,
      "y": 2080
    },
    {
      "id": "ci_fail_sw",
      "type": "Switch",
      "label": "Remember the read failed",
      "parameters": {
        "onFromStart": false
      },
      "x": 530,
      "y": 760
    },
    {
      "id": "ci_not_failed",
      "type": "Inverter",
      "label": "The read did not fail",
      "x": 530,
      "y": 880
    },
    {
      "id": "ci_words-2",
      "type": "JavaScriptFunction",
      "label": "Which state it is in",
      "parameters": {
        "functionScript": "// myCheckin's answer (DBU-10): waiting (not sent yet), open (sent, not answered) or answered.\nconst c = Inputs.checkin && typeof Inputs.checkin === 'object' ? Inputs.checkin : null;\nif (!c) return;\nOutputs.title = String(c.title || '');\nOutputs.stepId = String(c.id || '');\nOutputs.isWaiting = c.state === 'waiting';\nOutputs.isOpen = c.state === 'open';\nOutputs.isAnswered = c.state === 'answered';\nOutputs.questions = Array.isArray(c.questions) ? c.questions : [];\nOutputs.answers = c.answers && typeof c.answers === 'object' ? c.answers : {};"
      },
      "ports": [
        {
          "name": "in-checkin",
          "plug": "input",
          "type": "object"
        },
        {
          "name": "out-title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-stepId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-isWaiting",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-isOpen",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-isAnswered",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-questions",
          "plug": "output",
          "type": "array"
        },
        {
          "name": "out-answers",
          "plug": "output",
          "type": "object"
        }
      ],
      "x": 530,
      "y": 640
    },
