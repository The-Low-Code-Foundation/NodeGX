      "parameters": {
        "text": "",
        "mounted": false,
        "fontSize": "var(--text-sm)",
        "color": "var(--attention)"
      },
      "x": 280,
      "y": 1240
    },
    {
      "id": "st_failed",
      "type": "Text",
      "label": "Could not read the settings",
      "parent": "st_body",
      "parameters": {
        "text": "",
        "mounted": false,
        "fontSize": "var(--text-sm)",
        "color": "var(--attention)"
      },
      "x": 220,
      "y": 1360
    },
    {
      "id": "st_read",
      "type": "CloudFunction2",
      "label": "coachSettings (staff only)",
      "parameters": {
        "function": "coachSettings"
      },
      "x": 590,
      "y": 640
    },
    {
      "id": "st_write",
      "type": "CloudFunction2",
      "label": "saveCoachSettings (staff only)",
      "parameters": {
        "function": "saveCoachSettings"
      },
      "x": 590,
      "y": 760
    },
    {
      "id": "st_t_email",
      "type": "Translation",
      "label": "Learner messages are emailed to",
      "parameters": {
        "Namespace": "pages",
        "Key": "settings.coachEmail"
      },
      "x": 590,
      "y": 880
    },
    {
      "id": "st_t_hint",
      "type": "Translation",
      "label": "Hint",
      "parameters": {
        "Namespace": "pages",
        "Key": "settings.coachEmailHint"
      },
      "x": 590,
      "y": 1000
    },
    {
      "id": "st_t_save",
      "type": "Translation",
      "label": "Save",
      "parameters": {
        "Namespace": "pages",
        "Key": "settings.save"
      },
      "x": 590,
      "y": 1120
    },
    {
      "id": "st_t_saved",
      "type": "Translation",
      "label": "Saved. ... {email}",
      "parameters": {
        "Namespace": "pages",
        "Key": "settings.saved"
      },
      "x": 590,
      "y": 1840
    },
    {
      "id": "st_t_failed",
      "type": "Translation",
      "label": "Could not read",
      "parameters": {
        "Namespace": "pages",
        "Key": "settings.failed"
      },
      "x": 590,
      "y": 1600
    },
    {
      "id": "st_fill_saved",
      "type": "String Format",
      "label": "Saved, filled in",
      "parameters": {
        "format": "Saved. Learner messages now go to {email}."
      },
      "x": 590,
      "y": 1240
    },
    {
      "id": "st_saved_sw",
      "type": "Switch",
      "label": "Saved",
      "parameters": {
        "onFromStart": false
      },
      "x": 590,
      "y": 1360
    },
    {
      "id": "st_refused_sw",
      "type": "Switch",
      "label": "Not saved",
      "parameters": {
        "onFromStart": false
      },
      "x": 590,
      "y": 1480
    },
    {
      "id": "st_fail_sw",
      "type": "Switch",
      "label": "Could not read",
      "parameters": {
        "onFromStart": false
      },
      "x": 590,
      "y": 1720
    },
    {
      "id": "st_loaded_sw",
      "type": "Switch",
      "label": "Read once",
      "parameters": {
        "onFromStart": false
      },
      "x": 590,
      "y": 520
    },
    {
      "id": "st_name",
      "type": "net.noodl.controls.textinput",
      "label": "Coach name (what learners see)",
      "parent": "st_card",
      "parameters": {
        "type": "text",
        "useLabel": true,
        "maxLength": 60,
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "dataAttributes": "data-testid",
        "data-testid": "coach-name"
      },
      "x": 280,
      "y": 1000
    },
    {
      "id": "st_name_hint",
      "type": "Text",
      "label": "Where learners see it, and the default",
      "parent": "st_card",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--muted-foreground)"
      },
      "x": 280,
      "y": 1360
    },
    {
      "id": "st_t_name",
      "type": "Translation",
      "label": "Your name, as learners see it",
      "x": 900,
      "y": 40,
      "parameters": {
        "Namespace": "pages",
        "Key": "settings.coachName"
      }
    },
    {
      "id": "st_t_name_hint",
      "type": "Translation",
      "label": "Name hint",
      "x": 900,
      "y": 120,
      "parameters": {
        "Namespace": "pages",
        "Key": "settings.coachNameHint"
      }
    }
