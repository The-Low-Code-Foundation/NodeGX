{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "5edacb88-2351-5980-82c5-8a9a8a6f4957",
  "version": 1,
  "nodes": [
    {
      "id": "st_page",
      "type": "Page",
      "label": "Settings",
      "children": [
        "st_shell"
      ],
      "parameters": {
        "urlPath": "coach/settings"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "st_shell",
      "type": "/Shell/App shell",
      "label": "Coach shell",
      "parent": "st_page",
      "children": [
        "st_head",
        "st_body"
      ],
      "parameters": {
        "coach": true,
        "current": "settings"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "st_head",
      "type": "/Shell/Page head",
      "label": "Head",
      "parent": "st_shell",
      "parameters": {
        "titleKey": "settings.title",
        "leadKey": "settings.lead"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "st_t_tab",
      "type": "Translation",
      "label": "The browser tab's title",
      "x": 500,
      "y": 40,
      "parameters": {
        "Namespace": "pages",
        "Key": "settings.tab"
      }
    },
    {
      "id": "st_body",
      "type": "Group",
      "label": "Settings body (reads on mount)",
      "parent": "st_shell",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "rowGap": "var(--space-3)"
      },
      "children": [
        "st_card",
        "st_failed"
      ],
      "x": 160,
      "y": 400
    },
    {
      "id": "st_card",
      "type": "Group",
      "label": "Coach address",
      "parent": "st_body",
      "parameters": {
        "mounted": false,
        "width": {
          "value": 100,
          "unit": "%"
        },
        "maxWidth": {
          "value": 640,
          "unit": "px"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "stretch",
        "rowGap": "var(--space-3)",
        "backgroundColor": "var(--surface)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border)",
        "borderRadius": "var(--radius-xl)",
        "paddingTop": "var(--space-6)",
        "paddingBottom": "var(--space-6)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "dataAttributes": "data-testid",
        "data-testid": "coach-settings"
      },
      "children": [
        "st_name",
        "st_name_hint",
        "st_email",
        "st_hint",
        "st_save_row",
        "st_saved",
        "st_refused"
      ],
      "x": 220,
      "y": 520
    },
    {
      "id": "st_email",
      "type": "net.noodl.controls.textinput",
      "label": "Coach address",
      "parent": "st_card",
      "parameters": {
        "type": "email",
        "useLabel": true,
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight"
      },
      "x": 280,
      "y": 640
    },
    {
      "id": "st_hint",
      "type": "Text",
      "label": "Where they land, and the default",
      "parent": "st_card",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--muted-foreground)"
      },
      "x": 280,
      "y": 760
    },
    {
      "id": "st_save_row",
      "type": "Group",
      "label": "Save",
      "parent": "st_card",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "row",
        "paddingTop": "var(--space-1)"
      },
      "children": [
        "st_save"
      ],
      "x": 280,
      "y": 880
    },
    {
      "id": "st_save",
      "type": "net.noodl.controls.button",
      "label": "Save",
      "parent": "st_save_row",
      "parameters": {
        "label": "",
        "sizeMode": "contentSize"
      },
      "x": 340,
      "y": 1000
    },
    {
      "id": "st_saved",
      "type": "Text",
      "label": "Saved, with the address now used",
      "parent": "st_card",
      "parameters": {
        "text": "",
        "mounted": false,
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-medium)",
        "color": "var(--done-fg)"
      },
      "x": 280,
      "y": 1120
    },
    {
      "id": "st_refused",
      "type": "Text",
