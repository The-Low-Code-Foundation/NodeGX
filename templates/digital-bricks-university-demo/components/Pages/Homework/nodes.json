    {
      "id": "hw_read",
      "type": "CloudFunction2",
      "label": "myHomework (only my shared homework)",
      "parameters": {
        "function": "myHomework"
      },
      "x": 590,
      "y": 280
    },
    {
      "id": "hw_step_fn",
      "type": "JavaScriptFunction",
      "label": "When ?step= changes, read again",
      "parameters": {
        "functionScript": "// Opening another homework, the list, or the Homework tab changes ?step= without leaving the page.\n// No step reads as '' (the list), so the read never keeps a step that is no longer in the address.\nOutputs.stepId = String(Inputs.step || '');\nOutputs.go();"
      },
      "ports": [
        {
          "name": "in-step",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-stepId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 590,
      "y": 2080
    },
