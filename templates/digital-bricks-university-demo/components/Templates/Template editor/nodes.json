    },
    {
      "id": "te_arr",
      "type": "Collection2",
      "label": "The steps being edited",
      "x": 520,
      "y": 1000,
      "parameters": {
        "collectionId": "template-draft-items"
      },
      "metadata": {
        "comment": "An app-wide Array: one template editor exists, on one page (shared on purpose)."
      }
    },
    {
      "id": "te_open",
      "type": "JavaScriptFunction",
      "label": "Open the template: fill the fields and the steps",
      "x": 520,
      "y": 280,
      "parameters": {
        "runOnChange-in-template": false,
        "runOnChange-in-library": false,
        "runOnChange-in-kinds": false,
        "runOnChange-in-newHeading": false,
        "runOnChange-in-editHeading": false,
        "runOnChange-in-noLibrary": false,
        "functionScript": "/*\n * Runs each time the page opens the editor, for a new template ({}) or an existing one.\n * The steps are records in the named Array; each row writes its own fields as the coach types\n * (Templates/Template item row) and 'Gather' reads them back. Archived library items are\n * offered only where a step already names one.\n */\nconst tpl = Inputs.template && typeof Inputs.template === 'object' ? Inputs.template : {};\nconst get = (m, k) => (m && typeof m.get === 'function' ? m.get(k) : m && m[k]);\nconst kindInfo = {};\n(Inputs.kinds || []).forEach((k) => { kindInfo[get(k, 'value')] = { kindKey: get(k, 'labelKey'), kindBg: get(k, 'bg'), kindFg: get(k, 'fg') }; });\nconst items = Array.isArray(tpl.items) ? tpl.items : [];\nconst named = new Set(items.map((i) => i.libraryItem).filter(Boolean));\nconst library = (Inputs.library || []).filter((l) => !l.archived || named.has(l.id));\nconst libraryOptions = [{ Label: Inputs.noLibrary, Value: '' }].concat(library.map((l) => ({ Label: l.title, Value: l.id })));\nconst uid = () => 'tpli-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);\nNoodl.Arrays['template-draft-items'] = items.map((i) => Object.assign({ id: uid(), kind: i.kind }, kindInfo[i.kind] || {}, {\n  isLive: i.kind === 'live',\n  isHomework: i.kind === 'homework',\n  title: i.title || '',\n  dayOffset: String(Number.isInteger(i.dayOffset) ? i.dayOffset : 0),\n  durationMin: i.kind === 'live' ? String(Number.isInteger(i.durationMin) ? i.durationMin : 60) : '',\n  libraryItem: i.libraryItem || '',\n  libraryOptions\n}));\nOutputs.kindInfo = kindInfo;\nOutputs.libraryOptions = libraryOptions;\nOutputs.id = tpl.id || '';\nOutputs.title = tpl.title || '';\nOutputs.description = tpl.description || '';\nOutputs.heading = tpl.id ? Inputs.editHeading : Inputs.newHeading;\nOutputs.opened();\n"
      },
      "ports": [
        {
          "name": "in-template",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-library",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-kinds",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-newHeading",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-editHeading",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-noLibrary",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-kindInfo",
          "plug": "output",
          "type": "object"
        },
        {
          "name": "out-libraryOptions",
          "plug": "output",
          "type": "array"
        },
        {
          "name": "out-id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-description",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-heading",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-opened",
          "plug": "output",
          "type": "signal"
        }
      ]
    },
    {
      "id": "te_titles",
      "type": "JavaScriptFunction",
      "label": "A new step's title, by kind",
      "x": 820,
      "y": 1360,
      "parameters": {
        "functionScript": "if (Inputs.live === undefined || Inputs.homework === undefined || Inputs.checkin === undefined) return;\nOutputs.titles = { live: Inputs.live, homework: Inputs.homework, checkin: Inputs.checkin };\n"
      },
      "ports": [
        {
          "name": "in-live",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-homework",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-checkin",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-titles",
          "plug": "output",
          "type": "object"
        }
      ]
    },
    {
      "id": "te_gather",
      "type": "JavaScriptFunction",
      "label": "Gather the template from the fields and the steps",
      "x": 520,
      "y": 1840,
      "parameters": {
        "runOnChange-in-id": false,
        "runOnChange-in-title": false,
        "runOnChange-in-description": false,
        "functionScript": "// Read on Save only. savePlanTemplate keeps only the shape and checks every step again.\nconst get = (m, k) => (m && typeof m.get === 'function' ? m.get(k) : m && m[k]);\nOutputs.items = (Noodl.Arrays['template-draft-items'] || []).map((m) => ({\n  kind: get(m, 'kind'),\n  title: String(get(m, 'title') || ''),\n  dayOffset: String(get(m, 'dayOffset') || '').trim(),\n  durationMin: String(get(m, 'durationMin') || '').trim(),\n  libraryItem: String(get(m, 'libraryItem') || '')\n}));\nOutputs.id = String(Inputs.id || '');\nOutputs.title = String(Inputs.title || '').trim();\nOutputs.description = String(Inputs.description || '');\nOutputs.go();\n"
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-title",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-description",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-items",
          "plug": "output",
          "type": "array"
        },
        {
          "name": "out-id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-description",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        }
      ]
    },
