        "label": "",
        "sizeMode": "contentSize",
        "backgroundColor": "var(--surface)",
        "color": "var(--foreground)",
        "fontWeight": "var(--font-medium)",
        "fontSize": "var(--text-sm)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-control)",
        "paddingLeft": "var(--space-3)",
        "paddingRight": "var(--space-3)",
        "paddingTop": "var(--space-1-5)",
        "paddingBottom": "var(--space-1-5)",
        "minHeight": "var(--space-9)",
        "useIcon": true,
        "iconSourceType": "icon",
        "iconIconSource": {
          "class": "lucide",
          "code": "icon-chevron-right",
          "codeAsClass": true
        },
        "iconPlacement": "right",
        "iconColor": "var(--muted-foreground)",
        "iconSize": 16,
        "iconSpacing": "var(--space-1)"
      }
    },
    {
      "id": "rr_to_plan",
      "type": "RouterNavigate",
      "label": "→ This learner's plan",
      "x": 410,
      "y": 760,
      "parameters": {
        "router": "Main",
        "target": "/Pages/Learner plan"
      }
    },
    {
      "id": "rr_t_open",
      "type": "Translation",
      "label": "Open plan",
      "x": 410,
      "y": 640,
      "parameters": {
        "Namespace": "pages",
        "Key": "learners.open"
      }
    },
    {
      "id": "rr_unread",
      "type": "Text",
      "label": "Unread messages (DBU-07)",
      "parent": "rr_plan_line",
      "parameters": {
        "text": "",
        "mounted": false,
        "sizeMode": "contentSize",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "color": "var(--primary)"
      },
      "x": 220,
      "y": 760
    }
