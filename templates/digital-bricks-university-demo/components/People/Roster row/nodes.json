      "children": [
        "rr_plan",
        "rr_progress",
        "rr_unread"
      ],
      "parameters": {
        "sizeMode": "contentSize",
        "maxWidth": {
          "value": 100,
          "unit": "%"
        },
        "flexDirection": "row",
        "flexWrap": "wrap",
        "columnGap": "var(--space-3)",
        "rowGap": "var(--space-1)",
        "paddingTop": "var(--space-1)"
      },
      "x": 100,
      "y": 400
