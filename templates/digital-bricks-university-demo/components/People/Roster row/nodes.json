    {
      "id": "rr_detail",
      "type": "Text",
      "label": "Organisation and address",
      "parent": "rr_text",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "rr_plan_line",
      "type": "Group",
      "label": "Plan and progress",
