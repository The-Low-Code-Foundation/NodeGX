    {
      "id": "rr_plan",
      "type": "Text",
      "label": "Plan",
      "parent": "rr_plan_line",
      "parameters": {
        "text": "",
        "sizeMode": "contentSize",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-medium)",
        "color": "var(--accent-foreground)"
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "rr_progress",
      "type": "Text",
      "label": "Progress",
      "parent": "rr_plan_line",
      "parameters": {
        "text": "",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)"
      },
      "x": 160,
      "y": 640,
      "metadata": {
        "comment": "Content height, so a long progress (steps, not shared, creations) wraps on a phone instead of pushing Open plan off the screen. Content size never wraps."
      }
    },
    {
      "id": "rr_in",
      "type": "Component Inputs",
      "label": "Row in",
      "ports": [
        {
          "name": "name",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "detail",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "plan",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "progress",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "learnerId",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "unread",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "hasUnread",
          "plug": "output",
          "type": "boolean"
        }
