{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "53573221-6d78-5111-8d88-004a582b1946",
  "version": 1,
  "nodes": [
    {
      "id": "rr_row",
      "type": "Group",
      "label": "Row",
      "children": [
        "rr_text",
        "rr_open"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "row",
        "paddingTop": "var(--space-4)",
        "paddingBottom": "var(--space-4)",
        "paddingLeft": "var(--space-5)",
        "paddingRight": "var(--space-5)",
        "borderBottomStyle": "solid",
        "borderBottomWidth": "var(--border-1)",
        "borderBottomColor": "var(--border)",
        "alignItems": "center",
        "columnGap": "var(--space-4)"
      },
      "x": 40,
      "y": 40,
      "metadata": {
        "comment": "Not wrapped: the words shrink beside Open plan on a phone."
      }
    },
    {
      "id": "rr_name",
      "type": "Text",
      "label": "Name",
      "parent": "rr_text",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)",
        "fontWeight": "var(--font-semibold)",
        "color": "var(--foreground)"
      },
      "x": 100,
      "y": 160
