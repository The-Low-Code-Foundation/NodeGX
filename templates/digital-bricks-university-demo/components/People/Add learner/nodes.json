      "type": "Component Outputs",
      "label": "Add learner out",
      "x": 700,
      "y": 760,
      "ports": [
        {
          "name": "added",
          "plug": "input",
          "type": "signal",
          "displayName": "Added (or found)"
        },
        {
          "name": "closed",
          "plug": "input",
          "type": "signal",
          "displayName": "Closed"
        }
      ]
    },
    {
      "id": "ad_opts",
      "type": "JavaScriptFunction",
      "label": "The templates as choices, empty plan first",
      "x": 700,
      "y": 100,
      "parameters": {
        "functionScript": "if (Inputs.emptyLabel === undefined) return;\nconst templates = Array.isArray(Inputs.templates) ? Inputs.templates : [];\nOutputs.items = [{ Label: Inputs.emptyLabel, Value: '' }].concat(templates.map((t) => ({ Label: t.title, Value: t.id })));\n"
      },
      "ports": [
        {
          "name": "in-templates",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-emptyLabel",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-items",
          "plug": "output",
          "type": "*"
        }
      ]
    },
    {
      "id": "ad_call",
      "type": "CloudFunction2",
      "label": "addLearner (staff only)",
      "x": 700,
      "y": 220,
      "parameters": {
        "function": "addLearner"
      }
    },
    {
      "id": "ad_say",
      "type": "JavaScriptFunction",
      "label": "Added, already there, or added without the email",
      "x": 700,
      "y": 340,
      "parameters": {
        "runOnChange-in-created": false,
        "runOnChange-in-mailed": false,
        "runOnChange-in-name": false,
        "runOnChange-in-email": false,
        "runOnChange-in-added": false,
        "runOnChange-in-addedNoMail": false,
        "runOnChange-in-already": false,
        "functionScript": "// Say which, because 'already there' means nothing was changed: a coach who mistyped a\n// name on a second press needs to know it was ignored.\nconst fill = (s) => String(s || '').split('{name}').join(String(Inputs.name || '').trim()).split('{email}').join(String(Inputs.email || '').trim().toLowerCase());\nif (Inputs.created !== true) Outputs.text = fill(Inputs.already);\nelse if (Inputs.mailed !== true) Outputs.text = fill(Inputs.addedNoMail);\nelse Outputs.text = fill(Inputs.added);\n"
      },
      "ports": [
        {
          "name": "in-created",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-mailed",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-name",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-email",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-added",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-addedNoMail",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-already",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-text",
          "plug": "output",
          "type": "string"
        }
      ]
    },
