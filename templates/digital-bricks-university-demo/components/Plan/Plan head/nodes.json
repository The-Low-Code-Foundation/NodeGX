    {
      "id": "phd_opts",
      "type": "JavaScriptFunction",
      "label": "The templates on offer",
      "x": 560,
      "y": 2200,
      "parameters": {
        "functionScript": "// First a 'Choose one' that starts nothing, then the templates the backend offers (not archived).\nif (Inputs.choose === undefined) return;\nconst templates = Array.isArray(Inputs.templates) ? Inputs.templates : [];\nOutputs.items = [{ Label: Inputs.choose, Value: '' }].concat(templates.map((t) => ({ Label: t.title, Value: t.id })));\n"
      },
      "ports": [
        {
          "name": "in-templates",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-choose",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-items",
          "plug": "output",
          "type": "array"
        }
      ]
    },
    {
      "id": "phd_apply",
      "type": "CloudFunction2",
