      }
    },
    {
      "id": "phd_started",
      "type": "JavaScriptFunction",
      "label": "Started from it, in a sentence",
      "x": 860,
      "y": 2440,
      "parameters": {
        "runOnChange-in-templates": false,
        "runOnChange-in-templateId": false,
        "runOnChange-in-added": false,
        "runOnChange-in-said": false,
        "functionScript": "const fill = (s, v) => Object.keys(v).reduce((out, k) => out.split('{' + k + '}').join(String(v[k])), String(s || ''));\nconst t = (Inputs.templates || []).find((x) => x.id === Inputs.templateId) || {};\nOutputs.said = fill(Inputs.said, { title: t.title || '', count: Number(Inputs.added) || 0 });\nOutputs.show();\n"
      },
      "ports": [
        {
          "name": "in-templates",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-templateId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-added",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-said",
          "plug": "input",
          "type": "*"
