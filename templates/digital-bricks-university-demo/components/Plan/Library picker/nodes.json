    {
      "id": "lp_shape",
      "type": "JavaScriptFunction",
      "label": "What can be picked, matching the search",
      "x": 500,
      "y": 280,
      "parameters": {
        "functionScript": "// Archived items are never offered (DBU-03). The search matches a title or a tag.\nif (Inputs.items === undefined) return;\nconst fill = (s, v) => Object.keys(v).reduce((out, k) => out.split('{' + k + '}').join(String(v[k])), String(s || ''));\nconst words = String(Inputs.search || '').trim().toLowerCase();\nconst offered = (Array.isArray(Inputs.items) ? Inputs.items : []).filter((i) => i.archived !== true);\nconst matching = offered.filter((i) => !words || String(i.title || '').toLowerCase().includes(words) ||\n  (i.tags || []).some((t) => String(t).toLowerCase().includes(words)));\nOutputs.rows = matching.map((i) => ({\n  id: i.id,\n  title: i.title,\n  meta: [Number.isInteger(i.estimatedMinutes) ? fill(Inputs.minutes, { min: i.estimatedMinutes }) : '', (i.tags || []).join(', ')].filter(Boolean).join(' · ')\n}));\nOutputs.hasRows = matching.length > 0;\nOutputs.none = matching.length === 0;\n"
      },
      "ports": [
        {
          "name": "in-items",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-search",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-minutes",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-rows",
          "plug": "output",
          "type": "array"
        },
        {
          "name": "out-hasRows",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-none",
          "plug": "output",
          "type": "boolean"
        }
      ]
