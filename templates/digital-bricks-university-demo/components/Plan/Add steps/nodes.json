    {
      "id": "ads_ready_say",
      "type": "JavaScriptFunction",
      "label": "What sharing did, in a sentence",
      "x": 740,
      "y": 640,
      "parameters": {
        "runOnChange-in-changed": false,
        "runOnChange-in-left": false,
        "runOnChange-in-one": false,
        "runOnChange-in-some": false,
        "runOnChange-in-none": false,
        "functionScript": "// shareSteps answers how many it shared and how many drafts are not ready yet.\nconst fill = (s, v) => Object.keys(v).reduce((out, k) => out.split('{' + k + '}').join(String(v[k])), String(s || ''));\nconst changed = Number(Inputs.changed) || 0;\nconst left = Number(Inputs.left) || 0;\nif (!changed) Outputs.said = Inputs.none;\nelse Outputs.said = fill(left ? Inputs.some : Inputs.one, { changed, left });\nOutputs.show();\n"
      },
      "ports": [
        {
          "name": "in-changed",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-left",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-one",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-some",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-none",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-said",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-show",
          "plug": "output",
          "type": "signal"
        }
      ]
    },
