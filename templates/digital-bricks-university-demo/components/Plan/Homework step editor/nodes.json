    {
      "id": "hse_in",
      "type": "Component Inputs",
      "label": "The step",
      "x": 500,
      "y": 40,
      "ports": [
        {
          "name": "step",
          "plug": "output",
          "type": "object"
        }
      ]
    },
    {
      "id": "hse_out",
      "type": "Component Outputs",
      "label": "Saved or closed",
      "x": 500,
      "y": 1240,
      "ports": [
        {
          "name": "saved",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "savedTitle",
          "plug": "input",
          "type": "string"
        },
        {
          "name": "closed",
          "plug": "input",
          "type": "signal"
        }
      ]
    },
    {
      "id": "hse_open",
      "type": "JavaScriptFunction",
      "label": "Open the step: fill the fields and the two lists",
      "x": 500,
      "y": 160,
      "parameters": {
        "runOnChange-in-step": false,
        "functionScript": "/*\n * Runs when the editor appears. The two lists are named client-side Arrays, as in the\n * library editor; each row writes its own record as the coach types, and 'Gather' reads\n * them back. Fresh row ids every time, so nothing typed in a previous opening survives.\n */\nconst step = Inputs.step && typeof Inputs.step === 'object' ? Inputs.step : {};\nconst uid = (p) => p + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);\nNoodl.Arrays['plan-draft-checklist'] = (step.handInChecklist || [])\n  .map((c) => (typeof c === 'string' ? { text: c, required: true } : c))\n  .map((c) => ({ id: uid('pchk-'), text: c.text || '', required: c.required !== false }));\nNoodl.Arrays['plan-draft-resources'] = (step.resources || []).map((r) => ({\n  id: uid('pres-'), label: r.label || '', url: r.url || '', file: r.file || '', fileName: r.fileName || '', isFile: !!r.file\n}));\nOutputs.id = step.id || '';\nOutputs.title = step.title || '';\nOutputs.brief = step.brief || '';\nOutputs.due = step.dueAt ? new Date(step.dueAt).toLocaleDateString('en-CA', { timeZone: 'Europe/Paris' }) : '';\nOutputs.fromLibrary = !!step.fromLibraryItem;\nOutputs.opened();\n"
      },
      "ports": [
        {
          "name": "in-step",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-brief",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-due",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-fromLibrary",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-opened",
          "plug": "output",
          "type": "signal"
        }
      ]
    },
    {
      "id": "hse_gather",
      "type": "JavaScriptFunction",
      "label": "Gather the homework from the fields and the two lists",
      "x": 500,
      "y": 520,
      "parameters": {
        "runOnChange-in-id": false,
        "runOnChange-in-title": false,
        "runOnChange-in-due": false,
        "runOnChange-in-brief": false,
        "functionScript": "// Read on Save only. saveStep tidies and checks everything again.\nconst get = (m, k) => (m && typeof m.get === 'function' ? m.get(k) : m && m[k]);\nOutputs.handInChecklist = (Noodl.Arrays['plan-draft-checklist'] || []).map((m) => ({ text: String(get(m, 'text') || ''), required: get(m, 'required') !== false }));\nOutputs.resources = (Noodl.Arrays['plan-draft-resources'] || []).map((m) => (get(m, 'isFile')\n  ? { label: String(get(m, 'label') || ''), file: String(get(m, 'file') || ''), fileName: String(get(m, 'fileName') || '') }\n  : { label: String(get(m, 'label') || ''), url: String(get(m, 'url') || '') }));\nOutputs.id = String(Inputs.id || '');\nOutputs.title = String(Inputs.title || '').trim();\nOutputs.dueAt = String(Inputs.due || '').trim();\nOutputs.brief = String(Inputs.brief || '');\nOutputs.go();\n"
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-title",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-due",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-brief",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-dueAt",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-brief",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-handInChecklist",
          "plug": "output",
          "type": "array"
        },
        {
          "name": "out-resources",
          "plug": "output",
          "type": "array"
        },
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        }
      ]
    },
