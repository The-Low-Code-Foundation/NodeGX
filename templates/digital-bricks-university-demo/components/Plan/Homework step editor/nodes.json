      "parameters": {
        "listId": "plan-draft-checklist"
      },
      "metadata": {
        "comment": "Its own Array, not the library editor's: the plan builder opens one step editor at a time (Plan/Step list keeps one open), so one app-wide name is safe here (shared on purpose)."
      }
    },
    {
      "id": "hse_res",
