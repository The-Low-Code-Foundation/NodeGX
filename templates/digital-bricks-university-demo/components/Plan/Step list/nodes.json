    {
      "id": "sl_set_open",
      "type": "net.noodl.SetComponentObjectProperties",
      "label": "Open a step",
      "x": 500,
      "y": 280,
      "parameters": {
        "properties": "openId"
      }
    },
    {
      "id": "sl_set_close",
      "type": "net.noodl.SetComponentObjectProperties",
      "label": "Close the open step",
      "x": 500,
      "y": 400,
      "parameters": {
        "properties": "openId",
        "prop-openId": ""
      }
    },
    {
      "id": "sl_merge",
      "type": "JavaScriptFunction",
      "label": "The rows, with the open one marked",
      "x": 500,
      "y": 520,
      "parameters": {
        "functionScript": "// The page shapes every row; this only marks the open one (and stops it being dragged).\n// Ids stay the steps' own, so the repeater keeps each row as it is.\nif (Inputs.rows === undefined) return;\nconst rows = Array.isArray(Inputs.rows) ? Inputs.rows : [];\nconst openId = String(Inputs.openId || '');\nconst readOnly = Inputs.readOnly === true;\nOutputs.items = rows.map((r) => Object.assign({}, r, {\n  open: !readOnly && r.id === openId,\n  movable: !readOnly && r.id !== openId,\n  editable: !readOnly\n}));\nOutputs.hasRows = rows.length > 0;\nOutputs.showEmpty = rows.length === 0 && !readOnly;\n"
      },
      "ports": [
        {
          "name": "in-rows",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-openId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-readOnly",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-items",
          "plug": "output",
          "type": "array"
        },
        {
          "name": "out-hasRows",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-showEmpty",
          "plug": "output",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "sl_toggle",
      "type": "JavaScriptFunction",
      "label": "Edit opens a step, or closes it if it is open",
      "x": 500,
      "y": 640,
      "parameters": {
        "runOnChange-in-id": false,
        "runOnChange-in-current": false,
        "functionScript": "const id = String(Inputs.id || '');\nOutputs.next = id && id !== String(Inputs.current || '') ? id : '';\nOutputs.go();\n"
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-current",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-next",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        }
      ]
    },
    {
      "id": "sl_share",
      "type": "JavaScriptFunction",
      "label": "Share it, or take it back",
      "x": 500,
      "y": 760,
      "parameters": {
        "runOnChange-in-id": false,
        "runOnChange-in-rows": false,
        "functionScript": "// One button on the row; whether it shares or unshares is the row's own state.\nconst id = String(Inputs.id || '');\nconst row = (Inputs.rows || []).find((r) => r.id === id);\nif (!row) return;\nOutputs.stepIds = [id];\nOutputs.shared = row.shared !== true;\nOutputs.go();\n"
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-rows",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-stepIds",
          "plug": "output",
          "type": "array"
        },
        {
          "name": "out-shared",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        }
      ]
    },
