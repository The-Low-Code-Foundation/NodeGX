    {
      "id": "as_mark",
      "type": "JavaScriptFunction",
      "label": "This side's tabs, current one marked",
      "x": 760,
      "y": 80,
      "parameters": {
        "functionScript": "const list = Inputs.coach === true ? Inputs.coachTabs : Inputs.learnerTabs;\nif (list === undefined || Inputs.current === undefined) return;\nconst read = (tab, key) => (typeof tab.get === 'function' ? tab.get(key) : tab[key]);\n// A Static Data row is a Model: its id is the model's own id, not a property get() returns.\nconst idOf = (tab) => (typeof tab.getId === 'function' ? tab.getId() : tab.id);\n// DBU-07: unread messages show on Messages (a learner: Richard's) or Learners (the coach: every learner's).\n// DBU-08: the coach's Inbox shows how many things are waiting on him.\nconst counts = Inputs.coach === true\n  ? { learners: Number(Inputs.unread) || 0, inbox: Number(Inputs.inbox) || 0 }\n  : { messages: Number(Inputs.unread) || 0 };\nOutputs.tabs = list.map((tab) => ({\n  id: idOf(tab),\n  labelKey: read(tab, 'labelKey'),\n  path: read(tab, 'path'),\n  active: idOf(tab) === Inputs.current,\n  count: counts[idOf(tab)] > 0 ? String(counts[idOf(tab)]) : ''\n}));\n"
      },
      "ports": [
        {
          "name": "in-coach",
          "displayName": "coach",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-coachTabs",
          "displayName": "coachTabs",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-learnerTabs",
          "displayName": "learnerTabs",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-current",
          "displayName": "current",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-tabs",
          "displayName": "tabs",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ],
      "metadata": {
        "comment": "Waits for `current` as well as the list: a row the repeater has already drawn keeps its id, so a first pass with no current tab would leave every tab unmarked."
      }
