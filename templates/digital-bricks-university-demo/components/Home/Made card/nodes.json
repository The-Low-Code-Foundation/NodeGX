    {
      "id": "mc_read",
      "type": "CloudFunction2",
      "label": "myCreations (her own only)",
      "parameters": {
        "function": "myCreations"
      },
      "x": 350,
      "y": 40
    },
    {
      "id": "mc_shape",
      "type": "JavaScriptFunction",
      "label": "How many, and the newest",
      "parameters": {
        "functionScript": "// The answer is newest first. Keys, not words: the card fills its own sentences.\nconst items = Array.isArray(Inputs.items) ? Inputs.items : [];\nOutputs.none = items.length === 0;\nOutputs.some = items.length > 0;\nOutputs.countKey = items.length === 1 ? 'home.madeCountOne' : 'home.madeCount';\nOutputs.n = String(items.length);\nOutputs.latest = items.length ? String(items[0].title || '') : '';\n"
      },
      "ports": [
        {
          "name": "in-items",
          "plug": "input",
          "type": "*",
          "displayName": "items",
          "group": "Inputs"
        },
        {
          "name": "out-none",
          "plug": "output",
          "type": "*",
          "displayName": "none",
          "group": "Outputs"
        },
        {
          "name": "out-some",
          "plug": "output",
          "type": "*",
          "displayName": "some",
          "group": "Outputs"
        },
        {
          "name": "out-countKey",
          "plug": "output",
          "type": "*",
          "displayName": "countKey",
          "group": "Outputs"
        },
        {
          "name": "out-n",
          "plug": "output",
          "type": "*",
          "displayName": "n",
          "group": "Outputs"
        },
        {
          "name": "out-latest",
          "plug": "output",
          "type": "*",
          "displayName": "latest",
          "group": "Outputs"
        }
      ],
      "x": 350,
      "y": 400
    },
    {
      "id": "mc_t_count",
      "type": "Translation",
      "label": "You keep {n} things",
      "parameters": {
