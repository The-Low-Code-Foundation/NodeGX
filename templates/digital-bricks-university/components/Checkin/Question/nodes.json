    {
      "id": "cq_pick_fn",
      "type": "JavaScriptFunction",
      "label": "Pick a choice: one, or ticks for several",
      "parameters": {
        "runOnChange-in-itemId": false,
        "runOnChange-in-choiceId": false,
        "functionScript": "/*\n * A choice was pressed (DBU-10). A scale or radio question keeps that one value; a checkbox question\n * ticks it on or off. The value goes into this question's record (Checkin/Form reads it), and every\n * choice of the question is recoloured: picked ones filled, the rest plain.\n */\nconst qid = String(Inputs.itemId || '');\nconst cid = String(Inputs.choiceId || '');\nif (!qid || !cid) return;\nconst q = Noodl.Model.get(qid);\nconst choices = Array.isArray(q.get('choices')) ? q.get('choices') : [];\nconst c = choices.find((x) => x && x.id === cid);\nif (!c) return;\nlet value;\nif (q.get('type') === 'checkbox') {\n  const now = Array.isArray(q.get('value')) ? q.get('value') : [];\n  value = now.includes(c.value) ? now.filter((v) => v !== c.value) : now.concat([c.value]);\n} else {\n  value = c.value;\n}\nq.set('value', value);\nconst on = (v) => (Array.isArray(value) ? value.includes(v) : value === v);\nchoices.forEach((x) => {\n  const m = Noodl.Model.get(x.id);\n  const picked = on(x.value);\n  m.set('bg', picked ? 'var(--primary)' : 'var(--surface)');\n  m.set('fg', picked ? 'var(--primary-foreground)' : 'var(--foreground)');\n  m.set('border', picked ? 'var(--primary)' : 'var(--border-control)');\n});\nOutputs.changed();"
      },
      "ports": [
        {
          "name": "in-itemId",
          "plug": "input",
          "type": "string"
        },
        {
          "name": "in-choiceId",
          "plug": "input",
          "type": "string"
        },
        {
          "name": "out-changed",
          "plug": "output",
          "type": "signal"
        }
      ],
      "metadata": {
        "comment": "Writes the answer into this question's record and recolours its choices; Checkin/Form then works out which questions show."
      },
      "x": 470,
      "y": 640
    }
