    {
      "id": "co_files",
      "type": "Javascript2",
      "label": "The files for this message",
      "x": 520,
      "y": 520,
      "parameters": {
        "code": "/*\n * The files attached to the next message (DBU-07, the hand-in rules of DBU-06): up to 5, each a kind on the list and up to 50 MB,\n * judged from the name and size before anything is uploaded. A file that breaks a rule is\n * not added, and `refused` says why, naming it; the same file twice is added once.\n * Send sends them one after another through the Upload File node: `start` copies the\n * list, `uploadNext` puts each on `current`, the node's done comes back as `uploaded`.\n * After the last one `names` holds every stored name and `allUploaded` fires.\n * sendMessage checks every file again, from its bytes, and has the last word.\n */\nconst MAX_FILES = 5;\nconst MAX_BYTES = 50 * 1024 * 1024;\nlet chosen = [];\nlet seq = 0;\nlet queue = [];\nlet stored = [];\nlet total = 0;\n\nScript.Inputs = {\n  kinds: 'array', picked: '*', pickedName: 'string', pickedSize: 'number',\n  dropped: 'array', removeId: 'string', cloudFile: '*'\n};\nScript.Outputs = {\n  items: 'array', hasFiles: 'boolean', accept: 'string',\n  whyKey: 'string', whyName: 'string', refused: 'signal', accepted: 'signal',\n  current: '*', uploadNext: 'signal', names: 'array', allUploaded: 'signal',\n  busyKey: 'string', busyI: 'string', busyN: 'string'\n};\n\nconst get = (m, k) => (m && typeof m.get === 'function' ? m.get(k) : m && m[k]);\nconst exts = () => (Script.Inputs.kinds || []).map((k) => get(k, 'ext')).filter(Boolean);\nconst sizeText = (n) => (n >= 1024 * 1024 ? (n / (1024 * 1024)).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB');\n\nfunction publish() {\n  Script.Outputs.items = chosen.map((c) => ({ id: c.id, name: c.name, size: sizeText(c.size) }));\n  Script.Outputs.hasFiles = chosen.length > 0;\n}\nfunction refuse(key, name) {\n  Script.Outputs.whyKey = key;\n  Script.Outputs.whyName = name;\n  Script.Outputs.refused();\n}\n// true when the file is in the list (added now, or already there)\nfunction add(file, rawName, rawSize) {\n  const name = String(rawName || '');\n  const size = Number(rawSize) || 0;\n  if (!file || !name) return true;\n  if (chosen.some((c) => c.name === name && c.size === size)) return true;\n  const dot = name.lastIndexOf('.');\n  const ext = dot > 0 ? name.slice(dot + 1).toLowerCase() : '';\n  if (!exts().includes(ext)) { refuse('messages.badType', name); return false; }\n  if (size > MAX_BYTES) { refuse('messages.tooBig', name); return false; }\n  if (chosen.length >= MAX_FILES) { refuse('messages.tooMany', name); return false; }\n  seq += 1;\n  chosen.push({ id: 'chosen-' + seq, file, name, size });\n  return true;\n}\nfunction next() {\n  const c = queue.shift();\n  if (c) {\n    Script.Outputs.busyKey = 'work.uploading';\n    Script.Outputs.busyI = String(total - queue.length);\n    Script.Outputs.busyN = String(total);\n    Script.Outputs.current = c.file;\n    Script.Outputs.uploadNext();\n    return;\n  }\n  Script.Outputs.busyKey = 'messages.sending';\n  Script.Outputs.names = stored.slice();\n  Script.Outputs.allUploaded();\n}\n\nScript.OnInit = function () {\n  Script.Outputs.busyKey = 'messages.sending';\n  publish();\n};\nScript.Setters.kinds = function () {\n  Script.Outputs.accept = exts().map((e) => '.' + e).join(',');\n};\nScript.Signals.addPicked = function () {\n  const ok = add(Script.Inputs.picked, Script.Inputs.pickedName, Script.Inputs.pickedSize);\n  publish();\n  if (ok) Script.Outputs.accepted();\n};\nScript.Signals.addDropped = function () {\n  let ok = true;\n  Array.from(Script.Inputs.dropped || []).forEach((f) => { if (!add(f, f && f.name, f && f.size)) ok = false; });\n  publish();\n  if (ok) Script.Outputs.accepted();\n};\nScript.Signals.remove = function () {\n  const id = String(Script.Inputs.removeId || '');\n  chosen = chosen.filter((c) => c.id !== id);\n  publish();\n  Script.Outputs.accepted();\n};\nScript.Signals.start = function () {\n  queue = chosen.slice();\n  total = queue.length;\n  stored = [];\n  next();\n};\nScript.Signals.uploaded = function () {\n  const f = Script.Inputs.cloudFile;\n  const name = f ? (typeof f.getName === 'function' ? f.getName() : String(f.name || '')) : '';\n  if (name) stored.push(name);\n  next();\n};\nScript.Signals.abort = function () {\n  queue = [];\n  stored = [];\n  Script.Outputs.busyKey = 'messages.sending';\n};\nScript.Signals.clear = function () {\n  chosen = [];\n  queue = [];\n  stored = [];\n  publish();\n};\n"
      }
    },
