    {
      "id": "co_send",
      "type": "JavaScriptFunction",
      "label": "To sendMessage, or to replyAsCoach",
      "x": 760,
      "y": 1000,
      "parameters": {
        "runOnChange-in-mode": false,
        "runOnChange-in-text": false,
        "runOnChange-in-withFiles": false,
        "runOnChange-in-files": false,
        "functionScript": "// Runs once every file is uploaded, or straight from the check when there are none, and fires one call.\nconst coach = Inputs.mode === 'coach';\nOutputs.body = String(Inputs.text || '');\nOutputs.files = !coach && Inputs.withFiles === true && Array.isArray(Inputs.files) ? Inputs.files.slice() : [];\nOutputs.doneKey = coach ? 'messages.sentCoach' : 'messages.sentLearner';\nif (coach) Outputs.goCoach(); else Outputs.goLearner();"
      },
      "ports": [
