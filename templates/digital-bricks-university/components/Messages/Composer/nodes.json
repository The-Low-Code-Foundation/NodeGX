    {
      "id": "co_check",
      "type": "JavaScriptFunction",
      "label": "Anything to send?",
      "x": 520,
      "y": 1000,
      "parameters": {
        "runOnChange-in-text": false,
        "runOnChange-in-hasFiles": false,
        "functionScript": "// Text, files, or both; never nothing. Files are uploaded first, then everything goes in one message.\nconst text = String(Inputs.text || '');\nconst withFiles = Inputs.hasFiles === true;\nif (!text.trim() && !withFiles) { Outputs.whyKey = 'messages.needText'; Outputs.refuse(); return; }\nOutputs.text = text;\nOutputs.withFiles = withFiles;\nif (withFiles) Outputs.upload(); else Outputs.send();"
      },
