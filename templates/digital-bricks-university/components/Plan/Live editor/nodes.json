    {
      "id": "le_open",
      "type": "JavaScriptFunction",
      "label": "Open the step: fill every field",
      "x": 500,
      "y": 280,
      "parameters": {
        "runOnChange-in-step": false,
        "runOnChange-in-times": false,
        "functionScript": "/*\n * Runs when the editor appears. A time is shown in the coach's zone (Europe/Paris), the\n * zone saveStep reads it back in, so what is typed is what is stored.\n */\nconst step = Inputs.step && typeof Inputs.step === 'object' ? Inputs.step : {};\nconst get = (m, k) => (m && typeof m.get === 'function' ? m.get(k) : m && m[k]);\nconst times = (Inputs.times || []).map((t) => get(t, 'value')).filter(Boolean);\nlet date = '';\nlet time = '';\nif (step.startsAt) {\n  const d = new Date(step.startsAt);\n  date = d.toLocaleDateString('en-CA', { timeZone: 'Europe/Paris' });\n  time = d.toLocaleTimeString('en-GB', { timeZone: 'Europe/Paris', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });\n}\nconst offered = time && !times.includes(time) ? times.concat([time]).sort() : times;\nOutputs.timeItems = offered.map((t) => ({ Label: t, Value: t }));\nOutputs.id = step.id || '';\nOutputs.title = step.title || '';\nOutputs.date = date;\nOutputs.time = time || '10:00';\nOutputs.duration = Number.isInteger(step.durationMin) ? String(step.durationMin) : '60';\nOutputs.meetingLink = step.meetingLink || '';\nOutputs.recordingUrl = step.recordingUrl || '';\nOutputs.summary = step.summary || '';\nOutputs.opened();\n"
      },
      "ports": [
        {
          "name": "in-step",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-times",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-timeItems",
          "plug": "output",
