    {
      "id": "le_gather",
      "type": "JavaScriptFunction",
      "label": "Gather the session from the fields",
      "x": 500,
      "y": 760,
      "parameters": {
        "runOnChange-in-id": false,
        "runOnChange-in-title": false,
        "runOnChange-in-date": false,
        "runOnChange-in-time": false,
        "runOnChange-in-duration": false,
        "runOnChange-in-meetingLink": false,
        "runOnChange-in-recordingUrl": false,
        "runOnChange-in-summary": false,
        "functionScript": "// Read on Save only. A date with no time takes 10:00; no date means 'to book'.\n// saveStep checks every field again and answers in a sentence.\nconst date = String(Inputs.date || '').trim();\nOutputs.id = String(Inputs.id || '');\nOutputs.title = String(Inputs.title || '').trim();\nOutputs.startsAt = date ? date + 'T' + (String(Inputs.time || '') || '10:00') : '';\nOutputs.durationMin = String(Inputs.duration || '').trim();\nOutputs.meetingLink = String(Inputs.meetingLink || '').trim();\nOutputs.recordingUrl = String(Inputs.recordingUrl || '').trim();\nOutputs.summary = String(Inputs.summary || '');\nOutputs.go();\n"
      },
