    {
      "id": "cie_open",
      "type": "JavaScriptFunction",
      "label": "Open the step",
      "x": 500,
      "y": 160,
      "parameters": {
        "runOnChange-in-step": false,
        "functionScript": "/*\n * Runs when the editor appears (DBU-10). The send day is shown in the coach's zone, Europe/Paris.\n * The form list is the option set's, in the coach's words (a step on a form no longer offered keeps\n * it, by its own title). A check-in goes out on a date, or N days after a live session or a homework\n * of this plan (anchors, from Plan in words). Once it has gone out (not scheduled), only the title\n * can change.\n */\nconst step = Inputs.step && typeof Inputs.step === 'object' ? Inputs.step : {};\nconst get = (m, k) => (m && typeof m.get === 'function' ? m.get(k) : m && m[k]);\nconst words = { 'plan.formAfterSession': Inputs.tAfterSession, 'plan.formEndOfProgramme': Inputs.tEndOfProgramme, 'plan.formSixWeek': Inputs.tSixWeek };\nconst formItems = (Inputs.forms || []).map((f) => ({ Label: words[get(f, 'labelKey')] || get(f, 'value'), Value: get(f, 'value') }));\nconst form = (step.form && step.form.id) || 'after-session';\nif (!formItems.some((f) => f.Value === form)) formItems.push({ Label: String((step.form && step.form.title) || form), Value: form });\nconst after = step.sendAfter && step.sendAfter.step ? step.sendAfter : null;\nOutputs.id = step.id || '';\nOutputs.title = step.title || '';\nOutputs.sends = step.sendsAt ? new Date(step.sendsAt).toLocaleDateString('en-CA', { timeZone: 'Europe/Paris' }) : '';\nOutputs.formItems = formItems;\nOutputs.form = form;\nOutputs.whenItems = [{ Label: Inputs.tWhenDate || 'date', Value: 'date' }, { Label: Inputs.tWhenAfter || 'after', Value: 'after' }];\nOutputs.when = after ? 'after' : 'date';\nOutputs.anchorItems = [{ Label: Inputs.tNoAnchor || '', Value: '' }].concat((Array.isArray(Inputs.anchors) ? Inputs.anchors : []).map((a) => ({ Label: a.label, Value: a.id })));\nOutputs.anchor = after ? after.step : '';\nOutputs.days = after ? String(after.days) : '1';\nOutputs.locked = !!step.status && step.status !== 'scheduled';\nOutputs.unlocked = !Outputs.locked;\nOutputs.opened();",
        "runOnChange-in-anchors": false,
        "runOnChange-in-forms": false
      },
      "ports": [
        {
          "name": "in-step",
          "plug": "input",
          "type": "object"
        },
