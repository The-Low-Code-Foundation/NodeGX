    {
      "id": "cie_gather",
      "type": "JavaScriptFunction",
      "label": "Gather the check-in",
      "x": 500,
      "y": 280,
      "parameters": {
        "runOnChange-in-id": false,
        "runOnChange-in-title": false,
        "runOnChange-in-sends": false,
        "functionScript": "// Read on Save only. On a date: saveStep sends a date-only day at 09:00 Paris, and an empty step\n// clears any \"after\" rule. After a step: saveStep works the day out from that step (DBU-10).\nconst after = Inputs.when === 'after';\nOutputs.id = String(Inputs.id || '');\nOutputs.title = String(Inputs.title || '').trim();\nOutputs.formId = String(Inputs.form || '');\nOutputs.sendsAt = after ? '' : String(Inputs.sends || '').trim();\nOutputs.sendAfterStep = after ? String(Inputs.anchor || '') : '';\nOutputs.sendAfterDays = after ? String(Inputs.days || '').trim() : '';\nOutputs.go();\n",
        "runOnChange-in-form": false,
        "runOnChange-in-when": false,
        "runOnChange-in-anchor": false,
        "runOnChange-in-days": false
      },
