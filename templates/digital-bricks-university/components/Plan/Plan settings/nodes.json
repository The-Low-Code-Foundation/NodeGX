    {
      "id": "ps_open",
      "type": "JavaScriptFunction",
      "label": "Open the plan: fill the fields",
      "x": 500,
      "y": 280,
      "parameters": {
        "runOnChange-in-plan": false,
        "runOnChange-in-statuses": false,
        "runOnChange-in-active": false,
        "runOnChange-in-paused": false,
        "runOnChange-in-finished": false,
        "functionScript": "// The status list is the option set, in its order, each in the reader's words.\nconst plan = Inputs.plan && typeof Inputs.plan === 'object' ? Inputs.plan : {};\nconst get = (m, k) => (m && typeof m.get === 'function' ? m.get(k) : m && m[k]);\nconst words = { 'plan.planActive': Inputs.active, 'plan.planPaused': Inputs.paused, 'plan.planFinished': Inputs.finished };\nOutputs.statusItems = (Inputs.statuses || []).map((s) => ({ Label: words[get(s, 'labelKey')] || get(s, 'value'), Value: get(s, 'value') }));\nOutputs.id = plan.id || '';\nOutputs.title = plan.title || '';\nOutputs.meetingLink = plan.meetingLink || '';\nOutputs.bookingLink = plan.bookingLink || '';\nOutputs.status = plan.status || 'active';\nOutputs.opened();\n"
      },
      "ports": [
        {
          "name": "in-plan",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-statuses",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-active",
