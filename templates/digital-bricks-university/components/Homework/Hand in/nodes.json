    },
    {
      "id": "hi_check",
      "type": "JavaScriptFunction",
      "label": "What is being handed in?",
      "parameters": {
        "runOnChange-in-tab": false,
        "runOnChange-in-hasFile": false,
        "runOnChange-in-url": false,
        "runOnChange-in-text": false,
        "functionScript": "// The open tab decides what is handed in. Files are uploaded first; a link or text goes straight to handIn.\nconst tab = String(Inputs.tab || 'file');\nconst refuse = (key) => { Outputs.whyKey = key; Outputs.refuse(); };\nif (tab === 'file') {\n  if (!Inputs.hasFile) return refuse('work.needFile');\n  Outputs.kind = 'file';\n  Outputs.upload();\n  return;\n}\nif (tab === 'link') {\n  const url = String(Inputs.url || '').trim();\n  if (!url) return refuse('work.needLink');\n  Outputs.kind = 'link';\n  Outputs.url = url;\n  Outputs.send();\n  return;\n}\nconst text = String(Inputs.text || '');\nif (!text.trim()) return refuse('work.needText');\nOutputs.kind = 'text';\nOutputs.text = text;\nOutputs.send();"
      },
      "ports": [
        {
          "name": "in-tab",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-ok",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-hasFile",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-url",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-text",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-kind",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-url",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-text",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-whyKey",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-upload",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "out-send",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "out-refuse",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 470,
      "y": 1960
    },
    {
      "id": "hi_upload",
      "type": "Upload File",
      "label": "Upload it privately",
      "parameters": {
        "private": true
      },
      "metadata": {
        "comment": "Private: the backend reads it to nobody but its uploader (files.read is nobody). One file per Upload: The files for this version feeds them in turn. Richard sees them through fileLinkAsCoach; handIn checks the caller uploaded each."
      },
      "x": 470,
      "y": 5080
    },
    {
      "id": "hi_send",
      "type": "JavaScriptFunction",
      "label": "What goes to handIn",
      "parameters": {
        "runOnChange-in-kind": false,
        "runOnChange-in-url": false,
        "runOnChange-in-text": false,
        "functionScript": "// Runs once every file is uploaded (a file version) or straight from the check (a link or text), and fires go in the same run.\nconst kind = String(Inputs.kind || '');\nOutputs.kind = kind;\nOutputs.files = kind === 'file' && Array.isArray(Inputs.files) ? Inputs.files.slice() : [];\nOutputs.url = kind === 'link' ? String(Inputs.url || '') : '';\nOutputs.text = kind === 'text' ? String(Inputs.text || '') : '';\nOutputs.go();",
        "runOnChange-in-files": false
      },
      "ports": [
        {
          "name": "in-kind",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-cloudFile",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-url",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-text",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-kind",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-file",
          "plug": "output",
          "type": "string"
        },
        {
