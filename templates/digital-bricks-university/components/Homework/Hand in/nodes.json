      "parameters": {
        "states": "file,link,text",
        "values": "showFile,showLink,showText,fileBg,fileFg,linkBg,linkFg,textBg,textFg",
        "type-showFile": "boolean",
        "type-showLink": "boolean",
        "type-showText": "boolean",
        "type-fileBg": "color",
        "type-fileFg": "color",
        "type-linkBg": "color",
        "type-linkFg": "color",
        "type-textBg": "color",
        "type-textFg": "color",
        "value-file-showFile": true,
        "value-file-showLink": false,
        "value-file-showText": false,
        "value-file-fileBg": "var(--accent)",
        "value-file-fileFg": "var(--accent-foreground)",
        "value-file-linkBg": "var(--surface)",
        "value-file-linkFg": "var(--foreground)",
        "value-file-textBg": "var(--surface)",
        "value-file-textFg": "var(--foreground)",
        "value-link-showFile": false,
        "value-link-showLink": true,
        "value-link-showText": false,
        "value-link-fileBg": "var(--surface)",
        "value-link-fileFg": "var(--foreground)",
        "value-link-linkBg": "var(--accent)",
        "value-link-linkFg": "var(--accent-foreground)",
        "value-link-textBg": "var(--surface)",
        "value-link-textFg": "var(--foreground)",
        "value-text-showFile": false,
        "value-text-showLink": false,
        "value-text-showText": true,
        "value-text-fileBg": "var(--surface)",
        "value-text-fileFg": "var(--foreground)",
        "value-text-linkBg": "var(--surface)",
        "value-text-linkFg": "var(--foreground)",
        "value-text-textBg": "var(--accent)",
        "value-text-textFg": "var(--accent-foreground)"
      },
      "metadata": {
        "comment": "The form's own state (a States node, not a Variable): which way of handing in is open, and the look of each tab. The open tab wears the accent, like the current top-bar tab."
      },
      "x": 470,
      "y": 400
    },
    {
