{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "75918281-b87c-51d5-8e91-9778f67d4b06",
  "version": 1,
  "nodes": [
    {
      "id": "ar_req",
      "type": "noodl.cloud.request",
      "label": "The coach archives or restores",
      "parameters": {
        "params": "id,archived",
        "allowNoAuth": false,
        "ptype-id": "string",
        "preq-id": true,
        "ptype-archived": "boolean",
        "preq-archived": true
      },
      "metadata": {
        "comment": "role:staff in nodegx.security.json."
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "ar_fn",
      "type": "JavaScriptFunction",
      "label": "Set the flag",
      "parameters": {
        "functionScript": "// Archiving only hides the item from the pickers (DBU-04). Steps hold their own copy\n// (SCOPE R4), so no learner's homework changes, and nothing is deleted.\n(async () => {\n  try {\n    const id = String(Inputs.id || '');\n    const found = id ? await Noodl.Records.query('LibraryItem', { objectId: { equalTo: id } }, { limit: 2, plain: true }) : [];\n    if (found.length !== 1) {\n      Outputs.refuse();\n      return;\n    }\n    const archived = Inputs.archived === true;\n    await Noodl.Records.save(id, { archived }, { className: 'LibraryItem' });\n    Outputs.archived = archived;\n    Outputs.done();\n  } catch (e) {\n    console.error('[dbu:archiveLibraryItem]', String((e && e.message) || e));\n    Outputs.failed();\n  }\n})();",
        "runOnChange-in-id": false,
        "runOnChange-in-archived": false
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-archived",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-archived",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "out-done",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "out-refuse",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "out-failed",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 40,
      "y": 160
    },
    {
      "id": "ar_res",
      "type": "noodl.cloud.response",
      "label": "Done",
      "parameters": {
        "params": "archived"
      },
      "x": 40,
      "y": 280
    },
    {
      "id": "ar_deny",
      "type": "noodl.cloud.response",
      "label": "No such item",
      "parameters": {
        "status": "failure",
        "errorMessage": "That homework is no longer in the library. Reload the page."
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "ar_fail",
      "type": "noodl.cloud.response",
      "label": "Something broke",
      "parameters": {
        "status": "failure",
        "errorMessage": "The homework could not be archived. Try again."
      },
      "x": 40,
      "y": 520
    }
  ]
}