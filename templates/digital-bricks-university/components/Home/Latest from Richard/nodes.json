    {
      "id": "lr_in-2",
      "type": "Component Inputs",
      "label": "The newest coach message",
      "x": 520,
      "y": 40,
      "ports": [
        {
          "name": "latest",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "me",
          "plug": "output",
          "type": "*"
        }
      ]
    },
    {
      "id": "lr_fn",
      "type": "JavaScriptFunction",
      "label": "The message, in values",
      "x": 520,
      "y": 160,
      "parameters": {
        "functionScript": "// learnerHome's `latest` (null when Richard has written nothing yet) and `me` (for the time zone).\n// Long messages are cut: Messages has the rest.\nconst m = Inputs.latest || null;\nlet tz = String((Inputs.me && Inputs.me.timezone) || '');\ntry { new Date().toLocaleString('en-GB', { timeZone: tz || undefined }); } catch (e) { tz = ''; }\nconst zone = tz || Intl.DateTimeFormat().resolvedOptions().timeZone;\nconst d = m ? new Date(m.at) : null;\nOutputs.has = !!m;\nOutputs.none = !m;\nOutputs.when = d && !isNaN(d) ? d.toLocaleDateString('en-GB', { timeZone: zone, weekday: 'short', day: 'numeric', month: 'short' }) + ', ' +\n  d.toLocaleTimeString('en-GB', { timeZone: zone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }) : '';\nconst body = m ? String(m.body || '').trim() : '';\nOutputs.body = body.length > 280 ? body.slice(0, 277).trimEnd() + '…' : body;\nOutputs.hasBody = !!body;\nOutputs.isNew = !!(m && m.isNew);\nOutputs.tag = m ? String(m.stepTitle || '') : '';\nOutputs.hasTag = !!(m && m.stepTitle);"
      },
      "ports": [
        {
          "name": "in-latest",
          "displayName": "latest",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-timezone",
          "displayName": "timezone",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-has",
          "displayName": "has",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
