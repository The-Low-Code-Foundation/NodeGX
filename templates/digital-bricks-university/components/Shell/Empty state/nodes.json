      "parameters": {
        "sizeMode": "explicit",
        "width": {
          "value": 48,
          "unit": "px"
        },
        "height": {
          "value": 48,
          "unit": "px"
        },
        "borderRadius": "var(--radius-full)",
        "backgroundColor": "var(--accent)",
        "alignItems": "center",
        "justifyContent": "center"
      },
      "x": 100,
      "y": 320
    },
    {
      "id": "es_icon",
      "type": "net.noodl.visual.icon",
      "label": "Icon",
      "parent": "es_bubble",
