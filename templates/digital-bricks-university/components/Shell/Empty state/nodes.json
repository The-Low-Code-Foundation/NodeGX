    {
      "id": "es_t_title",
      "type": "Translation",
      "label": "What this is, in the reader's language",
      "x": 400,
      "y": 60,
      "parameters": {
        "Namespace": "pages"
      }
    },
    {
      "id": "es_t_body",
      "type": "Translation",
      "label": "What will appear, in the reader's language",
      "x": 400,
      "y": 160,
      "parameters": {
        "Namespace": "pages"
      }
    }
