        "iconSize": 22,
        "iconColor": "var(--accent-foreground)",
        "iconIconSource": {
          "class": "lucide",
          "code": "icon-inbox",
          "codeAsClass": true
        }
      },
      "x": 160,
      "y": 440
    },
    {
      "id": "es_title",
      "type": "Text",
      "label": "What this is",
      "parent": "es_card",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-lg)",
        "fontWeight": "var(--font-semibold)",
        "color": "var(--foreground)",
        "textAlignX": "center"
      },
      "x": 100,
      "y": 560
    },
    {
      "id": "es_body",
      "type": "Text",
      "label": "What will appear, and when",
      "parent": "es_card",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-sm)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--muted-foreground)",
        "textAlignX": "center",
        "maxWidth": {
          "value": 520,
          "unit": "px"
        }
      },
      "x": 100,
      "y": 680
    },
    {
      "id": "es_inputs",
      "type": "Component Inputs",
      "label": "Empty state in",
      "x": 40,
      "y": 40,
