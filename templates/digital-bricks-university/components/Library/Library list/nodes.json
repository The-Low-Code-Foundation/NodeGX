    {
      "id": "ll_shape",
      "type": "JavaScriptFunction",
      "label": "The rows to show, in words",
      "parameters": {
        "functionScript": "// Filters as the coach types: every word must be in the title or a tag. Archived items\n// show only when asked. The phrases come from Strings with {tags}; this fills them in.\nif (Inputs.items === undefined || Inputs.summary === undefined || Inputs.noTime === undefined) return;\nconst fill = (s, v) => Object.keys(v).reduce((out, k) => out.split('{' + k + '}').join(String(v[k])), String(s || ''));\nconst time = (m) => {\n  if (typeof m !== 'number' || m <= 0) return Inputs.noTime;\n  const h = Math.floor(m / 60);\n  const rest = m % 60;\n  if (!h) return fill(Inputs.minutes, { m: rest });\n  if (!rest) return fill(Inputs.hours, { h });\n  return fill(Inputs.hoursMinutes, { h, m: rest });\n};\nconst words = String(Inputs.query || '').toLowerCase().split(' ').filter(Boolean);\nconst all = Array.isArray(Inputs.items) ? Inputs.items : [];\nconst visible = all.filter((i) => Inputs.showArchived === true || !i.archived);\nconst shown = visible.filter((i) => {\n  const text = [i.title].concat(i.tags || []).join(' ').toLowerCase();\n  return words.every((w) => text.includes(w));\n});\nOutputs.rows = shown.map((i) => ({\n  id: i.id,\n  title: i.title,\n  meta: time(i.estimatedMinutes) + ' · ' + fill(Inputs.summary, { items: (i.handInChecklist || []).length, resources: (i.resources || []).length }),\n  tags: (i.tags || []).length ? i.tags.map((t, n) => ({ id: 'tag-' + i.id + '-' + n, label: t })) : null,\n  archived: i.archived === true\n}));\nOutputs.hasRows = shown.length > 0;\nOutputs.empty = visible.length === 0 && words.length === 0;\nOutputs.noMatch = shown.length === 0 && !(visible.length === 0 && words.length === 0);"
      },
      "ports": [
