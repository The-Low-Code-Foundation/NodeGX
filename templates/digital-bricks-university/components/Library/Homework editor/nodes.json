    {
      "id": "he_open",
      "type": "JavaScriptFunction",
      "label": "Open the item: fill the fields and the two lists",
      "parameters": {
        "functionScript": "/*\n * Runs each time the page opens the editor, for a new item ({}) or an existing one.\n * The two lists are named client-side Arrays; each row writes its own record as the coach\n * types (Library/Checklist row, Library/Resource row), and 'Gather the item' reads them back.\n * Fresh row ids every time, so nothing typed in a previous opening survives.\n */\nconst item = Inputs.item && typeof Inputs.item === 'object' ? Inputs.item : {};\nconst uid = (p) => p + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);\nNoodl.Arrays['library-draft-checklist'] = (item.handInChecklist || []).map((c) => ({ id: uid('chk-'), text: c.text || '', required: c.required !== false }));\nNoodl.Arrays['library-draft-resources'] = (item.resources || []).map((r) => ({\n  id: uid('res-'), label: r.label || '', url: r.url || '', file: r.file || '', fileName: r.fileName || '', isFile: !!r.file\n}));\nOutputs.id = item.id || '';\nOutputs.title = item.title || '';\nOutputs.brief = item.brief || '';\nOutputs.tags = (item.tags || []).join(', ');\nOutputs.minutes = typeof item.estimatedMinutes === 'number' ? String(item.estimatedMinutes) : '';\nOutputs.heading = item.id ? Inputs.editHeading : Inputs.newHeading;\nOutputs.opened();",
        "runOnChange-in-item": false,
        "runOnChange-in-newHeading": false,
        "runOnChange-in-editHeading": false
      },
      "ports": [
        {
          "name": "in-item",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-newHeading",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-editHeading",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-brief",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-tags",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-minutes",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-heading",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-opened",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 410,
      "y": 280
    },
    {
      "id": "he_gather",
      "type": "JavaScriptFunction",
      "label": "Gather the item from the fields and the two lists",
      "parameters": {
        "functionScript": "// Read on Save only. The server tidies and checks everything again (saveLibraryItem).\nconst get = (m, k) => (m && typeof m.get === 'function' ? m.get(k) : m && m[k]);\nOutputs.handInChecklist = (Noodl.Arrays['library-draft-checklist'] || []).map((m) => ({ text: String(get(m, 'text') || ''), required: get(m, 'required') !== false }));\nOutputs.resources = (Noodl.Arrays['library-draft-resources'] || []).map((m) => (get(m, 'isFile')\n  ? { label: String(get(m, 'label') || ''), file: String(get(m, 'file') || ''), fileName: String(get(m, 'fileName') || '') }\n  : { label: String(get(m, 'label') || ''), url: String(get(m, 'url') || '') }));\nOutputs.id = String(Inputs.id || '');\nOutputs.title = String(Inputs.title || '').trim();\nOutputs.brief = String(Inputs.brief || '');\nOutputs.minutes = String(Inputs.minutes || '').trim();\nOutputs.tags = String(Inputs.tags || '').split(',').map((t) => t.trim()).filter(Boolean);\nOutputs.go();",
        "runOnChange-in-id": false,
        "runOnChange-in-title": false,
        "runOnChange-in-brief": false,
        "runOnChange-in-minutes": false,
        "runOnChange-in-tags": false
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-title",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-brief",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-minutes",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-tags",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-brief",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-minutes",
          "plug": "output",
          "type": "string"
        },
        {
