    {
      "id": "re_add_link_fn",
      "type": "JavaScriptFunction",
      "label": "Add an empty link",
      "parameters": {
        "functionScript": "const id = String(Inputs.listId || '');\nif (!id) return;\nNoodl.Arrays[id] = (Noodl.Arrays[id] || []).concat([{ id: 'res-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7), label: '', url: '', file: '', fileName: '', isFile: false }]);",
        "runOnChange-in-listId": false
      },
      "ports": [
        {
          "name": "in-listId",
          "plug": "input",
          "type": "*"
        }
      ],
      "x": 410,
      "y": 1000
    },
    {
      "id": "re_add_file_fn",
      "type": "JavaScriptFunction",
      "label": "Add the uploaded file",
      "parameters": {
        "functionScript": "// The label starts as the file's own name without its extension; the coach can change it.\nconst id = String(Inputs.listId || '');\nconst f = Inputs.cloudFile;\nif (!id || !f) return;\nconst stored = typeof f.getName === 'function' ? f.getName() : String(f.name || '');\nconst original = String(Inputs.fileName || stored);\nconst dot = original.lastIndexOf('.');\nconst label = dot > 0 ? original.slice(0, dot) : original;\nNoodl.Arrays[id] = (Noodl.Arrays[id] || []).concat([{ id: 'res-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7), label, url: '', file: stored, fileName: original, isFile: true }]);",
        "runOnChange-in-listId": false,
        "runOnChange-in-cloudFile": false,
        "runOnChange-in-fileName": false
      },
      "ports": [
        {
          "name": "in-listId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-cloudFile",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-fileName",
          "plug": "input",
          "type": "*"
        }
      ],
      "x": 410,
      "y": 2200
    },
    {
      "id": "re_up_fn",
      "type": "JavaScriptFunction",
      "label": "Move the row up",
      "parameters": {
        "functionScript": "const id = String(Inputs.listId || '');\nconst list = (Noodl.Arrays[id] || []).slice();\nconst i = list.findIndex((m) => m.getId() === String(Inputs.itemId || ''));\nif (i < 1) return;\nconst moved = list.splice(i, 1)[0];\nlist.splice(i - 1, 0, moved);\nNoodl.Arrays[id] = list;",
        "runOnChange-in-listId": false,
        "runOnChange-in-itemId": false
      },
      "ports": [
        {
          "name": "in-listId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-itemId",
          "plug": "input",
          "type": "*"
        }
      ],
      "x": 410,
      "y": 640
    },
    {
      "id": "re_down_fn",
      "type": "JavaScriptFunction",
      "label": "Move the row down",
      "parameters": {
        "functionScript": "const id = String(Inputs.listId || '');\nconst list = (Noodl.Arrays[id] || []).slice();\nconst i = list.findIndex((m) => m.getId() === String(Inputs.itemId || ''));\nif (i < 0 || i >= list.length - 1) return;\nconst moved = list.splice(i, 1)[0];\nlist.splice(i + 1, 0, moved);\nNoodl.Arrays[id] = list;",
        "runOnChange-in-listId": false,
        "runOnChange-in-itemId": false
      },
      "ports": [
        {
          "name": "in-listId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-itemId",
          "plug": "input",
          "type": "*"
        }
      ],
      "x": 410,
      "y": 760
    },
    {
      "id": "re_remove_fn",
      "type": "JavaScriptFunction",
      "label": "Remove the row that asked",
      "parameters": {
        "functionScript": "const id = String(Inputs.listId || '');\nconst gone = String(Inputs.itemId || '');\nif (!id || !gone) return;\nNoodl.Arrays[id] = (Noodl.Arrays[id] || []).filter((m) => m.getId() !== gone);",
        "runOnChange-in-listId": false,
        "runOnChange-in-itemId": false
      },
      "ports": [
        {
          "name": "in-listId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-itemId",
          "plug": "input",
          "type": "*"
        }
      ],
      "x": 410,
      "y": 880
    },
    {
      "id": "re_why_fn",
      "type": "JavaScriptFunction",
      "label": "Why the upload failed, in a sentence",
      "parameters": {
        "functionScript": "Outputs.text = String(Inputs.format || '').split('{error}').join(String(Inputs.error || ''));",
        "runOnChange-in-format": false,
        "runOnChange-in-error": false
      },
      "ports": [
        {
          "name": "in-format",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-error",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-text",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 410,
      "y": 1840
