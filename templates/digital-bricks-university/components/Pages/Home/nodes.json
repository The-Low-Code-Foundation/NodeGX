      "x": 280,
      "y": 1720
    },
    {
      "id": "home_t_tab",
      "type": "Translation",
      "label": "The browser tab's title",
      "parameters": {
        "Namespace": "pages",
        "Key": "home.tab"
      },
      "x": 530,
      "y": 40
    },
    {
      "id": "home_read",
      "type": "CloudFunction2",
      "label": "learnerHome (only what is shared with me)",
      "parameters": {
        "function": "learnerHome"
      },
      "x": 530,
      "y": 280
    },
    {
      "id": "home_bell",
      "type": "SubscribeToChanges",
      "label": "My doorbell: Richard changed something I see",
      "parameters": {
        "collectionName": "Doorbell"
      },
      "metadata": {
        "comment": "The bell carries no content (PLATFORM.md 4): it only says read again. Its row ACL means only this learner's bells (and the coach's) arrive."
      },
      "x": 530,
      "y": 1120
    },
    {
      "id": "home_words",
      "type": "/Home/Home in words",
      "label": "Home, in keys and values",
      "x": 530,
      "y": 400
    },
    {
      "id": "home_t_plan",
      "type": "Translation",
      "label": "{plan} · 1:1 coaching with Richard · Week {week}",
      "parameters": {
        "Namespace": "pages",
        "Key": "home.planLine"
      },
      "x": 530,
      "y": 1240
    },
    {
      "id": "home_plan_fill",
      "type": "String Format",
      "label": "Plan and week into the line",
      "parameters": {
        "format": "{plan} {week}"
      },
      "metadata": {
        "comment": "The format arrives from the Translation; this default only declares the inputs."
      },
      "x": 530,
      "y": 520
    },
    {
      "id": "home_t_failed",
      "type": "Translation",
      "label": "Could not read",
      "parameters": {
        "Namespace": "pages",
        "Key": "home.failed"
      },
      "x": 530,
      "y": 880
    },
    {
      "id": "home_fail_sw",
      "type": "Switch",
      "label": "Remember the read failed",
      "parameters": {
        "onFromStart": false
      },
      "x": 530,
      "y": 1000
    },
    {
      "id": "home_latest",
      "type": "/Home/Latest from Richard",
      "label": "Latest from Richard",
      "parent": "home_side",
      "x": 280,
      "y": 1840
    },
    {
      "id": "home_ask",
      "type": "/Home/Ask Richard",
      "label": "Stuck between sessions? Ask Richard",
      "parent": "home_side",
      "x": 280,
      "y": 1960
    },
    {
      "id": "home_go",
      "type": "JavaScriptFunction",
      "label": "Only for someone signed in",
      "x": 380,
      "y": 200,
      "parameters": {
        "functionScript": "// Read the programme only for someone signed in. A signed-out visitor sees this page for a beat\n// before the gate (/App) sends them to Sign in, and a read then is refused.\nif (!Noodl.Users.Current) return;\nOutputs.go();"
      },
      "metadata": {
        "comment": "The page mounts a beat before the app's gate sends a signed-out visitor to Sign in; asking then is refused (403) and logged. Measured on the demo at nodegx.io."
      }
    }
