      "id": "si_redirect",
      "type": "JavaScriptFunction",
      "label": "Come back to this app",
      "x": 600,
      "y": 140,
      "parameters": {
        "functionScript": "// The link brings the person back to the start of this app, on whatever origin it is served\n// from. The backend sends NO mail for an origin missing from its redirect allow-list\n// (tools/setup-signin.mjs), which looks exactly like a mail that never came.\nif (typeof window !== 'undefined') Outputs.redirect = window.location.origin + '/';\n"
      },
      "ports": [
