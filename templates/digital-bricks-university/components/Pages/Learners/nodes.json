    {
      "id": "ln_shape",
      "type": "JavaScriptFunction",
      "label": "Roster rows, in words",
      "x": 700,
      "y": 160,
      "parameters": {
        "runOnChange-in-learners": false,
        "runOnChange-in-progress": false,
        "runOnChange-in-drafts": false,
        "runOnChange-in-noSteps": false,
        "functionScript": "// One row per learner, in the reader's words. The phrases come from Strings with {tags};\n// this fills them in, so the roster row only draws. The row's own id is prefixed (a row\n// is a Model named by its id for the whole app); `learnerId` is the account, for Open plan.\nconst fill = (s, v) => Object.keys(v).reduce((out, k) => out.split('{' + k + '}').join(String(v[k])), String(s || ''));\nconst learners = Array.isArray(Inputs.learners) ? Inputs.learners : [];\nOutputs.rows = learners.map((l) => {\n  const drafts = l.steps - l.shared;\n  const parts = [];\n  if (!l.steps) parts.push(Inputs.noSteps);\n  else parts.push(fill(Inputs.progress, { finished: l.finished, steps: l.steps }));\n  if (drafts > 0) parts.push(fill(Inputs.drafts, { drafts }));\n  // DBU-09: what they keep in My creations.\n  const made = Number(l.creations) || 0;\n  if (made > 0) parts.push(made === 1 ? Inputs.creationsOne : fill(Inputs.creations, { n: made }));\n  const unread = Number(l.unread) || 0;\n  return {\n    id: 'learner-' + l.id,\n    learnerId: l.id,\n    name: l.name,\n    detail: [l.organisation, l.email].filter(Boolean).join(' · '),\n    plan: l.planTitle,\n    progress: parts.join(' · '),\n    // DBU-07: messages from this learner the coach has not opened yet.\n    unread: unread > 0 ? fill(Inputs.unread, { n: unread }) : '',\n    hasUnread: unread > 0\n  };\n});\nOutputs.hasRows = learners.length > 0;\nOutputs.none = learners.length === 0;\n",
        "runOnChange-in-unread": false,
        "runOnChange-in-creations": false,
        "runOnChange-in-creationsOne": false
      },
