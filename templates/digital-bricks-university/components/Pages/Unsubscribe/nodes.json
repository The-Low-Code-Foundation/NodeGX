    {
      "id": "un_check",
      "type": "JavaScriptFunction",
      "label": "Is the link whole, and is it done?",
      "x": 600,
      "y": 140,
      "parameters": {
        "runOnChange-in-u": true,
        "runOnChange-in-s": true,
        "runOnChange-in-done": true,
        "functionScript": "// A link cut short by a mail client has no id or no signature: say so, and offer nothing to press.\n// Once done, the button and its explanation go, and only Done stays.\nconst whole = !!String(Inputs.u || '').trim() && !!String(Inputs.s || '').trim();\nOutputs.ask = whole && Inputs.done !== true;\nOutputs.broken = !whole;\n"
      },
      "ports": [
        {
          "name": "in-u",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-s",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-done",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-ask",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-broken",
          "plug": "output",
          "type": "boolean"
        }
      ]
    },
