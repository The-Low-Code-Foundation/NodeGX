    {
      "id": "ib_narrow",
      "type": "Javascript2",
      "label": "Narrow screen? (list and item on separate screens)",
      "x": 820,
      "y": 520,
      "parameters": {
        "code": "/*\n * Below 860px the list and the open item do not fit side by side (320px + 420px + the gaps), so the\n * inbox shows one at a time: the list, or the item with Back (DBU-08: \"on a phone, a separate screen\").\n */\nScript.Outputs = { narrow: 'boolean' };\nconst check = () => {\n  const narrow = typeof window !== 'undefined' && window.innerWidth < 860;\n  if (Script.Outputs.narrow !== narrow) Script.Outputs.narrow = narrow;\n};\nScript.OnInit = function () {\n  check();\n  if (typeof window !== 'undefined') window.addEventListener('resize', check);\n};\nScript.OnDestroy = function () {\n  if (typeof window !== 'undefined') window.removeEventListener('resize', check);\n};\n"
      }
