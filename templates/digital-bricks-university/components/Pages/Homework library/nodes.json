    {
      "id": "hl_arch_fn",
      "type": "JavaScriptFunction",
      "label": "Archive or restore: whichever it is not",
      "parameters": {
        "functionScript": "const items = Array.isArray(Inputs.items) ? Inputs.items : [];\nconst item = items.find((i) => i.id === Inputs.itemId);\nif (!item) return;\nconst archived = item.archived !== true;\nOutputs.id = item.id;\nOutputs.archived = archived;\nOutputs.say = String(archived ? Inputs.archivedSaid : Inputs.restoredSaid || '').split('{title}').join(item.title);\nOutputs.go();",
        "runOnChange-in-items": false,
        "runOnChange-in-itemId": false,
        "runOnChange-in-archivedSaid": false,
        "runOnChange-in-restoredSaid": false
      },
      "ports": [
        {
          "name": "in-items",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-itemId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-archivedSaid",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-restoredSaid",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-archived",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "out-say",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 530,
      "y": 1120
    },
