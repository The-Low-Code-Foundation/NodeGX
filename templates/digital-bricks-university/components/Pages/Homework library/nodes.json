    {
      "id": "hl_new_fn",
      "type": "JavaScriptFunction",
      "label": "A new, empty item",
      "parameters": {
        "functionScript": "Outputs.item = {};\nOutputs.open();"
      },
      "ports": [
        {
          "name": "out-item",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "out-open",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 530,
      "y": 1600
    },
    {
      "id": "hl_pick_fn",
      "type": "JavaScriptFunction",
      "label": "The item the row asked to edit",
      "parameters": {
        "functionScript": "const items = Array.isArray(Inputs.items) ? Inputs.items : [];\nconst item = items.find((i) => i.id === Inputs.itemId);\nif (!item) return;\nOutputs.item = JSON.parse(JSON.stringify(item));\nOutputs.open();",
        "runOnChange-in-items": false,
        "runOnChange-in-itemId": false
      },
      "ports": [
        {
          "name": "in-items",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-itemId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-item",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "out-open",
          "plug": "output",
          "type": "signal"
        }
      ],
      "x": 530,
      "y": 1720
    },
    {
      "id": "hl_dup_fn",
      "type": "JavaScriptFunction",
      "label": "Duplicate: the copy's title",
      "parameters": {
        "functionScript": "const items = Array.isArray(Inputs.items) ? Inputs.items : [];\nconst item = items.find((i) => i.id === Inputs.itemId);\nif (!item) return;\nconst title = String(Inputs.copyTitle || '{title}').split('{title}').join(item.title);\nOutputs.id = item.id;\nOutputs.title = title;\nOutputs.say = String(Inputs.said || '').split('{title}').join(title);\nOutputs.go();",
        "runOnChange-in-items": false,
        "runOnChange-in-itemId": false,
        "runOnChange-in-copyTitle": false,
        "runOnChange-in-said": false
      },
      "ports": [
        {
          "name": "in-items",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-itemId",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-copyTitle",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "in-said",
          "plug": "input",
          "type": "*"
        },
        {
          "name": "out-id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-title",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-say",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "out-go",
          "plug": "output",
          "type": "signal"
        }
