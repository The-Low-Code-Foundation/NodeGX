[Unit]
Description=Move last night's Digital Bricks Training backup off this box (encrypted)
After=dbtraining-backend.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/dbtraining/backup.env
ExecStart=/opt/dbtraining/ops/offsite-backup.sh
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/dbtraining
