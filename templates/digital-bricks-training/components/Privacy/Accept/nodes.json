      }
    },
    {
      "id": "pa_call",
      "type": "CloudFunction2",
      "label": "acceptPrivacy",
      "x": 700,
      "y": 640,
      "parameters": {
        "function": "acceptPrivacy"
      }
    },
    {
      "id": "pa_saving_sw",
      "type": "Switch",
      "label": "Saving, until it answers",
      "x": 700,
      "y": 560,
      "parameters": {
        "onFromStart": false
      }
    },
    {
      "id": "pa_fail_sw",
      "type": "Switch",
      "label": "Remember it failed",
      "x": 700,
      "y": 720,
      "parameters": {
        "onFromStart": false
      }
    },
    {
      "id": "pa_label",
      "type": "JavaScriptFunction",
      "label": "Say it is saving while it saves",
      "x": 1000,
      "y": 560,
      "parameters": {
        "functionScript": "// While the call is out the button says so, and pressing it again does nothing\n// new: the same version would be written twice, which is harmless, but a person\n// pressing twice is asking whether the first press worked.\nOutputs.label = Inputs.saving ? Inputs.savingText : Inputs.confirmText;\nOutputs.enabled = !Inputs.saving;\n"
      },
      "ports": [
        {
          "name": "in-saving",
          "plug": "input",
          "type": "*",
          "displayName": "saving",
          "group": "Inputs"
        },
        {
          "name": "in-confirmText",
          "plug": "input",
          "type": "*",
          "displayName": "confirmText",
          "group": "Inputs"
        },
        {
          "name": "in-savingText",
          "plug": "input",
          "type": "*",
          "displayName": "savingText",
          "group": "Inputs"
        },
        {
          "name": "out-label",
          "plug": "output",
          "type": "*",
          "displayName": "label",
          "group": "Outputs"
        },
        {
          "name": "out-enabled",
          "plug": "output",
          "type": "*",
          "displayName": "enabled",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "pa_reload",
      "type": "JavaScriptFunction",
      "label": "Reload the page they asked for",
      "x": 1000,
      "y": 640,
      "parameters": {
        "functionScript": "/*\n * ACCEPTED: RELOAD THE ADDRESS THEY ASKED FOR (the product's L53). The gate\n * never redirected, so the URL is still theirs; a reload re-reads the account\n * with its new version and the page renders in place of this screen. One\n * success behaviour, wherever the screen was shown.\n */\nif (typeof window !== 'undefined') window.location.reload();\n"
      },
      "ports": []
    },
    {
      "id": "pa_to_privacy",
      "type": "RouterNavigate",
      "label": "→ Privacy",
      "x": 700,
      "y": 480,
      "parameters": {
        "router": "Main",
        "target": "/Pages/Privacy"
      }
    },
