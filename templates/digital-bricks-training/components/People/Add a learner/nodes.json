    {
      "id": "al_call",
      "type": "CloudFunction2",
      "label": "addLearner — staff only",
      "x": 700,
      "y": 600,
      "parameters": {
        "function": "addLearner"
      }
    },
    {
      "id": "al_ok",
      "type": "JavaScriptFunction",
      "label": "Added, or already there",
      "x": 1000,
      "y": 600,
      "parameters": {
        "functionScript": "// TASK-L184: say which, because \"already there\" means nothing was changed —\n// a coach who mistyped a project name on a second press needs to know it was ignored.\nOutputs.text = Inputs.created ? Inputs.addedText : Inputs.alreadyText;\n",
        "runOnChange-in-created": false,
        "runOnChange-in-addedText": false,
        "runOnChange-in-alreadyText": false
      },
      "ports": [
        {
          "name": "in-created",
          "plug": "input",
          "type": "*",
          "displayName": "created",
          "group": "Inputs"
        },
        {
          "name": "in-addedText",
          "plug": "input",
          "type": "*",
          "displayName": "addedText",
          "group": "Inputs"
        },
        {
          "name": "in-alreadyText",
          "plug": "input",
          "type": "*",
          "displayName": "alreadyText",
          "group": "Inputs"
        },
        {
          "name": "out-text",
          "plug": "output",
          "type": "*",
          "displayName": "text",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "al_fail",
      "type": "JavaScriptFunction",
      "label": "The refusal, as the server worded it",
      "x": 1000,
      "y": 700,
      "parameters": {
        "functionScript": "// TASK-L184: every refusal from addLearner is already a sentence the coach can act on\n// (a malformed address, a coach's address, a blank project), so it is shown as written.\nOutputs.text = String(Inputs.error || '');\n",
        "runOnChange-in-error": false
      },
      "ports": [
        {
          "name": "in-error",
          "plug": "input",
          "type": "*",
          "displayName": "error",
          "group": "Inputs"
        },
        {
          "name": "out-text",
          "plug": "output",
          "type": "*",
          "displayName": "text",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "al_msg_sw",
      "type": "Switch",
      "label": "Show the sentence once there is one",
      "x": 700,
      "y": 680,
      "parameters": {
        "onFromStart": false
      }
    },
    {
      "id": "al_link_sw",
      "type": "Switch",
      "label": "Offer the link once they exist",
      "x": 700,
      "y": 760,
      "parameters": {
        "onFromStart": false
      }
    },
    {
      "id": "al_sent_sw",
      "type": "Switch",
      "label": "Say the link went",
      "x": 700,
      "y": 840,
      "parameters": {
        "onFromStart": false
      }
    },
    {
      "id": "al_norm",
      "type": "JavaScriptFunction",
      "label": "The address as the account holds it, and where the link lands",
      "x": 700,
      "y": 280,
      "parameters": {
        "functionScript": "// The account's username IS the address, trimmed and lower-cased (addLearner), so the\n// link is requested for exactly that. The link lands at the start of this app; the\n// backend refuses any destination not on its allow-list by sending nothing (L171).\nOutputs.email = String(Inputs.typed || '').trim().toLowerCase();\nif (typeof window !== 'undefined') Outputs.redirect = window.location.origin + '/';\n"
      },
      "ports": [
        {
          "name": "in-typed",
          "plug": "input",
          "type": "*",
          "displayName": "typed",
          "group": "Inputs"
        },
        {
          "name": "out-email",
          "plug": "output",
          "type": "*",
          "displayName": "email",
          "group": "Outputs"
        },
        {
          "name": "out-redirect",
          "plug": "output",
          "type": "*",
          "displayName": "redirect",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "al_link",
      "type": "net.noodl.user.RequestMagicLink",
      "label": "Ask the backend to email them a link",
      "x": 1000,
      "y": 760
    },
