    {
      "id": "tp_ask",
      "type": "JavaScriptFunction",
      "label": "Ask for the concepts once, when this arrives",
      "x": 700,
      "y": 40,
      "parameters": {
        "functionScript": "// Nothing is wired to this node's Run, so it runs once when the component mounts\n// (the template's Data/Roster ro_ask idiom). The concept list names nobody.\nOutputs.ask();\n"
      },
      "ports": [
        {
          "name": "out-ask",
          "plug": "output",
          "type": "signal"
        }
      ]
    },
    {
      "id": "tp_concepts",
      "type": "CloudFunction2",
      "label": "conceptList — staff only",
      "x": 1000,
      "y": 40,
      "parameters": {
        "function": "conceptList"
      }
    },
    {
      "id": "tp_seed",
      "type": "JavaScriptFunction",
      "label": "Start the draft from their current path",
      "x": 700,
      "y": 200,
      "parameters": {
        "functionScript": "/*\n * THE DRAFT STARTS AS THEIR CURRENT PATH (TASK-L184 §3). `entries` are the coach's\n * timeline for this learner; its lesson entries ARE their live path, in `position`\n * order. It is re-seeded whenever the programme is read — on arrival and after a save,\n * which is exactly when the draft should equal what is stored.\n */\nfunction plain(x) { if (x && typeof x === 'object' && x.data) return x.data; if (x && Array.isArray(x.items)) return x.items; return x; }\nconst entries = plain(Inputs.entries);\nif (Array.isArray(entries)) {\n  const lessons = entries.map(plain).filter((e) => e && e.kind === 'lesson' && e.conceptId).sort((a, b) => (a.position || 0) - (b.position || 0));\n  Noodl.Variables.dbtPathDraft = lessons.map((e) => e.conceptId);\n  Noodl.Variables.dbtPathTitles = Object.fromEntries(lessons.map((e) => [e.conceptId, e.title || e.conceptId]));\n  Outputs.hasPath = lessons.length > 0;\n}\n"
      },
      "ports": [
        {
          "name": "in-entries",
          "plug": "input",
          "type": "*",
          "displayName": "entries",
          "group": "Inputs"
        },
        {
          "name": "out-hasPath",
          "plug": "output",
          "type": "*",
          "displayName": "hasPath",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "tp_draft",
      "type": "Variable2",
      "label": "The draft path — concept ids in order",
      "x": 700,
      "y": 360,
      "parameters": {
        "name": "dbtPathDraft"
      }
    },
    {
      "id": "tp_rows",
      "type": "JavaScriptFunction",
      "label": "The two lists, from the draft",
      "x": 1000,
      "y": 360,
      "parameters": {
        "functionScript": "/*\n * THE TWO LISTS (TASK-L184 §3): what is on the path, in order, with what each can\n * do; and every other concept in the course, to add. A concept the course no longer\n * lists keeps its stored title rather than vanishing from a path somebody chose.\n */\nfunction plain(x) { if (x && typeof x === 'object' && x.data) return x.data; if (x && Array.isArray(x.items)) return x.items; return x; }\nconst draft = (plain(Inputs.draft) || []).map(String);\nconst concepts = (plain(Inputs.concepts) || []).map(plain).filter(Boolean);\nconst stored = Noodl.Variables.dbtPathTitles || {};\nconst titleOf = Object.fromEntries(concepts.map((c) => [String(c.conceptId), String(c.title)]));\nOutputs.chosen = draft.map((id, i) => ({\n  id, title: titleOf[id] || stored[id] || id, number: String(i + 1),\n  canUp: i > 0, canDown: i < draft.length - 1,\n  upLabel: Inputs.upLabel, downLabel: Inputs.downLabel, removeLabel: Inputs.removeLabel\n}));\nOutputs.available = concepts.filter((c) => draft.indexOf(String(c.conceptId)) === -1).map((c) => ({ id: String(c.conceptId), title: String(c.title), addLabel: Inputs.addLabel }));\nOutputs.noneChosen = draft.length === 0;\nOutputs.conceptIds = draft;\n"
      },
      "ports": [
        {
          "name": "in-draft",
          "plug": "input",
          "type": "*",
          "displayName": "draft",
          "group": "Inputs"
        },
        {
          "name": "in-concepts",
          "plug": "input",
          "type": "*",
          "displayName": "concepts",
          "group": "Inputs"
        },
        {
          "name": "in-upLabel",
          "plug": "input",
          "type": "*",
          "displayName": "upLabel",
          "group": "Inputs"
        },
        {
          "name": "in-downLabel",
          "plug": "input",
          "type": "*",
          "displayName": "downLabel",
          "group": "Inputs"
        },
        {
          "name": "in-removeLabel",
          "plug": "input",
          "type": "*",
          "displayName": "removeLabel",
          "group": "Inputs"
        },
        {
          "name": "in-addLabel",
          "plug": "input",
          "type": "*",
          "displayName": "addLabel",
          "group": "Inputs"
        },
        {
          "name": "out-chosen",
          "plug": "output",
          "type": "*",
          "displayName": "chosen",
          "group": "Outputs"
        },
        {
          "name": "out-available",
          "plug": "output",
          "type": "*",
          "displayName": "available",
          "group": "Outputs"
        },
        {
          "name": "out-noneChosen",
          "plug": "output",
          "type": "*",
          "displayName": "noneChosen",
          "group": "Outputs"
        },
        {
          "name": "out-conceptIds",
          "plug": "output",
          "type": "*",
          "displayName": "conceptIds",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "tp_up",
      "type": "JavaScriptFunction",
      "label": "Move a step up",
      "x": 1300,
      "y": 600,
      "parameters": {
        "functionScript": "const d = (Noodl.Variables.dbtPathDraft || []).slice();\nconst i = d.indexOf(String(Inputs.id));\nif (i > 0) { [d[i - 1], d[i]] = [d[i], d[i - 1]]; Noodl.Variables.dbtPathDraft = d; }\n",
        "runOnChange-in-id": false
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*",
          "displayName": "id",
          "group": "Inputs"
        }
      ]
    },
    {
      "id": "tp_down",
      "type": "JavaScriptFunction",
      "label": "Move a step down",
      "x": 1300,
      "y": 680,
      "parameters": {
        "functionScript": "const d = (Noodl.Variables.dbtPathDraft || []).slice();\nconst i = d.indexOf(String(Inputs.id));\nif (i > -1 && i < d.length - 1) { [d[i + 1], d[i]] = [d[i], d[i + 1]]; Noodl.Variables.dbtPathDraft = d; }\n",
        "runOnChange-in-id": false
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*",
          "displayName": "id",
          "group": "Inputs"
        }
      ]
    },
    {
      "id": "tp_remove",
      "type": "JavaScriptFunction",
      "label": "Take a step off",
      "x": 1300,
      "y": 760,
      "parameters": {
        "functionScript": "const id = String(Inputs.id);\nNoodl.Variables.dbtPathDraft = (Noodl.Variables.dbtPathDraft || []).filter((x) => x !== id);\n",
        "runOnChange-in-id": false
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*",
          "displayName": "id",
          "group": "Inputs"
        }
      ]
    },
    {
      "id": "tp_add",
      "type": "JavaScriptFunction",
      "label": "Put a concept at the end",
      "x": 1300,
      "y": 1240,
      "parameters": {
        "functionScript": "const id = String(Inputs.id);\nconst d = (Noodl.Variables.dbtPathDraft || []).slice();\nif (id && d.indexOf(id) === -1) { d.push(id); Noodl.Variables.dbtPathDraft = d; }\n",
        "runOnChange-in-id": false
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*",
          "displayName": "id",
          "group": "Inputs"
        }
      ]
    },
    {
      "id": "tp_avail_sw",
      "type": "Switch",
