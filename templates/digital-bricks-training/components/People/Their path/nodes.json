      "x": 1000,
      "y": 1160,
      "parameters": {
        "functionScript": "// setLearnerPath words every refusal for the coach (an unknown concept by name, an\n// empty path, a concept twice), so it is shown as written.\nOutputs.text = String(Inputs.error || '');\n",
        "runOnChange-in-error": false
      },
      "ports": [
        {
          "name": "in-error",
          "plug": "input",
          "type": "*",
