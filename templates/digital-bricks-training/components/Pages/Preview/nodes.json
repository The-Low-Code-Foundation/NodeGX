    {
      "id": "lp_say",
      "type": "JavaScriptFunction",
      "label": "What the band and the empty state say",
      "x": 1200,
      "y": 40,
      "parameters": {
        "functionScript": "/*\n * WHAT A PREVIEW SAYS ABOUT ITSELF (TASK-L190 §2). The page is the learner's\n * lesson page with every write taken out, so the one thing it must add is which\n * lesson this is: a DRAFT nobody else can see, or the published lesson they see,\n * and whose. Every word comes from the copy (lesson.preview), never a literal.\n */\nconst p = (Inputs.copy && Inputs.copy.lesson && Inputs.copy.lesson.preview) || null;\nif (!p) return;\nconst fill = (s, o) => String(s || '').replace(/{{(\\w+)}}/g, (_, k) => (o[k] === undefined ? '' : String(o[k])));\nconst state = Inputs.which === 'published' ? p.published : Inputs.live === true ? p.draftLive : p.draft;\nOutputs.band = fill(p.whose, { name: Inputs.name || '', step: Inputs.conceptTitle || '' }) + ' · ' + state;\nOutputs.noneEyebrow = p.eyebrow;\nOutputs.noneTitle = p.noneTitle;\nOutputs.noneBody = p.noneBody;\nOutputs.eyebrow = p.eyebrow;\nOutputs.tab = p.pageTitle;\n"
      },
      "ports": [
        {
          "name": "in-copy",
          "displayName": "copy",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-which",
          "displayName": "which",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-live",
          "displayName": "live",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-name",
          "displayName": "name",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-conceptTitle",
          "displayName": "conceptTitle",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-band",
          "displayName": "band",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-noneEyebrow",
          "displayName": "noneEyebrow",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-noneTitle",
          "displayName": "noneTitle",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-noneBody",
          "displayName": "noneBody",
          "plug": "output",
