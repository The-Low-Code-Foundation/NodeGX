    {
      "id": "pl_all",
      "type": "JavaScriptFunction",
      "label": "Every section, flat, plus the one kind the fixture lacks",
      "x": 800,
      "y": 400,
      "parameters": {
        "functionScript": "function plain(x) {\n  if (x === null || x === undefined) return x;\n  if (Array.isArray(x)) return x.map(plain);\n  if (typeof x === 'object') {\n    if (typeof x.get === 'function' && x.data && typeof x.data === 'object') return plain(x.data);\n    if (Array.isArray(x.items)) return plain(x.items);\n    const out = {};\n    for (const k of Object.keys(x)) out[k] = plain(x[k]);\n    return out;\n  }\n  return x;\n}\nconst sections = plain(Inputs.sections) || [];\nif (!sections.length) return;\nconst extra = {\n  id: 'pal-artifact',\n  kind: 'artifact_challenge',\n  title: 'Bring back one cleaned row',\n  brief: 'Take one real row from intake.csv, run it through your sanitiser, and paste what came out beside what went in.',\n  rubric: ['The row you chose is one a colleague actually sent', 'Every rule you wrote is visible in the difference', 'You can say which rule you are least sure about'],\n  acceptedFormats: ['text', 'markdown']\n};\nOutputs.rows = sections.concat([extra]).map((s) => ({ id: s.id, section: s }));\n"
      },
      "metadata": {
        "comment": "The fixture carries 18 of the 19 kinds; an artifact_challenge is added here so the page shows all of them."
      },
      "ports": [
        {
          "name": "in-sections",
          "displayName": "sections",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-rows",
          "displayName": "rows",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    }
  ],
