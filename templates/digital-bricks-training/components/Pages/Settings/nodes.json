    {
      "id": "st_save",
      "type": "JavaScriptFunction",
      "label": "Hand the document to the browser as a file",
      "x": 1100,
      "y": 1260,
      "parameters": {
        "functionScript": "/*\n * HAND THE EXPORT TO THE BROWSER AS A FILE (TASK-L185 §3). The document is the\n * whole answer from exportMine; nothing here filters it, so what the person\n * saves is exactly what the server said it holds. The name carries the date,\n * so two downloads a week apart do not overwrite each other.\n */\nconst doc = Inputs.document;\nif (doc && typeof doc === 'object' && typeof document !== 'undefined') {\n  const text = JSON.stringify(doc, null, 2);\n  const url = URL.createObjectURL(new Blob([text], { type: 'application/json' }));\n  const a = document.createElement('a');\n  a.href = url;\n  a.download = 'digital-bricks-training-my-data-' + new Date().toISOString().slice(0, 10) + '.json';\n  document.body.appendChild(a);\n  a.click();\n  a.remove();\n  setTimeout(() => URL.revokeObjectURL(url), 1000);\n}\n"
      },
      "ports": [
        {
          "name": "in-document",
          "plug": "input",
          "type": "*",
          "displayName": "document",
          "group": "Inputs"
        }
      ]
    },
    {
      "id": "st_ready",
      "type": "JavaScriptFunction",
      "label": "Only when they typed the word",
      "x": 800,
      "y": 1760,
      "parameters": {
        "functionScript": "/*\n * THE DELETE BUTTON WAKES ONLY FOR THE WORD (TASK-L185 §4). Exact, after\n * trimming spaces: a near miss leaves it asleep rather than guessing. The\n * server checks the same word again, so this is the courtesy and not the guard.\n */\nconst typed = String(Inputs.typed || '').trim();\nconst word = String(Inputs.word || '');\nOutputs.ready = word !== '' && typed === word;\nOutputs.confirm = typed;\n"
      },
      "ports": [
        {
          "name": "in-typed",
          "plug": "input",
          "type": "*",
          "displayName": "typed",
          "group": "Inputs"
        },
        {
          "name": "in-word",
          "plug": "input",
          "type": "*",
          "displayName": "word",
          "group": "Inputs"
        },
        {
          "name": "out-ready",
          "plug": "output",
          "type": "*",
          "displayName": "ready",
          "group": "Outputs"
        },
        {
          "name": "out-confirm",
          "plug": "output",
          "type": "*",
          "displayName": "confirm",
          "group": "Outputs"
        }
      ]
    },
