    {
      "id": "seo_st_page",
      "type": "JavaScriptFunction",
      "label": "Set the browser tab",
      "x": 1800,
      "y": 2200,
      "parameters": {
        "functionScript": "// The page title is the browser TAB. `Page.title` is read off the node's PARAMETERS at\n// export time, and a connection to the port is silently ignored (TASK-L161 §1), so the\n// parameter is the build-time fallback and the translated value overrides it here.\nconst t = Inputs.title;\nif (typeof t === 'string' && t !== '' && typeof Noodl !== 'undefined' && Noodl.SEO) {\n  Noodl.SEO.setTitle(t);\n}\n"
      },
      "ports": [
        {
          "name": "in-title",
          "plug": "input",
          "type": "*",
          "displayName": "title",
          "group": "Inputs"
        }
      ]
    },
    {
      "id": "st_gone",
      "type": "JavaScriptFunction",
      "label": "Forget the session here, then Home, saying it is done",
      "x": 1400,
      "y": 1840,
      "parameters": {
        "functionScript": "/*\n * THE ACCOUNT IS GONE: FORGET IT HERE TOO, THEN SAY SO ON HOME (TASK-L185 §4).\n *\n * deleteMine removed the account's sessions on the server, so the ordinary\n * Log Out node FAILS here (measured: \"Invalid session token\") and leaves the\n * stored session in the browser. Home then still believes somebody is signed\n * in, the notice gate holds it, and the person who just deleted their account\n * is shown the acceptance screen instead of the sentence saying it is done.\n *\n * So: ask to log out and ignore the answer, remove the stored session\n * ourselves, and load Home FRESH, so nothing in memory survives either. Every\n * key this removes is the browser's own copy of an account that no longer\n * exists anywhere.\n */\n(async () => {\n  try { if (Noodl.Users && Noodl.Users.Current) await Noodl.Users.Current.logOut(); } catch (e) { /* the server already ended it */ }\n  try {\n    for (const k of Object.keys(localStorage)) if (/\\/currentUser$/.test(k)) localStorage.removeItem(k);\n  } catch (e) { /* storage blocked: the fresh load below still drops the in-memory copy */ }\n  const hash = location.hash || '';\n  if (hash.indexOf('#/') === 0) location.replace(location.pathname + '#/home?deleted=1');\n  else location.replace('/home?deleted=1');\n})();\n"
      }
    },
