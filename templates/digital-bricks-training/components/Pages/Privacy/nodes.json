      }
    },
    {
      "id": "pv_lede",
      "type": "Text",
      "label": "What this is",
      "x": 40,
      "y": 700,
      "parent": "pv_shell",
      "parameters": {
        "as": "p",
        "fontSize": "var(--text-lg)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--muted-foreground)",
