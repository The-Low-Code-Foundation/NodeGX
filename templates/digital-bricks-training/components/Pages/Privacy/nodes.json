      "x": 40,
      "y": 800,
      "parent": "pv_shell",
      "children": [
        "pv_each"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "rowGap": "var(--space-8)",
        "paddingTop": "var(--space-4)"
      }
