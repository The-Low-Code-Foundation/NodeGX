    },
    {
      "id": "pv_title",
      "type": "Text",
      "label": "Headline",
      "x": 40,
      "y": 500,
      "parent": "pv_shell",
      "parameters": {
        "as": "h1",
        "fontFamily": "var(--font-display)",
