    {
      "id": "pv_each",
      "type": "For Each",
      "label": "One per section",
      "x": 40,
      "y": 900,
      "parent": "pv_list",
      "parameters": {
        "templateType": "explicit",
        "template": "/Privacy/Section"
      }
    },
    {
      "id": "pv_back",
      "type": "net.noodl.controls.button",
      "label": "Back",
      "x": 40,
      "y": 1000,
      "parent": "pv_shell",
      "parameters": {
        "sizeMode": "contentSize",
        "cssClassName": "btn pressable",
        "backgroundColor": "var(--surface-raised)",
        "color": "var(--foreground)"
      }
    },
    {
      "id": "pv_home",
      "type": "RouterNavigate",
      "label": "→ Home",
      "x": 700,
      "y": 1000,
      "parameters": {
        "router": "Main",
        "target": "/Pages/Home"
      }
    },
    {
      "id": "pv_lang_var",
      "type": "Variable",
      "label": "language — from App's one owner",
      "x": 700,
      "y": 40,
      "parameters": {
        "name": "language"
      }
    },
    {
      "id": "pv_strings",
      "type": "/Data/Strings",
      "label": "Every word on screen",
      "x": 700,
      "y": 160,
      "parameters": {
        "audience": "learner"
      }
    },
    {
      "id": "pv_sections",
      "type": "JavaScriptFunction",
      "label": "The notice's sections, as rows",
      "x": 700,
      "y": 300,
      "parameters": {
        "functionScript": "/*\n * THE NOTICE'S SECTIONS, AS ROWS (TASK-L185). They come from the generated\n * `privacy` namespace (privacy/notice.en.json, through tools/build-privacy.mjs),\n * so this page holds no word of the notice itself. A notice with no sections\n * renders none rather than a placeholder: an empty list is visible in review.\n */\nconst p = Inputs.privacy;\nif (p && Array.isArray(p.sections)) {\n  Outputs.items = p.sections.map((s) => ({ id: String(s.id), heading: String(s.heading || ''), body: String(s.body || '') }));\n}\n"
      },
      "ports": [
        {
          "name": "in-privacy",
          "plug": "input",
          "type": "*",
          "displayName": "privacy",
          "group": "Inputs"
        },
        {
          "name": "out-items",
          "plug": "output",
          "type": "*",
          "displayName": "items",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "t_pv_eyebrow",
      "type": "Translation",
      "label": "privacy:eyebrow",
      "x": 1000,
      "y": 400,
      "parameters": {
        "Key": "eyebrow",
        "Namespace": "privacy"
      }
    },
    {
      "id": "t_pv_title",
      "type": "Translation",
      "label": "privacy:title",
      "x": 1000,
      "y": 500,
      "parameters": {
        "Key": "title",
        "Namespace": "privacy"
      }
    },
    {
      "id": "t_pv_version",
      "type": "Translation",
      "label": "privacy:versionLine",
      "x": 1000,
      "y": 600,
      "parameters": {
        "Key": "versionLine",
        "Namespace": "privacy"
      }
    },
    {
      "id": "t_pv_lede",
      "type": "Translation",
      "label": "privacy:lede",
      "x": 1000,
      "y": 700,
      "parameters": {
        "Key": "lede",
        "Namespace": "privacy"
      }
    },
    {
      "id": "t_pv_back",
      "type": "Translation",
      "label": "privacy:settings.back",
      "x": 1000,
      "y": 1000,
      "parameters": {
        "Key": "settings.back",
        "Namespace": "privacy"
      }
    },
    {
      "id": "t_pv_page_title",
      "type": "Translation",
      "label": "privacy:pageTitle (the tab)",
      "x": 1000,
      "y": 1100,
      "parameters": {
        "Key": "pageTitle",
        "Namespace": "privacy"
      }
    },
    {
      "id": "seo_pv_page",
      "type": "JavaScriptFunction",
      "label": "Set the browser tab",
      "x": 1300,
      "y": 1100,
      "parameters": {
        "functionScript": "// The page title is the browser TAB. `Page.title` is read off the node's PARAMETERS at\n// export time, and a connection to the port is silently ignored (TASK-L161 §1), so the\n// parameter is the build-time fallback and the translated value overrides it here.\nconst t = Inputs.title;\nif (typeof t === 'string' && t !== '' && typeof Noodl !== 'undefined' && Noodl.SEO) {\n  Noodl.SEO.setTitle(t);\n}\n"
      },
      "ports": [
        {
          "name": "in-title",
          "plug": "input",
          "type": "*",
          "displayName": "title",
          "group": "Inputs"
        }
      ]
    }
  ],
  "visualRoots": [
    "pv_page"
  ]
}