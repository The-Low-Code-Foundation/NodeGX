        "letterSpacing": "var(--tracking-widest)",
        "textTransform": "uppercase",
        "color": "var(--thread-deep)"
      }
    },
    {
      "id": "si_title",
      "type": "Text",
      "label": "Headline",
      "x": 220,
      "y": 480,
      "parent": "si_shell",
      "parameters": {
        "as": "h1",
        "fontFamily": "var(--font-display)",
        "fontSize": "var(--text-4xl)",
        "fontWeight": 800,
        "lineHeight": "var(--leading-tight)",
        "color": "var(--foreground)"
      }
    },
    {
      "id": "si_lede",
      "type": "Text",
      "label": "What happens",
      "x": 220,
      "y": 560,
      "parent": "si_shell",
      "parameters": {
        "as": "p",
        "fontSize": "var(--text-lg)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--muted-foreground)"
      }
    },
    {
      "id": "si_email",
      "type": "net.noodl.controls.textinput",
      "label": "Email address",
      "x": 220,
      "y": 640,
      "parent": "si_shell",
      "parameters": {
        "type": "email",
        "useLabel": true,
        "labelfontSize": "var(--text-xs)",
        "labelfontWeight": "var(--font-bold)",
        "labeltextTransform": "uppercase",
        "labelcolor": "var(--muted-foreground)",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "backgroundColor": "var(--surface-raised)",
        "color": "var(--foreground)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border)",
        "borderRadius": "var(--radius-md)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)",
        "paddingLeft": "var(--space-3)",
        "paddingRight": "var(--space-3)"
      },
      "metadata": {
        "comment": "The control's own label, so the input is named for a screen reader rather than sitting beside a Text that nothing connects to it. Styled as the roster's search label is."
      }
    },
    {
      "id": "si_actions",
      "type": "Group",
      "label": "Actions",
      "x": 220,
      "y": 720,
      "parent": "si_shell",
      "parameters": {
        "sizeMode": "contentSize",
        "flexDirection": "row",
        "columnGap": "var(--space-3)"
      },
      "children": [
        "si_send",
        "si_back"
      ]
    },
    {
      "id": "si_send",
      "type": "net.noodl.controls.button",
      "label": "Email me a link",
      "x": 280,
      "y": 800,
      "parent": "si_actions",
      "parameters": {
        "sizeMode": "contentSize",
        "cssClassName": "btn btn-thread pressable",
        "backgroundColor": "var(--primary)",
        "color": "var(--primary-foreground)"
      }
    },
    {
      "id": "si_back",
      "type": "net.noodl.controls.button",
      "label": "Back to the start",
      "x": 280,
      "y": 880,
      "parent": "si_actions",
      "parameters": {
        "sizeMode": "contentSize",
        "cssClassName": "btn pressable",
        "backgroundColor": "var(--surface-raised)",
        "color": "var(--foreground)"
      }
    },
    {
      "id": "si_sent",
      "type": "Text",
      "label": "If that address has an account",
      "x": 220,
      "y": 960,
      "parent": "si_shell",
      "parameters": {
        "as": "p",
        "mounted": false,
        "fontSize": "var(--text-base)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--foreground)"
      },
      "metadata": {
        "comment": "THE SAME SENTENCE WHATEVER WAS TYPED (L122; the backend's own posture, oauth-routes.ts requestMagicLink). The request answers identically for a known and an unknown address, so a page that said 'no such account' would rebuild the oracle the backend removed. MOUNTED by a Switch, because `done` is a signal and a signal wired straight into `mounted` flashes once and vanishes (the auth-sign-in-without-a-password example)."
      }
    },
    {
      "id": "si_failed",
      "type": "Text",
      "label": "The request itself failed",
      "x": 220,
      "y": 1040,
      "parent": "si_shell",
      "parameters": {
        "as": "p",
        "mounted": false,
        "fontSize": "var(--text-base)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--foreground)"
      },
      "metadata": {
        "comment": "Failure means the REQUEST failed — no backend, a network error, a rate limit — never 'no such user' (Request Magic Link cannot know). No red: nothing the person did is wrong."
      }
    },
    {
      "id": "si_url",
      "type": "PageInputs",
      "label": "A door's prefill — ?email=",
      "x": 900,
      "y": 40,
      "parameters": {
        "queryParams": "email"
      },
      "metadata": {
        "comment": "Home's two doors pass the demo address of the person they are named after (TASK-L171 decision 8). A prefill decides nothing: whoever signs in is whoever owns the inbox, and staff is the backend's `staff` role alone."
      }
    },
    {
      "id": "si_redirect",
      "type": "JavaScriptFunction",
      "label": "Come back to this app",
      "x": 900,
      "y": 160,
      "parameters": {
        "functionScript": "/*\n * WHERE THE LINK BRINGS YOU BACK (TASK-L171 §2). The start of this app, on\n * whatever origin it is being served from. The backend refuses any destination\n * that is not on its redirect allow-list (tools/setup-signin.mjs puts this app's\n * origin there) — and it refuses by sending nothing, which looks exactly like a\n * mail that never came. Home then routes a signed-in person by their role.\n */\nif (typeof window !== 'undefined') Outputs.redirect = window.location.origin + '/';\n"
      },
      "ports": [
        {
          "name": "out-redirect",
          "displayName": "redirect",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "si_request",
      "type": "net.noodl.user.RequestMagicLink",
      "label": "Ask the backend to email a link",
      "x": 900,
      "y": 280,
      "metadata": {
        "comment": "Its `done` means the request was ACCEPTED, never that an account exists and never that anybody is signed in. The sign-in happens on a later page load, when the person presses the button on the page the link opens."
      }
    },
    {
      "id": "si_sent_sw",
      "type": "Switch",
      "label": "Remember the request was accepted",
      "x": 900,
      "y": 400,
      "parameters": {
        "onFromStart": false
      }
    },
    {
      "id": "si_fail_sw",
      "type": "Switch",
      "label": "Remember the request failed",
      "x": 900,
      "y": 520,
      "parameters": {
        "onFromStart": false
      }
    },
    {
      "id": "si_home",
      "type": "RouterNavigate",
      "label": "→ Home",
      "x": 900,
      "y": 640,
      "parameters": {
        "router": "Main",
        "target": "/Pages/Home"
      }
    },
