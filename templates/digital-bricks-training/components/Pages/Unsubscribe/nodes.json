      "parameters": {
        "functionScript": "// The tab title (TASK-L161 §1): Page.title is the build-time fallback; this overrides it.\nconst t = Inputs.title;\nif (typeof t === 'string' && t !== '' && typeof Noodl !== 'undefined' && Noodl.SEO) Noodl.SEO.setTitle(t);\n",
        "runOnChange-in-title": true
      },
