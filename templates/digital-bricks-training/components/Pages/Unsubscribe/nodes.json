    {
      "id": "un_view",
      "type": "JavaScriptFunction",
      "label": "What the page offers",
      "x": 960,
      "y": 40,
      "parameters": {
        "functionScript": "/*\n * TASK-L187 §5. The button is offered only for a link that LOOKS whole — an\n * account id and a 64-character signature — and only until it has been\n * pressed. Whether the signature is right is the server's question, and its\n * answer is the same either way, so this page cannot be used to test links.\n */\nconst u = String(Inputs.u || '');\nconst s = String(Inputs.s || '');\nconst whole = u.length > 0 && /^[0-9a-f]{64}$/i.test(s);\nconst done = Inputs.done === true;\nOutputs.showButton = whole && !done;\nOutputs.showNoLink = !whole;\n",
        "runOnChange-in-u": true,
        "runOnChange-in-s": true,
        "runOnChange-in-done": true
      },
      "ports": [
        {
          "name": "in-u",
          "plug": "input",
          "type": "*",
          "displayName": "u",
          "group": "Inputs"
        },
        {
          "name": "in-s",
          "plug": "input",
          "type": "*",
          "displayName": "s",
          "group": "Inputs"
        },
        {
          "name": "in-done",
          "plug": "input",
          "type": "*",
          "displayName": "done",
          "group": "Inputs"
        },
        {
          "name": "out-showButton",
          "plug": "output",
          "type": "*",
          "displayName": "showButton",
          "group": "Outputs"
        },
        {
          "name": "out-showNoLink",
