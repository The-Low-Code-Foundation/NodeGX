      "id": "cs_dos_close",
      "type": "JavaScriptFunction",
      "label": "Close it",
      "x": 2600,
      "y": 1900,
      "parameters": {
        "functionScript": "/* Escape, the overlay, Close — or the learner followed the one link out to\n   the lesson. Cleared either way: the Variable outlives the page, and a\n   reveal left set would reopen on the way back. */\nNoodl.Variables.dbtDossierOpen = '';\n"
      }
    },
    {
      "id": "cs_dos_pick",
      "type": "JavaScriptFunction",
      "label": "The open objective",
      "x": 2600,
      "y": 2100,
      "parameters": {
        "functionScript": "/* Which segment the reveal shows. Derived, never stored: the segment itself\n   comes from Logic/Dossier every time, so the reveal cannot show a stale copy\n   of an objective the meter has since redrawn. */\nfunction plain(x) {\n  if (x === null || x === undefined) return x;\n  if (Array.isArray(x)) return x.map(plain);\n  if (typeof x === 'object') {\n    if (typeof x.get === 'function' && x.data && typeof x.data === 'object') return plain(x.data);\n    if (Array.isArray(x.items)) return plain(x.items);\n    const out = {};\n    for (const k of Object.keys(x)) out[k] = plain(x[k]);\n    return out;\n  }\n  return x;\n}\nconst slug = String(Inputs.open || '');\nconst seg = slug ? (plain(Inputs.segments) || []).find((s) => s.slug === slug) : null;\nOutputs.segment = seg || null;\nOutputs.open = !!seg;\n"
      },
      "ports": [
        {
          "name": "in-open",
          "plug": "input",
          "type": "*",
          "displayName": "open",
          "group": "Inputs"
        },
        {
          "name": "in-segments",
          "plug": "input",
          "type": "*",
          "displayName": "segments",
          "group": "Inputs"
        },
        {
          "name": "out-open",
          "plug": "output",
          "type": "*",
          "displayName": "open",
          "group": "Outputs"
        },
        {
          "name": "out-segment",
          "plug": "output",
          "type": "*",
          "displayName": "segment",
          "group": "Outputs"
        }
      ]
    },
