      "type": "JavaScriptFunction",
      "label": "Open this objective",
      "x": 2600,
      "y": 1700,
      "parameters": {
        "functionScript": "/* A segment was pressed. The repeater hands back the ROW's id, which\n   Logic/Dossier keys by the objective's slug. */\nconst id = String(Inputs.id || '');\nif (!id) return;\nNoodl.Variables.dbtDossierOpen = id;\n",
        "runOnChange-in-id": false
      },
      "ports": [
        {
          "name": "in-id",
          "plug": "input",
          "type": "*",
          "displayName": "id",
