    {
      "id": "seo_cs_page",
      "type": "JavaScriptFunction",
      "label": "Set the browser tab",
      "x": 1400,
      "y": 2850,
      "parameters": {
        "functionScript": "// The page title is the browser TAB, and it is the one learner-facing string a\n// Translation node cannot reach: `Page.title` is read off the node's PARAMETERS at\n// export time into the router index (utils/exporter/router.ts), and the Router hands\n// that to Noodl.SEO.setTitle on mount. A connection to the port is silently ignored —\n// measured, TASK-L161 §1: with the parameter removed and a Translation wired, the tab\n// read \"Home\", the component name.\n//\n// So the parameter stays as the BUILD-TIME FALLBACK (the router index needs it, and it\n// is what the tab shows for the instant before this runs), and the translated value\n// overrides it here. Same shape as the kit's built-in English: a fallback is not a\n// second owner.\nconst t = Inputs.title;\nif (typeof t === 'string' && t !== '' && typeof Noodl !== 'undefined' && Noodl.SEO) {\n  Noodl.SEO.setTitle(t);\n}"
      },
      "ports": [
        {
          "name": "in-title",
          "plug": "input",
          "type": "string",
          "displayName": "title",
          "group": "Inputs"
        }
      ],
      "metadata": {
        "comment": "Why a JavaScript node and not a wire to Page.title: the port is build-time. See the script."
      }
    }
