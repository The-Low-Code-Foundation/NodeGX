    {
      "id": "hm_who",
      "type": "JavaScriptFunction",
      "label": "Which doors",
      "x": 900,
      "y": 1020,
      "parameters": {
        "functionScript": "/*\n * WHICH DOORS (TASK-L171 §2). Signed out: the two demo doors and the note that\n * says what they do. Signed in: one way on, decided by the backend's ROLE, never\n * by an address — L102's single owner is the backend's `staff` role now.\n *\n * `roles` is undefined when the backend has not said and [] when the user is in\n * none (user.ts, DEF-005). Undefined shows NEITHER way on rather than guessing\n * the learner's: a coach must not be offered a course that is not theirs because\n * a read had not come back yet. App's gate is what ASKS when they are unknown\n * (after a magic link they always are, for a moment); this node only reads the\n * answer, which every User node shares.\n */\nconst signedIn = Inputs.signedIn === true;\nconst roles = Array.isArray(Inputs.roles) ? Inputs.roles : undefined;\nOutputs.signedOut = !signedIn;\nOutputs.isStaff = signedIn && !!roles && roles.indexOf('staff') !== -1;\nOutputs.isLearner = signedIn && !!roles && roles.indexOf('staff') === -1;\nOutputs.canSignOut = signedIn;\n"
      },
      "ports": [
        {
          "name": "in-signedIn",
          "displayName": "signedIn",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-roles",
          "displayName": "roles",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-signedOut",
          "displayName": "signedOut",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-isStaff",
