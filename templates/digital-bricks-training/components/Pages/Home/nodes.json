    {
      "id": "hm_which_lede",
      "type": "JavaScriptFunction",
      "label": "Which lede",
      "x": 1500,
      "y": 1140,
      "parameters": {
        "functionScript": "/*\n * WHICH LEDE (TASK-L171). The signed-out lede ends \"Look at it from either\n * side:\", which introduces the two doors. Signed in there is one way on, so that\n * clause would point at buttons that are not there — found by looking at the\n * screenshot, not by any count. The signed-in lede is the same sentence without\n * it, one key in Data/Strings.\n */\nconst out = Inputs.signedOut !== false;\nOutputs.text = out ? Inputs.doors : Inputs.signedIn;\n"
      },
      "ports": [
        {
          "name": "in-signedOut",
          "displayName": "signedOut",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-doors",
          "displayName": "doors",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
