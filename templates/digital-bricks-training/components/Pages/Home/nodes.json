          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-isLearner",
          "displayName": "isLearner",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-canSignOut",
          "displayName": "canSignOut",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
