    },
    {
      "id": "ls_shell",
      "type": "Group",
      "label": "The shell",
      "x": 160,
      "y": 280,
      "parent": "ls_band",
      "children": [
        "ls_eyebrow",
        "ls_title",
        "ls_hook",
