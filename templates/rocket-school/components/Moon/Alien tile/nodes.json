{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "9d6e6d6c-0dd2-5d6c-84f3-ff21d9d07f14",
  "version": 1,
  "nodes": [
    {
      "id": "mtIn-2",
      "type": "Component Inputs",
      "label": "The alien",
      "ports": [
        {
          "name": "id",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "name",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "species",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "colour",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "grown",
          "plug": "output",
          "type": "number"
        },
        {
          "name": "hat",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "eyes",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "neck",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "back",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "form",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "happy",
          "plug": "output",
          "type": "number"
        },
        {
          "name": "selected",
          "plug": "output",
          "type": "boolean"
        },
        {
          "name": "line",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 350,
      "y": 280
    },
    {
      "id": "mtCard",
      "type": "Group",
      "label": "The tile",
      "children": [
        "mtAlien",
        "mtName",
        "mtLine"
      ],
      "parameters": {
        "width": {
          "value": 120,
          "unit": "px"
        },
        "sizeMode": "contentHeight",
        "backgroundColor": "var(--surface)",
        "borderRadius": "var(--radius-xl)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border)",
        "clip": true,
        "flexDirection": "column",
        "boxShadowEnabled": true,
        "boxShadowOffsetX": {
          "value": 4,
          "unit": "px"
        },
        "boxShadowOffsetY": {
          "value": 5,
          "unit": "px"
        },
        "boxShadowBlurRadius": {
          "value": 0,
          "unit": "px"
        },
        "boxShadowColor": "var(--foreground)",
        "alignItems": "center",
        "rowGap": "var(--space-1)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "paddingLeft": "var(--space-2)",
        "paddingRight": "var(--space-2)"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "mtAlien",
      "type": "game-kit.Alien",
      "label": "The alien",
      "parent": "mtCard",
      "parameters": {
        "size": 92
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "mtName",
      "type": "Text",
      "label": "Its name",
      "parent": "mtCard",
      "parameters": {
        "text": "",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-base)",
        "color": "var(--foreground)",
        "fontWeight": "var(--font-bold)",
        "textAlignX": "center"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "mtLine",
      "type": "Text",
      "label": "How grown",
      "parent": "mtCard",
      "parameters": {
        "text": "",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)",
        "textAlignX": "center"
      },
      "x": 100,
      "y": 400
    },
    {
      "id": "mtToneOf",
      "type": "Expression",
      "label": "Chosen?",
      "parameters": {
        "expression": "selected === true ? 'on' : 'off'"
      },
      "x": 350,
      "y": 400
    },
    {
      "id": "mtTone",
      "type": "States",
      "label": "Chosen, or not",
      "parameters": {
        "states": "off,on",
        "values": "ground",
        "useTransitions": false,
        "type-ground": "color",
        "value-off-ground": "var(--surface)",
        "value-on-ground": "var(--accent)"
      },
      "x": 350,
      "y": 40
    },
    {
      "id": "mtOut",
      "type": "Component Outputs",
      "label": "Tapped",
      "ports": [
        {
          "name": "tap",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "id",
          "plug": "input",
          "type": "string"
        }
      ],
      "x": 350,
      "y": 160
    }
  ],
  "visualRoots": [
    "mtCard"
  ]
}
