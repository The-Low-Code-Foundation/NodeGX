    {
      "id": "rdChainLine",
      "type": "JavaScriptFunction",
      "label": "The chain, in words",
      "parameters": {
        "functionScript": "var n = Math.max(0, Math.floor(Number(Inputs.n) || 0));\nvar of = Math.max(1, Math.floor(Number(Inputs.of) || 3));\n// Nothing to say before the first right answer of a run, or once it is charged (the button speaks then).\nOutputs.line = n > 0 && Inputs.ready !== true ? String(Inputs.word || '').replace('{n}', n).replace('{of}', of) : '';"
      },
