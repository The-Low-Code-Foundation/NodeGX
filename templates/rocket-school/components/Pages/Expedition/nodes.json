      "parent": "xpPage",
      "children": [
        "xpWrap"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "center"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "xpWrap",
      "type": "Group",
      "label": "The screen",
      "parent": "xpOuter",
      "children": [
        "xpHeader",
        "xpTitle",
        "xpPlay",
        "xpBack"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "stretch",
        "rowGap": "var(--space-4)",
        "paddingTop": "var(--space-4)",
        "paddingBottom": "var(--space-8)",
        "paddingLeft": "var(--space-4)",
        "paddingRight": "var(--space-4)",
        "maxWidth": {
          "value": 960,
          "unit": "px"
        }
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "xpHeader",
      "type": "/Game/Header",
      "label": "The bar",
      "parent": "xpWrap",
      "parameters": {
        "showHome": true,
        "showHangar": true
      },
      "x": 220,
      "y": 400
    },
    {
      "id": "xpTitle",
      "type": "Text",
      "label": "Expedition",
      "parent": "xpWrap",
      "parameters": {
        "text": "",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-3xl)",
        "fontWeight": "var(--font-extrabold)",
        "lineHeight": "var(--leading-tight)",
        "letterSpacing": "var(--tracking-tight)",
        "color": "var(--foreground)",
        "as": "h2",
        "fontFamily": "Grandstander"
      },
      "x": 220,
      "y": 520
    },
    {
      "id": "xpPlay",
      "type": "/Trip/Play",
      "label": "Expedition",
      "parent": "xpWrap",
      "x": 220,
      "y": 640
    },
    {
      "id": "xpBack",
