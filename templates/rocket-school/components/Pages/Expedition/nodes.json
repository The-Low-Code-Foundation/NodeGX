      "x": 470,
      "y": 1000
    },
    {
      "id": "xpCurriculum",
      "type": "/Data/Curriculum",
      "label": "The skills",
      "x": 470,
      "y": 1120
    },
    {
      "id": "xpWordLists",
      "type": "/Data/Word lists",
