        "target": "/Pages/Home"
      },
      "x": 470,
      "y": 760
    },
    {
      "id": "xpGoHangar",
      "type": "RouterNavigate",
      "label": "To the hangar",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Hangar"
      },
      "x": 470,
      "y": 880
