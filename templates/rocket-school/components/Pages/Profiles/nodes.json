    {
      "id": "pfEyebrow",
      "type": "Text",
      "label": "Eyebrow",
      "parent": "pfWrap",
      "parameters": {
        "text": "Rocket School",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-xs)",
        "fontWeight": "var(--font-semibold)",
        "letterSpacing": "var(--tracking-widest)",
        "textTransform": "uppercase",
        "color": "var(--foreground)",
        "as": "span",
        "textAlignX": "center"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "pfTitle",
      "type": "Text",
      "label": "Who is playing?",
      "parent": "pfWrap",
      "parameters": {
        "text": "",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-4xl)",
        "fontWeight": "var(--font-extrabold)",
        "lineHeight": "var(--leading-none)",
        "letterSpacing": "var(--tracking-tighter)",
        "color": "var(--foreground)",
        "as": "h1",
        "fontFamily": "Grandstander",
        "textAlignX": "center"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "pfLead",
      "type": "Text",
      "label": "The tagline",
      "parent": "pfWrap",
      "parameters": {
        "text": "",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-lg)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--muted-foreground)",
        "maxWidth": {
          "value": 560,
          "unit": "px"
        },
        "textAlignX": "center"
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "pfList",
      "type": "Group",
      "label": "The players",
      "parent": "pfWrap",
      "children": [
        "pfEach"
      ],
      "parameters": {
        "sizeMode": "contentSize",
        "flexDirection": "row",
        "alignItems": "center",
        "flexWrap": "wrap",
        "columnGap": "var(--space-4)",
        "rowGap": "var(--space-4)",
        "justifyContent": "center"
      },
      "x": 160,
      "y": 640
    },
    {
      "id": "pfEach",
      "type": "For Each",
      "label": "One card per player",
      "parameters": {
        "template": "/Game/Profile card",
        "templateType": "explicit"
      },
      "parent": "pfList",
      "x": 220,
      "y": 760
    },
    {
      "id": "pfNew",
      "type": "net.noodl.controls.button",
      "label": "New player",
      "parent": "pfWrap",
      "parameters": {
        "backgroundColor": "var(--primary)",
        "color": "var(--primary-foreground)",
        "borderRadius": "var(--radius-lg)",
        "borderStyle": "solid",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-extrabold)",
        "sizeMode": "contentSize",
        "fontFamily": "Grandstander",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--foreground)",
        "boxShadowEnabled": true,
        "boxShadowOffsetX": {
          "value": 4,
          "unit": "px"
        },
        "boxShadowOffsetY": {
          "value": 5,
          "unit": "px"
        },
        "boxShadowBlurRadius": {
          "value": 0,
          "unit": "px"
        },
        "boxShadowColor": "var(--foreground)",
        "label": "New player"
      },
      "x": 160,
      "y": 880
