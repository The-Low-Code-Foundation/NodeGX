    {
      "id": "pfForm",
      "type": "/Profiles/New player form",
      "label": "The form",
      "parent": "pfWrap",
      "x": 160,
      "y": 1000
    },
    {
      "id": "pfStore",
      "type": "/Logic/App store",
      "label": "The store",
      "x": 470,
      "y": 1480
    },
    {
      "id": "pfList2",
      "type": "/Logic/List profiles",
      "label": "The profiles",
      "x": 470,
      "y": 760
    },
    {
      "id": "pfSelect",
      "type": "/Logic/Select profile",
      "label": "Choose one",
      "x": 470,
      "y": 880
    },
    {
      "id": "pfCreate",
      "type": "/Logic/Create profile",
      "label": "Make one",
      "x": 470,
      "y": 1240
    },
    {
      "id": "pfWords",
      "type": "/Data/Words",
      "label": "The words",
      "x": 470,
      "y": 1600
    },
    {
      "id": "pfT",
      "type": "/Logic/Translate words",
      "label": "In English until a player is chosen",
      "x": 470,
      "y": 400
    },
    {
      "id": "pfFormOpen",
      "type": "Variable2",
      "label": "Is the form open?",
      "parameters": {
        "name": "profileFormOpen"
      },
      "x": 470,
      "y": 1360
    },
    {
      "id": "pfOpenForm",
      "type": "Set Variable",
      "label": "Open the form",
      "parameters": {
        "name": "profileFormOpen"
      },
      "x": 470,
      "y": 1000
    },
    {
      "id": "pfCloseForm",
      "type": "Set Variable",
      "label": "Close the form",
      "parameters": {
        "name": "profileFormOpen"
      },
      "x": 470,
      "y": 40
    },
    {
      "id": "pfTrue",
      "type": "Expression",
      "label": "True",
      "parameters": {
        "expression": "true"
      },
      "x": 470,
      "y": 1720
    },
    {
      "id": "pfFalse",
      "type": "Expression",
      "label": "False",
      "parameters": {
        "expression": "false"
      },
      "x": 470,
      "y": 1840
    },
    {
      "id": "pfNewShown",
      "type": "Expression",
      "label": "Show the button?",
      "parameters": {
        "expression": "canAdd && !open"
      },
      "x": 470,
      "y": 1120
    },
    {
      "id": "pfGoHome",
      "type": "RouterNavigate",
      "label": "Go home",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Home"
      },
      "x": 470,
      "y": 1960
    }
