{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "8b1720b7-fbd4-579b-8886-42d5c12426cb",
  "version": 1,
  "nodes": [
    {
      "id": "mnPage",
      "type": "Page",
      "label": "Moon",
      "children": [
        "mnOuter"
      ],
      "parameters": {
        "title": "Rocket School",
        "urlPath": "moon"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "mnOuter",
      "type": "Group",
      "label": "The ground",
      "parent": "mnPage",
      "children": [
        "mnWrap"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "center"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "mnWrap",
      "type": "Group",
      "label": "The screen",
      "parent": "mnOuter",
      "children": [
        "mnHeader",
        "mnTitle",
        "mnPurse",
        "mnAliens",
        "mnCare",
        "mnAdopt",
        "mnBack"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "sizeMode": "contentHeight",
        "flexDirection": "column",
        "alignItems": "stretch",
        "rowGap": "var(--space-4)",
        "paddingTop": "var(--space-4)",
        "paddingBottom": "var(--space-8)",
        "paddingLeft": "var(--space-4)",
        "paddingRight": "var(--space-4)",
        "maxWidth": {
          "value": 960,
          "unit": "px"
        }
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "mnHeader",
      "type": "/Game/Header",
      "label": "The bar",
      "parent": "mnWrap",
      "parameters": {
        "showHome": true,
        "showHangar": true
      },
      "x": 220,
      "y": 400
    },
    {
      "id": "mnTitle",
      "type": "Text",
      "label": "The Moon",
      "parent": "mnWrap",
      "parameters": {
        "text": "",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-3xl)",
        "fontWeight": "var(--font-extrabold)",
        "lineHeight": "var(--leading-tight)",
        "letterSpacing": "var(--tracking-tight)",
        "color": "var(--foreground)",
        "as": "h2",
        "fontFamily": "Grandstander"
      },
      "x": 220,
      "y": 520
    },
    {
      "id": "mnPurse",
      "type": "Text",
      "label": "The stars to spend",
      "parent": "mnWrap",
      "parameters": {
        "text": "",
        "sizeMode": "contentHeight",
        "fontSize": "var(--text-lg)",
        "lineHeight": "var(--leading-relaxed)",
        "color": "var(--muted-foreground)",
        "maxWidth": {
          "value": 560,
          "unit": "px"
        },
        "fontWeight": "var(--font-bold)"
      },
      "x": 220,
      "y": 640
    },
    {
      "id": "mnAliens",
      "type": "Group",
      "label": "The aliens",
      "parent": "mnWrap",
      "children": [
        "mnEach"
      ],
      "parameters": {
        "sizeMode": "contentHeight",
        "flexDirection": "row",
        "alignItems": "stretch",
        "flexWrap": "wrap",
        "columnGap": "var(--space-3)",
        "rowGap": "var(--space-3)",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "justifyContent": "center"
      },
      "x": 220,
      "y": 760
    },
    {
      "id": "mnEach",
      "type": "For Each",
      "label": "One tile per alien",
      "parameters": {
        "template": "/Moon/Alien tile",
        "templateType": "explicit"
      },
      "parent": "mnAliens",
      "x": 280,
      "y": 880
    },
    {
      "id": "mnCare",
      "type": "/Moon/Care",
      "label": "The chosen alien",
      "parent": "mnWrap",
      "x": 220,
      "y": 1000
    },
    {
      "id": "mnAdopt",
      "type": "/Moon/Adopt",
      "label": "Adopt an alien",
      "parent": "mnWrap",
      "x": 220,
      "y": 1120
    },
    {
      "id": "mnBack",
      "type": "net.noodl.controls.button",
      "label": "Back to the hangar",
      "parent": "mnWrap",
      "parameters": {
        "backgroundColor": "var(--surface)",
        "color": "var(--foreground)",
        "borderRadius": "var(--radius-lg)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--foreground)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-extrabold)",
        "sizeMode": "contentSize",
        "fontFamily": "Grandstander",
        "boxShadowEnabled": true,
        "boxShadowOffsetX": {
          "value": 4,
          "unit": "px"
        },
        "boxShadowOffsetY": {
          "value": 5,
          "unit": "px"
        },
        "boxShadowBlurRadius": {
          "value": 0,
          "unit": "px"
        },
        "boxShadowColor": "var(--foreground)",
        "label": "Back to the hangar"
      },
      "x": 220,
      "y": 1240
    },
    {
      "id": "mnStore",
      "type": "/Logic/App store",
      "label": "The store",
      "x": 530,
      "y": 400
    },
    {
      "id": "mnMe",
      "type": "/Logic/Active profile",
      "label": "Who is playing",
      "x": 530,
      "y": 520
    },
    {
      "id": "mnWords",
      "type": "/Data/Words",
      "label": "The words",
      "x": 530,
      "y": 1360
    },
    {
      "id": "mnT",
      "type": "/Logic/Translate words",
      "label": "In their language",
      "x": 530,
      "y": 1240
    },
    {
      "id": "mnView",
      "type": "/Logic/Moon view",
      "label": "The moon, as they see it",
      "x": 530,
      "y": 1000
    },
    {
      "id": "mnSelect",
      "type": "/Logic/Moon act",
      "label": "Choose an alien",
      "parameters": {
        "action": "select"
      },
      "x": 530,
      "y": 1120
    },
    {
      "id": "mnNoOne",
      "type": "Expression",
      "label": "Nobody signed in?",
      "parameters": {
        "expression": "has === false"
      },
      "x": 530,
      "y": 1480
    },
    {
      "id": "mnGuard",
      "type": "Condition",
      "label": "Send them to the profiles?",
      "parameters": {
        "runOnChange-condition": false
      },
      "x": 530,
      "y": 40
    },
    {
      "id": "mnGoProfiles",
      "type": "RouterNavigate",
      "label": "To the profiles",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Profiles"
      },
      "x": 530,
      "y": 640
    },
    {
      "id": "mnGoHome",
      "type": "RouterNavigate",
      "label": "Home",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Home"
      },
      "x": 530,
      "y": 760
    },
    {
      "id": "mnGoHangar",
      "type": "RouterNavigate",
      "label": "To the hangar",
      "parameters": {
        "router": "Main",
        "target": "/Pages/Hangar"
      },
      "x": 530,
      "y": 880
    }
  ],
  "visualRoots": [
    "mnPage"
  ]
}
