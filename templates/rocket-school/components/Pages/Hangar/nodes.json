      "x": 590,
      "y": 880
    },
    {
      "id": "hgCurriculum",
      "type": "/Data/Curriculum",
      "label": "The skills",
      "x": 590,
      "y": 1720
    },
    {
      "id": "hgWordLists",
      "type": "/Data/Word lists",
      "label": "The typing words",
      "x": 590,
      "y": 1840
    },
    {
      "id": "hgItems",
