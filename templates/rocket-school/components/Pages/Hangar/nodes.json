      "label": "What the shelf offers",
      "x": 590,
      "y": 1240
    },
    {
      "id": "hgPick",
      "type": "/Logic/Pick item",
      "label": "Buy it",
      "x": 590,
      "y": 1000
    },
    {
      "id": "hgAsk",
      "type": "States",
      "label": "Shelf, or the question",
      "parameters": {
        "states": "idle,asking",
        "values": "idle,asking",
        "useTransitions": false,
        "type-idle": "boolean",
        "value-idle-idle": true,
        "value-asking-idle": false,
        "type-asking": "boolean",
        "value-idle-asking": false,
        "value-asking-asking": true
      },
      "x": 590,
      "y": 1360
    },
    {
      "id": "hgBuyTitle",
      "type": "Expression",
      "label": "Buy what?",
      "parameters": {
        "expression": "String(word || '').replace('{item}', String(label || ''))"
      },
      "x": 590,
      "y": 1480
    },
    {
      "id": "hgWear",
      "type": "/Logic/Wear item",
      "label": "Put it on, or take it off",
      "x": 590,
      "y": 1120
    },
    {
      "id": "hgNoOne",
      "type": "Expression",
      "label": "Nobody signed in?",
      "parameters": {
        "expression": "has === false"
      },
      "x": 590,
      "y": 1960
    },
    {
      "id": "hgGuard",
      "type": "Condition",
      "label": "Send them to the profiles?",
      "parameters": {
        "runOnChange-condition": false
      },
      "x": 590,
      "y": 40
    },
    {
      "id": "hgGoProfiles",
