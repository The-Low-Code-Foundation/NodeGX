  "nodes": [
    {
      "id": "toggleidIn",
      "type": "Component Inputs",
      "label": "What the caller gives",
      "ports": [
        {
          "name": "run",
          "plug": "output",
          "type": "signal"
        },
        {
          "name": "list",
          "plug": "output",
