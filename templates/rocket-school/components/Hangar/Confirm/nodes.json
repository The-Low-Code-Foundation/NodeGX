    {
      "id": "hcSum",
      "type": "JavaScriptFunction",
      "label": "The three lines of the sum",
      "parameters": {
        "functionScript": "var purse = Math.max(0, Math.floor(Number(Inputs.purse) || 0));\nvar cost = Math.max(0, Math.floor(Number(Inputs.cost) || 0));\nOutputs.rows = [\n  { id: 'have', label: String(Inputs.haveWord || ''), value: purse + ' ⭐', strong: false },\n  { id: 'cost', label: String(Inputs.costWord || ''), value: '−' + cost + ' ⭐', strong: false },\n  { id: 'left', label: String(Inputs.leftWord || ''), value: Math.max(0, purse - cost) + ' ⭐', strong: true }\n];"
      },
      "x": 410,
      "y": 400,
      "ports": [
        {
          "name": "in-purse",
          "displayName": "purse",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-cost",
          "displayName": "cost",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-haveWord",
          "displayName": "haveWord",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-costWord",
          "displayName": "costWord",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-leftWord",
