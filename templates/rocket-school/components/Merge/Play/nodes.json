    {
      "id": "mpEndInView",
      "type": "JavaScriptFunction",
      "label": "Bring New game on screen",
      "parameters": {
        "functionScript": "if (typeof document !== 'undefined') {\n  const word = String(Inputs.word || '').trim();\n  setTimeout(() => {\n    const button = Array.from(document.querySelectorAll('button')).find((b) => b.getClientRects().length > 0 && b.innerText.trim() === word);\n    if (!button) return;\n    // The whole row of ways on (New game, the hangar, Home), not New game alone: build 2's phone showed New game and cut Home off.\n    let row = button.parentElement;\n    while (row && row.querySelectorAll('button').length < 2) row = row.parentElement;\n    (row || button).scrollIntoView({ block: 'nearest', behavior: 'auto' });\n  }, 250);\n}",
        "runOnChange-in-word": false
      },
      "x": 650,
      "y": 3280,
      "ports": [
