      "type": "Component Inputs",
      "label": "The square",
      "ports": [
        {
          "name": "word",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "kind",
          "plug": "output",
          "type": "string"
        },
        {
          "name": "fx",
          "plug": "output",
          "type": "string"
        }
      ],
      "x": 350,
      "y": 160
    },
    {
      "id": "mtCell",
      "type": "Group",
      "label": "The square",
      "children": [
        "mtWord"
      ],
      "parameters": {
        "width": {
          "value": 72,
          "unit": "px"
        },
        "height": {
          "value": 72,
          "unit": "px"
        },
        "sizeMode": "explicit",
        "alignItems": "center",
        "justifyContent": "center",
        "backgroundColor": "var(--muted)",
        "borderRadius": "var(--radius-md)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-subtle)",
        "cssClassName": "rkt-merge-tile"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "mtWord",
      "type": "Text",
      "label": "The number",
      "parent": "mtCell",
      "parameters": {
        "text": "",
        "sizeMode": "contentSize",
        "fontFamily": "Grandstander",
        "fontWeight": "var(--font-extrabold)",
        "fontSize": "var(--text-2xl)",
        "fontVariantNumeric": "tabular-nums",
        "color": "var(--foreground)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "mtKind",
      "type": "States",
      "label": "Empty, a number, a ten, tens, or a hundred and over",
