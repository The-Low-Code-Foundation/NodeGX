        "type-ground": "color",
        "value-empty-ground": "var(--muted)",
        "value-unit-ground": "var(--surface)",
        "value-ten-ground": "var(--accent)",
        "value-tens-ground": "var(--primary)",
        "value-big-ground": "var(--secondary)",
        "type-edge": "color",
        "value-empty-edge": "var(--border-subtle)",
        "value-unit-edge": "var(--foreground)",
        "value-ten-edge": "var(--foreground)",
        "value-tens-edge": "var(--foreground)",
        "value-big-edge": "var(--foreground)"
