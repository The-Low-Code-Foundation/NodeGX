{
 "theme": "dark",
 "fills": {
  "rgb(46, 44, 54) = bg-2": {
   "button panel-head-row-field": 2,
   "div SearchInput.Root": 1,
   "div SizeModeInput.Segment": 2,
   "div NumberUnitInput.Field": 4,
   "input PropertyPanelBaseInput.Root PropertyPanelBaseInput.has-hidden-caret": 3,
   "div AlignToolsInput.Segment": 3
  },
  "rgb(35, 33, 41) = bg-1|on-secondary|focus-ring-offset": {
