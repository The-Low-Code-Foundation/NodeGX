   "button VariantSelector.VariantSelector-trigger": 1,
   "div SizePicker.SizePicker-group": 1,
   "input SearchInput.SearchInput property-filter-input": 1,
   "input PropertyPanelBaseInput.Root PropertyPanelBaseInput.has-hidden-caret": 2,
   "input PropertyPanelBaseInput.Root": 1,
   "div NumberUnitInput.Field": 2,
   "input PropertyPanelBaseInput.Root PropertyPanelBaseInput.is-numeric": 2,
   "div ColorInput.Field": 1,
   "input PropertyPanelBaseInput.Root ColorInput.Value": 1
  },
  "4px --radius-default": {
