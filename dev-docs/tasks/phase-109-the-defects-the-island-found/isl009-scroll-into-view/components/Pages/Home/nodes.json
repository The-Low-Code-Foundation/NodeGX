{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "c_home",
  "version": 1,
  "nodes": [
    {
      "id": "page",
      "type": "Page",
      "label": "Home",
      "children": [
        "layout"
      ],
      "parameters": {
        "title": "Home",
        "scrollIntoViewAlign": "start",
        "dataAttributes": "data-testid",
        "data-testid": "page"
      }
    },
    {
      "id": "layout",
      "type": "Group",
      "label": "Layout",
      "parent": "page",
      "children": [
        "bar",
        "sp1",
        "pageCard",
        "nativeBox",
        "iscrollBox",
        "sp4"
      ],
      "parameters": {
        "sizeMode": "contentHeight"
      }
    },
    {
      "id": "bar",
      "type": "Group",
      "label": "buttons",
      "parent": "layout",
      "children": [
        "bPage",
        "bNative",
        "bIscroll",
        "bTop"
      ],
      "parameters": {
        "flexDirection": "row",
        "sizeMode": "contentHeight"
      }
    },
    {
      "id": "bPage",
      "type": "Group",
      "label": "to page card",
      "parent": "bar",
      "children": [
        "bPageT"
      ],
      "parameters": {
        "backgroundColor": "#dde",
        "paddingLeft": {
          "value": 8,
          "unit": "px"
        },
        "paddingRight": {
          "value": 8,
          "unit": "px"
        },
        "sizeMode": "contentSize",
        "dataAttributes": "data-testid",
        "data-testid": "bPage"
      }
    },
    {
      "id": "bPageT",
      "type": "Text",
      "parent": "bPage",
      "parameters": {
        "text": "to page card"
      }
    },
    {
      "id": "bNative",
      "type": "Group",
      "label": "to native card",
      "parent": "bar",
      "children": [
        "bNativeT"
      ],
      "parameters": {
        "backgroundColor": "#dde",
        "paddingLeft": {
          "value": 8,
          "unit": "px"
        },
        "paddingRight": {
          "value": 8,
          "unit": "px"
        },
        "sizeMode": "contentSize",
        "dataAttributes": "data-testid",
        "data-testid": "bNative"
      }
    },
    {
      "id": "bNativeT",
      "type": "Text",
      "parent": "bNative",
      "parameters": {
        "text": "to native card"
      }
    },
    {
      "id": "bIscroll",
      "type": "Group",
      "label": "to iscroll card",
      "parent": "bar",
      "children": [
        "bIscrollT"
      ],
      "parameters": {
        "backgroundColor": "#dde",
        "paddingLeft": {
          "value": 8,
          "unit": "px"
        },
        "paddingRight": {
          "value": 8,
          "unit": "px"
        },
        "sizeMode": "contentSize",
        "dataAttributes": "data-testid",
        "data-testid": "bIscroll"
      }
    },
    {
      "id": "bIscrollT",
      "type": "Text",
      "parent": "bIscroll",
      "parameters": {
        "text": "to iscroll card"
      }
    },
    {
      "id": "bTop",
      "type": "Group",
      "label": "to top",
      "parent": "bar",
      "children": [
        "bTopT"
      ],
      "parameters": {
        "backgroundColor": "#dde",
        "paddingLeft": {
          "value": 8,
          "unit": "px"
        },
        "paddingRight": {
          "value": 8,
          "unit": "px"
        },
        "sizeMode": "contentSize",
        "dataAttributes": "data-testid",
        "data-testid": "bTop"
      }
    },
    {
      "id": "bTopT",
      "type": "Text",
      "parent": "bTop",
      "parameters": {
        "text": "to top"
      }
    },
    {
      "id": "sp1",
      "type": "Group",
      "label": "spacer",
      "parent": "layout",
      "parameters": {
        "sizeMode": "explicit",
        "height": {
          "value": 2200,
          "unit": "px"
        },
        "backgroundColor": "#f4f4f4"
      }
    },
    {
      "id": "pageCard",
      "type": "Group",
      "label": "PAGE CARD",
      "parent": "layout",
      "children": [
        "pageCardT"
      ],
      "parameters": {
        "sizeMode": "explicit",
        "height": {
          "value": 120,
          "unit": "px"
        },
        "backgroundColor": "#fc9",
        "dataAttributes": "data-testid",
        "data-testid": "pageCard"
      }
    },
    {
      "id": "pageCardT",
      "type": "Text",
      "parent": "pageCard",
      "parameters": {
        "text": "PAGE CARD"
      }
