          "unit": "px"
        },
        "scrollEnabled": true,
        "nativeScroll": true,
        "clip": true,
        "dataAttributes": "data-testid",
        "data-testid": "nativeBox"
      }
    },
    {
      "id": "sp2",
      "type": "Group",
      "label": "spacer",
      "parent": "nativeBox",
      "parameters": {
        "sizeMode": "explicit",
        "height": {
          "value": 1000,
          "unit": "px"
        },
        "backgroundColor": "#f4f4f4"
      }
    },
    {
      "id": "nativeCard",
      "type": "Group",
      "label": "NATIVE CARD",
      "parent": "nativeBox",
      "children": [
        "nativeCardT"
      ],
      "parameters": {
        "sizeMode": "explicit",
        "height": {
          "value": 120,
          "unit": "px"
        },
        "backgroundColor": "#9cf",
        "dataAttributes": "data-testid",
        "data-testid": "nativeCard"
      }
    },
    {
      "id": "nativeCardT",
      "type": "Text",
      "parent": "nativeCard",
      "parameters": {
        "text": "NATIVE CARD"
      }
    },
    {
      "id": "iscrollBox",
      "type": "Group",
      "label": "iscroll box",
      "parent": "layout",
      "children": [
        "sp3",
        "iscrollCard"
      ],
      "parameters": {
        "sizeMode": "explicit",
        "height": {
          "value": 200,
          "unit": "px"
        },
        "scrollEnabled": true,
        "nativeScroll": false,
        "clip": true,
        "dataAttributes": "data-testid",
        "data-testid": "iscrollBox"
      }
    },
    {
      "id": "sp3",
      "type": "Group",
      "label": "spacer",
      "parent": "iscrollBox",
      "parameters": {
        "sizeMode": "explicit",
        "height": {
          "value": 1000,
          "unit": "px"
        },
        "backgroundColor": "#f4f4f4"
      }
