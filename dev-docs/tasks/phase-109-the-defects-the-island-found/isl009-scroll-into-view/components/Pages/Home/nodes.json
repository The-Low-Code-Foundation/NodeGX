      "parameters": {
        "sizeMode": "explicit",
        "height": {
          "value": 120,
          "unit": "px"
        },
        "backgroundColor": "#9f9",
        "dataAttributes": "data-testid"
      }
    },
    {
      "id": "iscrollCardT",
      "type": "Text",
      "parent": "iscrollCard",
      "parameters": {
        "text": "ISCROLL CARD"
      }
    },
    {
      "id": "sp4",
      "type": "Group",
      "label": "spacer",
      "parent": "layout",
      "parameters": {
        "sizeMode": "explicit",
        "height": {
          "value": 1500,
          "unit": "px"
        },
        "backgroundColor": "#f4f4f4"
      }
    },
    {
      "id": "iscrollCardName",
      "type": "Expression",
      "label": "iScroll card's test name",
      "parameters": {
        "expression": "'iscrollCard'"
      }
