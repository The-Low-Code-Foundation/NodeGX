      "parameters": {
        "style": "/* ISL-008 AC1: ordinary CSS for an overlay. `.win` and `.win-set` carry NO !important. */\n.win, .win-set { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; }\n/* The known-firing control: the same rules forced, the way five templates had to write them. */\n.win-imp { position: fixed !important; inset: 0 !important; display: flex !important; align-items: center !important; justify-content: center !important; }\n"
      }
    },
