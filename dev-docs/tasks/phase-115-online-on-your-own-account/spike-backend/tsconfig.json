      "@noodl/backend-contract": ["../../../../packages/nodegx-backend-contract/src/index.ts"],
      "@noodl/backend-contract/*": ["../../../../packages/nodegx-backend-contract/*"],
      "@noodl/runtime": ["../../../../packages/noodl-runtime/noodl-runtime.ts"],
      "@noodl/runtime/*": ["../../../../packages/noodl-runtime/*"]
