{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "d416af00-381c-5c00-8fe3-a672b7e04efe",
  "version": 1,
  "nodes": [
    {
      "id": "cp-card",
      "type": "Group",
      "label": "Composer card",
      "children": [
        "cp-author",
        "cp-content",
        "cp-actions"
      ],
      "parameters": {
        "backgroundColor": "var(--surface)",
        "borderColor": "var(--border)",
        "borderRadius": "var(--radius-xl)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "flexDirection": "column",
        "paddingBottom": "var(--space-5)",
        "paddingLeft": "var(--space-5)",
        "paddingRight": "var(--space-5)",
        "paddingTop": "var(--space-5)",
        "rowGap": "var(--space-4)",
        "sizeMode": "contentHeight",
        "width": {
          "unit": "%",
          "value": 100
        }
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "cp-author",
      "type": "/Components/SelectField",
      "label": "Author picker",
      "parent": "cp-card",
      "parameters": {
        "label": "Posting as",
        "placeholder": "Choose your name"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "cp-content",
      "type": "/Components/TextField",
      "label": "Update field",
      "parent": "cp-card",
      "parameters": {
        "label": "Update",
        "multiline": true,
        "placeholder": "Share a short update with the team…"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "cp-actions",
      "type": "Group",
      "label": "Actions row",
      "parent": "cp-card",
      "children": [
        "cp-post"
      ],
      "parameters": {
        "flexDirection": "row",
        "justifyContent": "flex-end"
      },
      "x": 100,
      "y": 400
    },
    {
      "id": "cp-post",
      "type": "net.noodl.controls.button",
      "label": "Post update",
      "parent": "cp-actions",
      "parameters": {
        "backgroundColor": "var(--primary)",
        "borderRadius": "var(--radius-full)",
        "borderStyle": "none",
        "color": "var(--primary-foreground)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "label": "Post update",
        "paddingBottom": "var(--space-3)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "sizeMode": "contentSize"
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "cp-ci",
      "type": "Component Inputs",
      "label": "Composer inputs",
      "ports": [
        {
          "name": "options",
          "plug": "output",
          "type": "array"
        }
      ],
      "x": 410,
      "y": 160
    },
    {
      "id": "cp-co",
      "type": "Component Outputs",
      "label": "Composer outputs",
      "ports": [
        {
          "name": "posted",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 410,
      "y": 640
    },
    {
      "id": "cp-create",
      "type": "NewDbModelProperties",
      "label": "Create feed post",
      "parameters": {
        "collectionName": "FeedPost",
        "prop-kind": "manual"
      },
      "x": 410,
      "y": 280
    },
    {
      "id": "cp-canpost",
      "type": "Expression",
      "label": "Can post",
      "parameters": {
        "expression": "!!(author && content)"
      },
      "x": 410,
      "y": 520
    }
  ],
  "visualRoots": [
    "cp-card"
  ]
}