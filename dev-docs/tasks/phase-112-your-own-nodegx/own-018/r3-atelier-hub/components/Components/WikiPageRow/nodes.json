{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "89751fe8-14ee-589b-83f2-0059cb2480a5",
  "version": 1,
  "nodes": [
    {
      "id": "wr-row",
      "type": "Group",
      "label": "Wiki page row",
      "children": [
        "wr-main",
        "wr-author",
        "wr-updated"
      ],
      "parameters": {
        "alignItems": "center",
        "borderBottomColor": "var(--border-subtle)",
        "borderBottomStyle": "solid",
        "borderBottomWidth": "var(--border-1)",
        "columnGap": "var(--space-4)",
        "flexDirection": "row",
        "paddingBottom": "var(--space-3)",
        "paddingTop": "var(--space-3)",
        "sizeMode": "contentHeight",
        "width": {
          "unit": "%",
          "value": 100
        }
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "wr-main",
      "type": "Group",
      "label": "Title and slug",
      "parent": "wr-row",
      "children": [
        "wr-title",
        "wr-slug"
      ],
      "parameters": {
        "flexDirection": "column",
        "minWidth": {
          "unit": "px",
          "value": 0
        },
        "rowGap": "var(--space-1)",
        "width": {
          "unit": "%",
          "value": 50
        }
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "wr-title",
      "type": "Text",
      "label": "Page title",
      "parent": "wr-main",
      "parameters": {
        "color": "var(--foreground)",
        "fontSize": "var(--text-base)",
        "fontWeight": "var(--font-semibold)",
        "minWidth": {
          "unit": "px",
          "value": 0
        },
        "textOverflow": "ellipsis"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "wr-slug",
      "type": "Text",
      "label": "Slug",
      "parent": "wr-main",
      "parameters": {
        "color": "var(--muted-foreground)",
        "fontFamily": "var(--font-mono)",
        "fontSize": "var(--text-xs)",
        "minWidth": {
          "unit": "px",
          "value": 0
        },
        "textOverflow": "ellipsis"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "wr-author",
      "type": "Text",
      "label": "Author name",
      "parent": "wr-row",
      "parameters": {
        "color": "var(--muted-foreground)",
        "fontSize": "var(--text-sm)",
        "minWidth": {
          "unit": "px",
          "value": 0
        },
        "textOverflow": "ellipsis",
        "width": {
          "unit": "%",
          "value": 25
        }
      },
      "x": 100,
      "y": 520
    },
    {
      "id": "wr-updated",
      "type": "Text",
      "label": "Updated date",
      "parent": "wr-row",
      "parameters": {
        "color": "var(--muted-foreground)",
        "fontSize": "var(--text-sm)",
        "minWidth": {
          "unit": "px",
          "value": 0
        },
        "textOverflow": "ellipsis",
        "width": {
          "unit": "%",
          "value": 20
        }
      },
      "x": 100,
      "y": 640
    },
    {
      "id": "wr-ci",
      "type": "Component Inputs",
      "label": "Page fields in",
      "ports": [
        {
          "name": "id",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "title",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "slug",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "author",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "updatedAt",
          "plug": "output",
          "type": "*"
        }
      ],
      "x": 410,
      "y": 280
    },
    {
      "id": "wr-co",
      "type": "Component Outputs",
      "label": "Row actions out",
      "ports": [
        {
          "name": "click",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 410,
      "y": 40
    },
    {
      "id": "wr-authorid",
      "type": "Expression",
      "label": "Author id",
      "parameters": {
        "expression": "typeof author === 'string' ? author : ((author && (author.id || author.objectId)) || '')"
      },
      "x": 410,
      "y": 760
    },
    {
      "id": "wr-authorrec",
      "type": "DbModel2",
      "label": "Author record",
      "parameters": {
        "collectionName": "TeamMember"
      },
      "x": 410,
      "y": 520
    },
    {
      "id": "wr-datefmt",
      "type": "Date To String",
      "label": "Updated date format",
      "parameters": {
        "formatString": "{d} {monthName} {year}",
        "locale": "fr-FR"
      },
      "x": 410,
      "y": 640
    }
  ],
  "visualRoots": [
    "wr-row"
  ]
}