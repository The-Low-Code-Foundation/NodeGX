{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "0894b2e4-bcf3-5407-8dcf-38f67052ba21",
  "version": 1,
  "nodes": [
    {
      "id": "mr-row",
      "type": "Group",
      "label": "Member row",
      "children": [
        "mr-avatar",
        "mr-main",
        "mr-email"
      ],
      "parameters": {
        "alignItems": "center",
        "borderBottomColor": "var(--border-subtle)",
        "borderBottomStyle": "solid",
        "borderBottomWidth": "var(--border-1)",
        "columnGap": "var(--space-4)",
        "flexDirection": "row",
        "paddingBottom": "var(--space-3)",
        "paddingTop": "var(--space-3)",
        "sizeMode": "contentHeight",
        "width": {
          "unit": "%",
          "value": 100
        }
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "mr-avatar",
      "type": "Group",
      "label": "Avatar disc",
      "parent": "mr-row",
      "children": [
        "mr-initials"
      ],
      "parameters": {
        "alignItems": "center",
        "backgroundColor": "var(--muted)",
        "borderRadius": "var(--radius-full)",
        "flexDirection": "row",
        "height": {
          "unit": "px",
          "value": 36
        },
        "justifyContent": "center",
        "sizeMode": "explicit",
        "width": {
          "unit": "px",
          "value": 36
        }
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "mr-initials",
      "type": "Text",
      "label": "Initials",
      "parent": "mr-avatar",
      "parameters": {
        "color": "var(--foreground)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "mr-main",
      "type": "Group",
      "label": "Name and role",
      "parent": "mr-row",
      "children": [
        "mr-name",
        "mr-role"
      ],
      "parameters": {
        "flexDirection": "column",
        "minWidth": {
          "unit": "px",
          "value": 0
        },
        "rowGap": "var(--space-1)",
        "width": {
          "unit": "%",
          "value": 45
        }
      },
      "x": 100,
      "y": 400
    },
    {
      "id": "mr-name",
      "type": "Text",
      "label": "Member name",
      "parent": "mr-main",
      "parameters": {
        "color": "var(--foreground)",
        "fontSize": "var(--text-base)",
        "fontWeight": "var(--font-semibold)",
        "minWidth": {
          "unit": "px",
          "value": 0
        },
        "textOverflow": "ellipsis"
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "mr-role",
      "type": "Text",
      "label": "Role",
      "parent": "mr-main",
      "parameters": {
        "color": "var(--muted-foreground)",
        "fontSize": "var(--text-sm)",
        "minWidth": {
          "unit": "px",
          "value": 0
        },
        "textOverflow": "ellipsis"
      },
      "x": 160,
      "y": 640
    },
    {
      "id": "mr-email",
      "type": "Text",
      "label": "Email",
      "parent": "mr-row",
      "parameters": {
        "color": "var(--muted-foreground)",
        "fontSize": "var(--text-sm)",
        "minWidth": {
          "unit": "px",
          "value": 0
        },
        "textOverflow": "ellipsis",
        "width": {
          "unit": "%",
          "value": 30
        }
      },
      "x": 100,
      "y": 760
    },
    {
      "id": "mr-ci",
      "type": "Component Inputs",
      "label": "Member fields in",
      "ports": [
        {
          "name": "id",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "name",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "role",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "email",
          "plug": "output",
          "type": "*"
        }
      ],
      "x": 410,
      "y": 520
    },
    {
      "id": "mr-co",
      "type": "Component Outputs",
      "label": "Row actions out",
      "ports": [
        {
          "name": "click",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 410,
      "y": 40
    },
    {
      "id": "mr-initialexpr",
      "type": "Expression",
      "label": "Initials",
      "parameters": {
        "expression": "(name || '?').split(' ').map(function (w) { return w.charAt(0); }).join('').slice(0, 2).toUpperCase()"
      },
      "x": 410,
      "y": 280
    }
  ],
  "visualRoots": [
    "mr-row"
  ]
}