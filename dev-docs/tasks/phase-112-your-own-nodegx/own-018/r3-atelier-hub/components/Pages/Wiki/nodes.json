{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "6105ff25-a0f2-531a-86f5-6f3081a41f63",
  "version": 1,
  "nodes": [
    {
      "id": "wk-page",
      "type": "Page",
      "label": "Wiki page",
      "children": [
        "wk-canvas"
      ],
      "parameters": {
        "title": "Wiki",
        "urlPath": "wiki"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "wk-canvas",
      "type": "Group",
      "label": "Page canvas",
      "parent": "wk-page",
      "children": [
        "wk-band"
      ],
      "parameters": {
        "alignItems": "center",
        "backgroundColor": "var(--background)",
        "flexDirection": "column",
        "sizeMode": "contentHeight",
        "width": {
          "unit": "%",
          "value": 100
        }
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "wk-band",
      "type": "Group",
      "label": "Band",
      "parent": "wk-canvas",
      "children": [
        "wk-shell"
      ],
      "parameters": {
        "alignItems": "center",
        "flexDirection": "column",
        "paddingBottom": "var(--space-20)",
        "paddingTop": "var(--space-12)",
        "sizeMode": "contentHeight",
        "width": {
          "unit": "%",
          "value": 100
        }
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "wk-shell",
      "type": "Group",
      "label": "Shell",
      "parent": "wk-band",
      "children": [
        "wk-listpanel",
        "wk-viewpanel",
        "wk-editorpanel"
      ],
      "parameters": {
        "flexDirection": "column",
        "maxWidth": {
          "unit": "px",
          "value": 900
        },
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "rowGap": "var(--space-8)",
        "sizeMode": "contentHeight",
        "width": {
          "unit": "%",
          "value": 100
        }
      },
      "x": 220,
      "y": 400
    },
    {
      "id": "wk-listpanel",
      "type": "Group",
      "label": "List panel",
      "parent": "wk-shell",
      "children": [
        "wk-header",
        "wk-list",
        "wk-empty"
      ],
      "parameters": {
        "flexDirection": "column",
        "rowGap": "var(--space-6)",
        "sizeMode": "contentHeight",
        "width": {
          "unit": "%",
          "value": 100
        }
      },
      "x": 280,
      "y": 520
    },
    {
      "id": "wk-header",
      "type": "/Components/PageHeader",
      "label": "Page header",
      "parent": "wk-listpanel",
      "children": [
        "wk-newbtn"
      ],
      "parameters": {
        "eyebrow": "Wiki",
        "lead": "How-tos and references. Anyone can write, anyone can edit.",
        "title": "Wiki"
      },
      "x": 340,
      "y": 640
    },
    {
      "id": "wk-newbtn",
      "type": "net.noodl.controls.button",
      "label": "New page",
      "parent": "wk-header",
      "parameters": {
        "backgroundColor": "var(--primary)",
        "borderRadius": "var(--radius-full)",
        "borderStyle": "none",
        "color": "var(--primary-foreground)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "label": "New page",
        "paddingBottom": "var(--space-3)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "sizeMode": "contentSize"
      },
      "x": 400,
      "y": 760
    },
    {
      "id": "wk-list",
      "type": "For Each",
      "label": "Wiki page rows",
      "parent": "wk-listpanel",
      "parameters": {
        "template": "/Components/WikiPageRow"
      },
      "x": 340,
      "y": 880
    },
    {
      "id": "wk-empty",
      "type": "/Components/EmptyState",
      "label": "Empty wiki",
      "parent": "wk-listpanel",
      "parameters": {
        "actionLabel": "New page",
        "body": "Write the first how-to — the team will thank you.",
        "title": "No pages yet"
      },
      "x": 340,
      "y": 1000
    },
    {
      "id": "wk-viewpanel",
      "type": "Group",
      "label": "View panel",
      "parent": "wk-shell",
      "children": [
        "wk-backrow",
        "wk-title",
        "wk-meta",
        "wk-body"
      ],
      "parameters": {
        "flexDirection": "column",
        "rowGap": "var(--space-6)",
        "sizeMode": "contentHeight",
        "width": {
          "unit": "%",
          "value": 100
        }
      },
      "x": 280,
      "y": 1120
    },
    {
      "id": "wk-backrow",
      "type": "Group",
      "label": "Back row",
      "parent": "wk-viewpanel",
      "children": [
