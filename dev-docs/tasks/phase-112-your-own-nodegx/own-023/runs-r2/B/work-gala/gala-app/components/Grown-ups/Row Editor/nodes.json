    {
      "id": "re_change",
      "type": "JavaScriptFunction",
      "label": "The change to send",
      "parameters": {
        "uses": "gala/editing.js",
        "runOnChange-in-row": false,
        "runOnChange-in-fr": false,
        "runOnChange-in-en": false,
        "runOnChange-in-d": false,
        "runOnChange-in-price": false,
        "runOnChange-in-min": false,
        "runOnChange-in-stars": false,
        "functionScript": "const c = Scripts.editing.changeFromRow(Inputs.row, {\n  fr: Inputs.fr, en: Inputs.en, d: Inputs.d, price: Inputs.price, min: Inputs.min, stars: Inputs.stars,\n});\nif (c.action === 'save') {\n  Outputs.table = c.table;\n  Outputs.rowId = c.rowId;\n  Outputs.fields = c.fields;\n  Outputs.save();\n} else if (c.action === 'remove') {\n  Outputs.undo();\n}\n"
      },
