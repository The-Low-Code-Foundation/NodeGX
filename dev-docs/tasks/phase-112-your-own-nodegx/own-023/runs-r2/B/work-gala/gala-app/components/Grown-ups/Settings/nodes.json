      },
      "x": 40,
      "y": 40
    },
    {
      "id": "st_school",
      "type": "/Grown-ups/Section",
      "label": "A new school",
      "parent": "st_root",
      "children": [
        "st_start_list"
      ],
      "parameters": {
        "title": "⭐ A new school",
        "hint": "How many stars a school starts with. A school already playing keeps its stars; a new school (in the game: Carnet ▸ Recommencer, or on a computer that has never played) starts with these."
      },
      "x": 100,
      "y": 160
    },
