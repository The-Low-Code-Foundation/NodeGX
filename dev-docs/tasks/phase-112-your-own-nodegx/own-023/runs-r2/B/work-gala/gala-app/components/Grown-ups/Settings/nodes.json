    {
      "id": "st_changes",
      "type": "DbCollection2",
      "label": "The saved changes",
      "parameters": {
        "collectionName": "GameChange",
        "storageEnableLimit": true,
        "storageLimit": 1000
      },
      "x": 410,
      "y": 280
    },
    {
      "id": "st_rows",
      "type": "JavaScriptFunction",
      "label": "What can be changed",
      "parameters": {
        "uses": "gala/editing.js",
        "functionScript": "if (Inputs.changes === undefined) return;\nconst data = await import('/gala-rules/src/data.js');\nconst rows = Scripts.editing.rowsToEdit(Inputs.changes, data);\nconst choices = Scripts.editing.choices(data);\nOutputs.start = rows.start;\nOutputs.moves = rows.moves;\nOutputs.outfits = rows.outfits;\nOutputs.hairs = rows.hairs;\nOutputs.shoes = rows.shoes;\nOutputs.accs = rows.accs;\nOutputs.freeStep = Scripts.editing.freeId(Inputs.changes, 'moves');\nOutputs.freeCostume = Scripts.editing.freeId(Inputs.changes, 'outfits');\nOutputs.stepChoices = choices.steps;\nOutputs.costumeChoices = choices.outfits;\nOutputs.icons = choices.icons;\n"
      },
      "metadata": {
        "comment": "The game's own rows come from gala-rules/src/data.js as shipped (this page never applies the changes), with the saved changes laid over them for display."
      },
      "x": 410,
      "y": 400,
