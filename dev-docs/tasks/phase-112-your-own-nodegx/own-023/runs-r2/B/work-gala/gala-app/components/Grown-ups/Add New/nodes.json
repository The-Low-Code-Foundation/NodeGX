    {
      "id": "an_compose",
      "type": "JavaScriptFunction",
      "label": "Compose the new row",
      "parameters": {
        "uses": "gala/editing.js",
        "runOnChange-in-table": false,
        "runOnChange-in-freeId": false,
        "runOnChange-in-fr": false,
        "runOnChange-in-en": false,
        "runOnChange-in-d": false,
        "runOnChange-in-price": false,
        "runOnChange-in-min": false,
        "runOnChange-in-like": false,
        "runOnChange-in-icon": false,
        "functionScript": "const refuse = (message) => { Outputs.message = message; Outputs.refused(); };\nif (!Inputs.freeId) return refuse('Twenty is the most a family can add here: remove one to add another.');\nif (!Inputs.icon) return refuse('Choose an icon.');\nconst data = await import('/gala-rules/src/data.js');\nconst form = { fr: Inputs.fr || '', en: Inputs.en || '', d: Inputs.d || '1', price: Inputs.price, min: Inputs.min, like: Inputs.like, icon: Inputs.icon };\nconst made = Inputs.table === 'moves' ? Scripts.editing.newStep(form, data) : Scripts.editing.newCostume(form, data);\nif (made.error) return refuse(made.error);\nOutputs.rowId = Inputs.freeId;\nOutputs.fields = made.fields;\nOutputs.send();\n"
      },
