{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nodegx": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@nodegx/mcp@0.2.4",
        "--allow-writes",
        "--screenshots-to-files"
      ],
      "enabled": true
    }
  },
  "provider": {
    "mistral": {
      "models": {
        "mistral-large-4": {
          "limit": {
            "context": 150000,
            "output": 32000
          }
        }
      }
    }
  }
}
