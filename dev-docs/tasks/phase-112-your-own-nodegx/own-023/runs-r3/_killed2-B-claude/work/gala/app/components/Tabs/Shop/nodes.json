    {
      "id": "sp_view",
      "type": "JavaScriptFunction",
      "label": "The shop's rows",
      "parameters": {
        "uses": "view/prep,view/common,game/text,rules/data,rules/engine",
        "functionScript": "if (!Inputs.save || !Inputs.save.school) return;\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\nconst v = Scripts.prep.shop(Inputs.save, Inputs.ui || {}, w);\nOutputs.title = v.title; Outputs.hint = w('shopHint');\nOutputs.cats = v.cats; Outputs.rows = v.rows;\nOutputs.showBd = v.showBackdrops; Outputs.bdH = w('backdropH'); Outputs.bds = v.backdrops;\n"
      },
