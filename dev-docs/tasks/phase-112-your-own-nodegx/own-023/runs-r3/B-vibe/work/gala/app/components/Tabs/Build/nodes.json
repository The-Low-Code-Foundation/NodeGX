      "type": "JavaScriptFunction",
      "label": "The dressing room's rows",
      "parameters": {
        "uses": "view/prep,view/common,game/text,rules/data,rules/engine",
        "functionScript": "if (!Inputs.save || !Inputs.save.school) return;\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\nconst v = Scripts.prep.build(Inputs.save, Inputs.ui || {}, w);\nOutputs.nameH = w('schoolName'); Outputs.name = v.name; Outputs.namePlaceholder = w('school');\nOutputs.title = w('buildH'); Outputs.fxH = w('fxH'); Outputs.fx = v.fx; Outputs.warnings = v.warnings;\nOutputs.hint = w('buildHint');\nOutputs.goLoge = w('goLoge'); Outputs.notInLoge = !v.inLoge; Outputs.inLoge = v.inLoge;\nOutputs.armed = v.armed && v.inLoge; Outputs.rotArm = w('rotateKey'); Outputs.cancel = w('cancel');\nOutputs.selected = v.selected && v.inLoge; Outputs.rotSel = w('rotate'); Outputs.movSel = w('move'); Outputs.delSel = v.removeLabel;\nOutputs.pieces = v.pieces;\n"
      },
