    {
      "id": "go_view",
      "type": "JavaScriptFunction",
      "label": "The snack table's rows",
      "parameters": {
        "uses": "view/prep,view/common,game/text,rules/data,rules/engine",
        "functionScript": "if (!Inputs.save || !Inputs.save.school) return;\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\nconst v = Scripts.prep.gouter(Inputs.save, {}, w);\nOutputs.title = w('gouterH');\nOutputs.snackH = w('snackH');\nOutputs.snackHint = w('snackHint');\nOutputs.snacks = v.snacks;\nOutputs.tableH = w('vGouter');\nOutputs.facts = v.facts;\nOutputs.hCls = w('kTable_0'); Outputs.hN = w('kTable_1'); Outputs.hKcal = w('kTable_2'); Outputs.hJuice = w('kTable_3');\nOutputs.table = v.table;\nOutputs.cakeLabel = w('cake'); Outputs.cake = v.cake;\nOutputs.bottlesLabel = w('bottles'); Outputs.bottles = v.bottles;\nOutputs.crepesLabel = w('crepes'); Outputs.crepes = v.crepes; Outputs.crepesOn = v.crepesOn;\nOutputs.compotesLabel = w('compotes'); Outputs.compotes = v.compotes; Outputs.compotesOn = v.compotesOn;\nOutputs.hint = w('gouterHint');\n"
      },
