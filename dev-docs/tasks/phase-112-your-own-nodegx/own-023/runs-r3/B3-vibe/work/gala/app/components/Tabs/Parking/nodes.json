    {
      "id": "pk_view",
      "type": "JavaScriptFunction",
      "label": "The car park's rows",
      "parameters": {
        "uses": "view/prep,view/common,game/text,rules/data,rules/engine",
        "functionScript": "if (!Inputs.save || !Inputs.save.school || Inputs.save.season < 2) return;\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\nconst v = Scripts.prep.parking(Inputs.save, {}, w);\nOutputs.title = w('parkH'); Outputs.hint = w('parkHint'); Outputs.facts = v.facts;\nOutputs.wH = w('bayWidth'); Outputs.widths = v.widths; Outputs.warn = w('narrowWarn'); Outputs.narrow = v.narrow;\nOutputs.dH = w('doors'); Outputs.doors = v.doors;\nOutputs.uH = w('parkUpgrades'); Outputs.ups = v.upgrades;\n"
      },
