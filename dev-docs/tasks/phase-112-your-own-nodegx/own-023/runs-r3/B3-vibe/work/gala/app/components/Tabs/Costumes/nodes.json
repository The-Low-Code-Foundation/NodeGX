      "id": "co_view",
      "type": "JavaScriptFunction",
      "label": "The costume tab's rows",
      "parameters": {
        "uses": "view/prep,view/common,game/text,rules/data,rules/engine",
        "functionScript": "if (!Inputs.save || !Inputs.save.school) return;\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\nconst v = Scripts.prep.costumes(Inputs.save, Inputs.ui || {}, w);\nOutputs.title = w('costH'); Outputs.hint = w('costHint');\nOutputs.nums = v.numChips;\nOutputs.outH = w('outfit'); Outputs.outfits = v.outfits;\nOutputs.colH = w('colour'); Outputs.colors = v.colors;\nOutputs.shoeH = w('shoes'); Outputs.shoes = v.shoes;\nOutputs.warn = w('pointesWarn'); Outputs.shoeWarn = v.shoeWarn;\nOutputs.accH = w('acc'); Outputs.accs = v.accs;\nOutputs.suits = w('suits');\nOutputs.hairH = w('hairH'); Outputs.hair = v.hair;\n"
      },
