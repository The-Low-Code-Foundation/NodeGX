    {
      "id": "rs_view",
      "type": "JavaScriptFunction",
      "label": "The verdicts",
      "parameters": {
        "uses": "view/run,view/formation,view/common,game/text,rules/data,rules/engine,rules/tunes",
        "functionScript": "if (!Inputs.show || !Inputs.save || !Inputs.res || !Inputs.live) return;\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\nconst v = Scripts.run.results(Inputs.res, Inputs.live, Inputs.save, w);\nOutputs.title = v.title; Outputs.points = v.points; Outputs.note = v.note; Outputs.ptsList = v.ptsList; Outputs.verdicts = v.verdicts;\nOutputs.isTry = v.isTry; Outputs.stepsH = w('step_head');\nif (v.steps) { Outputs.stepsSum = v.steps.summary; Outputs.blocks = v.steps.blocks; }\n"
      },
