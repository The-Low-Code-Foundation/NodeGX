        "keys": "save"
      },
      "x": 40,
      "y": 280
    },
    {
      "id": "dp_ui",
      "type": "net.noodl.GlobalStore.Subscribe",
      "parameters": {
        "storeName": "ui",
        "keys": "ui"
      },
      "x": 40,
      "y": 400
    },
    {
      "id": "dp_res",
      "type": "net.noodl.GlobalStore.Subscribe",
