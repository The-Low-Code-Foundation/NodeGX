        "keys": "live"
      },
      "x": 40,
      "y": 640
    },
    {
      "id": "dp_words",
      "type": "Variable2",
      "label": "words (shared on purpose)",
      "parameters": {
        "name": "words"
      },
      "x": 40,
      "y": 760
    },
    {
      "id": "dp_fn",
      "type": "JavaScriptFunction",
      "label": "What the press changes",
      "parameters": {
        "uses": "game/dispatch,game/actions,game/save,game/text,view/run,view/common,view/formation,view/prep,settings/check,rules/data,rules/engine,rules/plan",
        "runOnChange-in-act": false,
        "runOnChange-in-arg": false,
        "runOnChange-in-save": false,
        "runOnChange-in-ui": false,
        "runOnChange-in-res": false,
        "runOnChange-in-live": false,
        "runOnChange-in-words": false,
        "runOnChange-in-stage": false,
        "scriptOutputs": [
          {
            "id": "save",
            "label": "save"
          },
          {
            "id": "saveChanged",
            "label": "saveChanged"
          },
          {
            "id": "ui",
            "label": "ui"
          },
          {
            "id": "uiChanged",
            "label": "uiChanged"
          },
          {
            "id": "res",
            "label": "res"
          },
          {
            "id": "resChanged",
            "label": "resChanged"
          },
          {
            "id": "live",
            "label": "live"
          },
          {
            "id": "liveChanged",
            "label": "liveChanged"
          },
          {
            "id": "toast",
            "label": "toast"
          },
          {
            "id": "toastChanged",
            "label": "toastChanged"
          }
        ],
        "outtype-save": "object",
        "outtype-saveChanged": "signal",
        "outtype-ui": "object",
        "outtype-uiChanged": "signal",
        "outtype-res": "object",
        "outtype-resChanged": "signal",
        "outtype-live": "object",
        "outtype-liveChanged": "signal",
        "outtype-toast": "object",
        "outtype-toastChanged": "signal",
        "functionScript": "if (!Inputs.save) return;\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\nconst ui = { ...(Inputs.ui || {}), res: Inputs.res || null, live: Inputs.live || null };\nconst r = Scripts.dispatch.dispatch(Inputs.act, Inputs.arg, Inputs.save, ui, w, Inputs.stage) || {};\nif (r.save) { Outputs.save = r.save; Outputs.saveChanged(); }\nif (r.ui) {\n  const { res, live, ...patch } = r.ui;\n  if ('res' in r.ui) { Outputs.res = res; Outputs.resChanged(); }\n  if ('live' in r.ui) { Outputs.live = live; Outputs.liveChanged(); }\n  if (Object.keys(patch).length) { Outputs.ui = patch; Outputs.uiChanged(); }\n}\nif (r.toast) { Outputs.toast = { text: r.toast, n: Date.now() }; Outputs.toastChanged(); }\n"
      },
      "metadata": {
        "comment": "Runs only on a press (every input's Run On Value Change is off). scripts/game/dispatch.js decides; this writes nothing itself, it hands the answer to the Set Global Store nodes."
      },
      "x": 40,
      "y": 880,
      "ports": [
        {
          "name": "out-save",
          "displayName": "save",
          "plug": "output",
          "type": "object",
          "group": "Outputs"
        },
        {
          "name": "out-saveChanged",
          "displayName": "saveChanged",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-ui",
          "displayName": "ui",
          "plug": "output",
          "type": "object",
          "group": "Outputs"
        },
        {
          "name": "out-uiChanged",
          "displayName": "uiChanged",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-res",
          "displayName": "res",
          "plug": "output",
          "type": "object",
          "group": "Outputs"
        },
        {
          "name": "out-resChanged",
          "displayName": "resChanged",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-live",
          "displayName": "live",
          "plug": "output",
          "type": "object",
          "group": "Outputs"
        },
        {
          "name": "out-liveChanged",
          "displayName": "liveChanged",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-toast",
          "displayName": "toast",
          "plug": "output",
          "type": "object",
          "group": "Outputs"
        },
        {
          "name": "out-toastChanged",
          "displayName": "toastChanged",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "in-save",
          "displayName": "save",
          "plug": "input",
