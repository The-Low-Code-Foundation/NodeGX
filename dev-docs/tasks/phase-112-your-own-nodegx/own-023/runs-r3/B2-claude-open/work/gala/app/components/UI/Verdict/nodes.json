          "value": 100,
          "unit": "%"
        }
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "vd_badge",
      "type": "Text",
      "parent": "vd_head",
      "parameters": {
        "fontWeight": "var(--font-extrabold)",
