    {
      "id": "vd_open",
      "type": "Switch",
      "label": "Why? open",
      "x": 410,
      "y": 760
    },
    {
      "id": "vd_look",
      "type": "States",
      "label": "Perfect or to fix",
      "parameters": {
        "states": "fix,ok",
        "values": "border",
        "type-border": "color",
        "value-fix-border": "var(--warning)",
        "value-ok-border": "var(--success)"
      },
      "x": 410,
      "y": 40
    },
    {
      "id": "vd_state",
      "type": "Boolean To String",
      "parameters": {
        "trueString": "ok",
        "falseString": "fix"
      },
      "x": 410,
      "y": 880
    },
    {
      "id": "vd_arrow",
      "type": "String Format",
      "parameters": {
        "format": "▸ {why}"
      },
      "x": 410,
      "y": 640
