        "fontSize": "var(--text-sm)"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "vd_says",
      "type": "Text",
      "parent": "vd_root",
      "parameters": {
        "fontSize": "var(--text-sm)",
        "lineHeight": "var(--leading-snug)",
        "styleCss": "white-space: pre-line;"
      },
      "x": 100,
      "y": 520
    },
    {
      "id": "vd_whybtn",
      "type": "Text",
      "label": "Why? toggle",
