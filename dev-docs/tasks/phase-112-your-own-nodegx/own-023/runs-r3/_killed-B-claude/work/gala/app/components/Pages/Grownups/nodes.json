        "outtype-fields": "object",
        "outtype-send": "signal",
        "outtype-message": "string",
        "outtype-said": "signal",
        "functionScript": "const lang = (Inputs.save && Inputs.save.lang) || 'fr';\nconst w = Scripts.text.words([...(Inputs.words || []), ...(Inputs.gwords || [])], lang);\nconst c = { table: 'start', rowId: 'row', fields: { stars: Number(Inputs.stars) } };\nconst p = Scripts.grownups.precheck(c, w);\nif (!p.ok) { Outputs.message = p.message; Outputs.said(); return; }\nOutputs.table = c.table; Outputs.rowId = c.rowId; Outputs.fields = c.fields;\nOutputs.send();\n"
