    {
      "id": "gp_view",
      "type": "JavaScriptFunction",
      "label": "What the page shows",
      "parameters": {
        "uses": "view/grownups,game/text,settings/check,rules/data",
        "functionScript": "const lang = (Inputs.save && Inputs.save.lang) || 'fr';\nconst w = Scripts.text.words([...(Inputs.words || []), ...(Inputs.gwords || [])], lang);\nconst G = Scripts.grownups;\nconst roles = (Inputs.roles || []).map((r) => (typeof r === 'string' ? r : r && (r.name || (r.get && r.get('name')))));\nconst signedIn = !!Inputs.authenticated, grownup = signedIn && roles.includes('grownup');\nconst table = G.TABLE_KEYS.includes(Inputs.table) ? Inputs.table : 'moves';\nOutputs.title = w('g_title'); Outputs.intro = w('g_intro'); Outputs.back = w('g_back');\nOutputs.message = Inputs.message || '';\nOutputs.needSignIn = !signedIn; Outputs.notGrownup = signedIn && !grownup; Outputs.isGrownup = grownup;\nOutputs.siH = w('g_signinH'); Outputs.user = w('g_user'); Outputs.pass = w('g_pass'); Outputs.login = w('g_login'); Outputs.signup = w('g_signup'); Outputs.siHint = w('g_signupHint');\nOutputs.notGText = w('g_notGrownup'); Outputs.logout = w('g_logout'); Outputs.who = w('g_signedAs', Inputs.username || '');\nOutputs.tables = G.tables(table, w); Outputs.applyNote = w('g_applyNote'); Outputs.openGame = w('g_openGame');\nOutputs.rows = G.rows(table, Inputs.changes || [], w).map((r) => ({ ...r, saveLabel: w('g_save'), resetLabel: w('g_reset'), frLabel: w('gf_fr'), enLabel: w('gf_en') }));\nOutputs.isStart = table === 'start'; Outputs.startH = w('g_startH'); Outputs.startHint = w('g_startHint'); Outputs.stars = String(Scripts.data.START.stars); Outputs.save = w('g_save');\nOutputs.isMoves = table === 'moves'; Outputs.isOutfits = table === 'outfits';\nOutputs.savedText = w('g_saved'); Outputs.removedText = w('g_removed');\nconst o = G.options(w);\nOutputs.nsTitle = w('g_newStepH'); Outputs.ncTitle = w('g_newCostumeH'); Outputs.add = w('g_add');\nOutputs.frL = w('gf_fr'); Outputs.enL = w('gf_en'); Outputs.dL = w('gf_d'); Outputs.cL = w('gf_c'); Outputs.iconL = w('gf_icon'); Outputs.stL = w('gf_st'); Outputs.aL = w('gf_a'); Outputs.bL = w('gf_b'); Outputs.minL = w('gf_min'); Outputs.priceL = w('gf_price'); Outputs.themeL = w('gf_theme');\nOutputs.diffs = o.diffs; Outputs.counts = o.counts; Outputs.icons = o.icons; Outputs.styles = o.styles; Outputs.levels = o.levels; Outputs.themes = o.themes;\n"
      },
