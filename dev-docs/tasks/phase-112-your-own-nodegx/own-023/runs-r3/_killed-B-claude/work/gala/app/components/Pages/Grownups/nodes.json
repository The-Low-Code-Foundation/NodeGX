    {
      "id": "gp_stars",
      "type": "JavaScriptFunction",
      "label": "A new school's stars to send",
      "parameters": {
        "uses": "view/grownups,game/text,settings/check,rules/data",
        "runOnChange-in-stars": false,
        "runOnChange-in-words": false,
        "runOnChange-in-gwords": false,
        "runOnChange-in-save": false,
        "scriptOutputs": [
          {
            "id": "table",
