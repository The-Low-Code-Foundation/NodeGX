    {
      "id": "gp_change",
      "type": "JavaScriptFunction",
      "label": "A change to send",
      "parameters": {
        "uses": "view/grownups,game/text,settings/check,rules/data",
        "runOnChange-in-rowId": false,
        "runOnChange-in-rowValues": false,
        "runOnChange-in-stepValues": false,
        "runOnChange-in-costumeValues": false,
        "runOnChange-in-table": false,
        "runOnChange-in-words": false,
        "runOnChange-in-gwords": false,
        "runOnChange-in-save": false,
        "scriptOutputs": [
          {
            "id": "table",
            "label": "table"
          },
          {
            "id": "rowId",
            "label": "rowId"
          },
          {
            "id": "fields",
            "label": "fields"
          },
          {
            "id": "send",
            "label": "send"
          },
          {
            "id": "message",
            "label": "message"
          },
          {
            "id": "said",
            "label": "said"
          }
        ],
        "outtype-table": "string",
        "outtype-rowId": "string",
        "outtype-fields": "object",
        "outtype-send": "signal",
        "outtype-message": "string",
        "outtype-said": "signal",
        "functionScript": "const lang = (Inputs.save && Inputs.save.lang) || 'fr';\nconst w = Scripts.text.words([...(Inputs.words || []), ...(Inputs.gwords || [])], lang);\nconst G = Scripts.grownups;\nconst at = (v) => (v && v.at) || 0;\nconst latest = Math.max(at(Inputs.rowValues), at(Inputs.stepValues), at(Inputs.costumeValues));\nlet c = null;\nif (latest && latest === at(Inputs.rowValues)) c = G.rowChange(Inputs.table || 'moves', Inputs.rowId, Inputs.rowValues);\nelse if (latest && latest === at(Inputs.stepValues)) c = G.newStep(Inputs.stepValues);\nelse if (latest && latest === at(Inputs.costumeValues)) c = G.newCostume(Inputs.costumeValues);\nconst p = G.precheck(c, w);\nif (!p.ok) { Outputs.message = p.message; Outputs.said(); return; }\nOutputs.table = c.table; Outputs.rowId = c.rowId; Outputs.fields = c.fields;\nOutputs.send();\n"
      },
      "metadata": {
        "comment": "Three forms feed one change: a row's Save, a new step, a new costume (the most recent one pressed wins; each form stamps its values with the time). The same check as the cloud function runs here first, so the grown-up hears at once what is wrong; the cloud function checks again and is the one that counts."
      },
      "x": 650,
      "y": 3280,
      "ports": [
        {
          "name": "out-table",
          "displayName": "table",
          "plug": "output",
          "type": "string",
          "group": "Outputs"
        },
        {
          "name": "out-rowId",
          "displayName": "rowId",
          "plug": "output",
          "type": "string",
          "group": "Outputs"
        },
        {
          "name": "out-fields",
          "displayName": "fields",
          "plug": "output",
          "type": "object",
          "group": "Outputs"
        },
        {
          "name": "out-send",
          "displayName": "send",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-message",
          "displayName": "message",
          "plug": "output",
          "type": "string",
          "group": "Outputs"
        },
        {
          "name": "out-said",
          "displayName": "said",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "in-save",
          "displayName": "save",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
