        "functionScript": "const lang = (Inputs.save && Inputs.save.lang) || 'fr';\nconst w = Scripts.text.words([...(Inputs.words || []), ...(Inputs.gwords || [])], lang);\nconst e = String(Inputs.error || '');\nconst key = `gm_${e}`;\nOutputs.message = w.has(key) ? w(key) : e ? `${w('gm_network')} (${e.slice(0, 80)})` : w('gm_network');\nOutputs.said();\n"
