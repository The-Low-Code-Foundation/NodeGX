npm cache ---\"; ls ~/.npm/_npx 2>/dev/null | head; echo \"--- global ---\"; npm ls -g --depth=0 2>/dev/null | head -20'", "code": null, "details": null}, "output": null, "outputText": "", "durationMs": 0.0, "display": {"success": false, "verb": "", "message": "bash failed: Command timed out after 300s: 'find / -maxdepth 6 -type d -name \"@nodegx\" 2>/dev/null | head; echo \"---\"; find / -maxdepth 8 -type d -path \\'*node_modules/@nodegx*\\' 2>/dev/null | head -20; echo \"--- npm cache ---\"; ls ~/.npm/_npx 2>/dev/null | head; echo \"--- global ---\"; npm ls -g --depth=0 2>/dev/null | head -20'", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
