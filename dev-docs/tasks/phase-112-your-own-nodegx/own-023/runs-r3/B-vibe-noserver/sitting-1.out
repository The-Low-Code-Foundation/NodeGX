{"id": "d3ca499c-99ad-4ccf-a7fc-909094e9c9b2", "sessionId": "25505b9f-a8ea-dd62-6b8d-be45f136b4b6", "turnId": "5093e3ac-9153-41c4-bc70-29af6171bbc2", "inputEntryId": null, "createdAt": 1792605329145, "updatedAt": 1792605329179, "generationStatus": "completed", "relatedEntryId": null, "type": "reasoning", "text": "Now I understand the core: the save lives in a persisted GlobalStore \"gala\" under key \"save\", stored in localStorage under key \"gala-game-v2\". Every press goes through the dispatcher, which writes the new save back to the store.\n\nNow let me read the remaining scripts: game/actions.js, rules/engine.js, rules/plan.js, rules/data.js, view/run.js, view/prep.js, view/common.js, view/frame.js, view/formation.js, game/text.js. And the gala-rules tests. Let me read the most relevant ones for the plan: rules/plan.js (save shape), rules/data.js (tables), game/actions.js (what changes the save).\n\nLet me read them.", "summary": []}
{"id": "call_91a73fdd1ffd41319359928c", "sessionId": "25505b9f-a8ea-dd62-6b8d-be45f136b4b6", "turnId": "5093e3ac-9153-41c4-bc70-29af6171bbc2", "inputEntryId": null, "createdAt": 1792605329184, "updatedAt": 1792605329195, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "read_file", "detail": {"toolName": "read_file", "display": {"summary": "Reading app/scripts/game/actions.js", "content": null, "suffix": "", "verb": "Reading", "message": "app/scripts/game/actions.js", "settledVerb": "Read", "settledMessage": "app/scripts/game/actions.js", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/game/actions.js", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/game/actions.js", "content": "        1→// What a press does to the save: the onclick handlers of reference/src/ui.js, as pure functions. Each takes the save\n        2→// and the screen state and returns { save, ui, toast } — only the parts that changed. The graph writes them back\n        3→// into the Global Stores; nothing here touches the page.\n        4→const { RULES, NUMBERS, MOVES, MAX_MOVES, OUTFITS, HAIRS, SHOES, ACCS, PIECES, LOGE, SNACKS, UPGRADES } = use('rules/data');\n        5→const { clamp, isOwned, fits, footprint, routineInfo, danceOf, stageOf } = use('rules/engine');\n        6→const { pickedNum } = use('view/common');\n        7→const { geometry } = use('view/formation');\n        8→const { foodPrice } = use('view/prep');\n        9→const { cleanName } = use('settings/check');\n       10→\n       11→const copy = (o) => JSON.parse(JSON.stringify(o));\n       12→const MAX_BLOCKS = 8, MAX_CHAIN = 60;\n       13→\n       14→// buying: a price in stars, kept for good\n       15→function buy(save, kind, id, w) {\n       16→  const price = kind === 'up' ? UPGRADES[id].price : kind === 'food' ? foodPrice(id) : (({ outfit: OUTFITS, hair: HAIRS, shoes: SHOES, acc: ACCS, piece: PIECES, snack: SNACKS })[kind][id].price || 0);\n       17→  const name = kind === 'up' ? w.nm(UPGRADES[id]) : kind === 'food' ? w(`foods_${id}`) : w.nm(({ outfit: OUTFITS, hair: HAIRS, shoes: SHOES, acc: ACCS, piece: PIECES, snack: SNACKS })[kind][id]);\n       18→  const sc = save.school;\n       19→  if (sc.stars < price) return { ok: false, toast: w('notEnough') };\n       20→  sc.stars -= price;\n       21→  if (kind === 'up') sc.upgrades[id] = id === 'sieges' ? (sc.upgrades[id] || 0) + 1 : true;\n       22→  else sc.owned[`${kind}:${id}`] = true;\n       23→  if (kind === 'up' && id === 'logeXL') sc.logeCols = LOGE.colsBig;\n       24→  if (kind === 'up' && id.startsWith('decor')) save.plan.backdrop = { decorForet: 'foret', decorMer: 'mer', decorVille: 'ville' }[id];\n       25→  return { ok: true, toast: w('bought', name) };\n       26→}\n       27→\n       28→/* ---------------- the programme ---------------- */\n       29→function orderStep(save0, which, d) {\n       30→  const save = copy(save0), P = save.plan;\n       31→  if (which === 'start') P.start = clamp(P.start + d * 300, RULES.startMin, RULES.startMax);\n       32→  if (which === 'interval') P.interval = clamp(P.interval + d * 300, RULES.intervalMin, RULES.intervalMax);\n       33→  return { save };\n       34→}\n       35→function moveCard(save0, id, d) {\n       36→  const save = copy(save0), o = save.plan.order, i = o.indexOf(id), j = clamp(i + d, 1, o.length - 2);\n       37→  if (i < 1 || i === j) return {};\n       38→  o.splice(i, 1); o.splice(j, 0, id);\n       39→  return { save };\n       40→}\n       41→\n       42→/* ---------------- the formation and the choreography ---------------- */\n       43→function formationAct(save0, ui0, act, arg, w) {\n       44→  const save = copy(save0), ui = copy(ui0), id = pickedNum(save, ui, 'G1'), N = NUMBERS[id], np = save.plan.numbers[id];\n       45→  ui.selBlock = ui.selBlock || {};\n       46→  const bid = np.blocks.some((b) => b.id === ui.selBlock[id]) ? ui.selBlock[id] : np.blocks[0].id, blk = np.blocks.find((b) => b.id === bid);\n       47→  const free = () => 'abcdefgh'.split('').find((c) => !np.blocks.some((b) => b.id === c));\n       48→  const moveIn = (list, k, d) => { const j = clamp(k + d, 0, list.length - 1); if (j !== k) { const [x] = list.splice(k, 1); list.splice(j, 0, x); } return j; };\n       49→  switch (act) {\n       50→    case 'pickNum': return { ui: { ...ui0, pickNum: arg, pickDancer: null, editB: false, selMove: null, selChain: null } };\n       51→    case 'ab': {\n       52→      if (arg === 'B' && !np.B) np.B = np.A.map((p) => ({ ...p }));\n       53→      return { save, ui: { ...ui0, editB: arg === 'B' } };\n       54→    }\n       55→    case 'block': return { ui: { ...ui, selBlock: { ...ui.selBlock, [id]: arg }, selMove: null } };\n       56→    case 'newBlock': case 'copyBlock': {\n       57→      if (np.blocks.length >= MAX_BLOCKS) return { toast: w('maxBlocks') };\n       58→      const f = free();\n       59→      np.blocks.push(act === 'newBlock' ? { id: f, name: f.toUpperCase(), moves: [] } : { id: f, name: `${blk.name} 2`.slice(0, 24), moves: [...blk.moves] });\n       60→      return { save, ui: { ...ui, selBlock: { ...ui.selBlock, [id]: f }, selMove: null } };\n       61→    }\n       62→    case 'renameBlock': {\n       63→      const name = cleanName(arg, 24);\n       64→      if (!name) return { toast: w('nameRefused') };\n       65→      blk.name = name; return { save };\n       66→    }\n       67→    case 'delBlock': {\n       68→      if (np.blocks.length < 2) return {};\n       69→      np.blocks = np.blocks.filter((b) => b !== blk); np.chain = np.chain.filter((x) => x !== bid);\n       70→      return { save, ui: { ...ui, selChain: null, selMove: null } };\n       71→    }\n       72→    case 'step': return { ui: { ...ui0, selMove: ui0.selMove === arg ? null : arg } };\n       73→    case 'stepTool': {\n       74→      const k = ui.selMove; if (k === null || k === undefined || !blk.moves[k]) return {};\n       75→      if (arg === 'x') { blk.moves.splice(k, 1); return { save, ui: { ...ui0, selMove: null } }; }\n       76→      return { save, ui: { ...ui0, selMove: moveIn(blk.moves, k, arg) } };\n       77→    }\n       78→    case 'addMove': {\n       79→      if (!MOVES[arg]) return {};\n       80→      if (blk.moves.length >= MAX_MOVES) return { toast: w('maxMoves') };\n       81→      blk.moves.push(arg);\n       82→      if (MOVES[arg].swap && !np.B) np.B = np.A.map((p) => ({ ...p }));\n       83→      return { save };\n       84→    }\n       85→    case 'chain': return { ui: { ...ui0, selChain: ui0.selChain === arg ? null : arg } };\n       86→    case 'chainTool': {\n       87→      const k = ui.selChain; if (k === null || k === undefined || k >= np.chain.length) return {};\n       88→      if (arg === 'x') { np.chain.splice(k, 1); return { save, ui: { ...ui0, selChain: null } }; }\n       89→      return { save, ui: { ...ui0, selChain: moveIn(np.chain, k, arg) } };\n       90→    }\n       91→    case 'addChain': {\n       92→      if (np.chain.length >= MAX_CHAIN) return { toast: w('maxChain') };\n       93→      np.chain.push(bid); return { save };\n       94→    }\n       95→    case 'filter': return { ui: { ...ui0, allMoves: arg === 'all' } };\n       96→    case 'pickDancer': return { ui: { ...ui0, pickDancer: arg } };\n       97→    case 'dropDancer': {\n       98→      // arg: { index, left, top } — the dot's new top-left corner on the plan, in pixels\n       99→      const g = geometry(stageOf(save.school)), info = routineInfo(danceOf(np).moves, N.style, false);\n      100→      const F = ui.editB && info.swaps && np.B ? np.B : np.A, size = 0.6 * g.k;\n      101→      const x = (arg.left + size / 2) / g.k - g.W - 0.9, z = g.D + 0.5 - (arg.top + size / 2) / g.k;\n      102→      if (!F[arg.index]) return {};\n      103→      F[arg.index] = { x: clamp(Math.round(x * 2) / 2, -g.W - 0.5, g.W + 0.5), z: clamp(Math.round(z * 2) / 2, 0, g.D) };\n      104→      return { save, ui: { ...ui0, pickDancer: arg.index } };\n      105→    }\n      106→    default: return {};\n      107→  }\n      108→}\n      109→\n      110→/* ---------------- the goûter ---------------- */\n      111→function gouterStep(save0, which, d) {\n      112→  const save = copy(save0), P = save.plan;\n      113→  if (which === 'cake') P.cakeG = clamp(P.cakeG + d * 50, 0, 8000);\n      114→  if (which === 'bottles') P.bottles = clamp(P.bottles + d, 0, 20);\n      115→  if (which === 'crepes') P.crepes = clamp((P.crepes || 0) + d, 0, 60);\n      116→  if (which === 'compotes') P.compotes = clamp((P.compotes || 0) + d, 0, 60);\n      117→  return { save };\n      118→}\n      119→function snack(save0, id, w) {\n      120→  if (!SNACKS[id]) return {};\n      121→  const save = copy(save0);\n      122→  if (!isOwned(save.school, 'snack', id)) { const b = buy(save, 'snack', id, w); if (!b.ok) return { toast: b.toast }; save.plan.snack = id; return { save, toast: b.toast }; }\n      123→  save.plan.snack = id; return { save };\n      124→}\n      125→\n      126→/* ---------------- the costumes ---------------- */\n      127→function costume(save0, ui, act, arg, w) {\n      128→  const save = copy(save0), id = pickedNum(save, ui), cos = save.plan.numbers[id].costume;\n      129→  if (act === 'pickNum') return { ui: { ...ui, pickNum: arg } };\n      130→  if (act === 'color') { cos.color = arg; return { save }; }\n      131→  let toast;\n      132→  if (act === 'item') {\n      133→    const [kind, k] = String(arg).split(':'), list = { outfit: OUTFITS, shoes: SHOES, acc: ACCS }[kind];\n      134→    if (!list || !list[k]) return {};\n      135→    if (!isOwned(save.school, kind, k)) { const b = buy(save, kind, k, w); if (!b.ok) return { toast: b.toast }; toast = b.toast; }\n      136→    cos[kind === 'outfit' ? 'outfit' : kind === 'shoes' ? 'shoes' : 'acc'] = k;\n      137→    return { save, toast };\n      138→  }\n      139→  if (act === 'hair') {\n      140→    const [cls, k] = String(arg).split(':');\n      141→    if (!HAIRS[k]) return {};\n      142→    if (!isOwned(save.school, 'hair', k)) { const b = buy(save, 'hair', k, w); if (!b.ok) return { toast: b.toast }; toast = b.toast; }\n      143→    save.plan.hair[cls] = k;\n      144→    return { save, toast };\n      145→  }\n      146→  return {};\n      147→}\n      148→\n      149→/* ---------------- the dressing room ---------------- */\n      150→function build(save0, ui0, act, arg, w) {\n      151→  const save = copy(save0), ui = copy(ui0), sc = save.school, cols = sc.logeCols;\n      152→  const same = (a, b) => a && b && a.id === b.id && a.c === b.c && a.r === b.r && a.rot === b.rot;\n      153→  const selIndex = ui.selected ? sc.furniture.findIndex((f) => same(f, ui.selected)) : -1;\n      154→  switch (act) {\n      155→    case 'name': {\n      156→      const name = cleanName(arg, 40);\n      157→      if (name === null) return { toast: w('nameRefused') };\n      158→      sc.name = name; return { save };\n      159→    }\n      160→    case 'piece': {\n      161→      if (!PIECES[arg]) return {};\n      162→      let toast;\n      163→      if (!isOwned(sc, 'piece', arg)) { const b = buy(save, 'piece', arg, w); if (!b.ok) return { toast: b.toast }; toast = b.toast; }\n      164→      return { save, toast, ui: { ...ui0, armed: ui0.armed && ui0.armed.id === arg ? null : { id: arg, rot: 0 }, selected: null } };\n      165→    }\n      166→    case 'rotateArmed': return ui.armed ? { ui: { ...ui0, armed: { ...ui.armed, rot: (ui.armed.rot + 1) % 4 } } } : {};\n      167→    case 'cancelArmed': {\n      168→      if (ui.armed && ui.armed.was) sc.furniture.push(ui.armed.was);\n      169→      return { save, ui: { ...ui0, armed: null } };\n      170→    }\n      171→    case 'rotateSelected': {\n      172→      if (selIndex < 0) return {};\n      173→      const f = sc.furniture[selIndex], old = { c: f.c, r: f.r, rot: f.rot };\n      174→      f.rot = (f.rot + 1) % 4;\n      175→      if (!fits(f, sc.furniture, cols, f)) { const fp = footprint(f); f.c = clamp(f.c, 0, cols - fp.w); f.r = clamp(f.r, 0, LOGE.rows - fp.d); if (!fits(f, sc.furniture, cols, f)) Object.assign(f, old); }\n      176→      return { save, ui: { ...ui0, selected: { ...f } } };\n      177→    }\n      178→    case 'moveSelected': {\n      179→      if (selIndex < 0) return {};\n      180→      const [f] = sc.furniture.splice(selIndex, 1);\n      181→      return { save, ui: { ...ui0, armed: { id: f.id, rot: f.rot, was: f }, selected: null } };\n      182→    }\n      183→    case 'removeSelected': {\n      184→      if (selIndex < 0) return {};\n      185→      sc.furniture.splice(selIndex, 1);\n      186→      return { save, ui: { ...ui0, selected: null } };\n      187→    }\n      188→    case 'place': {\n      189→      // arg: { id, c, r, rot } — the 3D view says where the ghost stood when she tapped\n      190→      if (!ui.armed || !PIECES[arg.id] || !fits(arg, sc.furniture, cols)) return {};\n      191→      const f = { id: arg.id, c: arg.c, r: arg.r, rot: arg.rot };\n      192→      sc.furniture.push(f);\n      193→      return { save, ui: { ...ui0, selected: { ...f }, armed: ui.armed.was ? null : ui.armed } };\n      194→    }\n      195→    case 'select': return { ui: { ...ui0, selected: arg ? { ...arg } : null } };\n      196→    default: return {};\n      197→  }\n      198→}\n      199→\n      200→/* ---------------- the car park and the shop ---------------- */\n      201→function parking(save0, act, arg, w) {\n      202→  const save = copy(save0), P = save.plan;\n      203→  if (act === 'width') P.parking.width = Number(arg);\n      204→  if (act === 'doors') P.parking.doors = Number(arg);\n      205→  if (act === 'up') { if (save.school.upgrades[arg] || !UPGRADES[arg]) return {}; const b = buy(save, 'up', arg, w); return b.ok ? { save, toast: b.toast } : { toast: b.toast }; }\n      206→  return { save };\n      207→}\n      208→function shop(save0, act, arg, w) {\n      209→  const save = copy(save0);\n      210→  if (act === 'backdrop') { save.plan.backdrop = arg; return { save }; }\n      211→  if (act === 'buy') {\n      212→    const [kind, id] = String(arg).split('|');\n      213→    const b = buy(save, kind, id, w);\n      214→    return b.ok ? { save, toast: b.toast } : { toast: b.toast };\n      215→  }\n      216→  return {};\n      217→}\n      218→\n      219→/* ---------------- the end of a gala ---------------- */\n      220→function finishGala(save0, R) {\n      221→  const save = copy(save0);\n      222→  save.galaDone = true; save.school.stars += R.points; save.school.earned += R.points;\n      223→  save.notebook.unshift({ season: save.season, at: new Date().toISOString().slice(0, 10), points: R.points, satisfaction: R.parents.satisfaction, nums: Object.fromEntries(Object.values(R.perf).map((p) => [p.id, p.total])) });\n      224→  return { save };\n      225→}\n      226→\n      227→Object.assign(exports, { buy, orderStep, moveCard, formationAct, gouterStep, snack, costume, build, parking, shop, finishGala });", "numLines": 227, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": 227, "wasTruncated": false}, "outputText": "", "durationMs": 1.6156251076608896, "display": {"success": true, "verb": "Read", "message": "227 lines from app/scripts/game/actions.js", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
{"id": "call_4f3b91650bfd415d88acd92a", "sessionId": "25505b9f-a8ea-dd62-6b8d-be45f136b4b6", "turnId": "5093e3ac-9153-41c4-bc70-29af6171bbc2", "inputEntryId": null, "createdAt": 1792605329179, "updatedAt": 1792605329197, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "read_file", "detail": {"toolName": "read_file", "display": {"summary": "Reading app/scripts/rules/plan.js", "content": null, "suffix": "", "verb": "Reading", "message": "app/scripts/rules/plan.js", "settledVerb": "Read", "settledMessage": "app/scripts/rules/plan.js", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/rules/plan.js", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/rules/plan.js", "content": "        1→// GENERATED from gala-rules/src/plan.js by tools/sync-rules.mjs — do not edit here, edit gala-rules and run it again.\n        2→// The starting plan and the starting school, and how a season adds its new numbers. Pure: no DOM, no three.js.\n        3→const { hm, NUMBERS, CLS, LOGE, seasonRules, START } = use('rules/data');\n        4→\n        5→const xz = (pts) => pts.map(([x, z]) => ({ x, z }));\n        6→// each number's starting formation: every one fits on the stage except the seniors' \"Lumière\", a line a metre apart\n        7→// (the arms of a senior span 1.6 m: the first rehearsal shows their hands touching, as in round 1)\n        8→const FORMATIONS = {\n        9→  petits: xz([[-2.5, 1], [-0.5, 1], [1.5, 1], [-1.5, 2.5], [0.5, 2.5], [2.5, 2.5]]),\n       10→  moyens: xz([[-3.5, 1], [-1.5, 1], [0.5, 1], [2.5, 1], [-2.5, 2.5], [-0.5, 2.5], [1.5, 2.5], [3.5, 2.5], [-3, 4], [3, 4]]),\n       11→  grandes: xz([[-3, 1.5], [-1, 1.5], [1, 1.5], [3, 1.5], [-4, 3.5], [-2, 3.5], [2, 3.5], [4, 3.5]]),\n       12→  ados: xz([[-3, 1.5], [-1, 1.5], [1, 1.5], [3, 1.5], [-4, 3.5], [-2, 3.5], [2, 3.5], [4, 3.5]]),\n       13→  mamans: xz([[-3, 1.5], [0, 1.5], [3, 1.5], [-4.5, 3.5], [-1.5, 3.5], [1.5, 3.5]]),\n       14→};\n       15→const G1_LINE = xz([[-3.5, 1.5], [-2.5, 1.5], [-1.5, 1.5], [-0.5, 1.5], [0.5, 1.5], [1.5, 1.5], [2.5, 1.5], [3.5, 1.5]]);\n       16→// each number's starting phrase and how many times it repeats (one block, chained that many times). All fill their music\n       17→// exactly, except \"Lumière\": 16 × 32 = 512 counts for 480 counts of music, and a pirouette straight off the floor\n       18→const ROUTINES = {\n       19→  P1: { moves: ['plie', 'bras', 'saute', 'reception', 'tourne', 'plie', 'reverence'], repeats: 9 },\n       20→  P2: { moves: ['clap', 'chasseD', 'clap', 'chasseG', 'saute', 'reception'], repeats: 9 },\n       21→  M1: { moves: ['bras', 'descente', 'roulade', 'remonte', 'arabesque'], repeats: 12 },\n       22→  M2: { moves: ['kick', 'chasseD', 'kick', 'chasseG', 'sautChat', 'reception'], repeats: 12 },\n       23→  G1: { moves: ['plie', 'bras', 'arabesque', 'descente', 'pirouette', 'reverence'], repeats: 16 },\n       24→  G2: { moves: ['releve', 'pirouette', 'bras', 'chasseD', 'chasseG'], repeats: 15 },\n       25→  A1: { moves: ['toprock', 'vague', 'clap', 'moonwalk', 'chasseD'], repeats: 10 },\n       26→  A2: { moves: ['toprock', 'descente', 'freeze', 'remonte', 'vague', 'toprock'], repeats: 12 },\n       27→  F1: { moves: ['clap', 'chasseD', 'chasseG', 'tourne', 'kick', 'clap'], repeats: 8 },\n       28→};\n       29→const COSTUMES = {\n       30→  P1: { outfit: 'tutu', color: '#ff9ec7', shoes: 'demi', acc: 'noeud' }, P2: { outfit: 'jupette', color: '#ff6f91', shoes: 'demi', acc: 'aucun' },\n       31→  M1: { outfit: 'jupette', color: '#7cc6ff', shoes: 'pieds', acc: 'aucun' }, M2: { outfit: 'justaucorps', color: '#4f7cff', shoes: 'demi', acc: 'aucun' },\n       32→  G1: { outfit: 'justaucorps', color: '#b48cff', shoes: 'demi', acc: 'aucun' }, G2: { outfit: 'tutu', color: '#ffffff', shoes: 'demi', acc: 'aucun' },\n       33→  A1: { outfit: 'street', color: '#c23652', shoes: 'baskets', acc: 'aucun' }, A2: { outfit: 'street', color: '#2b2236', shoes: 'baskets', acc: 'aucun' },\n       34→  F1: { outfit: 'jupette', color: '#86d9a6', shoes: 'demi', acc: 'noeud' },\n       35→};\n       36→const DEFAULT_HAIR = { petits: 'chignon', moyens: 'queue', grandes: 'chignon', ados: 'queue', mamans: 'carre' };\n       37→\n       38→function numberPlan(id) {\n       39→  const cls = NUMBERS[id].cls, A = (id === 'G1' ? G1_LINE : FORMATIONS[cls]).map((p) => ({ ...p }));\n       40→  return { A, B: null, ...oneBlock(ROUTINES[id].moves, ROUTINES[id].repeats), costume: { ...COSTUMES[id] } };\n       41→}\n       42→// a dance as blocks and a chain: round 2's \"phrase × repeats\" is one block, chained `repeats` times\n       43→const oneBlock = (moves, repeats) => ({ blocks: [{ id: 'a', name: 'A', moves: [...moves] }], chain: Array(repeats).fill('a') });\n       44→// an older save's number (moves + repeats) becomes one block, chained as many times: the same dance, nothing lost\n       45→function migrateNumber(np) {\n       46→  if (np.blocks) return np;\n       47→  const { moves = [], repeats = 1, ...rest } = np;\n       48→  return { ...rest, ...oneBlock(moves, repeats) };\n       49→}\n       50→\n       51→function defaultPlan() {\n       52→  const numbers = {};\n       53→  for (const id of ['P1', 'P2', 'M1', 'M2', 'G1', 'G2']) numbers[id] = numberPlan(id);\n       54→  return {\n       55→    start: hm(20, 0), interval: 1500,\n       56→    order: ['accueil', 'P1', 'M1', 'G1', 'entracte', 'P2', 'M2', 'G2', 'final'],\n       57→    numbers, hair: { petits: 'chignon', moyens: 'queue', grandes: 'chignon' },\n       58→    snack: 'rien', cakeG: 1500, bottles: 3, crepes: 0, compotes: 0,\n       59→    parking: { width: 2.5, doors: 30 }, backdrop: 'nuit',\n       60→  };\n       61→}\n       62→\n       63→function defaultSchool() {\n       64→  return {\n       65→    name: '', logeCols: LOGE.cols, stars: START.stars, earned: 0, owned: {}, upgrades: {},\n       66→    furniture: [\n       67→      { id: 'banc', c: 1, r: 4, rot: 0 }, { id: 'portant', c: 6, r: 5, rot: 0 },\n       68→      { id: 'miroir', c: 3, r: 0, rot: 0 }, { id: 'miroir', c: 5, r: 0, rot: 0 },\n       69→    ],\n       70→  };\n       71→}\n       72→\n       73→// a new season brings its new classes: their numbers join the programme just before the interval and the finale\n       74→const ARRIVALS = { ados: [['A1', 'entracte'], ['A2', 'final']], mamans: [['F1', 'final']] };\n       75→function addSeasonNumbers(plan, season) {\n       76→  for (const cls of seasonRules(season).classes) {\n       77→    if (!ARRIVALS[cls]) continue;\n       78→    if (!plan.hair[cls]) plan.hair[cls] = DEFAULT_HAIR[cls];\n       79→    for (const [id, before] of ARRIVALS[cls]) {\n       80→      if (plan.numbers[id]) continue;\n       81→      plan.numbers[id] = numberPlan(id);\n       82→      const k = plan.order.indexOf(before); plan.order.splice(k < 0 ? plan.order.length - 1 : k, 0, id);\n       83→    }\n       84→  }\n       85→  return plan;\n       86→}\n       87→const classOf = (id) => CLS[NUMBERS[id].cls];\n       88→\n       89→Object.assign(exports, { DEFAULT_HAIR, numberPlan, oneBlock, migrateNumber, defaultPlan, defaultSchool, addSeasonNumbers, classOf });", "numLines": 89, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": 89, "wasTruncated": false}, "outputText": "", "durationMs": 3.3914169762283564, "display": {"success": true, "verb": "Read", "message": "89 lines from app/scripts/rules/plan.js", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
