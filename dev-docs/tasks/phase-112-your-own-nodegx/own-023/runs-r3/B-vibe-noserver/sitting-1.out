ser.LogIn\",\"CloudFunction2\",\"noodl.cloud.request\",\"noodl.cloud.getuserroles\",\"DbCollection2\",\"Router\",\"RouterNavigate\",\"Page\",\"net.noodl.GlobalStore\",\"net.noodl.GlobalStore.Set\",\"net.noodl.GlobalStore.Subscribe\",\"JavaScriptFunction\",\"Static Data\",\"net.noodl.controls.textinput\",\"net.noodl.controls.button\",\"net.noodl.controls.options\",\"Event Sender\",\"Event Receiver\",\"Component Inputs\",\"Component Outputs\",\"Variable2\",\"Set Variable\",\"States\",\"Switch\",\"Inverter\",\"Timer\",\"String Format\",\"Boolean To String\",\"net.noodl.externallink\"):\n        print(\"###\", n[\"id\"], t, \"|\", n.get(\"label\",\"\"))\n        print(json.dumps(n.get(\"parameters\",{}), ensure_ascii=False)[:1500])\n        print()\nEOF"}}, "state": {"status": "completed", "output": {"stdout": "### gp_page Page | \n{\"title\": \"Réglages des grands\", \"urlPath\": \"grownups\"}\n\n### gp_user net.noodl.controls.textinput | \n{\"sizeMode\": \"contentHeight\", \"width\": {\"value\": 100, \"unit\": \"%\"}, \"backgroundColor\": \"var(--muted)\", \"color\": \"var(--foreground)\", \"borderStyle\": \"solid\", \"borderWidth\": \"var(--border-1)\", \"borderColor\": \"var(--border-control)\", \"borderRadius\": \"var(--radius-md)\", \"paddingTop\": \"var(--space-2)\", \"paddingBottom\": \"var(--space-2)\", \"paddingLeft\": \"var(--space-3)\", \"paddingRight\": \"var(--space-3)\"}\n\n### gp_pass net.noodl.controls.textinput | \n{\"type\": \"password\", \"sizeMode\": \"contentHeight\", \"width\": {\"value\": 100, \"unit\": \"%\"}, \"backgroundColor\": \"var(--muted)\", \"color\": \"var(--foreground)\", \"borderStyle\": \"solid\", \"borderWidth\": \"var(--border-1)\", \"borderColor\": \"var(--border-control)\", \"borderRadius\": \"var(--radius-md)\", \"paddingTop\": \"var(--space-2)\", \"paddingBottom\": \"var(--space-2)\", \"paddingLeft\": \"var(--space-3)\", \"paddingRight\": \"var(--space-3)\"}\n\n### gp_starsIn net.noodl.controls.textinput | \n{\"type\": \"number\", \"sizeMode\": \"explicit\", \"width\": {\"value\": 100, \"unit\": \"px\"}, \"backgroundColor\": \"var(--muted)\", \"color\": \"var(--foreground)\", \"borderStyle\": \"solid\", \"borderWidth\": \"var(--border-1)\", \"borderColor\": \"var(--border-control)\", \"borderRadius\": \"var(--radius-md)\", \"paddingTop\": \"var(--space-1-5)\", \"paddingBottom\": \"var(--space-1-5)\", \"paddingLeft\": \"var(--space-2)\", \"paddingRight\": \"var(--space-2)\"}\n\n### gp_gwords Variable2 | grownupWords (shared on purpose)\n{\"name\": \"grownupWords\"}\n\n### gp_words Variable2 | words (shared on purpose)\n{\"name\": \"words\"}\n\n### gp_save net.noodl.GlobalStore.Subscribe | The language, from the save\n{\"storeName\": \"gala\", \"keys\": \"save\"}\n\n### gp_userNode net.noodl.user.User | Who is signed in\n{}\n\n### gp_table Variable2 | Which table (shared on purpose: one editor)\n{\"name\": \"grownupTable\"}\n\n### gp_message Variable2 | The last message (shared on purpose: one page)\n{\"name\": \"grownupMessage\"}\n\n### gp_changes DbCollection2 | Changes saved so far\n{\"collectionName\": \"GameChange\"}\n\n### gp_view JavaScriptFunction | What the page shows\n{\"uses\": \"view/grownups,game/text,settings/check,rules/data\", \"functionScript\": \"const lang = (Inputs.save && Inputs.save.lang) || 'fr';\\nconst w = Scripts.text.words([...(Inputs.words || []), ...(Inputs.gwords || [])], lang);\\nconst G = Scripts.grownups;\\nconst roles = (Inputs.roles || []).map((r) => (typeof r === 'string' ? r : r && (r.name || (r.get && r.get('name')))));\\nconst signedIn = !!Inputs.authenticated, grownup = signedIn && roles.includes('grownup');\\nconst table = G.TABLE_KEYS.includes(Inputs.table) ? Inputs.table : 'moves';\\nOutputs.title = w('g_title'); Outputs.intro = w('g_intro'); Outputs.back = w('g_back');\\nOutputs.message = Inputs.message || '';\\nOutputs.needSignIn = !signedIn; Outputs.notGrownup = signedIn && !grownup; Outputs.isGrownup = grownup;\\nOutputs.siH = w('g_signinH'); Outputs.user = w('g_user'); Outputs.pass = w('g_pass'); Outputs.login = w('g_login'); Outputs.signup = w('g_signup'); Outputs.siHint = w('g_signupHint');\\nOutputs.notGText = w('g_notGrownup'); Outputs.logout = w('g_logout'); Outputs.who = w('g_signedAs', Inputs.username || '');\\nOutputs.tables = G.tables(table, w); Outputs.applyNote = w('g_applyNote'); Outputs.openGame = w('g_openGame');\\nOutputs.rows = G.rows(table, Inputs.changes || [], w).map((r) => ({ ...r, saveLabel: w('g_save'), resetLabel: w('g_reset'), frLabel: w('gf_fr'), enLabel: w('gf_en') }));\\nOutputs.isStart = table === 'start'; Outputs.startH = w('g_startH'); Outputs.startHint = w('g_startHint'); Outputs.stars = Str\n\n### gp_change JavaScriptFunction | A change to send\n{\"uses\": \"view/grownups,game/text,settings/check,rules/data\", \"runOnChange-in-rowId\": false, \"runOnChange-in-rowValues\": false, \"runOnChange-in-stepValues\": false, \"runOnChange-in-costumeValues\": false, \"runOnChange-in-table\": false, \"runOnChange-in-words\": false, \"runOnChange-in-gwords\": false, \"runOnChange-in-save\": false, \"scriptOutputs\": [{\"id\": \"table\", \"label\": \"table\"}, {\"id\": \"rowId\", \"label\": \"rowId\"}, {\"id\": \"fields\", \"label\": \"fields\"}, {\"id\": \"send\", \"label\": \"send\"}, {\"id\": \"message\", \"label\": \"message\"}, {\"id\": \"said\", \"label\": \"said\"}], \"outtype-table\": \"string\", \"outtype-rowId\": \"string\", \"outtype-fields\": \"object\", \"outtype-send\": \"signal\", \"outtype-message\": \"string\", \"outtype-said\": \"signal\", \"functionScript\": \"const lang = (Inputs.save && Inputs.save.lang) || 'fr';\\nconst w = Scripts.text.words([...(Inputs.words || []), ...(Inputs.gwords || [])], lang);\\nconst G = Scripts.grownups;\\nconst at = (v) => (v && v.at) || 0;\\nconst latest = Math.max(at(Inputs.rowValues), at(Inputs.stepValues), at(Inputs.costumeValues));\\nlet c = null;\\nif (latest && latest === at(Inputs.rowValues)) c = G.rowChange(Inputs.table || 'moves', Inputs.rowId, Inputs.rowValues);\\nelse if (latest && latest === at(Inputs.stepValues)) c = G.newStep(Inputs.stepValues);\\nelse if (latest && latest === at(Inputs.costumeValues)) c = G.newCostume(Inputs.costumeValues);\\nconst p = G.precheck(c, w);\\nif (!p.ok) { Outputs.message = p.message; Outputs.said(); return; }\\nOutputs.table = c.table; Outpu\n\n### gp_stars JavaScriptFunction | A new school's stars to send\n{\"uses\": \"view/grownups,game/text,settings/check,rules/data\", \"runOnChange-in-stars\": false, \"runOnChange-in-words\": false, \"runOnChange-in-gwords\": false, \"runOnChange-in-save\": false, \"scriptOutputs\": [{\"id\": \"table\", \"label\": \"table\"}, {\"id\": \"rowId\", \"label\": \"rowId\"}, {\"id\": \"fields\", \"label\": \"fields\"}, {\"id\": \"send\", \"label\": \"send\"}, {\"id\": \"message\", \"label\": \"message\"}, {\"id\": \"said\", \"label\": \"said\"}], \"outtype-table\": \"string\", \"outtype-rowId\": \"string\", \"outtype-fields\": \"object\", \"outtype-send\": \"signal\", \"outtype-message\": \"string\", \"outtype-said\": \"signal\", \"functionScript\": \"const lang = (Inputs.save && Inputs.save.lang) || 'fr';\\nconst w = Scripts.text.words([...(Inputs.words || []), ...(Inputs.gwords || [])], lang);\\nconst c = { table: 'start', rowId: 'row', fields: { stars: Number(Inputs.stars) } };\\nconst p = Scripts.grownups.precheck(c, w);\\nif (!p.ok) { Outputs.message = p.message; Outputs.said(); return; }\\nOutputs.table = c.table; Outputs.rowId = c.rowId; Outputs.fields = c.fields;\\nOutputs.send();\\n\"}\n\n### gp_saveFn CloudFunction2 | saveChange (checked on the server)\n{\"function\": \"saveChange\"}\n\n### gp_removeFn CloudFunction2 | removeChange\n{\"function\": \"removeChange\"}\n\n### gp_claimFn CloudFunction2 | claimGrownup (only the first account)\n{\"function\": \"claimGrownup\"}\n\n### gp_login1 net.noodl.user.LogIn | \n{}\n\n### gp_signup1 net.noodl.user.SignUp | \n{}\n\n### gp_logout1 net.noodl.user.LogOut | \n{}\n\n### gp_said JavaScriptFunction | Say what went wrong\n{\"uses\": \"game/text\", \"runOnChange-in-error\": false, \"runOnChange-in-words\": false, \"runOnChange-in-gwords\": false, \"runOnChange-in-save\": false, \"scriptOutputs\": [{\"id\": \"message\", \"label\": \"message\"}, {\"id\": \"said\", \"label\": \"said\"}], \"outtype-message\": \"string\", \"outtype-said\": \"signal\", \"functionScript\": \"const lang = (Inputs.save && Inputs.save.lang) || 'fr';\\nconst w = Scripts.text.words([...(Inputs.words || []), ...(Inputs.gwords || [])], lang);\\nconst e = String(Inputs.error || '');\\nconst key = `gm_${e}`;\\nOutputs.message = w.has(key) ? w(key) : e ? `${w('gm_network')} (${e.slice(0, 80)})` : w('gm_network');\\nOutputs.said();\\n\"}\n\n### gp_setMsg Set Variable | Show what the check said\n{\"name\": \"grownupMessage\", \"setWith\": \"string\"}\n\n### gp_setMsgStars Set Variable | Show what the check said\n{\"name\": \"grownupMessage\", \"setWith\": \"string\"}\n\n### gp_setMsgErr Set Variable | Show what went wrong\n{\"name\": \"grownupMessage\", \"setWith\": \"string\"}\n\n### gp_setMsgSaved Set Variable | Saved\n{\"name\": \"grownupMessage\", \"setWith\": \"string\"}\n\n### gp_setMsgRemoved Set Variable | Taken back\n{\"name\": \"grownupMessage\", \"setWith\": \"string\"}\n\n### gp_setTable Set Variable | Pick a table\n{\"name\": \"grownupTable\", \"setWith\": \"string\"}\n\n### gp_goGame RouterNavigate | Back to the game\n{\"target\": \"/Pages/Game\"}\n\n### gp_reload net.noodl.externallink | Open the game afresh\n{\"link\": \"/\", \"openInNewTab\": false}\n\n", "stderr": "", "output": "", "truncated": false}, "outputText": "### gp_page Page | \n{\"title\": \"Réglages des grands\", \"urlPath\": \"grownups\"}\n\n### gp_user net.noodl.controls.textinput | \n{\"sizeMode\": \"contentHeight\", \"width\": {\"value\": 100, \"unit\": \"%\"}, \"backgroundColor\": \"var(--muted)\", \"color\": \"var(--foreground)\", \"borderStyle\": \"solid\", \"borderWidth\": \"var(--b