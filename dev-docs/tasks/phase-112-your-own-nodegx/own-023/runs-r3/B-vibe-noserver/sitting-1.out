mGrownup removeChange saveChange; do echo \"===== $d/component.json =====\"; cat \"/private/var/tmp/own023-r3/B-vibe/work/gala/app/components/__cloud__/$d/component.json\"; echo; echo \"===== $d/nodes.json =====\"; cat \"/private/var/tmp/own023-r3/B-vibe/work/gala/app/components/__cloud__/$d/nodes.json\"; echo; echo \"===== $d/connections.json =====\"; cat \"/private/var/tmp/own023-r3/B-vibe/work/gala/app/components/__cloud__/$d/connections.json\"; echo; done"}}, "state": {"status": "completed", "output": {"stdout": "===== claimGrownup/component.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/component-v2.json\",\n  \"id\": \"b956d8e2-c31a-5fda-838f-2396aad5f67d\",\n  \"name\": \"claimGrownup\",\n  \"path\": \"/#__cloud__/claimGrownup\",\n  \"type\": \"cloud\",\n  \"created\": \"2026-10-21T13:06:24.974Z\",\n  \"modified\": \"2026-10-21T13:06:24.974Z\",\n  \"modifiedBy\": \"noodl-mcp\",\n  \"description\": \"Makes the signed-in account the home's grown-up, but only while there is none yet. Once a grown-up exists, every other account (a child's included) is refused here, so the settings stay theirs.\"\n}\n===== claimGrownup/nodes.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/nodes-v2.json\",\n  \"componentId\": \"b956d8e2-c31a-5fda-838f-2396aad5f67d\",\n  \"version\": 1,\n  \"nodes\": [\n    {\n      \"id\": \"cl_req\",\n      \"type\": \"noodl.cloud.request\",\n      \"parameters\": {\n        \"params\": \"\"\n      },\n      \"x\": 40,\n      \"y\": 40\n    },\n    {\n      \"id\": \"cl_list\",\n      \"type\": \"noodl.cloud.listusersinrole\",\n      \"label\": \"Who is a grown-up already?\",\n      \"parameters\": {\n        \"role\": \"grownup\",\n        \"limit\": 10\n      },\n      \"x\": 40,\n      \"y\": 160\n    },\n    {\n      \"id\": \"cl_decide\",\n      \"type\": \"JavaScriptFunction\",\n      \"label\": \"Only the first account may claim\",\n      \"parameters\": {\n        \"scriptOutputs\": [\n          {\n            \"id\": \"grant\",\n            \"label\": \"grant\"\n          },\n          {\n            \"id\": \"already\",\n            \"label\": \"already\"\n          },\n          {\n            \"id\": \"refused\",\n            \"label\": \"refused\"\n          }\n        ],\n        \"outtype-grant\": \"signal\",\n        \"outtype-already\": \"signal\",\n        \"outtype-refused\": \"signal\",\n        \"runOnChange-in-ids\": false,\n        \"runOnChange-in-me\": false,\n        \"functionScript\": \"const ids = Inputs.ids || [];\\nconst me = String(Inputs.me || '');\\nif (!me) { Outputs.refused(); return; }\\nif (ids.includes(me)) { Outputs.already(); return; }\\nif (ids.length > 0) { Outputs.refused(); return; }\\nOutputs.grant();\\n\"\n      },\n      \"metadata\": {\n        \"comment\": \"Run from the list's done or unchanged (an empty role answers unchanged), never on value change, so it cannot decide before the list has been read.\"\n      },\n      \"x\": 40,\n      \"y\": 280,\n      \"ports\": [\n        {\n          \"name\": \"out-grant\",\n          \"displayName\": \"grant\",\n          \"plug\": \"output\",\n          \"type\": \"signal\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"out-already\",\n          \"displayName\": \"already\",\n          \"plug\": \"output\",\n          \"type\": \"signal\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"out-refused\",\n          \"displayName\": \"refused\",\n          \"plug\": \"output\",\n          \"type\": \"signal\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"in-ids\",\n          \"displayName\": \"ids\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        },\n        {\n          \"name\": \"in-me\",\n          \"displayName\": \"me\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        }\n      ]\n    },\n    {\n      \"id\": \"cl_add\",\n      \"type\": \"noodl.cloud.addusertorole\",\n      \"parameters\": {\n        \"role\": \"grownup\",\n        \"createRole\": false\n      },\n      \"x\": 40,\n      \"y\": 400\n    },\n    {\n      \"id\": \"cl_ok\",\n      \"type\": \"noodl.cloud.response\",\n      \"parameters\": {\n        \"params\": \"grownup\"\n      },\n      \"x\": 40,\n      \"y\": 520\n    },\n    {\n      \"id\": \"cl_fail\",\n      \"type\": \"noodl.cloud.response\",\n      \"parameters\": {\n        \"status\": \"failure\",\n        \"errorMessage\": \"alreadyClaimed\"\n      },\n      \"x\": 40,\n      \"y\": 640\n    }\n  ]\n}\n===== claimGrownup/connections.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/connections-v2.json\",\n  \"componentId\": \"b956d8e2-c31a-5fda-838f-2396aad5f67d\",\n  \"version\": 1,\n  \"connections\": [\n    {\n      \"fromId\": \"cl_req\",\n      \"fromProperty\": \"receive\",\n      \"toId\": \"cl_list\",\n      \"toProperty\": \"read\"\n    },\n    {\n      \"fromId\": \"cl_list\",\n      \"fromProperty\": \"userIds\",\n      \"toId\": \"cl_decide\",\n      \"toProperty\": \"in-ids\"\n    },\n    {\n      \"fromId\": \"cl_req\",\n      \"fromProperty\": \"userId\",\n      \"toId\": \"cl_decide\",\n      \"toProperty\": \"in-me\"\n    },\n    {\n      \"fromId\": \"cl_list\",\n      \"fromProperty\": \"done\",\n      \"toId\": \"cl_decide\",\n      \"toProperty\": \"run\"\n    },\n    {\n      \"fromId\": \"cl_list\",\n      \"fromProperty\": \"unchanged\",\n      \"toId\": \"cl_decide\",\n      \"toProperty\": \"run\"\n    },\n    {\n      \"fromId\": \"cl_req\",\n      \"fromProperty\": \"userId\",\n      \"toId\": \"cl_add\",\n      \"toProperty\": \"userId\"\n    },\n    {\n      \"fromId\": \"cl_decide\",\n      \"fromProperty\": \"out-grant\",\n      \"toId\": \"cl_add\",\n      \"toProperty\": \"add\"\n    },\n    {\n      \"fromId\": \"cl_add\",\n      \"fromProperty\": \"done\",\n      \"toId\": \"cl_ok\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"cl_add\",\n      \"fromProperty\": \"unchanged\",\n      \"toId\": \"cl_ok\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"cl_decide\",\n      \"fromProperty\": \"out-already\",\n      \"toId\": \"cl_ok\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"cl_decide\",\n      \"fromProperty\": \"out-refused\",\n      \"toId\": \"cl_fail\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"cl_add\",\n      \"fromProperty\": \"failure\",\n      \"toId\": \"cl_fail\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"cl_list\",\n      \"fromProperty\": \"failure\",\n      \"toId\": \"cl_fail\",\n      \"toProperty\": \"send\"\n    }\n  ]\n}\n===== removeChange/component.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/component-v2.json\",\n  \"id\": \"2a1ca1d4-76e5-5689-8230-c383a957b3f3\",\n  \"name\": \"removeChange\",\n  \"path\": \"/#__cloud__/removeChange\",\n  \"type\": \"cloud\",\n  \"created\": \"2026-10-21T13:06:15.468Z\",\n  \"modified\": \"2026-10-21T13:06:15.468Z\",\n  \"modifiedBy\": \"noodl-mcp\",\n  \"description\": \"Takes back one grown-up change: the row goes back to how the game ships it. Only a signed-in grown-up.\"\n}\n===== removeChange/nodes.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/nodes-v2.json\",\n  \"componentId\": \"2a1ca1d4-76e5-5689-8230-c383a957b3f3\",\n  \"version\": 1,\n  \"nodes\": [\n    {\n      \"id\": \"rm_req\",\n      \"type\": \"noodl.cloud.request\",\n      \"parameters\": {\n        \"params\": \"table,rowId\"\n      },\n      \"x\": 40,\n      \"y\": 40\n    },\n    {\n      \"id\": \"rm_roles\",\n      \"type\": \"noodl.cloud.getuserroles\",\n      \"label\": \"Is the caller a grown-up?\",\n      \"x\": 40,\n      \"y\": 160\n    },\n    {\n      \"id\": \"rm_query\",\n      \"type\": \"DbCollection2\",\n      \"label\": \"What is saved\",\n      \"parameters\": {\n        \"collectionName\": \"GameChange\",\n        \"runOnChange-collectionName\": false,\n        \"runOnChange-querySettings\": false\n      },\n      \"x\": 40,\n      \"y\": 280\n    },\n    {\n      \"id\": \"rm_find\",\n      \"type\": \"JavaScriptFunction\",\n      \"label\": \"Find the row to take back\",\n      \"parameters\": {\n        \"scriptOutputs\": [\n          {\n            \"id\": \"found\",\n            \"label\": \"found\"\n          },\n          {\n            \"id\": \"refused\",\n            \"label\": \"refused\"\n          },\n          {\n            \"id\": \"reason\",\n            \"label\": \"reason\"\n          },\n          {\n            \"id\": \"id\",\n            \"label\": \"id\"\n          }\n        ],\n        \"outtype-found\": \"signal\",\n        \"outtype-refused\": \"signal\",\n        \"outtype-reason\": \"string\",\n        \"outtype-id\": \"string\",\n        \"runOnChange-in-rows\": false,\n        \"runOnChange-in-roles\": false,\n        \"runOnChange-in-table\": false,\n        \"runOnChange-in-rowId\": false,\n        \"functionScript\": \"if (Inputs.rows === undefined || Inputs.roles === undefined) return;\\nif (!(Inputs.roles || []).includes('grownup')) { Outputs.reason = 'notGrownup'; Outputs.refused(); return; }\\nconst get = (o, k) => (o && typeof o.get === 'function' ? o.get(k) : o && o[k]);\\nconst rowId = Inputs.table === 'start' ? 'row' : String(Inputs.rowId || '');\\nconst row = (Inputs.rows || []).find((r) => get(r, 'table') === Inputs.table && get(r, 'rowId') === rowId);\\nif (!row) { Outputs.reason = 'nothing'; Outputs.refused(); return; }\\nOutputs.id = get(row, 'id') || row.id;\\nOutputs.found();\\n\"\n      },\n      \"x\": 40,\n      \"y\": 400,\n      \"ports\": [\n        {\n          \"name\": \"out-found\",\n          \"displayName\": \"found\",\n          \"plug\": \"output\",\n          \"type\": \"signal\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"out-refused\",\n          \"displayName\": \"refused\",\n          \"plug\": \"output\",\n          \"type\": \"signal\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"out-reason\",\n          \"displayName\": \"reason\",\n          \"plug\": \"output\",\n          \"type\": \"string\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"out-id\",\n          \"displayName\": \"id\",\n          \"plug\": \"output\",\n          \"type\": \"string\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"in-rows\",\n          \"displayName\": \"rows\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        },\n        {\n          \"name\": \"in-roles\",\n          \"displayName\": \"roles\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        },\n        {\n          \"name\": \"in-table\",\n          \"displayName\": \"table\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        },\n        {\n          \"name\": \"in-rowId\",\n          \"displayName\": \"rowId\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        }\n      ]\n    },\n    {\n      \"id\": \"rm_delete\",\n      \"type\": \"DeleteDbModelProperties\",\n      \"parameters\": {\n        \"collectionName\": \"GameChange\",\n        \"idSource\": \"explicit\"\n      },\n      \"x\": 40,\n      \"y\": 520\n    },\n    {\n      \"id\": \"rm_ok\",\n      \"type\": \"noodl.cloud.response\",\n      \"label\": \"Taken back\",\n      \"parameters\": {\n        \"params\": \"removed\"\n      },\n      \"x\": 40,\n      \"y\": 640\n    },\n    {\n      \"id\": \"rm_fail\",\n      \"type\": \"noodl.cloud.response\",\n      \"label\": \"Refused\",\n      \"parameters\": {\n        \"status\": \"failure\"\n      },\n      \"x\": 40,\n      \"y\": 760\n    }\n  ]\n}\n===== removeChange/connections.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/connections-v2.json\",\n  \"componentId\": \"2a1ca1d4-76e5-5689-8230-c383a957b3f3\",\n  \"version\": 1,\n  \"connections\": [\n    {\n      \"fromId\": \"rm_req\",\n      \"fromProperty\": \"userId\",\n      \"toId\": \"rm_roles\",\n      \"toProperty\": \"userId\"\n    },\n    {\n      \"fromId\": \"rm_req\",\n      \"fromProperty\": \"receive\",\n      \"toId\": \"rm_roles\",\n      \"toProperty\": \"read\"\n    },\n    {\n      \"fromId\": \"rm_roles\",\n      \"fromProperty\": \"roles\",\n      \"toId\": \"rm_find\",\n      \"toProperty\": \"in-roles\"\n    },\n    {\n      \"fromId\": \"rm_roles\",\n      \"fromProperty\": \"done\",\n      \"toId\": \"rm_query\",\n      \"toProperty\": \"storageFetch\"\n    },\n    {\n      \"fromId\": \"rm_roles\",\n      \"fromProperty\": \"unchanged\",\n      \"toId\": \"rm_query\",\n      \"toProperty\": \"storageFetch\"\n    },\n    {\n      \"fromId\": \"rm_req\",\n      \"fromProperty\": \"pm-table\",\n      \"toId\": \"rm_find\",\n      \"toProperty\": \"in-table\"\n    },\n    {\n      \"fromId\": \"rm_req\",\n      \"fromProperty\": \"pm-rowId\",\n      \"toId\": \"rm_find\",\n      \"toProperty\": \"in-rowId\"\n    },\n    {\n      \"fromId\": \"rm_query\",\n      \"fromProperty\": \"items\",\n      \"toId\": \"rm_find\",\n      \"toProperty\": \"in-rows\"\n    },\n    {\n      \"fromId\": \"rm_query\",\n      \"fromProperty\": \"fetched\",\n      \"toId\": \"rm_find\",\n      \"toProperty\": \"run\"\n    },\n    {\n      \"fromId\": \"rm_find\",\n      \"fromProperty\": \"out-id\",\n      \"toId\": \"rm_delete\",\n      \"toProperty\": \"modelId\"\n    },\n    {\n      \"fromId\": \"rm_find\",\n      \"fromProperty\": \"out-found\",\n      \"toId\": \"rm_delete\",\n      \"toProperty\": \"store\"\n    },\n    {\n      \"fromId\": \"rm_find\",\n      \"fromProperty\": \"out-id\",\n      \"toId\": \"rm_ok\",\n      \"toProperty\": \"pm-removed\"\n    },\n    {\n      \"fromId\": \"rm_delete\",\n      \"fromProperty\": \"done\",\n      \"toId\": \"rm_ok\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"rm_find\",\n      \"fromProperty\": \"out-reason\",\n      \"toId\": \"rm_fail\",\n      \"toProperty\": \"errorMessage\"\n    },\n    {\n      \"fromId\": \"rm_find\",\n      \"fromProperty\": \"out-refused\",\n      \"toId\": \"rm_fail\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"rm_delete\",\n      \"fromProperty\": \"failure\",\n      \"toId\": \"rm_fail\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"rm_query\",\n      \"fromProperty\": \"failure\",\n      \"toId\": \"rm_fail\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"rm_roles\",\n      \"fromProperty\": \"failure\",\n      \"toId\": \"rm_fail\",\n      \"toProperty\": \"send\"\n    }\n  ]\n}\n===== saveChange/component.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/component-v2.json\",\n  \"id\": \"91553f65-e1cc-5441-8c65-7da92d293d1c\",\n  \"name\": \"saveChange\",\n  \"path\": \"/#__cloud__/saveChange\",\n  \"type\": \"cloud\",\n  \"created\": \"2026-10-21T13:05:59.460Z\",\n  \"modified\": \"2026-10-21T13:05:59.460Z\",\n  \"modifiedBy\": \"noodl-mcp\",\n  \"description\": \"Saves one grown-up change to one row of a game table (a step's name or difficulty, a price, the starting stars, a new costume or step). Only a signed-in grown-up; only known tables and fields, numbers in range, names that are short, plain and kind. Anything else is refused with a reason.\"\n}\n===== saveChange/nodes.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/nodes-v2.json\",\n  \"componentId\": \"91553f65-e1cc-5441-8c65-7da92d293d1c\",\n  \"version\": 1,\n  \"nodes\": [\n    {\n      \"id\": \"sv_req\",\n      \"type\": \"noodl.cloud.request\",\n      \"label\": \"The change asked for\",\n      \"parameters\": {\n        \"params\": \"table,rowId,fields\"\n      },\n      \"x\": 40,\n      \"y\": 40\n    },\n    {\n      \"id\": \"sv_roles\",\n      \"type\": \"noodl.cloud.getuserroles\",\n      \"label\": \"Is the caller a grown-up?\",\n      \"x\": 40,\n      \"y\": 160\n    },\n    {\n      \"id\": \"sv_query\",\n      \"type\": \"DbCollection2\",\n      \"label\": \"What is already saved\",\n      \"parameters\": {\n        \"collectionName\": \"GameChange\",\n        \"runOnChange-collectionName\": false,\n        \"runOnChange-querySettings\": false\n      },\n      \"metadata\": {\n        \"comment\": \"The table of changes is small (a few dozen rows at most), so the function reads it whole and finds the row in code. Fetched only after the roles are known, never at graph build.\"\n      },\n      \"x\": 40,\n      \"y\": 280\n    },\n    {\n      \"id\": \"sv_check\",\n      \"type\": \"JavaScriptFunction\",\n      \"label\": \"Check the change\",\n      \"parameters\": {\n        \"scriptOutputs\": [\n          {\n            \"id\": \"create\",\n            \"label\": \"create\"\n          },\n          {\n            \"id\": \"update\",\n            \"label\": \"update\"\n          },\n          {\n            \"id\": \"refused\",\n            \"label\": \"refused\"\n          },\n          {\n            \"id\": \"reason\",\n            \"label\": \"reason\"\n          },\n          {\n            \"id\": \"table\",\n            \"label\": \"table\"\n          },\n          {\n            \"id\": \"rowId\",\n            \"label\": \"rowId\"\n          },\n          {\n            \"id\": \"fieldsJson\",\n            \"label\": \"fieldsJson\"\n          },\n          {\n            \"id\": \"existingId\",\n            \"label\": \"existingId\"\n          }\n        ],\n        \"outtype-create\": \"signal\",\n        \"outtype-update\": \"signal\",\n        \"outtype-refused\": \"signal\",\n        \"outtype-reason\": \"string\",\n        \"outtype-table\": \"string\",\n        \"outtype-rowId\": \"string\",\n        \"outtype-fieldsJson\": \"string\",\n        \"outtype-existingId\": \"string\",\n        \"runOnChange-in-rows\": false,\n        \"runOnChange-in-roles\": false,\n        \"runOnChange-in-table\": false,\n        \"runOnChange-in-rowId\": false,\n        \"runOnChange-in-fields\": false,\n        \"functionScript\": \"// What a grown-up may change, and how far. The same code runs in the cloud function that saves a change (so a child\\n// cannot get round it from the page) and in the browser before a change is laid over the game.\\nconst KNOWN = {\\", "stderr": "", "output": "", "truncated": false}, "outputText": "===== claimGrownup/component.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/component-v2.json\",\n  \"id\": \"b956d8e2-c31a-5fda-838f-2396aad5f67d\",\n  \"name\": \"claimGrownup\",\n  \"path\": \"/#__cloud__/claimGrownup\",\n  \"type\": \"cloud\",\n  \"created\": \"2026-10-21T13:06:24.974Z\",\n  \"modified\": \"2026-10-21T13:06:24.974Z\",\n  \"modifiedBy\": \"noodl-mcp\",\n  \"description\": \"Makes the signed-in account the home's grown-up, but only while there is none yet. Once a grown-up exists, every other account (a child's included) is refused here, so the settings stay theirs.\"\n}\n===== claimGrownup/nodes.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/nodes-v2.json\",\n  \"componentId\": \"b956d8e2-c31a-5fda-838f-2396aad5f67d\",\n  \"version\": 1,\n  \"nodes\": [\n    {\n      \"id\": \"cl_req\",\n      \"type\": \"noodl.cloud.request\",\n      \"parameters\": {\n        \"params\": \"\"\n      },\n      \"x\": 40,\n      \"y\": 40\n    },\n    {\n      \"id\": \"cl_list\",\n      \"type\": \"noodl.cloud.listusersinrole\",\n      \"label\": \"Who is a grown-up already?\",\n      \"parameters\": {\n        \"role\": \"grownup\",\n        \"limit\": 10\n      },\n      \"x\": 40,\n      \"y\": 160\n    },\n    {\n      \"id\": \"cl_decide\",\n      \"type\": \"JavaScriptFunction\",\n      \"label\": \"Only the first account may claim\",\n      \"parameters\": {\n        \"scriptOutputs\": [\n          {\n            \"id\": \"grant\",\n            \"label\": \"grant\"\n          },\n          {\n            \"id\": \"already\",\n            \"label\": \"already\"\n          },\n          {\n            \"id\": \"refused\",\n            \"label\": \"refused\"\n          }\n        ],\n        \"outtype-grant\": \"signal\",\n        \"outtype-already\": \"signal\",\n        \"outtype-refused\": \"signal\",\n        \"runOnChange-in-ids\": false,\n        \"runOnChange-in-me\": false,\n        \"functionScript\": \"const ids = Inputs.ids || [];\\nconst me = String(Inputs.me || '');\\nif (!me) { Outputs.refused(); return; }\\nif (ids.includes(me)) { Outputs.already(); return; }\\nif (ids.length > 0) { Outputs.refused(); return; }\\nOutputs.grant();\\n\"\n      },\n      \"metadata\": {\n        \"comment\": \"Run from the list's done or unchanged (an empty role answers unchanged), never on value change, so it cannot decide before the list has been read.\"\n      },\n      \"x\": 40,\n      \"y\": 280,\n      \"ports\": [\n        {\n          \"name\": \"out-grant\",\n          \"displayName\": \"grant\",\n          \"plug\": \"output\",\n          \"type\": \"signal\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"out-already\",\n          \"displayName\": \"already\",\n          \"plug\": \"output\",\n          \"type\": \"signal\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"out-refused\",\n          \"displayName\": \"refused\",\n          \"plug\": \"output\",\n          \"type\": \"signal\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"in-ids\",\n          \"displayName\": \"ids\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        },\n        {\n          \"name\": \"in-me\",\n          \"displayName\": \"me\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        }\n      ]\n    },\n    {\n      \"id\": \"cl_add\",\n      \"type\": \"noodl.cloud.addusertorole\",\n      \"parameters\": {\n        \"role\": \"grownup\",\n        \"createRole\": false\n      },\n      \"x\": 40,\n      \"y\": 400\n    },\n    {\n      \"id\": \"cl_ok\",\n      \"type\": \"noodl.cloud.response\",\n      \"parameters\": {\n        \"params\": \"grownup\"\n      },\n      \"x\": 40,\n      \"y\": 520\n    },\n    {\n      \"id\": \"cl_fail\",\n      \"type\": \"noodl.cloud.response\",\n      \"parameters\": {\n        \"status\": \"failure\",\n        \"errorMessage\": \"alreadyClaimed\"\n      },\n      \"x\": 40,\n      \"y\": 640\n    }\n  ]\n}\n===== claimGrownup/connections.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/connections-v2.json\",\n  \"componentId\": \"b956d8e2-c31a-5fda-838f-2396aad5f67d\",\n  \"version\": 1,\n  \"connections\": [\n    {\n      \"fromId\": \"cl_req\",\n      \"fromProperty\": \"receive\",\n      \"toId\": \"cl_list\",\n      \"toProperty\": \"read\"\n    },\n    {\n      \"fromId\": \"cl_list\",\n      \"fromProperty\": \"userIds\",\n      \"toId\": \"cl_decide\",\n      \"toProperty\": \"in-ids\"\n    },\n    {\n      \"fromId\": \"cl_req\",\n      \"fromProperty\": \"userId\",\n      \"toId\": \"cl_decide\",\n      \"toProperty\": \"in-me\"\n    },\n    {\n      \"fromId\": \"cl_list\",\n      \"fromProperty\": \"done\",\n      \"toId\": \"cl_decide\",\n      \"toProperty\": \"run\"\n    },\n    {\n      \"fromId\": \"cl_list\",\n      \"fromProperty\": \"unchanged\",\n      \"toId\": \"cl_decide\",\n      \"toProperty\": \"run\"\n    },\n    {\n      \"fromId\": \"cl_req\",\n      \"fromProperty\": \"userId\",\n      \"toId\": \"cl_add\",\n      \"toProperty\": \"userId\"\n    },\n    {\n      \"fromId\": \"cl_decide\",\n      \"fromProperty\": \"out-grant\",\n      \"toId\": \"cl_add\",\n      \"toProperty\": \"add\"\n    },\n    {\n      \"fromId\": \"cl_add\",\n      \"fromProperty\": \"done\",\n      \"toId\": \"cl_ok\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"cl_add\",\n      \"fromProperty\": \"unchanged\",\n      \"toId\": \"cl_ok\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"cl_decide\",\n      \"fromProperty\": \"out-already\",\n      \"toId\": \"cl_ok\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"cl_decide\",\n      \"fromProperty\": \"out-refused\",\n      \"toId\": \"cl_fail\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"cl_add\",\n      \"fromProperty\": \"failure\",\n      \"toId\": \"cl_fail\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"cl_list\",\n      \"fromProperty\": \"failure\",\n      \"toId\": \"cl_fail\",\n      \"toProperty\": \"send\"\n    }\n  ]\n}\n===== removeChange/component.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/component-v2.json\",\n  \"id\": \"2a1ca1d4-76e5-5689-8230-c383a957b3f3\",\n  \"name\": \"removeChange\",\n  \"path\": \"/#__cloud__/removeChange\",\n  \"type\": \"cloud\",\n  \"created\": \"2026-10-21T13:06:15.468Z\",\n  \"modified\": \"2026-10-21T13:06:15.468Z\",\n  \"modifiedBy\": \"noodl-mcp\",\n  \"description\": \"Takes back one grown-up change: the row goes back to how the game ships it. Only a signed-in grown-up.\"\n}\n===== removeChange/nodes.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/nodes-v2.json\",\n  \"componentId\": \"2a1ca1d4-76e5-5689-8230-c383a957b3f3\",\n  \"version\": 1,\n  \"nodes\": [\n    {\n      \"id\": \"rm_req\",\n      \"type\": \"noodl.cloud.request\",\n      \"parameters\": {\n        \"params\": \"table,rowId\"\n      },\n      \"x\": 40,\n      \"y\": 40\n    },\n    {\n      \"id\": \"rm_roles\",\n      \"type\": \"noodl.cloud.getuserroles\",\n      \"label\": \"Is the caller a grown-up?\",\n      \"x\": 40,\n      \"y\": 160\n    },\n    {\n      \"id\": \"rm_query\",\n      \"type\": \"DbCollection2\",\n      \"label\": \"What is saved\",\n      \"parameters\": {\n        \"collectionName\": \"GameChange\",\n        \"runOnChange-collectionName\": false,\n        \"runOnChange-querySettings\": false\n      },\n      \"x\": 40,\n      \"y\": 280\n    },\n    {\n      \"id\": \"rm_find\",\n      \"type\": \"JavaScriptFunction\",\n      \"label\": \"Find the row to take back\",\n      \"parameters\": {\n        \"scriptOutputs\": [\n          {\n            \"id\": \"found\",\n            \"label\": \"found\"\n          },\n          {\n            \"id\": \"refused\",\n            \"label\": \"refused\"\n          },\n          {\n            \"id\": \"reason\",\n            \"label\": \"reason\"\n          },\n          {\n            \"id\": \"id\",\n            \"label\": \"id\"\n          }\n        ],\n        \"outtype-found\": \"signal\",\n        \"outtype-refused\": \"signal\",\n        \"outtype-reason\": \"string\",\n        \"outtype-id\": \"string\",\n        \"runOnChange-in-rows\": false,\n        \"runOnChange-in-roles\": false,\n        \"runOnChange-in-table\": false,\n        \"runOnChange-in-rowId\": false,\n        \"functionScript\": \"if (Inputs.rows === undefined || Inputs.roles === undefined) return;\\nif (!(Inputs.roles || []).includes('grownup')) { Outputs.reason = 'notGrownup'; Outputs.refused(); return; }\\nconst get = (o, k) => (o && typeof o.get === 'function' ? o.get(k) : o && o[k]);\\nconst rowId = Inputs.table === 'start' ? 'row' : String(Inputs.rowId || '');\\nconst row = (Inputs.rows || []).find((r) => get(r, 'table') === Inputs.table && get(r, 'rowId') === rowId);\\nif (!row) { Outputs.reason = 'nothing'; Outputs.refused(); return; }\\nOutputs.id = get(row, 'id') || row.id;\\nOutputs.found();\\n\"\n      },\n      \"x\": 40,\n      \"y\": 400,\n      \"ports\": [\n        {\n          \"name\": \"out-found\",\n          \"displayName\": \"found\",\n          \"plug\": \"output\",\n          \"type\": \"signal\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"out-refused\",\n          \"displayName\": \"refused\",\n          \"plug\": \"output\",\n          \"type\": \"signal\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"out-reason\",\n          \"displayName\": \"reason\",\n          \"plug\": \"output\",\n          \"type\": \"string\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"out-id\",\n          \"displayName\": \"id\",\n          \"plug\": \"output\",\n          \"type\": \"string\",\n          \"group\": \"Outputs\"\n        },\n        {\n          \"name\": \"in-rows\",\n          \"displayName\": \"rows\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        },\n        {\n          \"name\": \"in-roles\",\n          \"displayName\": \"roles\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        },\n        {\n          \"name\": \"in-table\",\n          \"displayName\": \"table\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        },\n        {\n          \"name\": \"in-rowId\",\n          \"displayName\": \"rowId\",\n          \"plug\": \"input\",\n          \"type\": \"*\",\n          \"group\": \"Inputs\"\n        }\n      ]\n    },\n    {\n      \"id\": \"rm_delete\",\n      \"type\": \"DeleteDbModelProperties\",\n      \"parameters\": {\n        \"collectionName\": \"GameChange\",\n        \"idSource\": \"explicit\"\n      },\n      \"x\": 40,\n      \"y\": 520\n    },\n    {\n      \"id\": \"rm_ok\",\n      \"type\": \"noodl.cloud.response\",\n      \"label\": \"Taken back\",\n      \"parameters\": {\n        \"params\": \"removed\"\n      },\n      \"x\": 40,\n      \"y\": 640\n    },\n    {\n      \"id\": \"rm_fail\",\n      \"type\": \"noodl.cloud.response\",\n      \"label\": \"Refused\",\n      \"parameters\": {\n        \"status\": \"failure\"\n      },\n      \"x\": 40,\n      \"y\": 760\n    }\n  ]\n}\n===== removeChange/connections.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/connections-v2.json\",\n  \"componentId\": \"2a1ca1d4-76e5-5689-8230-c383a957b3f3\",\n  \"version\": 1,\n  \"connections\": [\n    {\n      \"fromId\": \"rm_req\",\n      \"fromProperty\": \"userId\",\n      \"toId\": \"rm_roles\",\n      \"toProperty\": \"userId\"\n    },\n    {\n      \"fromId\": \"rm_req\",\n      \"fromProperty\": \"receive\",\n      \"toId\": \"rm_roles\",\n      \"toProperty\": \"read\"\n    },\n    {\n      \"fromId\": \"rm_roles\",\n      \"fromProperty\": \"roles\",\n      \"toId\": \"rm_find\",\n      \"toProperty\": \"in-roles\"\n    },\n    {\n      \"fromId\": \"rm_roles\",\n      \"fromProperty\": \"done\",\n      \"toId\": \"rm_query\",\n      \"toProperty\": \"storageFetch\"\n    },\n    {\n      \"fromId\": \"rm_roles\",\n      \"fromProperty\": \"unchanged\",\n      \"toId\": \"rm_query\",\n      \"toProperty\": \"storageFetch\"\n    },\n    {\n      \"fromId\": \"rm_req\",\n      \"fromProperty\": \"pm-table\",\n      \"toId\": \"rm_find\",\n      \"toProperty\": \"in-table\"\n    },\n    {\n      \"fromId\": \"rm_req\",\n      \"fromProperty\": \"pm-rowId\",\n      \"toId\": \"rm_find\",\n      \"toProperty\": \"in-rowId\"\n    },\n    {\n      \"fromId\": \"rm_query\",\n      \"fromProperty\": \"items\",\n      \"toId\": \"rm_find\",\n      \"toProperty\": \"in-rows\"\n    },\n    {\n      \"fromId\": \"rm_query\",\n      \"fromProperty\": \"fetched\",\n      \"toId\": \"rm_find\",\n      \"toProperty\": \"run\"\n    },\n    {\n      \"fromId\": \"rm_find\",\n      \"fromProperty\": \"out-id\",\n      \"toId\": \"rm_delete\",\n      \"toProperty\": \"modelId\"\n    },\n    {\n      \"fromId\": \"rm_find\",\n      \"fromProperty\": \"out-found\",\n      \"toId\": \"rm_delete\",\n      \"toProperty\": \"store\"\n    },\n    {\n      \"fromId\": \"rm_find\",\n      \"fromProperty\": \"out-id\",\n      \"toId\": \"rm_ok\",\n      \"toProperty\": \"pm-removed\"\n    },\n    {\n      \"fromId\": \"rm_delete\",\n      \"fromProperty\": \"done\",\n      \"toId\": \"rm_ok\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"rm_find\",\n      \"fromProperty\": \"out-reason\",\n      \"toId\": \"rm_fail\",\n      \"toProperty\": \"errorMessage\"\n    },\n    {\n      \"fromId\": \"rm_find\",\n      \"fromProperty\": \"out-refused\",\n      \"toId\": \"rm_fail\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"rm_delete\",\n      \"fromProperty\": \"failure\",\n      \"toId\": \"rm_fail\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"rm_query\",\n      \"fromProperty\": \"failure\",\n      \"toId\": \"rm_fail\",\n      \"toProperty\": \"send\"\n    },\n    {\n      \"fromId\": \"rm_roles\",\n      \"fromProperty\": \"failure\",\n      \"toId\": \"rm_fail\",\n      \"toProperty\": \"send\"\n    }\n  ]\n}\n===== saveChange/component.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/component-v2.json\",\n  \"id\": \"91553f65-e1cc-5441-8c65-7da92d293d1c\",\n  \"name\": \"saveChange\",\n  \"path\": \"/#__cloud__/saveChange\",\n  \"type\": \"cloud\",\n  \"created\": \"2026-10-21T13:05:59.460Z\",\n  \"modified\": \"2026-10-21T13:05:59.460Z\",\n  \"modifiedBy\": \"noodl-mcp\",\n  \"description\": \"Saves one grown-up change to one row of a game table (a step's name or difficulty, a price, the starting stars, a new costume or step). Only a signed-in grown-up; only known tables and fields, numbers in range, names that are short, plain and kind. Anything else is refused with a reason.\"\n}\n===== saveChange/nodes.json =====\n{\n  \"$schema\": \"https://opennoodl.dev/schemas/nodes-v2.json\",\