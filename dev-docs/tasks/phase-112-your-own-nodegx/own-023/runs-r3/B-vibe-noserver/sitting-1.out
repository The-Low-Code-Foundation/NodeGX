{"id": "call_061e431860954151ba34de3b", "sessionId": "25505b9f-a8ea-dd62-6b8d-be45f136b4b6", "turnId": "5093e3ac-9153-41c4-bc70-29af6171bbc2", "inputEntryId": null, "createdAt": 1792605274787, "updatedAt": 1792605274805, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "read_file", "detail": {"toolName": "read_file", "display": {"summary": "Reading app/scripts/game/save.js", "content": null, "suffix": "", "verb": "Reading", "message": "app/scripts/game/save.js", "settledVerb": "Read", "settledMessage": "app/scripts/game/save.js", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/game/save.js", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/game/save.js", "content": "        1→// The save's shape and its repairs, from reference/src/state.js. Where it is kept is the graph's business: the\n        2→// persisted Global Store \"gala\" holds it under the key \"save\".\n        3→const { defaultPlan, defaultSchool, addSeasonNumbers, numberPlan, migrateNumber, DEFAULT_HAIR } = use('rules/plan');\n        4→const { NUMBERS } = use('rules/data');\n        5→\n        6→const newSeed = () => (Math.random() * 1e9) >>> 0;\n        7→\n        8→function fresh(lang) {\n        9→  return { v: 2, lang: lang || 'fr', season: 1, galaDone: false, seenIntro: 0, plan: defaultPlan(), school: defaultSchool(), notebook: [], sound: true, seed: newSeed() };\n       10→}\n       11→\n       12→// round 1's save: the running order, the formation and the goûter carry over; costumes per class become costumes per number\n       13→function fromRound1(o) {\n       14→  const s = fresh(), p = s.plan;\n       15→  try {\n       16→    if (o.plan) {\n       17→      p.start = o.plan.start ?? p.start; p.interval = o.plan.interval ?? p.interval;\n       18→      if (Array.isArray(o.plan.order) && o.plan.order.every((id) => NUMBERS[id] || ['accueil', 'entracte', 'final'].includes(id))) p.order = o.plan.order;\n       19→      if (Array.isArray(o.plan.formation) && o.plan.formation.length === 8) p.numbers.G1.A = o.plan.formation.map((q) => ({ x: q.x, z: q.z }));\n       20→      p.cakeG = o.plan.cakeG ?? p.cakeG; p.bottles = o.plan.bottles ?? p.bottles;\n       21→    }\n       22→    if (o.school) {\n       23→      s.school.name = o.school.name || '';\n       24→      const cos = o.school.costumes || {};\n       25→      for (const [id, np] of Object.entries(p.numbers)) { const c = cos[NUMBERS[id].cls]; if (c) { np.costume.color = c.color; if (['tutu', 'jupette', 'justaucorps'].includes(c.style)) np.costume.outfit = c.style; } }\n       26→      for (const [cls, c] of Object.entries(cos)) { const h = { bun: 'chignon', ponytail: 'queue', braids: 'tresses', bob: 'carre' }[c.hair]; if (h) p.hair[cls] = h; }\n       27→    }\n       28→    s.lang = o.lang || 'fr';\n       29→  } catch (e) { /* a broken old save starts fresh */ }\n       30→  return s;\n       31→}\n       32→\n       33→// fill in anything a newer version added, so an older save keeps working; anything unreadable starts fresh\n       34→function mend(input) {\n       35→  if (!input || input.v !== 2 || !input.plan || !input.school) return fresh(input && input.lang);\n       36→  const s = JSON.parse(JSON.stringify(input)), f = fresh(s.lang);\n       37→  for (const k of Object.keys(f)) if (s[k] === undefined) s[k] = f[k];\n       38→  for (const k of Object.keys(f.plan)) if (s.plan[k] === undefined) s.plan[k] = f.plan[k];\n       39→  for (const k of Object.keys(f.school)) if (s.school[k] === undefined) s.school[k] = f.school[k];\n       40→  addSeasonNumbers(s.plan, s.season);\n       41→  for (const id of Object.keys(s.plan.numbers)) {\n       42→    if (!NUMBERS[id]) { delete s.plan.numbers[id]; continue; }\n       43→    const np = s.plan.numbers[id];\n       44→    s.plan.numbers[id] = np.blocks || np.moves ? migrateNumber(np) : numberPlan(id);\n       45→  }\n       46→  s.plan.order = s.plan.order.filter((id) => NUMBERS[id] || ['accueil', 'entracte', 'final'].includes(id));\n       47→  for (const c of Object.keys(DEFAULT_HAIR)) if (!s.plan.hair[c] && c in s.plan.hair) s.plan.hair[c] = DEFAULT_HAIR[c];\n       48→  return s;\n       49→}\n       50→\n       51→// the next season: new classes join, the dice change\n       52→function nextSeason(save) {\n       53→  const s = JSON.parse(JSON.stringify(save));\n       54→  s.season++; s.galaDone = false; s.seed = newSeed();\n       55→  addSeasonNumbers(s.plan, s.season);\n       56→  return s;\n       57→}\n       58→\n       59→Object.assign(exports, { fresh, fromRound1, mend, nextSeason, newSeed });", "numLines": 59, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": 59, "wasTruncated": false}, "outputText": "", "durationMs": 1.9667909946292639, "display": {"success": true, "verb": "Read", "message": "59 lines from app/scripts/game/save.js", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
{"id": "call_e349c5c40f9b47f89cfa5b5c", "sessionId": "25505b9f-a8ea-dd62-6b8d-be45f136b4b6", "turnId": "5093e3ac-9153-41c4-bc70-29af6171bbc2", "inputEntryId": null, "createdAt": 1792605274790, "updatedAt": 1792605274806, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "read_file", "detail": {"toolName": "read_file", "display": {"summary": "Reading app/scripts/game/dispatch.js", "content": null, "suffix": "", "verb": "Reading", "message": "app/scripts/game/dispatch.js", "settledVerb": "Read", "settledMessage": "app/scripts/game/dispatch.js", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/game/dispatch.js", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/game/dispatch.js", "content": "        1→// One press → what changes. Every button in the game sends an event on the channel \"gala-act\" with an `act` (what\n        2→// kind of press: \"order:up\", \"tab\", \"go\") and an `arg` (which card, which tab…). The Game page's dispatcher Function\n        3→// hands both here with the save, the screen state and the 3D stage, and writes back what this returns:\n        4→//   { save, ui, toast } — a new save, a patch for the screen state, a sentence for the toast.\n        5→// The 3D stage is told directly (begin a run, turn the camera): it is the one thing here that is not state.\n        6→const A = use('game/actions');\n        7→const S = use('game/save');\n        8→const { simulate } = use('rules/engine');\n        9→const { NUMBERS, seasonRules } = use('rules/data');\n       10→const { sayText } = use('view/run');\n       11→\n       12→const UI0 = { screen: 'prep', tab: 'order', pickNum: 'G1', selBlock: {}, selMove: null, selChain: null, allMoves: false, editB: false, pickDancer: null, armed: null, selected: null, pickedRoom: null, shopCat: 'hall', speed: 1, follow: true, introForced: false, confirm: null, renaming: false };\n       13→const num = (x) => Number(x);\n       14→const split = (s) => { const i = String(s).indexOf(':'); return i < 0 ? [String(s), ''] : [String(s).slice(0, i), String(s).slice(i + 1)]; };\n       15→\n       16→function tabChange(save, ui, k) {\n       17→  const patch = { tab: k, armed: null, confirm: null, renaming: false };\n       18→  if (k !== 'build') patch.selected = null;\n       19→  if (k === 'build') patch.pickedRoom = 'dr';\n       20→  else if (['formation', 'costumes', 'parking'].includes(k) || ui.pickedRoom === 'dr') patch.pickedRoom = null;\n       21→  return { ui: patch };\n       22→}\n       23→\n       24→function begin(save, ui, stage, mode, tryId) {\n       25→  if (!stage || (mode === 'gala' && save.galaDone)) return {};\n       26→  const res = stage.beginRun(mode, tryId);\n       27→  if (!res) return {};\n       28→  return { ui: { screen: 'run', res, live: { mode, t: 0, done: false, feed: [], tryId: tryId || null }, speed: 1, pickedRoom: null, armed: null, selected: null, confirm: null } };\n       29→}\n       30→function stop(stage) {\n       31→  if (stage) stage.stopRun();\n       32→  return { ui: { screen: 'prep', res: null, live: null } };\n       33→}\n       34→\n       35→function dispatch(act, arg, save, ui, w, stage) {\n       36→  ui = { ...UI0, ...(ui || {}) };\n       37→  const [group, what] = split(act);\n       38→  const out = (r) => r || {};\n       39→  switch (group) {\n       40→    case 'tab': return tabChange(save, ui, String(arg));\n       41→    case 'lang': return { save: { ...save, lang: save.lang === 'en' ? 'fr' : 'en' } };\n       42→    case 'sound': { const on = save.sound === false; if (on && stage) stage.wake(); return { save: { ...save, sound: on } }; }\n       43→    case 'intro': return { ui: { introForced: true } };\n       44→    case 'introGo': {\n       45→      const r = { save: { ...save, seenIntro: save.season }, ui: { introForced: false } };\n       46→      if (save.season === 2) Object.assign(r.ui, tabChange(save, ui, 'parking').ui);\n       47→      return r;\n       48→    }\n       49→    case 'cam': if (stage) stage.camCmd(String(arg)); return {};\n       50→    case 'go': {\n       51→      const id = String(arg);\n       52→      if (id === 'rehearse') return begin(save, ui, stage, 'rehearsal');\n       53→      if (id === 'gala') return begin(save, ui, stage, 'gala');\n       54→      if (id === 'speed') { const s = ui.speed >= 8 ? 1 : ui.speed * 2; if (stage) stage.setSpeed(s); return { ui: { speed: s } }; }\n       55→      if (id === 'follow') { const f = !ui.follow; if (stage) stage.setFollow(f); return { ui: { follow: f } }; }\n       56→      if (id === 'skipNum') { if (stage) stage.skipNumber(); return {}; }\n       57→      if (id === 'skip') { if (stage) stage.skipToEnd(); return {}; }\n       58→      if (id === 'stop' || id === 'back') return stop(stage);\n       59→      if (id === 'nextSeason') { stop(stage); return { save: S.nextSeason(save), ui: { ...UI0, screen: 'prep', res: null, live: null } }; }\n       60→      return {};\n       61→    }\n       62→    case 'try': return begin(save, ui, stage, 'try', ui.pickNum && NUMBERS[ui.pickNum] ? ui.pickNum : 'G1');\n       63→    // the 3D stage reports\n       64→    case 'runDone': {\n       65→      const live = arg || ui.live || {};\n       66→      const r = { ui: { screen: 'results', live } };\n       67→      if (live.mode === 'gala' && ui.res && !save.galaDone) r.save = A.finishGala(save, ui.res).save;\n       68→      return r;\n       69→    }\n       70→    case 'say': return Array.isArray(arg) ? { toast: sayText(arg, w) } : {};\n       71→    case 'stageUi': return { ui: arg && typeof arg === 'object' ? arg : {} };\n       72→    case 'place': return out(A.build(save, ui, 'place', arg, w));\n       73→    case 'key': return out(A.build(save, ui, String(arg), null, w));\n       74→    // the tabs\n       75→    case 'order': {\n       76→      if (what === 'up' || what === 'down') return out(A.moveCard(save, String(arg), what === 'up' ? -1 : 1));\n       77→      const [which, d] = split(what); return out(A.orderStep(save, which, num(d)));\n       78→    }\n       79→    case 'form': {\n       80→      if (what === 'renameAsk') return { ui: { renaming: true } };\n       81→      if (what === 'renameCancel') return { ui: { renaming: false } };\n       82→      if (what === 'delAsk') return { ui: { confirm: 'delBlock' } };\n       83→      if (what === 'confirmNo') return { ui: { confirm: null } };\n       84→      if (what === 'renameBlock') { const r = out(A.formationAct(save, ui, 'renameBlock', arg, w)); if (r.save) r.ui = { renaming: false }; return r; }\n       85→      if (what === 'delBlock') { const r = out(A.formationAct(save, ui, 'delBlock', null, w)); r.ui = { ...(r.ui || {}), confirm: null }; return r; }\n       86→      const idx = (prefix) => num(String(arg).split(prefix).pop());\n       87→      if (what === 'step') return out(A.formationAct(save, ui, 'step', idx('s'), w));\n       88→      if (what === 'chain') return out(A.formationAct(save, ui, 'chain', idx('c'), w));\n       89→      if (what === 'pickDancer') return out(A.formationAct(save, ui, 'pickDancer', idx('-'), w));\n       90→      if (what === 'stepTool' || what === 'chainTool') return out(A.formationAct(save, ui, what, arg === 'x' ? 'x' : num(arg), w));\n       91→      if (what === 'dropDancer') return out(A.formationAct(save, ui, 'dropDancer', { ...arg, index: num(String(arg.id).split('-').pop()) }, w));\n       92→      return out(A.formationAct(save, ui, what, arg, w));\n       93→    }\n       94→    case 'gouter': {\n       95→      if (what === 'snack') return out(A.snack(save, String(arg), w));\n       96→      const [which, d] = split(what); return out(A.gouterStep(save, which, num(d)));\n       97→    }\n       98→    case 'cos': return out(A.costume(save, ui, what, String(arg), w));\n       99→    case 'build': {\n      100→      if (what === 'goLoge') return { ui: { pickedRoom: 'dr' } };\n      101→      return out(A.build(save, ui, what, arg, w));\n      102→    }\n      103→    case 'park': return out(A.parking(save, what, arg, w));\n      104→    case 'shop': {\n      105→      if (what === 'cat') return { ui: { shopCat: String(arg) } };\n      106→      return out(A.shop(save, what, String(arg), w));\n      107→    }\n      108→    case 'note': {\n      109→      if (what === 'resetAsk') return { ui: { confirm: 'reset' } };\n      110→      if (what === 'resetNo') return { ui: { confirm: null } };\n      111→      if (what === 'resetYes') { stop(stage); return { save: S.fresh(save.lang), ui: { ...UI0 } }; }\n      112→      return {};\n      113→    }\n      114→    default: return {};\n      115→  }\n      116→}\n      117→\n      118→// what the stage's sync needs to know is worth a re-sync: anything but the live evening\n      119→const syncKey = (save, ui) => JSON.stringify([save, ui && { ...ui, res: null, live: null }]);\n      120→\n      121→Object.assign(exports, { dispatch, UI0, syncKey, seasonRulesOf: seasonRules, simulate });", "numLines": 121, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": 121, "wasTruncated": false}, "outputText": "", "durationMs": 3.192791948094964, "display": {"success": true, "verb": "Read", "message": "121 lines from app/scripts/game/dispatch.js", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
{"id": "11281eec-9bdf-4b75-a61d-83f0d26570dc", "sessionId": "25505b9f-a8ea-dd62-6b8d-be45f136b4b6", "turnId": "5093e3ac-9153-41c4-bc70-29af6171bbc2", "inputEntryId": null, "createdAt": 1792605277768, "updatedAt": 1792605277778, "generationStatus": "completed", "relatedEntryId": null, "type": "reasoning", "text": "Now let me read the cloud glue and check files, and the __cloud__ components. These are the key to the backend.", "summary": []}
{"id": "call_caaaedcfcd6249f386be4049", "sessionId": "25505b9f-a8ea-dd62-6b8d-be45f136b4b6", "turnId": "5093e3ac-9153-41c4-bc70-29af6171bbc2", "inputEntryId": null, "createdAt": 1792605277778, "updatedAt": 1792605277798, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "read_file", "detail": {"toolName": "read_file", "display": {"summary": "Reading tools/cloud-save.glue.js", "content": null, "suffix": "", "verb": "Reading", "message": "tools/cloud-save.glue.js", "settledVerb": "Read", "settledMessage": "tools/cloud-save.glue.js", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/tools/cloud-save.glue.js", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/tools/cloud-save.glue.js", "content": "        1→\n        2→// ---- the change itself: only a grown-up, only what the checker above lets through ----\n        3→if (Inputs.rows === undefined || Inputs.roles === undefined) return;\n        4→const refuse = (reason) => { Outputs.reason = reason; Outputs.refused(); };\n        5→if (!(Inputs.roles || []).includes('grownup')) return refuse('notGrownup');\n        6→let fields = Inputs.fields;\n        7→if (typeof fields === 'string') { try { fields = JSON.parse(fields); } catch (e) { fields = null; } }\n        8→if (!fields || typeof fields !== 'object' || Array.isArray(fields)) return refuse('badFields');\n        9→const table = String(Inputs.table || '');\n       10→if (!TABLES[table]) return refuse('badTable');\n       11→const rowId = TABLES[table].one ? 'row' : String(Inputs.rowId || '');\n       12→const get = (o, k) => (o && typeof o.get === 'function' ? o.get(k) : o && o[k]);\n       13→const old = (Inputs.rows || []).find((r) => get(r, 'table') === table && get(r, 'rowId') === rowId);\n       14→let before = {};\n       15→if (old) { try { before = JSON.parse(get(old, 'fields')) || {}; } catch (e) { before = {}; } }\n       16→const result = checkChange(table, rowId, { ...before, ...fields });\n       17→if (!result.ok) return refuse(result.reason);\n       18→Outputs.table = table;\n       19→Outputs.rowId = rowId;\n       20→Outputs.fieldsJson = JSON.stringify(result.fields);\n       21→Outputs.existingId = old ? get(old, 'id') || old.id : '';\n       22→if (old) Outputs.update(); else Outputs.create();", "numLines": 22, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": 22, "wasTruncated": false}, "outputText": "", "durationMs": 2.282625064253807, "display": {"success": true, "verb": "Read", "message": "22 lines from tools/cloud-save.glue.js", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
{"id": "call_bc9b41efd65a4c598c2c911c", "sessionId": "25505b9f-a8ea-dd62-6b8d-be45f136b4b6", "turnId": "5093e3ac-9153-41c4-bc70-29af6171bbc2", "inputEntryId": null, "createdAt": 1792605277782, "updatedAt": 1792605277798, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "read_file", "detail": {"toolName": "read_file", "display": {"summary": "Reading tools/check.cloud.js", "content": null, "suffix": "", "verb": "Reading", "message": "tools/check.cloud.js", "settledVerb": "Read", "settledMessage": "tools/check.cloud.js", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/tools/check.cloud.js", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/tools/check.cloud.js", "content": "        1→// GENERATED from tools/check.src.js by tools/sync-check.mjs — edit that file and run it again.\n        2→// What a grown-up may change, and how far. The same code runs in the cloud function that saves a change (so a child\n        3→// cannot get round it from the page) and in the browser before a change is laid over the game (so a bad row that got\n        4→// into the database some other way never reaches the screen). It has no imports: the ids it knows are written in by\n        5→// tools/sync-check.mjs from gala-rules/src/data.js.\n        6→const KNOWN = {\"moves\":[\"plie\",\"releve\",\"bras\",\"chasseD\",\"chasseG\",\"avance\",\"recule\",\"tourne\",\"saute\",\"reception\",\"clap\",\"vague\",\"descente\",\"remonte\",\"pirouette\",\"arabesque\",\"sautChat\",\"kick\",\"roulade\",\"moonwalk\",\"toprock\",\"grandJete\",\"fouette\",\"freeze\",\"echange\",\"reverence\"],\"outfits\":[\"justaucorps\",\"jupette\",\"tutu\",\"robe\",\"marin\",\"fee\",\"papillon\",\"cygne\",\"lapin\",\"flocon\",\"etoile\",\"flamenco\",\"princesse\",\"street\",\"abeille\",\"disco\"],\"hairs\":[\"chignon\",\"queue\",\"tresses\",\"carre\",\"couettes\",\"laches\",\"macarons\",\"couronne\",\"ruban\",\"afro\"],\"shoes\":[\"demi\",\"pieds\",\"pointes\",\"jazz\",\"baskets\",\"paillettes\",\"claquettes\"],\"accs\":[\"aucun\",\"noeud\",\"tiare\",\"fleurs\",\"ailes\",\"oreilles\",\"casquette\",\"beret\",\"baguette\",\"antennes\"],\"pieces\":[\"miroir\",\"banc\",\"portant\",\"chaise\",\"plante\",\"lampe\",\"tapis\",\"coiffeuse\",\"etagere\",\"pouf\",\"canape\",\"paravent\",\"fontaine\",\"fruits\",\"enceinte\",\"barre\",\"ventilo\",\"doudous\",\"sieste\",\"horloge\"],\"snacks\":[\"rien\",\"bonbons\",\"fruits\",\"barres\",\"tartines\"],\"upgrades\":[\"sieges\",\"confort\",\"buvette\",\"projecteurs\",\"boule\",\"scene\",\"decorForet\",\"decorMer\",\"decorVille\",\"logeXL\",\"placeur\",\"covoit\",\"navette\",\"rangee\"],\"numbers\":[\"P1\",\"P2\",\"M1\",\"M2\",\"G1\",\"G2\",\"A1\",\"A2\",\"F1\"],\"icons\":[\"💃\",\"🕺\",\"🩰\",\"🎀\",\"👑\",\"🌸\",\"🌼\",\"🌙\",\"⭐\",\"🌟\",\"✨\",\"💫\",\"🦋\",\"🐝\",\"🐞\",\"🦄\",\"🐬\",\"🐧\",\"🦊\",\"🐼\",\"🐸\",\"🌈\",\"☀️\",\"❄️\",\"🔥\",\"🍀\",\"🎈\",\"🎉\",\"🎵\",\"🎶\",\"🥁\",\"🎻\",\"🎺\",\"🪄\",\"🧚\",\"🧜\",\"🦢\",\"🕊️\",\"🌊\",\"🌀\",\"🔄\",\"⬆️\",\"⬇️\",\"➡️\",\"⬅️\",\"👏\",\"🙌\",\"🤸\",\"🧘\",\"🦵\",\"👣\",\"💎\",\"🪩\",\"🧢\",\"👗\",\"👘\",\"🥻\",\"🩱\",\"👒\",\"🎩\",\"🙇\",\"⏬\",\"⏫\",\"🐇\",\"🛬\",\"〰️\",\"⤵️\",\"⤴️\",\"🐈\",\"🌪️\",\"🦌\",\"🧊\",\"🔀\",\"⚓\",\"🐰\",\"🪞\",\"🪑\",\"💺\",\"🪴\",\"💡\",\"🟪\",\"💄\",\"👟\",\"🟣\",\"🛋️\",\"🎎\",\"🚰\",\"🍎\",\"🔊\",\"🧸\",\"😴\",\"🕰️\",\"🚫\",\"🍬\",\"🍌\",\"🥣\",\"🍞\",\"🥤\",\"🔦\",\"🎭\",\"🌳\",\"🏙️\",\"🧱\",\"🦺\",\"🚙\",\"🚐\",\"🅿️\"],\"styles\":[\"classique\",\"contemporain\",\"jazz\",\"hiphop\"],\"themes\":[\"lucioles\",\"lapins\",\"vent\",\"marins\",\"lumiere\",\"lac\",\"street\",\"battle\",\"disco\"]};\n        7→\n        8→// every table a grown-up may touch, the fields of an existing row they may change, and the fields a new row must have\n        9→const TABLES = {\n       10→  moves: { edit: ['fr', 'en', 'd', 'c', 'icon'], add: ['fr', 'en', 'd', 'c', 'icon', 'a', 'b', 'st'], optional: ['dx', 'dz'] },\n       11→  outfits: { edit: ['fr', 'en', 'price', 'min', 'icon', 'themes'], add: ['fr', 'en', 'min', 'icon'], optional: ['price', 'themes'] },\n       12→  hairs: { edit: ['fr', 'en', 'price', 'min'], add: ['fr', 'en', 'min'], optional: ['price'] },\n       13→  shoes: { edit: ['fr', 'en', 'price'] },\n       14→  accs: { edit: ['fr', 'en', 'price', 'themes'], add: ['fr', 'en'], optional: ['price', 'themes'] },\n       15→  pieces: { edit: ['fr', 'en', 'price'] },\n       16→  snacks: { edit: ['fr', 'en', 'price'] },\n       17→  upgrades: { edit: ['fr', 'en', 'price'] },\n       18→  numbers: { edit: ['fr', 'en'] },\n       19→  start: { edit: ['stars'], one: true },\n       20→};\n       21→const RANGES = { d: [1, 3], price: [0, 300], min: [1, 15], stars: [0, 9999], a: [0, 2], b: [0, 2], dx: [-1, 1], dz: [-1, 1] };\n       22→\n       23→// words nobody wants on a child's screen, in French and English; matched on the letters only, accents and look-alike\n       24→// digits removed, so \"C0NN@RD\" and \"connard\" are the same word. Short ones must stand alone; long ones anywhere.\n       25→const ALONE = ['cul', 'con', 'cons', 'conne', 'pd', 'nik', 'nique', 'niquer', 'bite', 'zob', 'tg', 'fdp', 'ass', 'arse', 'tit', 'tits', 'fag', 'cum', 'wank', 'twat', 'nazi', 'sex', 'sexe', 'porn', 'porno', 'crap', 'piss', 'poo', 'caca', 'pipi', 'prout'];\n       26→const ANYWHERE = ['merde', 'putain', 'pute', 'salope', 'connard', 'connasse', 'encule', 'enculer', 'batard', 'bordel', 'couille', 'chier', 'nichon', 'branle', 'bouffon', 'abruti', 'debile', 'cretin', 'idiot', 'pouffiasse', 'fuck', 'shit', 'bitch', 'bastard', 'dick', 'cock', 'pussy', 'slut', 'whore', 'cunt', 'asshole', 'bollock', 'bugger', 'wanker', 'stupid', 'dumb', 'hitler', 'drogue', 'cocaine', 'weed', 'beer', 'biere', 'vodka', 'whisky'];\n       27→const LOOK_ALIKE = { 0: 'o', 1: 'i', 3: 'e', 4: 'a', 5: 's', 7: 't', 8: 'b', '@': 'a', $: 's', '€': 'e', '!': 'i', '|': 'i' };\n       28→function plainLetters(s) {\n       29→  return String(s).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().split('').map((ch) => LOOK_ALIKE[ch] || ch).join('');\n       30→}\n       31→function rude(s) {\n       32→  const plain = plainLetters(s), joined = plain.replace(/[^a-z]/g, ''), squeezed = joined.replace(/(.)\\1+/g, '$1');\n       33→  const words = plain.split(/[^a-z]+/).filter(Boolean);\n       34→  if (words.some((x) => ALONE.includes(x) || ALONE.includes(x.replace(/(.)\\1+/g, '$1')))) return true;\n       35→  return ANYWHERE.some((bad) => joined.includes(bad) || squeezed.includes(bad));\n       36→}\n       37→\n       38→// a name: short plain text, letters, digits, spaces and everyday punctuation only — no markup, no links, nothing rude.\n       39→// Returns the tidied name, '' for an empty one, or null when it is refused.\n       40→const NAME_CHARS = /^[\\p{L}\\p{N} '’\\-.,!?&()«»“”:]*$/u;\n       41→function cleanName(s, max) {\n       42→  const name = String(s === undefined || s === null ? '' : s).normalize('NFC').replace(/\\s+/g, ' ').trim();\n       43→  if (!name) return '';\n       44→  if (name.length > (max || 30) || !NAME_CHARS.test(name) || rude(name)) return null;\n       45→  return name;\n       46→}\n       47→\n       48→// check one change. table, rowId, fields: what the grown-up sent, laid over what they had already saved for that row.\n       49→// Returns { ok: true, fields } with only allowed, tidied values, or { ok: false, reason } — the reason is a key of the\n       50→// grown-ups' words.\n       51→function checkChange(table, rowId, fields) {\n       52→  const T = TABLES[table];\n       53→  if (!T) return { ok: false, reason: 'badTable' };\n       54→  if (!fields || typeof fields !== 'object' || Array.isArray(fields)) return { ok: false, reason: 'badFields' };\n       55→  const id = T.one ? 'row' : String(rowId || '');\n       56→  const exists = T.one || (KNOWN[table] || []).includes(id);\n       57→  if (!exists) {\n       58→    if (!T.add) return { ok: false, reason: 'cannotAdd' };\n       59→    if (!/^[a-z][a-zA-Z0-9]{2,19}$/.test(id) || ['constructor', 'prototype', 'toString', 'valueOf'].includes(id)) return { ok: false, reason: 'badId' };\n       60→  }\n       61→  const allowed = exists ? T.edit : [...T.add, ...(T.optional || [])];\n       62→  const out = {};\n       63→  for (const [k, v] of Object.entries(fields)) {\n       64→    if (!allowed.includes(k)) return { ok: false, reason: 'badField' };\n       65→    if (k === 'fr' || k === 'en') {\n       66→      const name = cleanName(v, 30);\n       67→      if (!name) return { ok: false, reason: name === null ? 'nameRefused' : 'nameEmpty' };\n       68→      out[k] = name;\n       69→    } else if (k === 'icon') {\n       70→      if (!KNOWN.icons.includes(v)) return { ok: false, reason: 'badIcon' };\n       71→      out[k] = v;\n       72→    } else if (k === 'c') {\n       73→      if (v !== 4 && v !== 8) return { ok: false, reason: 'badCounts' };\n       74→      out[k] = v;\n       75→    } else if (k === 'st') {\n       76→      const list = String(v).split(' ').filter(Boolean);\n       77→      if (!(v === '*' || (list.length && list.every((x) => KNOWN.styles.includes(x))))) return { ok: false, reason: 'badStyle' };\n       78→      out[k] = v === '*' ? '*' : list.join(' ');\n       79→    } else if (k === 'themes') {\n       80→      if (!Array.isArray(v) || v.length > 4 || !v.every((x) => KNOWN.themes.includes(x))) return { ok: false, reason: 'badTheme' };\n       81→      out[k] = [...new Set(v)];\n       82→    } else {\n       83→      const [lo, hi] = RANGES[k];\n       84→      if (typeof v !== 'number' || !Number.isInteger(v) || v < lo || v > hi) return { ok: false, reason: `range_${k}` };\n       85→      if ((k === 'dx' || k === 'dz') && v === 0) continue;\n       86→      out[k] = v;\n       87→    }\n       88→  }\n       89→  if (!exists) for (const k of T.add) if (out[k] === undefined) return { ok: false, reason: 'missing' };\n       90→  if (Object.keys(out).length === 0) return { ok: false, reason: 'nothing' };\n       91→  return { ok: true, fields: out, isNew: !exists };\n       92→}\n       93→\n       94→// every saved change → the `over` that gala-rules' applyRows takes; changes that fail the check are left out\n       95→function toRows(changes) {\n       96→  const over = {}, refused = [];\n       97→  for (const c of changes || []) {\n       98→    let fields = c.fields;\n       99→    if (typeof fields === 'string') { try { fields = JSON.parse(fields); } catch (e) { fields = null; } }\n      100→    const r = checkChange(c.table, c.rowId, fields);\n      101→    if (!r.ok) { refused.push(`${c.table}/${c.rowId}`); continue; }\n      102→    if (TABLES[c.table].one) over[c.table] = r.fields;\n      103→    else (over[c.table] = over[c.table] || {})[c.rowId] = r.fields;\n      104→  }\n      105→  return { over, refused };\n      106→}", "numLines": 106, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": 106, "wasTruncated": false}, "outputText": "", "durationMs": 3.0898749828338623, "display": {"success": true, "verb": "Read", "message": "106 lines from tools/check.cloud.js", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
