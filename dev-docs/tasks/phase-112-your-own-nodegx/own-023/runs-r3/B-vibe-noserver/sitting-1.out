  28→        \"collectionName\": \"GameChange\",\n       29→        \"runOnChange-collectionName\": false,\n       30→        \"runOnChange-querySettings\": false\n       31→      },\n       32→      \"metadata\": {\n       33→        \"comment\": \"The table of changes is small (a few dozen rows at most), so the function reads it whole and finds the row in code. Fetched only after the roles are known, never at graph build.\"\n       34→      },\n       35→      \"x\": 40,\n       36→      \"y\": 280\n       37→    },\n       38→    {\n       39→      \"id\": \"sv_check\",\n       40→      \"type\": \"JavaScriptFunction\",\n       41→      \"label\": \"Check the change\",\n       42→      \"parameters\": {\n       43→        \"scriptOutputs\": [\n       44→          {\n       45→            \"id\": \"create\",\n       46→            \"label\": \"create\"\n       47→          },\n       48→          {\n       49→            \"id\": \"update\",\n       50→            \"label\": \"update\"\n       51→          },\n       52→          {\n       53→            \"id\": \"refused\",\n       54→            \"label\": \"refused\"\n       55→          },\n       56→          {\n       57→            \"id\": \"reason\",\n       58→            \"label\": \"reason\"\n       59→          },\n       60→          {\n       61→            \"id\": \"table\",\n       62→            \"label\": \"table\"\n       63→          },\n       64→          {\n       65→            \"id\": \"rowId\",\n       66→            \"label\": \"rowId\"\n       67→          },\n       68→          {\n       69→            \"id\": \"fieldsJson\",\n       70→            \"label\": \"fieldsJson\"\n       71→          },\n       72→          {\n       73→            \"id\": \"existingId\",\n       74→            \"label\": \"existingId\"\n       75→          }\n       76→        ],\n       77→        \"outtype-create\": \"signal\",\n       78→        \"outtype-update\": \"signal\",\n       79→        \"outtype-refused\": \"signal\",\n       80→        \"outtype-reason\": \"string\",\n       81→        \"outtype-table\": \"string\",\n       82→        \"outtype-rowId\": \"string\",\n       83→        \"outtype-fieldsJson\": \"string\",\n       84→        \"outtype-existingId\": \"string\",\n       85→        \"runOnChange-in-rows\": false,\n       86→        \"runOnChange-in-roles\": false,\n       87→        \"runOnChange-in-table\": false,\n       88→        \"runOnChange-in-rowId\": false,\n       89→        \"runOnChange-in-fields\": false,\n       90→        \"functionScript\": \"// What a grown-up may change, and how far. The same code runs in the cloud function that saves a change (so a child\\n// cannot get round it from the page) and in the browser before a change is laid over the game.\\nconst KNOWN = {\\\"moves\\\":[\\\"plie\\\",\\\"releve\\\",\\\"bras\\\",\\\"chasseD\\\",\\\"chasseG\\\",\\\"avance\\\",\\\"recule\\\",\\\"tourne\\\",\\\"saute\\\",\\\"reception\\\",\\\"clap\\\",\\\"vague\\\",\\\"descente\\\",\\\"remonte\\\",\\\"pirouette\\\",\\\"arabesque\\\",\\\"sautChat\\\",\\\"kick\\\",\\\"roulade\\\",\\\"moonwalk\\\",\\\"toprock\\\",\\\"grandJete\\\",\\\"fouette\\\",\\\"freeze\\\",\\\"echange\\\",\\\"reverence\\\"],\\\"outfits\\\":[\\\"justaucorps\\\",\\\"jupette\\\",\\\"tutu\\\",\\\"robe\\\",\\\"marin\\\",\\\"fee\\\",\\\"papillon\\\",\\\"cygne\\\",\\\"lapin\\\",\\\"flocon\\\",\\\"etoile\\\",\\\"flamenco\\\",\\\"princesse\\\",\\\"street\\\",\\\"abeille\\\",\\\"disco\\\"],\\\"hairs\\\":[\\\"chignon\\\",\\\"queue\\\",\\\"tresses\\\",\\\"carre\\\",\\\"couettes\\\",\\\"laches\\\",\\\"macarons\\\",\\\"couronne\\\",\\\"ruban\\\",\\\"afro\\\"],\\\"shoes\\\":[\\\"demi\\\",\\\"pieds\\\",\\\"pointes\\\",\\\"jazz\\\",\\\"baskets\\\",\\\"paillettes\\\",\\\"claquettes\\\"],\\\"accs\\\":[\\\"aucun\\\",\\\"noeud\\\",\\\"tiare\\\",\\\"fleurs\\\",\\\"ailes\\\",\\\"oreilles\\\",\\\"casquette\\\",\\\"beret\\\",\\\"baguette\\\",\\\"antennes\\\"],\\\"pieces\\\":[\\\"miroir\\\",\\\"banc\\\",\\\"portant\\\",\\\"chaise\\\",\\\"plante\\\",\\\"lampe\\\",\\\"tapis\\\",\\\"coiffeuse\\\",\\\"etagere\\\",\\\"pouf\\\",\\\"canape\\\",\\\"paravent\\\",\\\"fontaine\\\",\\\"fruits\\\",\\\"enceinte\\\",\\\"barre\\\",\\\"ventilo\\\",\\\"doudous\\\",\\\"sieste\\\",\\\"horloge\\\"],\\\"snacks\\\":[\\\"rien\\\",\\\"bonbons\\\",\\\"fruits\\\",\\\"barres\\\",\\\"tartines\\\"],\\\"upgrades\\\":[\\\"sieges\\\",\\\"confort\\\",\\\"buvette\\\",\\\"projecteurs\\\",\\\"boule\\\",\\\"scene\\\",\\\"decorForet\\\",\\\"decorMer\\\",\\\"decorVille\\\",\\\"logeXL\\\",\\\"placeur\\\",\\\"covoit\\\",\\\"navette\\\",\\\"rangee\\\"],\\\"numbers\\\":[\\\"P1\\\",\\\"P2\\\",\\\"M1\\\",\\\"M2\\\",\\\"G1\\\",\\\"G2\\\",\\\"A1\\\",\\\"A2\\\",\\\"F1\\\"],\\\"icons\\\":[\\\"💃\\\",\\\"🕺\\\",\\\"🩰\\\",\\\"🎀\\\",\\\"👑\\\",\\\"🌸\\\",\\\"🌼\\\",\\\"🌙\\\",\\\"⭐\\\",\\\"🌟\\\",\\\"✨\\\",\\\"💫\\\",\\\"🦋\\\",\\\"🐝\\\",\\\"🐞\\\",\\\"🦄\\\",\\\"🐬\\\",\\\"🐧\\\",\\\"🦊\\\",\\\"🐼\\\",\\\"🐸\\\",\\\"🌈\\\",\\\"☀️\\\",\\\"❄️\\\",\\\"🔥\\\",\\\"🍀\\\",\\\"🎈\\\",\\\"🎉\\\",\\\"🎵\\\",\\\"🎶\\\",\\\"🥁\\\",\\\"🎻\\\",\\\"🎺\\\",\\\"🪄\\\",\\\"🧚\\\",\\\"🧜\\\",\\\"🦢\\\",\\\"🕊️\\\",\\\"🌊\\\",\\\"🌀\\\",\\\"🔄\\\",\\\"⬆️\\\",\\\"⬇️\\\",\\\"➡️\\\",\\\"⬅️\\\",\\\"👏\\\",\\\"🙌\\\",\\\"🤸\\\",\\\"🧘\\\",\\\"🦵\\\",\\\"👣\\\",\\\"💎\\\",\\\"🪩\\\",\\\"🧢\\\",\\\"👗\\\",\\\"👘\\\",\\\"🥻\\\",\\\"🩱\\\",\\\"👒\\\",\\\"🎩\\\",\\\"🙇\\\",\\\"⏬\\\",\\\"⏫\\\",\\\"🐇\\\",\\\"🛬\\\",\\\"〰️\\\",\\\"⤵️\\\",\\\"⤴️\\\",\\\"🐈\\\",\\\"🌪️\\\",\\\"🦌\\\",\\\"🧊\\\",\\\"🔀\\\",\\\"⚓\\\",\\\"🐰\\\",\\\"🪞\\\",\\\"🪑\\\",\\\"💺\\\",\\\"🪴\\\",\\\"💡\\\",\\\"🟪\\\",\\\"💄\\\",\\\"👟\\\",\\\"🟣\\\",\\\"🛋️\\\",\\\"🎎\\\",\\\"🚰\\\",\\\"🍎\\\",\\\"🔊\\\",\\\"🧸\\\",\\\"😴\\\",\\\"🕰️\\\",\\\"🚫\\\",\\\"🍬\\\",\\\"🍌\\\",\\\"🥣\\\",\\\"🍞\\\",\\\"🥤\\\",\\\"🔦\\\",\\\"🎭\\\",\\\"🌳\\\",\\\"🏙️\\\",\\\"🧱\\\",\\\"🦺\\\",\\\"🚙\\\",\\\"🚐\\\",\\\"🅿️\\\"],\\\"styles\\\":[\\\"classique\\\",\\\"contemporain\\\",\\\"jazz\\\",\\\"hiphop\\\"],\\\"themes\\\":[\\\"lucioles\\\",\\\"lapins\\\",\\\"vent\\\",\\\"marins\\\",\\\"lumiere\\\",\\\"lac\\\",\\\"street\\\",\\\"battle\\\",\\\"disco\\\"]};\\nconst TABLES = {\\n  moves: { edit: ['fr', 'en', 'd', 'c', 'icon'], add: ['fr', 'en', 'd', 'c', 'icon', 'a', 'b', 'st'], optional: ['dx', 'dz'] },\\n  outfits: { edit: ['fr', 'en', 'price', 'min', 'icon', 'themes'], add: ['fr', 'en', 'min', 'icon'], optional: ['price', 'themes'] },\\n  hairs: { edit: ['fr', 'en', 'price', 'min'], add: ['fr', 'en', 'min'], optional: ['price'] },\\n  shoes: { edit: ['fr', 'en', 'price'] },\\n  accs: { edit: ['fr', 'en', 'price', 'themes'], add: ['fr', 'en'], optional: ['price', 'themes'] },\\n  pieces: { edit: ['fr', 'en', 'price'] },\\n  snacks: { edit: ['fr', 'en', 'price'] },\\n  upgrades: { edit: ['fr', 'en', 'price'] },\\n  numbers: { edit: ['fr', 'en'] },\\n  start: { edit: ['stars'], one: true },\\n};\\nconst RANGES = { d: [1, 3], price: [0, 300], min: [1, 15], stars: [0, 9999], a: [0, 2], b: [0, 2], dx: [-1, 1], dz: [-1, 1] };\\n// words nobody wants on a child's screen, matched on the letters only, accents and look-alike digits removed\\nconst ALONE = ['cul', 'con', 'cons', 'conne', 'pd', 'nik', 'nique', 'niquer', 'bite', 'zob', 'tg', 'fdp', 'ass', 'arse', 'tit', 'tits', 'fag', 'cum', 'wank', 'twat', 'nazi', 'sex', 'sexe', 'porn', 'porno', 'crap', 'piss', 'poo', 'caca', 'pipi', 'prout'];\\nconst ANYWHERE = ['merde', 'putain', 'pute', 'salope', 'connard', 'connasse', 'encule', 'enculer', 'batard', 'bordel', 'couille', 'chier', 'nichon', 'branle', 'bouffon', 'abruti', 'debile', 'cretin', 'idiot', 'pouffiasse', 'fuck', 'shit', 'bitch', 'bastard', 'dick', 'cock', 'pussy', 'slut', 'whore', 'cunt', 'asshole', 'bollock', 'bugger', 'wanker', 'stupid', 'dumb', 'hitler', 'drogue', 'cocaine', 'weed', 'beer', 'biere', 'vodka', 'whisky'];\\nconst LOOK_ALIKE = { 0: 'o', 1: 'i', 3: 'e', 4: 'a', 5: 's', 7: 't', 8: 'b', '@': 'a', $: 's', '€': 'e', '!': 'i', '|': 'i' };\\nfunction plainLetters(s) {\\n  return String(s).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().split('').map((ch) => LOOK_ALIKE[ch] || ch).join('');\\n}\\nfunction rude(s) {\\n  const plain = plainLetters(s), joined = plain.replace(/[^a-z]/g, ''), squeezed = joined.replace(/(.)\\\\1+/g, '$1');\\n  const words = plain.split(/[^a-z]+/).filter(Boolean);\\n  if (words.some((x) => ALONE.includes(x) || ALONE.includes(x.replace(/(.)\\\\1+/g, '$1')))) return true;\\n  return ANYWHERE.some((bad) => joined.includes(bad) || squeezed.includes(bad));\\n}\\nconst NAME_CHARS = /^[\\\\p{L}\\\\p{N} '’\\\\-.,!?&()«»“”:]*$/u;\\nfunction cleanName(s, max) {\\n  const name = String(s === undefined || s === null ? '' : s).normalize('NFC').replace(/\\\\s+/g, ' ').trim();\\n  if (!name) return '';\\n  if (name.length > (max || 30) || !NAME_CHARS.test(name) || rude(name)) return null;\\n  return name;\\n}\\nfunction checkChange(table, rowId, fields) {\\n  const T = TABLES[table];\\n  if (!T) return { ok: false, reason: 'badTable' };\\n  if (!fields || typeof fields !== 'object' || Array.isArray(fields)) return { ok: false, reason: 'badFields' };\\n  const id = T.one ? 'row' : String(rowId || '');\\n  const exists = T.one || (KNOWN[table] || []).includes(id);\\n  if (!exists) {\\n    if (!T.add) return { ok: false, reason: 'cannotAdd' };\\n    if (!/^[a-z][a-zA-Z0-9]{2,19}$/.test(id) || ['constructor', 'prototype', 'toString', 'valueOf'].includes(id)) return { ok: false, reason: 'badId' };\\n  }\\n  const allowed = exists ? T.edit : [...T.add, ...(T.optional || [])];\\n  const out = {};\\n  for (const [k, v] of Object.entries(fields)) {\\n    if (!allowed.includes(k)) return { ok: false, reason: 'badField' };\\n    if (k === 'fr' || k === 'en') {\\n      const name = cleanName(v, 30);\\n      if (!name) return { ok: false, reason: name === null ? 'nameRefused' : 'nameEmpty' };\\n      out[k] = name;\\n    } else if (k === 'icon') {\\n      if (!KNOWN.icons.includes(v)) return { ok: false, reason: 'badIcon' };\\n      out[k] = v;\\n    } else if (k === 'c') {\\n      if (v !== 4 && v !== 8) return { ok: false, reason: 'badCounts' };\\n      out[k] = v;\\n    } else if (k === 'st') {\\n      const list = String(v).split(' ').filter(Boolean);\\n      if (!(v === '*' || (list.length && list.every((x) => KNOWN.styles.includes(x))))) return { ok: false, reason: 'badStyle' };\\n      out[k] = v === '*' ? '*' : list.join(' ');\\n    } else if (k === 'themes') {\\n      if (!Array.isArray(v) || v.length > 4 || !v.every((x) => KNOWN.themes.includes(x))) return { ok: false, reason: 'badTheme' };\\n      out[k] = [...new Set(v)];\\n    } else {\\n      const [lo, hi] = RANGES[k];\\n      if (typeof v !== 'number' || !Number.isInteger(v) || v < lo || v > hi) return { ok: false, reason: `range_${k}` };\\n      if ((k === 'dx' || k === 'dz') && v === 0) continue;\\n      out[k] = v;\\n    }\\n  }\\n  if (!exists) for (const k of T.add) if (out[k] === undefined) return { ok: false, reason: 'missing' };\\n  if (Object.keys(out).length === 0) return { ok: false, reason: 'nothing' };\\n  return { ok: true, fields: out, isNew: !exists };\\n}\\n\\n// ---- the change itself: only a grown-up, only what the checker above lets through ----\\nif (Inputs.rows === undefined || Inputs.roles === undefined) return;\\nconst refuse = (reason) => { Outputs.reason = reason; Outputs.refused(); };\\nif (!(Inputs.roles || []).includes('grownup')) return refuse('notGrownup');\\nlet fields = Inputs.fields;\\nif (typeof fields === 'string') { try { fields = JSON.parse(fields); } catch (e) { fields = null; } }\\nif (!fields || typeof fields !== 'object' || Array.isArray(fields)) return refuse('badFields');\\nconst table = String(Inputs.table || '');\\nif (!TABLES[table]) return refuse('badTable');\\nconst rowId = TABLES[table].one ? 'row' : String(Inputs.rowId || '');\\nconst get = (o, k) => (o && typeof o.get === 'function' ? o.get(k) : o && o[k]);\\nconst old = (Inputs.rows || []).find((r) => get(r, 'table') === table && get(r, 'rowId') === rowId);\\nlet before = {};\\nif (old) { try { before = JSON.parse(get(old, 'fields')) || {}; } catch (e) { before = {}; } }\\nconst result = checkChange(table, rowId, { ...before, ...fields });\\nif (!result.ok) return refuse(result.reason);\\nOutputs.table = table;\\nOutputs.rowId = rowId;\\nOutputs.fieldsJson = JSON.stringify(result.fields);\\nOutputs.existingId = old ? get(old, 'id') || old.id : '';\\nif (old) Outputs.update(); else Outputs.create();\\n\"\n       91→      },\n       92→      \"metadata\": {\n       93→        \"comment\": \"The same checker as the browser's scripts/settings/check.js (generated from tools/check.src.js by tools/sync-check.mjs): cloud functions cannot use script files yet, so it is pasted here.\"\n       94→      },\n       95→      \"x\": 40,\n       96→      \"y\": 400,\n       97→      \"ports\": [\n       98→        {\n       99→          \"name\": \"out-create\",\n      100→          \"displayName\": \"create\",\n      101→          \"plug\": \"output\",\n      102→          \"type\": \"signal\",\n      103→          \"group\": \"Outputs\"\n      104→        },\n      105→        {\n      106→          \"name\": \"out-update\",\n      107→          \"displayName\": \"update\",\n      108→          \"plug\": \"output\",\n      109→          \"type\": \"signal\",\n      110→          \"group\": \"Outputs\"\n      111→        },\n      112→        {\n      113→          \"name\": \"out-refused\",\n      114→          \"displayName\": \"refused\",\n      115→          \"plug\": \"output\",\n      116→          \"type\": \"signal\",\n      117→          \"group\": \"Outputs\"\n      118→        },\n      119→        {\n      120→          \"name\": \"out-reason\",\n      121→          \"displayName\": \"reason\",\n      122→          \"plug\": \"output\",\n      123→          \"type\": \"string\",\n      124→          \"group\": \"Outputs\"\n      125→        },\n      126→        {\n      127→          \"name\": \"out-table\",\n      128→          \"displayName\": \"table\",\n      129→          \"plug\": \"output\",\n      130→          \"type\": \"string\",\n      131→          \"group\": \"Outputs\"\n      132→        },\n      133→        {\n      134→          \"name\": \"out-rowId\",\n      135→          \"displayName\": \"rowId\",\n      136→          \"plug\": \"output\",\n      137→          \"type\": \"string\",\n      138→          \"group\": \"Outputs\"\n      139→        },\n      140→        {\n      141→          \"name\": \"out-fieldsJson\",\n      142→          \"displayName\": \"fieldsJson\",\n      143→          \"plug\": \"output\",\n      144→          \"type\": \"string\",\n      145→          \"group\": \"Outputs\"\n      146→        },\n      147→        {\n      148→          \"name\": \"out-existingId\",\n      149→          \"displayName\": \"existingId\",\n      150→          \"plug\": \"output\",\n      151→          \"type\": \"string\",\n      152→          \"group\": \"Outputs\"\n      153→        },\n      154→        {\n      155→          \"name\": \"in-rows\",\n      156→          \"displayName\": \"rows\",\n      157→          \"plug\": \"input\",\n      158→          \"type\": \"*\",\n      159→          \"group\": \"Inputs\"\n      160→        },\n      161→        {\n      162→          \"name\": \"in-roles\",\n      163→          \"displayName\": \"roles\",\n      164→          \"plug\": \"input\",\n      165→          \"type\": \"*\",\n      166→          \"group\": \"Inputs\"\n      167→        },\n      168→        {\n      169→          \"name\": \"in-fields\",\n      170→          \"displayName\": \"fields\",\n      171→          \"plug\": \"input\",\n      172→          \"type\": \"*\",\n      173→          \"group\": \"Inputs\"\n      174→        },\n      175→        {\n      176→          \"name\": \"in-table\",\n      177→          \"displayName\": \"table\",\n      178→          \"plug\": \"input\",\n      179→          \"type\": \"*\",\n      180→          \"group\": \"Inputs\"\n      181→        },\n      182→        {\n      183→          \"name\": \"in-rowId\",\n      184→          \"displayName\": \"rowId\",\n      185→          \"plug\": \"input\",\n      186→          \"type\": \"*\",\n      187→          \"group\": \"Inputs\"\n      188→        }\n      189→      ]\n      190→    },\n      191→    {\n      192→      \"id\": \"sv_create\",\n      193→      \"type\": \"NewDbModelProperties\",\n      194→      \"label\": \"A first change to this row\",\n      195→      \"parameters\": {\n      196→        \"collectionName\": \"GameChange\"\n      197→      },\n      198→      \"x\": 40,\n      199→      \"y\": 520\n      200→    },\n      201→    {\n      202→      \"id\": \"sv_update\",\n      203→      \"type\": \"SetDbModelProperties\",\n      204→      \"label\": \"This row was changed before\",\n      205→      \"parameters\": {\n      206→        \"collectionName\": \"GameChange\",\n      207→        \"idSource\": \"explicit\"\n      208→      },\n      209→      \"x\": 40,\n      210→      \"y\": 640\n      211→    },\n      212→    {\n      213→      \"id\": \"sv_ok\",\n      214→      \"type\": \"noodl.cloud.response\",\n      215→      \"label\": \"Saved\",\n      216→      \"parameters\": {\n      217→        \"params\": \"fields\"\n      218→      },\n      219→      \"x\": 40,\n      220→      \"y\": 760\n      221→    },\n      222→    {\n      223→      \"id\": \"sv_fail\",\n      224→      \"type\": \"noodl.cloud.response\",\n      225→      \"label\": \"Refused\",\n      226→      \"parameters\": {\n      227→        \"status\": \"failure\"\n      228→      },\n      229→      \"x\": 40,\n      230→      \"y\": 880\n      231→    }\n      232→  ]\n      233→}", "numLines": 233, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": 233, "wasTruncated": false}, "outputText": "", "durationMs": 10.587124852463603, "display": {"success": true, "verb": "Read", "message": "233 lines from app/components/__cloud__/saveChange/nodes.json", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
