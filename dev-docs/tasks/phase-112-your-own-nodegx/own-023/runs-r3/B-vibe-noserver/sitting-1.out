{"id": "call_8e3fd41bd53542b2b0273c1a", "sessionId": "25505b9f-a8ea-dd62-6b8d-be45f136b4b6", "turnId": "5093e3ac-9153-41c4-bc70-29af6171bbc2", "inputEntryId": null, "createdAt": 1792605333450, "updatedAt": 1792605333466, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "read_file", "detail": {"toolName": "read_file", "display": {"summary": "Reading app/scripts/rules/data.js", "content": null, "suffix": "", "verb": "Reading", "message": "app/scripts/rules/data.js", "settledVerb": "Read", "settledMessage": "app/scripts/rules/data.js", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/rules/data.js", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/rules/data.js", "content": "        1→// GENERATED from gala-rules/src/data.js by tools/sync-rules.mjs — do not edit here, edit gala-rules and run it again.\n        2→// Everything the game knows, as data. The engine (engine.js) reads it, the world draws it, the sheet lists it.\n        3→// To add a costume, a move, a piece of furniture or a shop item, add a row here: nothing else needs to change\n        4→// unless the new thing has a new kind of effect.\n        5→const hm = (h, m = 0, s = 0) => h * 3600 + m * 60 + s;\n        6→\n        7→/* ---------------- the day's fixed facts ---------------- */\n        8→const RULES = {\n        9→  arrive: hm(18, 30), warmUp: hm(18, 45), hairStart: hm(19, 0), dressedBy: hm(19, 45), snackAt: hm(19, 15),\n       10→  hallCloses: hm(21, 0), bedtime: hm(20, 45),\n       11→  setChange: 90, floorSwap: 150, wingsBefore: 150,\n       12→  stage: { halfW: 5.5, depth: 5 }, stageBig: { halfW: 6, depth: 5.5 },\n       13→  hideDx: 0.5, bump: 0.6,\n       14→  cakeKcal: 400, bottleCl: 150, crepeKcal: 150, compoteKcal: 70,\n       15→  startMin: hm(19, 45), startMax: hm(20, 30), intervalMin: 600, intervalMax: 1800,\n       16→  railCap: 8, countsPerSec: 4,\n       17→  ankle: 0.15, // the share of falls on a step above the class's level that twist an ankle\n       18→};\n       19→\n       20→/* ---------------- the classes: who dances ---------------- */\n       21→// exp: experience (1 beginner .. 3 experienced); span: arms open, hand to hand, in metres\n       22→// drain: energy lost per minute awake; nerves: stage fright at the start of the evening\n       23→const CLASSES = [\n       24→  { id: 'petits', n: 6, age: 6, scale: 0.7, kcal: 200, juice: 15, exp: 1, span: 1.0, from: 1, nerves: 30, drain: 0.2, color: '#ff9ec7', fr: 'Les petits', en: 'The little ones' },\n       25→  { id: 'moyens', n: 10, age: 10, scale: 0.85, kcal: 300, juice: 20, exp: 2, span: 1.3, from: 1, nerves: 45, drain: 0.15, color: '#7cc6ff', fr: 'Les moyens', en: 'The middles' },\n       26→  { id: 'grandes', n: 8, age: 15, scale: 1, kcal: 400, juice: 25, exp: 3, span: 1.6, from: 1, nerves: 35, drain: 0.12, color: '#b48cff', fr: 'Les grandes', en: 'The seniors' },\n       27→  { id: 'ados', n: 8, age: 13, scale: 0.95, kcal: 350, juice: 25, exp: 2, span: 1.5, from: 3, nerves: 40, drain: 0.13, color: '#ffb86b', fr: 'Les ados', en: 'The teens' },\n       28→  { id: 'mamans', n: 6, age: 38, scale: 1.04, kcal: 300, juice: 25, exp: 1, span: 1.7, from: 4, nerves: 60, drain: 0.1, color: '#86d9a6', fr: 'Les mamans', en: 'The mums' },\n       29→];\n       30→const CLS = Object.fromEntries(CLASSES.map((c) => [c.id, c]));\n       31→const NAMES = {\n       32→  petits: ['Lou', 'Mila', 'Jade', 'Rose', 'Nino', 'Alba'],\n       33→  moyens: ['Inès', 'Léna', 'Chloé', 'Manon', 'Zoé', 'Sacha', 'Lina', 'Maëlle', 'Romy', 'Iris'],\n       34→  grandes: ['Camille', 'Juliette', 'Clara', 'Anaïs', 'Margaux', 'Louise', 'Emma', 'Salomé'],\n       35→  ados: ['Yanis', 'Kenza', 'Noé', 'Maya', 'Lilou', 'Tom', 'Aya', 'Nora'],\n       36→  mamans: ['Sophie', 'Nadia', 'Claire', 'Fatou', 'Hélène', 'Julie'],\n       37→};\n       38→\n       39→/* ---------------- the numbers: one piece of music each ---------------- */\n       40→// counts = the beats in the music; the music lasts counts × 60 ÷ bpm seconds\n       41→// floor: classical and contemporary dance on the dance mat (\"tapis\"), jazz and hip-hop on the wooden boards\n       42→const NUMBERS = {\n       43→  P1: { cls: 'petits', bpm: 96, counts: 288, style: 'classique', mood: 'calme', theme: 'lucioles', fr: 'Les lucioles', en: 'Fireflies' },\n       44→  P2: { cls: 'petits', bpm: 120, counts: 288, style: 'jazz', mood: 'vif', theme: 'lapins', fr: 'La ronde des lapins', en: 'Rabbit round' },\n       45→  M1: { cls: 'moyens', bpm: 90, counts: 384, style: 'contemporain', mood: 'calme', theme: 'vent', fr: 'Le vent', en: 'The wind' },\n       46→  M2: { cls: 'moyens', bpm: 128, counts: 384, style: 'jazz', mood: 'vif', theme: 'marins', fr: 'Les marins', en: 'Sailors' },\n       47→  G1: { cls: 'grandes', bpm: 120, counts: 480, style: 'classique', mood: 'calme', theme: 'lumiere', fr: 'Lumière', en: 'Light' },\n       48→  G2: { cls: 'grandes', bpm: 96, counts: 480, style: 'classique', mood: 'calme', theme: 'lac', fr: 'Le lac', en: 'The lake' },\n       49→  A1: { cls: 'ados', bpm: 100, counts: 320, style: 'hiphop', mood: 'vif', theme: 'street', fr: 'Dans la rue', en: 'Street' },\n       50→  A2: { cls: 'ados', bpm: 120, counts: 384, style: 'hiphop', mood: 'vif', theme: 'battle', fr: 'La battle', en: 'The battle' },\n       51→  F1: { cls: 'mamans', bpm: 120, counts: 256, style: 'jazz', mood: 'vif', theme: 'disco', fr: 'Disco des mamans', en: 'Mums’ disco' },\n       52→};\n       53→const numDur = (id) => (NUMBERS[id].counts * 60) / NUMBERS[id].bpm;\n       54→const OTHER_ITEMS = { accueil: { kind: 'talk', dur: 240 }, entracte: { kind: 'interval' }, final: { kind: 'finale', dur: 180 } };\n       55→const itemKind = (id) => (NUMBERS[id] ? 'number' : OTHER_ITEMS[id].kind);\n       56→const STYLES = {\n       57→  classique: { icon: '🩰', floor: 'tapis', fr: 'classique', en: 'ballet' },\n       58→  contemporain: { icon: '🌊', floor: 'tapis', fr: 'contemporain', en: 'contemporary' },\n       59→  jazz: { icon: '🎷', floor: 'bois', fr: 'jazz', en: 'jazz' },\n       60→  hiphop: { icon: '🧢', floor: 'bois', fr: 'hip-hop', en: 'hip-hop' },\n       61→};\n       62→\n       63→/* ---------------- the moves she chains into a phrase ---------------- */\n       64→// counts: 4 or 8; diff 1..3; a = the level it starts on, b = the level it ends on (0 floor, 1 standing, 2 up in the air);\n       65→// dx: metres to the right (seen from the audience), dz: metres back (away from the audience);\n       66→// st: the styles it belongs to ('*' every style); swap: walks to the other formation\n       67→const MOVES = {\n       68→  plie: { c: 4, d: 1, a: 1, b: 1, st: '*', icon: '🙇', fr: 'Plié', en: 'Plié' },\n       69→  releve: { c: 4, d: 1, a: 1, b: 2, st: 'classique contemporain jazz', icon: '⬆️', fr: 'Relevé', en: 'Rise' },\n       70→  bras: { c: 8, d: 1, a: 1, b: 1, st: 'classique contemporain', icon: '🦢', fr: 'Port de bras', en: 'Arm sweep' },\n       71→  chasseD: { c: 8, d: 1, a: 1, b: 1, dx: 1, st: '*', icon: '➡️', fr: 'Chassé à droite', en: 'Chassé right' },\n       72→  chasseG: { c: 8, d: 1, a: 1, b: 1, dx: -1, st: '*', icon: '⬅️', fr: 'Chassé à gauche', en: 'Chassé left' },\n       73→  avance: { c: 4, d: 1, a: 1, b: 1, dz: -1, st: '*', icon: '⏬', fr: 'Pas en avant', en: 'Step forward' },\n       74→  recule: { c: 4, d: 1, a: 1, b: 1, dz: 1, st: '*', icon: '⏫', fr: 'Pas en arrière', en: 'Step back' },\n       75→  tourne: { c: 4, d: 1, a: 1, b: 1, st: '*', icon: '🔄', fr: 'Tour sur soi', en: 'Spin' },\n       76→  saute: { c: 4, d: 1, a: 1, b: 2, st: '*', icon: '🐇', fr: 'Petits sauts', en: 'Hops' },\n       77→  reception: { c: 4, d: 1, a: 2, b: 1, st: '*', icon: '🛬', fr: 'Réception', en: 'Landing' },\n       78→  clap: { c: 4, d: 1, a: 1, b: 1, st: 'jazz hiphop', icon: '👏', fr: 'Tape des mains', en: 'Clap' },\n       79→  vague: { c: 4, d: 1, a: 1, b: 1, st: 'hiphop jazz contemporain', icon: '〰️', fr: 'Vague', en: 'Body wave' },\n       80→  descente: { c: 4, d: 1, a: 1, b: 0, st: 'contemporain jazz hiphop', icon: '⤵️', fr: 'Descente au sol', en: 'Down to the floor' },\n       81→  remonte: { c: 4, d: 1, a: 0, b: 1, st: '*', icon: '⤴️', fr: 'Se relever', en: 'Get up' },\n       82→  pirouette: { c: 4, d: 2, a: 2, b: 1, st: 'classique jazz contemporain', icon: '🌀', fr: 'Pirouette', en: 'Pirouette' },\n       83→  arabesque: { c: 8, d: 2, a: 1, b: 1, st: 'classique contemporain', icon: '🕊️', fr: 'Arabesque', en: 'Arabesque' },\n       84→  sautChat: { c: 4, d: 2, a: 1, b: 2, st: 'classique jazz', icon: '🐈', fr: 'Saut de chat', en: 'Cat leap' },\n       85→  kick: { c: 4, d: 2, a: 1, b: 1, st: 'jazz', icon: '🦵', fr: 'Kick jazz', en: 'Jazz kick' },\n       86→  roulade: { c: 8, d: 2, a: 0, b: 0, st: 'contemporain hiphop', icon: '🌪️', fr: 'Roulade au sol', en: 'Floor roll' },\n       87→  moonwalk: { c: 8, d: 2, a: 1, b: 1, dx: -1, st: 'hiphop jazz', icon: '🌙', fr: 'Moonwalk', en: 'Moonwalk' },\n       88→  toprock: { c: 8, d: 1, a: 1, b: 1, st: 'hiphop', icon: '🕺', fr: 'Toprock', en: 'Toprock' },\n       89→  grandJete: { c: 8, d: 3, a: 1, b: 2, dx: 1, st: 'classique contemporain', icon: '🦌', fr: 'Grand jeté', en: 'Grand jeté' },\n       90→  fouette: { c: 8, d: 3, a: 2, b: 2, st: 'classique', icon: '💫', fr: 'Fouettés', en: 'Fouettés' },\n       91→  freeze: { c: 4, d: 3, a: 0, b: 0, st: 'hiphop', icon: '🧊', fr: 'Freeze', en: 'Freeze' },\n       92→  echange: { c: 8, d: 1, a: 1, b: 1, swap: true, st: '*', icon: '🔀', fr: 'Changer de place', en: 'Swap places' },\n       93→  reverence: { c: 4, d: 1, a: 1, b: 1, st: '*', icon: '🎀', fr: 'Révérence', en: 'Curtsy' },\n       94→};\n       95→const MAX_MOVES = 12;\n       96→const LEVELS = { fr: ['au sol', 'debout', 'en l’air'], en: ['on the floor', 'standing', 'in the air'] };\n       97→\n       98→/* ---------------- the costumes ---------------- */\n       99→// min: minutes to put it on; themes: the numbers it suits (a costume that suits the number makes the parents go \"oh!\")\n      100→const OUTFITS = {\n      101→  justaucorps: { min: 2, fr: 'Justaucorps', en: 'Leotard', icon: '🩱' },\n      102→  jupette: { min: 3, fr: 'Jupette', en: 'Skirt', icon: '👗' },\n      103→  tutu: { min: 4, fr: 'Tutu', en: 'Tutu', icon: '🩰', themes: ['lumiere'] },\n      104→  robe: { min: 4, price: 20, fr: 'Robe longue', en: 'Long dress', icon: '👘', themes: ['vent'] },\n      105→  marin: { min: 3, price: 20, fr: 'Marinière', en: 'Sailor', icon: '⚓', themes: ['marins'] },\n      106→  fee: { min: 6, price: 35, fr: 'Fée', en: 'Fairy', icon: '🧚', themes: ['lucioles', 'lumiere'] },\n      107→  papillon: { min: 5, price: 30, fr: 'Papillon', en: 'Butterfly', icon: '🦋', themes: ['vent', 'lucioles'] },\n      108→  cygne: { min: 6, price: 40, fr: 'Cygne', en: 'Swan', icon: '🦢', themes: ['lac'] },\n      109→  lapin: { min: 4, price: 25, fr: 'Lapin', en: 'Bunny', icon: '🐰', themes: ['lapins'] },\n      110→  flocon: { min: 5, price: 30, fr: 'Flocon', en: 'Snowflake', icon: '❄️', themes: ['lac', 'vent'] },\n      111→  etoile: { min: 4, price: 35, fr: 'Étoile à paillettes', en: 'Sequin star', icon: '⭐', themes: ['lumiere', 'disco'] },\n      112→  flamenco: { min: 5, price: 30, fr: 'Robe à volants', en: 'Flamenco dress', icon: '💃', themes: ['disco'] },\n      113→  princesse: { min: 6, price: 40, fr: 'Princesse', en: 'Princess', icon: '👑', themes: ['lumiere', 'lac'] },\n      114→  street: { min: 2, fr: 'Jogging et sweat', en: 'Joggers and hoodie', icon: '🧢', themes: ['street', 'battle'], season: 3 },\n      115→  abeille: { min: 4, price: 25, fr: 'Abeille', en: 'Bee', icon: '🐝', themes: ['lapins'] },\n      116→  disco: { min: 3, price: 25, fr: 'Combi disco', en: 'Disco jumpsuit', icon: '🪩', themes: ['disco', 'battle'] },\n      117→};\n      118→// min: minutes to do one dancer's hair\n      119→const HAIRS = {\n      120→  chignon: { min: 4, fr: 'Chignon', en: 'Bun' },\n      121→  queue: { min: 2, fr: 'Queue de cheval', en: 'Ponytail' },\n      122→  tresses: { min: 6, fr: 'Tresses', en: 'Braids' },\n      123→  carre: { min: 1, fr: 'Carré', en: 'Bob' },\n      124→  couettes: { min: 3, price: 10, fr: 'Couettes', en: 'Pigtails' },\n      125→  laches: { min: 1, price: 10, fr: 'Cheveux lâchés', en: 'Hair down' },\n      126→  macarons: { min: 5, price: 15, fr: 'Macarons', en: 'Space buns' },\n      127→  couronne: { min: 8, price: 20, fr: 'Couronne de tresses', en: 'Crown braid' },\n      128→  ruban: { min: 3, price: 15, fr: 'Queue haute à ruban', en: 'High pony with ribbon' },\n      129→  afro: { min: 2, price: 15, fr: 'Afro', en: 'Afro' },\n      130→};\n      131→const SHOES = {\n      132→  demi: { fr: 'Demi-pointes', en: 'Ballet slippers', color: '#f2a7bb' },\n      133→  pieds: { fr: 'Pieds nus', en: 'Barefoot', color: null },\n      134→  pointes: { price: 30, fr: 'Pointes', en: 'Pointe shoes', color: '#ffc9d6', expMin: 3 },\n      135→  jazz: { price: 15, fr: 'Bottines jazz', en: 'Jazz boots', color: '#2b2236' },\n      136→  baskets: { price: 15, fr: 'Baskets', en: 'Trainers', color: '#ffffff', season: 3 },\n      137→  paillettes: { price: 25, fr: 'Chaussons à paillettes', en: 'Glitter slippers', color: '#f5d76e' },\n      138→  claquettes: { price: 20, fr: 'Claquettes', en: 'Tap shoes', color: '#1b1720' },\n      139→};\n      140→const ACCS = {\n      141→  aucun: { fr: 'Rien', en: 'Nothing' },\n      142→  noeud: { fr: 'Nœud', en: 'Bow' },\n      143→  tiare: { price: 20, fr: 'Tiare', en: 'Tiara', themes: ['lac', 'lumiere'] },\n      144→  fleurs: { price: 15, fr: 'Couronne de fleurs', en: 'Flower crown', themes: ['vent', 'lucioles'] },\n      145→  ailes: { price: 30, fr: 'Ailes', en: 'Wings', themes: ['lucioles'] },\n      146→  oreilles: { price: 15, fr: 'Oreilles de lapin', en: 'Bunny ears', themes: ['lapins'] },\n      147→  casquette: { price: 10, fr: 'Casquette', en: 'Cap', themes: ['street', 'battle'] },\n      148→  beret: { price: 10, fr: 'Béret de marin', en: 'Sailor cap', themes: ['marins'] },\n      149→  baguette: { price: 15, fr: 'Baguette magique', en: 'Magic wand', themes: ['lucioles'] },\n      150→  antennes: { price: 15, fr: 'Antennes', en: 'Antennae', themes: ['lapins'] },\n      151→};\n      152→const COLORS = ['#ff9ec7', '#ff6f91', '#c23652', '#ffb86b', '#f5d76e', '#86d9a6', '#2e8b8b', '#7cc6ff', '#4f7cff', '#b48cff', '#ffffff', '#2b2236'];\n      153→\n      154→/* ---------------- the dressing room (\"la loge\") ---------------- */\n      155→// w × d tiles of 1 m; wall: must stand with its back against a wall, facing the room; flat: a rug, you can walk on it\n      156→// the effects are read by the engine: postes (hair stations), rail (holds 8 costumes), seats, calm (less stage fright),\n      157→// and the named effects (water, fruit, fan, shoes, screen, sieste, doudous, barre, clock, music)\n      158→const PIECES = {\n      159→  miroir: { w: 1, d: 1, wall: true, icon: '🪞', fx: { postes: 1 }, fr: 'Miroir', en: 'Mirror' },\n      160→  banc: { w: 2, d: 1, icon: '🪑', fx: { seats: 2 }, fr: 'Banc', en: 'Bench' },\n      161→  portant: { w: 2, d: 1, icon: '👗', fx: { rail: 1 }, fr: 'Portant', en: 'Clothes rail' },\n      162→  chaise: { w: 1, d: 1, icon: '💺', fx: { seats: 1 }, fr: 'Chaise', en: 'Chair' },\n      163→  plante: { w: 1, d: 1, icon: '🪴', fx: { calm: 4 }, fr: 'Plante', en: 'Plant' },\n      164→  lampe: { w: 1, d: 1, icon: '💡', fx: { calm: 3 }, fr: 'Lampe douce', en: 'Soft lamp' },\n      165→  tapis: { w: 2, d: 2, flat: true, icon: '🟪', fx: { calm: 3 }, fr: 'Tapis', en: 'Rug' },\n      166→  coiffeuse: { w: 2, d: 1, wall: true, icon: '💄', fx: { postes: 2 }, price: 30, fr: 'Coiffeuse lumineuse', en: 'Make-up table' },\n      167→  etagere: { w: 2, d: 1, wall: true, icon: '👟', fx: { shoes: 1 }, price: 20, fr: 'Étagère à chaussons', en: 'Shoe shelf' },\n      168→  pouf: { w: 1, d: 1, icon: '🟣', fx: { seats: 1, calm: 1 }, price: 10, fr: 'Pouf', en: 'Pouffe' },\n      169→  canape: { w: 3, d: 1, icon: '🛋️', fx: { seats: 3, calm: 2 }, price: 35, fr: 'Canapé', en: 'Sofa' },\n      170→  paravent: { w: 2, d: 1, icon: '🎎', fx: { screen: 1 }, price: 20, fr: 'Paravent', en: 'Changing screen' },\n      171→  fontaine: { w: 1, d: 1, wall: true, icon: '🚰', fx: { water: 1 }, price: 25, fr: 'Fontaine à eau', en: 'Water cooler' },\n      172→  fruits: { w: 1, d: 1, icon: '🍎', fx: { fruit: 1 }, price: 15, fr: 'Corbeille de fruits', en: 'Fruit bowl' },\n      173→  enceinte: { w: 1, d: 1, icon: '🔊', fx: { calm: 8, music: 1 }, price: 25, fr: 'Enceinte', en: 'Speaker' },\n      174→  barre: { w: 3, d: 1, wall: true, icon: '🤸', fx: { calm: 6, barre: 1 }, price: 30, fr: 'Barre d’échauffement', en: 'Warm-up barre' },\n      175→  ventilo: { w: 1, d: 1, icon: '🌀', fx: { fan: 1 }, price: 15, fr: 'Ventilateur', en: 'Fan' },\n      176→  doudous: { w: 1, d: 1, icon: '🧸', fx: { doudous: 1 }, price: 15, fr: 'Coffre à doudous', en: 'Cuddly-toy chest' },\n      177→  sieste: { w: 2, d: 2, flat: true, icon: '😴', fx: { sieste: 1 }, price: 30, fr: 'Coin sieste', en: 'Nap corner' },\n      178→  horloge: { w: 1, d: 1, wall: true, icon: '🕰️', fx: { clock: 1 }, price: 10, fr: 'Horloge', en: 'Wall clock' },\n      179→};\n      180→const LOGE = { rows: 8, cols: 10, colsBig: 13 };\n      181→// the doorways: nothing may stand in them\n      182→const doorTiles = (cols) => [[0, 1], [0, 2], [4, 7], [5, 7]].filter(([c]) => c < cols);\n      183→\n      184→/* ---------------- the goûter and the snack before the show ---------------- */\n      185→const SNACKS = {\n      186→  rien: { relief: 0, boost: 0, crash: 0, fr: 'Rien', en: 'Nothing', icon: '🚫' },\n      187→  bonbons: { relief: 15, boost: 15, crash: 20, fr: 'Bonbons', en: 'Sweets', icon: '🍬' },\n      188→  fruits: { relief: 25, boost: 5, crash: 0, fr: 'Fruits', en: 'Fruit', icon: '🍌' },\n      189→  barres: { relief: 35, boost: 10, crash: 0, price: 15, fr: 'Barres de céréales', en: 'Cereal bars', icon: '🥣' },\n      190→  tartines: { relief: 45, boost: 5, crash: 0, price: 20, fr: 'Tartines', en: 'Bread and jam', icon: '🍞' },\n      191→};\n      192→\n      193→/* ---------------- the hall, the car park: what the shop sells beyond costumes ---------------- */\n      194→const UPGRADES = {\n      195→  sieges: { price: 40, max: 3, icon: '💺', fr: 'Une rangée de 14 sièges', en: 'A row of 14 seats' },\n      196→  confort: { price: 60, icon: '🛋️', fr: 'Sièges en velours moelleux', en: 'Soft velvet seats' },\n      197→  buvette: { price: 50, icon: '🥤', fr: 'Buvette (boissons et crêpes à l’entracte)', en: 'Snack bar (drinks at the interval)' },\n      198→  projecteurs: { price: 60, icon: '🔦', fr: 'Projecteurs de couleur', en: 'Coloured spotlights' },\n      199→  boule: { price: 40, icon: '🪩', fr: 'Boule à facettes', en: 'Disco ball' },\n      200→  scene: { price: 90, icon: '🎭', fr: 'Agrandir la scène (+1 m de large)', en: 'Bigger stage (+1 m wide)' },\n      201→  decorForet: { price: 20, icon: '🌳', fr: 'Décor : la forêt', en: 'Backdrop: the forest' },\n      202→  decorMer: { price: 20, icon: '🌊', fr: 'Décor : la mer', en: 'Backdrop: the sea' },\n      203→  decorVille: { price: 20, icon: '🏙️', fr: 'Décor : la ville', en: 'Backdrop: the city' },\n      204→  logeXL: { price: 80, icon: '🧱', fr: 'Agrandir la loge (+3 m)', en: 'Bigger dressing room (+3 m)' },\n      205→  placeur: { price: 25, season: 2, icon: '🦺', fr: 'Un placeur au portail', en: 'A car-park attendant' },\n      206→  covoit: { price: 30, season: 2, icon: '🚙', fr: 'Affiche « covoiturage »', en: '“Car-share” poster' },\n      207→  navette: { price: 60, season: 2, icon: '🚐', fr: 'Navette depuis le supermarché', en: 'Shuttle from the supermarket' },\n      208→  rangee: { price: 100, season: 2, icon: '🅿️', fr: 'Une 2e rangée de places', en: 'A 2nd row of bays' },\n      209→};\n      210→const BACKDROPS = { nuit: { icon: '🌙' }, foret: { icon: '🌳', need: 'decorForet' }, mer: { icon: '🌊', need: 'decorMer' }, ville: { icon: '🏙️', need: 'decorVille' } };\n      211→// the backdrop that suits a number makes it shine a little more\n      212→const BACKDROP_THEMES = { nuit: ['lucioles', 'lumiere'], foret: ['lapins', 'vent'], mer: ['marins', 'lac'], ville: ['street', 'battle', 'disco'] };\n      213→\n      214→const PARKING = {\n      215→  lotLength: 28, widths: [2.2, 2.5, 2.8], doorsOptions: [15, 30, 45, 60],\n      216→  perFamily: 0.8, perCar: 2.2, guestsPerSeason: 4, gateRate: 2, gateRatePlaceur: 3,\n      217→  parkMin: { 2.2: 1, 2.5: 0.5, 2.8: 0.5 }, walkFromBay: 1, overflowDrive: 2, overflowWalk: 12, shuttleWalk: 4, carpool: 0.25,\n      218→};\n      219→\n      220→/* ---------------- the seasons: a new challenge each year ---------------- */\n      221→const SEASONS = [\n      222→  { n: 1, icon: '🌟' },\n      223→  { n: 2, icon: '🚗', adds: ['parking'] },\n      224→  { n: 3, icon: '🧢', adds: ['ados', 'floors', 'moods'] },\n      225→  { n: 4, icon: '💃', adds: ['mamans'] },\n      226→];\n      227→const seasonRules = (season) => ({\n      228→  season, parking: season >= 2, floors: season >= 3, moods: season >= 3,\n      229→  classes: CLASSES.filter((c) => c.from <= season).map((c) => c.id),\n      230→});\n      231→// the stars a new school starts with\n      232→const START = { stars: 30 };\n      233→\n      234→/* ---------------- the rows a grown-up may change ---------------- */\n      235→// Everything above is the default game. applyRows(over) lays changed rows over it, in place, before the game starts:\n      236→//   { moves: { plie: { fr: 'Plié royal' } }, outfits: { fee: { price: 20 } }, start: { stars: 50 } }\n      237→// A row that exists gets the given fields; a new id adds a row (it must carry every field its table's rows have);\n      238→// nothing is removed. Every module reads these same objects, so a change reaches the rules, the 3D and the sheet alike.\n      239→// WHERE the changes are kept between visits is the page's business, not this file's.\n      240→const ROW_TABLES = { classes: CLS, names: NAMES, numbers: NUMBERS, moves: MOVES, outfits: OUTFITS, hairs: HAIRS, shoes: SHOES, accs: ACCS, pieces: PIECES, snacks: SNACKS, upgrades: UPGRADES };\n      241→const ONE_ROW = { rules: RULES, start: START, parking: PARKING };\n      242→const EDITABLE = [...Object.keys(ROW_TABLES), ...Object.keys(ONE_ROW)];\n      243→function applyRows(over = {}) {\n      244→  for (const [t, rows] of Object.entries(over)) {\n      245→    if (ONE_ROW[t]) { Object.assign(ONE_ROW[t], rows); continue; }\n      246→    const T = ROW_TABLES[t]; if (!T) throw new Error(`applyRows: no table \"${t}\" (tables: ${EDITABLE.join(', ')})`);\n      247→    for (const [id, row] of Object.entries(rows)) {\n      248→      if (Array.isArray(row) || !T[id] || typeof T[id] !== 'object' || Array.isArray(T[id])) T[id] = row;\n      249→      else Object.assign(T[id], row);\n      250→      if (t === 'classes' && !CLASSES.includes(T[id])) CLASSES.push(T[id]);\n      251→    }\n      252→  }\n      253→}\n      254→\n      255→Object.assign(exports, { hm, RULES, CLASSES, CLS, NAMES, NUMBERS, numDur, OTHER_ITEMS, itemKind, STYLES, MOVES, MAX_MOVES, LEVELS, OUTFITS, HAIRS, SHOES, ACCS, COLORS, PIECES, LOGE, doorTiles, SNACKS, UPGRADES, BACKDROPS, BACKDROP_THEMES, PARKING, SEASONS, seasonRules, START, EDITABLE, applyRows });", "numLines": 255, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": 255, "wasTruncated": false}, "outputText": "", "durationMs": 3.204749897122383, "display": {"success": true, "verb": "Read", "message": "255 lines from app/scripts/rules/data.js", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
