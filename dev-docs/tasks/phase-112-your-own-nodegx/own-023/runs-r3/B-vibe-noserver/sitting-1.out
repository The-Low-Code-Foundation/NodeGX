n-live\": false, \"runOnChange-in-words\": false, \"runOnChange-in-stage\": false, \"scriptOutputs\": [{\"id\": \"save\", \"label\": \"save\"}, {\"id\": \"saveChanged\", \"label\": \"saveChanged\"}, {\"id\": \"ui\", \"label\": \"ui\"}, {\"id\": \"uiChanged\", \"label\": \"uiChanged\"}, {\"id\": \"res\", \"label\": \"res\"}, {\"id\": \"resChanged\", \"label\": \"resChanged\"}, {\"id\": \"live\", \"label\": \"live\"}, {\"id\": \"liveChanged\", \"label\": \"liveChanged\"}, {\"id\": \"toast\", \"label\": \"toast\"}, {\"id\": \"toastChanged\", \"label\": \"toastChanged\"}], \"outtype-save\": \"object\", \"outtype-saveChanged\": \"signal\", \"outtype-ui\": \"object\", \"outtype-uiChanged\": \"signal\", \"outtype-res\": \"object\", \"outtype-resChanged\": \"signal\", \"outtype-live\": \"object\", \"outtype-liveChanged\": \"signal\", \"outtype-toast\": \"object\", \"outtype-toastChanged\": \"signal\", \"functionScript\": \"if (!Inputs.save) return;\\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\\nconst ui = { ...(Inputs.ui || {}), res: Inputs.res || null, live: Inputs.live || null };\\nconst r = Scripts.dispatch.dispatch(Inputs.act, Inputs.arg, Inputs.save, ui, w, Inputs.stage)\n\n### dp_setSave net.noodl.GlobalStore.Set | The new save\n{\"storeName\": \"gala\", \"key\": \"save\"}\n\n### dp_setUi net.noodl.GlobalStore.Set | What changes on screen\n{\"storeName\": \"ui\", \"key\": \"ui\", \"merge\": true}\n\n### dp_setRes net.noodl.GlobalStore.Set | The evening's result\n{\"storeName\": \"ui\", \"key\": \"res\"}\n\n### dp_setLive net.noodl.GlobalStore.Set | The evening so far\n{\"storeName\": \"ui\", \"key\": \"live\"}\n\n### dp_setToast net.noodl.GlobalStore.Set | A toast\n{\"storeName\": \"ui\", \"key\": \"toast\"}\n\n===== connections =====\ndp_rx.act -> dp_fn.in-act\ndp_rx.arg -> dp_fn.in-arg\ndp_rx.eventReceived -> dp_fn.run\ndp_save.value -> dp_fn.in-save\ndp_ui.value -> dp_fn.in-ui\ndp_res.value -> dp_fn.in-res\ndp_live.value -> dp_fn.in-live\ndp_words.value -> dp_fn.in-words\ndp_in.stage -> dp_fn.in-stage\ndp_fn.out-save -> dp_setSave.value\ndp_fn.out-saveChanged -> dp_setSave.set\ndp_fn.out-ui -> dp_setUi.value\ndp_fn.out-uiChanged -> dp_setUi.set\ndp_fn.out-res -> dp_setRes.value\ndp_fn.out-resChanged -> dp_setRes.set\ndp_fn.out-live -> dp_setLive.value\ndp_fn.out-liveChanged -> dp_setLive.set\ndp_fn.out-toast -> dp_setToast.value\ndp_fn.out-toastChanged -> dp_setToast.set\n", "stderr": "", "output": "", "truncated": false}, "outputText": "### dp_in Component Inputs | \n{}\n\n### dp_rx Event Receiver | A press\n{\"channelName\": \"gala-act\"}\n\n### dp_save net.noodl.GlobalStore.Subscribe | \n{\"storeName\": \"gala\", \"keys\": \"save\"}\n\n### dp_ui net.noodl.GlobalStore.Subscribe | \n{\"storeName\": \"ui\", \"keys\": \"ui\"}\n\n### dp_res net.noodl.GlobalStore.Subscribe | \n{\"storeName\": \"ui\", \"keys\": \"res\"}\n\n### dp_live net.noodl.GlobalStore.Subscribe | \n{\"storeName\": \"ui\", \"keys\": \"live\"}\n\n### dp_words Variable2 | words (shared on purpose)\n{\"name\": \"words\"}\n\n### dp_fn JavaScriptFunction | What the press changes\n{\"uses\": \"game/dispatch,game/actions,game/save,game/text,view/run,view/common,view/formation,view/prep,settings/check,rules/data,rules/engine,rules/plan\", \"runOnChange-in-act\": false, \"runOnChange-in-arg\": false, \"runOnChange-in-save\": false, \"runOnChange-in-ui\": false, \"runOnChange-in-res\": false, \"runOnChange-in-live\": false, \"runOnChange-in-words\": false, \"runOnChange-in-stage\": false, \"scriptOutputs\": [{\"id\": \"save\", \"label\": \"save\"}, {\"id\": \"saveChanged\", \"label\": \"saveChanged\"}, {\"id\": \"ui\", \"label\": \"ui\"}, {\"id\": \"uiChanged\", \"label\": \"uiChanged\"}, {\"id\": \"res\", \"label\": \"res\"}, {\"id\": \"resChanged\", \"label\": \"resChanged\"}, {\"id\": \"live\", \"label\": \"live\"}, {\"id\": \"liveChanged\", \"label\": \"liveChanged\"}, {\"id\": \"toast\", \"label\": \"toast\"}, {\"id\": \"toastChanged\", \"label\": \"toastChanged\"}], \"outtype-save\": \"object\", \"outtype-saveChanged\": \"signal\", \"outtype-ui\": \"object\", \"outtype-uiChanged\": \"signal\", \"outtype-res\": \"object\", \"outtype-resChanged\": \"signal\", \"outtype-live\": \"object\", \"outtype-liveChanged\": \"signal\", \"outtype-toast\": \"object\", \"outtype-toastChanged\": \"signal\", \"functionScript\": \"if (!Inputs.save) return;\\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\\nconst ui = { ...(Inputs.ui || {}), res: Inputs.res || null, live: Inputs.live || null };\\nconst r = Scripts.dispatch.dispatch(Inputs.act, Inputs.arg, Inputs.save, ui, w, Inputs.stage)\n\n### dp_setSave net.noodl.GlobalStore.Set | The new save\n{\"storeName\": \"gala\", \"key\": \"save\"}\n\n### dp_setUi net.noodl.GlobalStore.Set | What changes on screen\n{\"storeName\": \"ui\", \"key\": \"ui\", \"merge\": true}\n\n### dp_setRes net.noodl.GlobalStore.Set | The evening's result\n{\"storeName\": \"ui\", \"key\": \"res\"}\n\n### dp_setLive net.noodl.GlobalStore.Set | The evening so far\n{\"storeName\": \"ui\", \"key\": \"live\"}\n\n### dp_setToast net.noodl.GlobalStore.Set | A toast\n{\"storeName\": \"ui\", \"key\": \"toast\"}\n\n===== connections =====\ndp_rx.act -> dp_fn.in-act\ndp_rx.arg -> dp_fn.in-arg\ndp_rx.eventReceived -> dp_fn.run\ndp_save.value -> dp_fn.in-save\ndp_ui.value -> dp_fn.in-ui\ndp_res.value -> dp_fn.in-res\ndp_live.value -> dp_fn.in-live\ndp_words.value -> dp_fn.in-words\ndp_in.stage -> dp_fn.in-stage\ndp_fn.out-save -> dp_setSave.value\ndp_fn.out-saveChanged -> dp_setSave.set\ndp_fn.out-ui -> dp_setUi.value\ndp_fn.out-uiChanged -> dp_setUi.set\ndp_fn.out-res -> dp_setRes.value\ndp_fn.out-resChanged -> dp_setRes.set\ndp_fn.out-live -> dp_setLive.value\ndp_fn.out-liveChanged -> dp_setLive.set\ndp_fn.out-toast -> dp_setToast.value\ndp_fn.out-toastChanged -> dp_setToast.set\n", "durationMs": 45.53629201836884, "display": {"success": true, "verb": "Ran", "message":