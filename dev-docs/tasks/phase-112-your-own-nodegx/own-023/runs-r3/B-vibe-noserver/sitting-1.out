{"id": "call_a72d6515904544cfb242bd49", "sessionId": "25505b9f-a8ea-dd62-6b8d-be45f136b4b6", "turnId": "5093e3ac-9153-41c4-bc70-29af6171bbc2", "inputEntryId": null, "createdAt": 1792605685511, "updatedAt": 1792605685527, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "read_file", "detail": {"toolName": "read_file", "display": {"summary": "Reading app/scripts/view/prep.js", "content": null, "suffix": "", "verb": "Reading", "message": "app/scripts/view/prep.js", "settledVerb": "Read", "settledMessage": "app/scripts/view/prep.js", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/view/prep.js", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "/private/var/tmp/own023-r3/B-vibe/work/gala/app/scripts/view/prep.js", "content": "        1→// The rows of the preparation tabs (all but the formation, which has its own file): from reference/src/ui.js\n        2→// paintOrder, paintGouter, paintCostumes, paintBuild, paintParking, paintShop and paintNotebook.\n        3→const {\n        4→  CLS, NUMBERS, numDur, itemKind, STYLES, OUTFITS, HAIRS, SHOES, ACCS, PIECES, SNACKS, UPGRADES, BACKDROPS, PARKING, COLORS,\n        5→} = use('rules/data');\n        6→const { isOwned, analyseLoge } = use('rules/engine');\n        7→const { rules, forecast, clsColor, pickedNum, numChips, facts } = use('view/common');\n        8→\n        9→/* ---------------- the programme ---------------- */\n       10→function order(save, ui, w) {\n       11→  const P = save.plan, s = save.season;\n       12→  const cards = P.order.map((id, k) => {\n       13→    const kind = itemKind(id), locked = k === 0 || k === P.order.length - 1;\n       14→    const dur = kind === 'interval' ? P.interval : kind === 'number' ? numDur(id) : null;\n       15→    const tags = kind === 'number' && s >= 3 ? `${STYLES[NUMBERS[id].style].icon}${NUMBERS[id].mood === 'calme' ? '🐢' : '⚡'}` : '';\n       16→    return { id, name: w.item(id), dot: clsColor(kind === 'number' ? NUMBERS[id].cls : null), tags, dur: dur ? w.dur(dur) : id === 'accueil' ? '4 min' : '3 min', locked };\n       17→  });\n       18→  const list = [0, 1, 2, 3, 4, ...(s >= 3 ? [5, 6] : [])].map((i) => w(`orderFacts_${i}`));\n       19→  return { facts: facts(list), start: w.clock(P.start), interval: w.dur(P.interval), cards };\n       20→}\n       21→\n       22→/* ---------------- the goûter ---------------- */\n       23→function gouter(save, ui, w) {\n       24→  const P = save.plan, sc = save.school;\n       25→  const snacks = Object.entries(SNACKS).map(([id, s]) => {\n       26→    const own = isOwned(sc, 'snack', id);\n       27→    return { id, icon: s.icon, label: w.nm(s), small: own ? w(`snackFx_${id}`) : w('buy', s.price), pressed: P.snack === id, locked: !own };\n       28→  });\n       29→  const crepes = !!sc.owned['food:crepes'], compotes = !!sc.owned['food:compotes'];\n       30→  const table = rules(save).classes.map((c) => ({ id: c, cls: `${w.cls(c)} (${CLS[c].age})`, n: String(CLS[c].n), kcal: `${CLS[c].kcal} kcal`, juice: `${CLS[c].juice} cl` }));\n       31→  return {\n       32→    snacks, table, crepesOn: crepes, compotesOn: compotes,\n       33→    facts: facts([w('gouterFacts_0'), w('gouterFacts_1'), crepes && w('crepeFact'), compotes && w('compoteFact')]),\n       34→    cake: `${P.cakeG} g`, bottles: String(P.bottles), crepes: String(P.crepes || 0), compotes: String(P.compotes || 0),\n       35→  };\n       36→}\n       37→\n       38→/* ---------------- the costumes ---------------- */\n       39→function costumes(save, ui, w) {\n       40→  const id = pickedNum(save, ui), N = NUMBERS[id], cos = save.plan.numbers[id].costume, sc = save.school, cls = CLS[N.cls];\n       41→  const opt = (kind, list, cur, extra) => Object.entries(list).filter(([, x]) => !x.season || x.season <= save.season).map(([k, x]) => {\n       42→    const own = isOwned(sc, kind, k), suits = (x.themes || []).includes(N.theme);\n       43→    return { id: `${kind}:${k}`, icon: x.icon || '', label: w.nm(x), small: (own ? (extra ? extra(x) : '') : w('buy', x.price)) + (suits ? ' ✨' : ''), pressed: cur === k, locked: !own };\n       44→  });\n       45→  const hair = rules(save).classes.map((c) => ({\n       46→    id: c, label: w.cls(c), dot: clsColor(c),\n       47→    chips: Object.entries(HAIRS).map(([k, x]) => {\n       48→      const own = isOwned(sc, 'hair', k);\n       49→      return { id: `${c}:${k}`, label: `${w.nm(x)} ${own ? `⏱ ${x.min} min` : w('buy', x.price)}`, pressed: save.plan.hair[c] === k, locked: !own };\n       50→    }),\n       51→  }));\n       52→  const shoe = SHOES[cos.shoes];\n       53→  return {\n       54→    num: id, numChips: numChips(save, ui, w, id),\n       55→    outfits: opt('outfit', OUTFITS, cos.outfit, (x) => w('putOn', x.min)),\n       56→    colors: COLORS.map((c) => ({ id: c, color: c, pressed: cos.color === c })),\n       57→    shoes: opt('shoes', SHOES, cos.shoes), shoeWarn: !!(shoe && shoe.expMin && cls.exp < shoe.expMin),\n       58→    accs: opt('acc', ACCS, cos.acc), hair,\n       59→  };\n       60→}\n       61→\n       62→/* ---------------- the dressing room ---------------- */\n       63→function build(save, ui, w) {\n       64→  const sc = save.school, total = rules(save).classes.reduce((s, c) => s + CLS[c].n, 0), L = analyseLoge(sc, total);\n       65→  const lines = [L.postesRaw ? w('fx_postes', L.postesRaw) : w('fx_postesNone'), w('fx_rail', L.rail, L.railCap, total), w('fx_seats', L.seats, total)];\n       66→  if (L.calm) lines.push(w('fx_calm', L.calm));\n       67→  for (const k of ['water', 'fruit', 'fan', 'shoes', 'screen', 'sieste', 'doudous', 'barre', 'clock', 'music']) if (L[k]) lines.push(w(`fx_${k}`));\n       68→  if (L.clutter) lines.push(w('fx_clutter'));\n       69→  const tag = (p) => Object.entries(p.fx).map(([k, v]) => (w.has(`fxTag_${k}`) ? w(`fxTag_${k}`, v) : k)).join(' · ') + (p.wall ? ` · ${w('wallTag')}` : '');\n       70→  const pieces = Object.entries(PIECES).map(([id, p]) => {\n       71→    const own = isOwned(sc, 'piece', id);\n       72→    return { id, icon: p.icon, label: w.nm(p), small: own ? tag(p) : `${w('buy', p.price)} · ${tag(p)}`, pressed: !!(ui.armed && ui.armed.id === id), locked: !own };\n       73→  });\n       74→  const selected = ui.selected && PIECES[ui.selected.id] ? ui.selected : null;\n       75→  return {\n       76→    name: sc.name || '', fx: facts(lines), warnings: facts(L.invalid.map((f) => `⚠️ ${w('wallWarn', w.nm(PIECES[f.id]))}`)),\n       77→    inLoge: ui.pickedRoom === 'dr', armed: !!ui.armed, selected: !!selected,\n       78→    removeLabel: selected ? `${w('remove')} · ${w.nm(PIECES[selected.id])}` : w('remove'), pieces,\n       79→  };\n       80→}\n       81→\n       82→/* ---------------- the car park ---------------- */\n       83→function parking(save, ui, w) {\n       84→  const P = save.plan, sc = save.school, pk = forecast(save).parking;\n       85→  const list = pk ? [w('parkFacts_0', pk.dancers, pk.families), w('parkFacts_1', pk.guests), w('parkFacts_2'), w('parkFacts_3', pk.rate), w('parkFacts_4'), w('parkFacts_5')] : [];\n       86→  return {\n       87→    facts: facts(list),\n       88→    widths: PARKING.widths.map((x) => ({ id: String(x), label: `${w.num(x)} m`, pressed: P.parking.width === x })),\n       89→    narrow: P.parking.width < 2.5,\n       90→    doors: PARKING.doorsOptions.map((m) => ({ id: String(m), label: w('doorsVal', m), pressed: P.parking.doors === m })),\n       91→    upgrades: ['placeur', 'covoit', 'navette', 'rangee'].map((k) => { const u = UPGRADES[k], own = !!sc.upgrades[k]; return { id: k, icon: u.icon, label: w.nm(u), small: own ? w('owned') : w('buy', u.price), pressed: own, locked: !own }; }),\n       92→  };\n       93→}\n       94→\n       95→/* ---------------- the shop ---------------- */\n       96→const PARK_UPS = ['placeur', 'covoit', 'navette', 'rangee'];\n       97→const foodPrice = (id) => 15 + (id === 'crepes' ? 5 : 0);\n       98→function shop(save, ui, w) {\n       99→  const sc = save.school, cats = ['hall', ...(rules(save).parking ? ['park'] : []), 'loge', 'outfit', 'hair', 'shoes', 'acc', 'food'];\n      100→  const cat = cats.includes(ui.shopCat) ? ui.shopCat : 'hall';\n      101→  const rows = [];\n      102→  const row = (kind, id, icon, name, price, own, note) => rows.push({ id: `${kind}|${id}`, icon: icon || '✨', name, note: note || '', own: own ? (own === 'max' ? w('maxed') : w('owned')) : '', price: own ? '' : w('buy', price), poor: sc.stars < price });\n      103→  const fxTags = (p) => Object.entries(p.fx).map(([k, v]) => (w.has(`fxTag_${k}`) ? w(`fxTag_${k}`, v) : k)).join(' · ');\n      104→  if (cat === 'hall' || cat === 'park') {\n      105→    for (const [k, u] of Object.entries(UPGRADES)) {\n      106→      if ((cat === 'park') !== PARK_UPS.includes(k) || (u.season && u.season > save.season)) continue;\n      107→      const n = sc.upgrades[k], own = u.max ? (n >= u.max ? 'max' : false) : !!n;\n      108→      row('up', k, u.icon, w.nm(u) + (u.max && n ? ` (${n}/${u.max})` : ''), u.price, own);\n      109→    }\n      110→  }\n      111→  if (cat === 'loge') for (const [k, p] of Object.entries(PIECES)) if (p.price) row('piece', k, p.icon, w.nm(p), p.price, isOwned(sc, 'piece', k), fxTags(p));\n      112→  if (cat === 'outfit') for (const [k, o] of Object.entries(OUTFITS)) if (o.price) row('outfit', k, o.icon, w.nm(o), o.price, isOwned(sc, 'outfit', k), w('putOn', o.min));\n      113→  if (cat === 'hair') for (const [k, o] of Object.entries(HAIRS)) if (o.price) row('hair', k, '💇', w.nm(o), o.price, isOwned(sc, 'hair', k), `⏱ ${o.min} min`);\n      114→  if (cat === 'shoes') for (const [k, o] of Object.entries(SHOES)) if (o.price && (!o.season || o.season <= save.season)) row('shoes', k, '🩰', w.nm(o), o.price, isOwned(sc, 'shoes', k));\n      115→  if (cat === 'acc') for (const [k, o] of Object.entries(ACCS)) if (o.price) row('acc', k, '🎀', w.nm(o), o.price, isOwned(sc, 'acc', k));\n      116→  if (cat === 'food') {\n      117→    for (const [k, s] of Object.entries(SNACKS)) if (s.price) row('snack', k, s.icon, w.nm(s), s.price, isOwned(sc, 'snack', k));\n      118→    for (const k of ['crepes', 'compotes']) row('food', k, k === 'crepes' ? '🥞' : '🍏', w(`foods_${k}`), foodPrice(k), !!sc.owned[`food:${k}`]);\n      119→  }\n      120→  const backdrops = Object.entries(BACKDROPS).filter(([, b]) => !b.need || sc.upgrades[b.need]).map(([k, b]) => ({ id: k, label: b.icon, pressed: save.plan.backdrop === k }));\n      121→  return {\n      122→    title: `${w('shopH')} · ${w('stars', sc.stars)}`,\n      123→    cats: cats.map((c) => ({ id: c, label: w(`cats_${c}`), pressed: c === cat })),\n      124→    rows, showBackdrops: cat === 'hall', backdrops,\n      125→  };\n      126→}\n      127→\n      128→/* ---------------- the notebook ---------------- */\n      129→function notebook(save, ui, w) {\n      130→  const entries = (save.notebook || []).map((n, i) => ({\n      131→    id: `n${i}`, title: `${w('noteGala', n.season)} · ${n.at} · ${n.points} ⭐`, line: w('satisfaction', n.satisfaction),\n      132→    nums: Object.entries(n.nums || {}).filter(([id]) => NUMBERS[id]).map(([id, p]) => `${w.numName(id)} ${p} ⭐`).join(' · '),\n      133→  }));\n      134→  return { entries, empty: entries.length === 0 };\n      135→}\n      136→\n      137→Object.assign(exports, { order, gouter, costumes, build, parking, shop, notebook, foodPrice });", "numLines": 137, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": 137, "wasTruncated": false}, "outputText": "", "durationMs": 2.5172079913318157, "display": {"success": true, "verb": "Read", "message": "137 lines from app/scripts/view/prep.js", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
