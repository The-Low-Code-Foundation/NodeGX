{\"id\": \"rowId\", \"label\": \"rowId\"}, {\"id\": \"fields\", \"label\": \"fields\"}, {\"id\": \"send\", \"label\": \"send\"}, {\"id\": \"message\", \"label\": \"message\"}, {\"id\": \"said\", \"label\": \"said\"}], \"outtype-table\": \"string\", \"outtype-rowId\": \"string\", \"outtype-fields\": \"object\", \"outtype-send\": \"signal\", \"outtype-message\": \"string\", \"outtype-said\": \"signal\", \"functionScript\": \"const lang = (Inputs.save && Inputs.save.lang) || 'fr';\\nconst w = Scripts.text.words([...(Inputs.words || []), ...(Inputs.gwords || [])], lang);\\nconst G = Scripts.grownups;\\nconst at = (v) => (v && v.at) || 0;\\nconst latest = Math.max(at(Inputs.rowValues), at(Inputs.stepValues), at(Inputs.costumeValues));\\nlet c = null;\\nif (latest && latest === at(Inputs.rowValues)) c = G.rowChange(Inputs.table || 'moves', Inputs.rowId, Inputs.rowValues);\\nelse if (latest && latest === at(Inputs.stepValues)) c = G.newStep(Inputs.stepValues);\\nelse if (latest && latest === at(Inputs.costumeValues)) c = G.newCostume(Inputs.costumeValues);\\nconst p = G.precheck(c, w);\\nif (!p.ok) { Outputs.message = p.message; Outputs.said(); return; }\\nOutputs.table = c.table; Outpu\n\n### gp_stars JavaScriptFunction | A new school's stars to send\n{\"uses\": \"view/grownups,game/text,settings/check,rules/data\", \"runOnChange-in-stars\": false, \"runOnChange-in-words\": false, \"runOnChange-in-gwords\": false, \"runOnChange-in-save\": false, \"scriptOutputs\": [{\"id\": \"table\", \"label\": \"table\"}, {\"id\": \"rowId\", \"label\": \"rowId\"}, {\"id\": \"fields\", \"label\": \"fields\"}, {\"id\": \"send\", \"label\": \"send\"}, {\"id\": \"message\", \"label\": \"message\"}, {\"id\": \"said\", \"label\": \"said\"}], \"outtype-table\": \"string\", \"outtype-rowId\": \"string\", \"outtype-fields\": \"object\", \"outtype-send\": \"signal\", \"outtype-message\": \"string\", \"outtype-said\": \"signal\", \"functionScript\": \"const lang = (Inputs.save && Inputs.save.lang)