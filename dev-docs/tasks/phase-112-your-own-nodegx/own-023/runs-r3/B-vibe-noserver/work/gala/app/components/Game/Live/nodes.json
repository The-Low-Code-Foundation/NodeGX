    {
      "id": "lv_view",
      "type": "JavaScriptFunction",
      "label": "The evening so far",
      "parameters": {
        "uses": "view/run,view/formation,view/common,game/text,rules/data,rules/engine,rules/tunes",
        "functionScript": "if (!Inputs.show || !Inputs.save || !Inputs.res || !Inputs.live) return;\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\nconst v = Scripts.run.liveSheet(Inputs.res, Inputs.live, w);\nOutputs.title = v.title; Outputs.cards = v.cards; Outputs.feed = v.feed; Outputs.isTry = v.isTry;\nOutputs.stepsH = w('step_head');\nif (v.steps) { Outputs.stepsSum = v.steps.summary; Outputs.blocks = v.steps.blocks; }\n"
      },
      "x": 410,
      "y": 160,
      "ports": [
        {
          "name": "in-show",
          "displayName": "show",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
