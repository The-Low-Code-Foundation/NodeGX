    {
      "id": "fo_view",
      "type": "JavaScriptFunction",
      "label": "The formation tab's rows",
      "parameters": {
        "uses": "view/formation,view/common,game/text,rules/data,rules/engine,rules/tunes",
        "functionScript": "if (!Inputs.save || !Inputs.save.school || !Inputs.show) return;\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\nconst v = Scripts.formation.formation(Inputs.save, Inputs.ui || {}, w);\nconst ui = Inputs.ui || {};\nOutputs.title = w('formH'); Outputs.nums = v.numChips; Outputs.facts = v.facts; Outputs.hint = w('formHint');\nOutputs.planW = v.plan.width; Outputs.planH = v.plan.height;\nOutputs.stageLeft = v.plan.stageLeft; Outputs.stageTop = v.plan.stageTop; Outputs.stageW = v.plan.stageWidth; Outputs.stageH = v.plan.stageHeight;\nOutputs.ticksX = v.ticksX; Outputs.ticksZ = v.ticksZ; Outputs.path = v.path; Outputs.dots = v.dots;\nOutputs.showArms = v.showArms;\nif (v.arms) { Outputs.armsLeft = v.arms.left; Outputs.armsTop = v.arms.top; Outputs.armsSize = v.arms.size; }\nOutputs.audience = `▼ ${w('audience')} ▼`;\nOutputs.swaps = v.swaps; Outputs.abChips = v.abChips; Outputs.names = v.names;\nOutputs.blocksH = w('blocksH'); Outputs.blocksHint = w('blocksHint'); Outputs.blocks = v.blocks;\nOutputs.newBlock = w('newBlock'); Outputs.copyBlock = w('copyBlock'); Outputs.renameBlock = w('renameBlock'); Outputs.delBlock = w('delBlock'); Outputs.noDel = !v.canDelBlock;\nOutputs.renaming = !!ui.renaming; Outputs.blockName = v.blockName; Outputs.ok = w('ok'); Outputs.cancel = w('cancel'); Outputs.renameAsk = w('renameAsk');\nOutputs.delAsking = ui.confirm === 'delBlock'; Outputs.delText = w('delAsk', v.blockName); Outputs.yes = w('yes'); Outputs.no = w('no');\nOutputs.blockColor = v.blockColor; Outputs.steps = v.steps; Outputs.stepsEmpty = v.stepsEmpty; Outputs.emptyText = w('emptyBlock'); Outputs.legend = w('harmonyLegend');\nOutputs.moveTools = v.moveTools; Outputs.left = `◀ ${w('moveLeft')}`; Outputs.right = `${w('moveRight')} ▶`; Outputs.remove = `✕ ${w('removeMove')}`;\nOutputs.blockLen = v.blockLen; Outputs.addH = w('addMoves'); Outputs.filters = v.filterChips; Outputs.palette = v.palette; Outputs.levels = v.levels;\nOutputs.chainH = w('chainH'); Outputs.chainHint = w('chainHint'); Outputs.chain = v.chain; Outputs.chainEmpty = v.chainEmpty; Outputs.chainEmptyText = w('chainEmpty');\nOutputs.addToChain = v.addToChain; Outputs.chainTools = v.chainTools; Outputs.danceLen = v.danceLen;\nOutputs.musicLabel = w('musicBar'); Outputs.danceLabel = w('yourDance'); Outputs.musicWidth = v.musicWidth; Outputs.segs = v.segs;\nOutputs.foreH = w('forecastH'); Outputs.meters = v.meters; Outputs.risk = v.risk; Outputs.reasons = v.reasons;\nOutputs.tryBtn = w('tryBtn'); Outputs.tryNote = w('tryNote');\n"
      },
      "metadata": {
        "comment": "Runs the rehearsal forecast (gala-rules simulate) for the meters, as the coded tab did."
      },
