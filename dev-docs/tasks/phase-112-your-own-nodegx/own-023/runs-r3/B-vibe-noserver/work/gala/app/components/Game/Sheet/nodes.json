    {
      "id": "sh_view",
      "type": "JavaScriptFunction",
      "label": "Which tab, which buttons",
      "parameters": {
        "uses": "view/frame,view/common,game/text,rules/data,rules/engine",
        "functionScript": "if (!Inputs.save || !Inputs.save.school) return;\nconst w = Scripts.text.words(Inputs.words || [], Inputs.save.lang || 'fr');\nconst ui = { ...(Inputs.ui || {}), live: Inputs.live };\nconst tab = Scripts.frame.currentTab(Inputs.save, ui), screen = ui.screen || 'prep', prep = screen === 'prep';\nOutputs.tabs = Scripts.frame.tabs(Inputs.save, ui, w);\nOutputs.go = Scripts.frame.go(Inputs.save, ui, w);\nOutputs.isPrep = prep;\nOutputs.isRun = screen === 'run';\nOutputs.isResults = screen === 'results';\nfor (const k of ['order', 'formation', 'gouter', 'costumes', 'build', 'parking', 'shop', 'notebook']) Outputs[`show_${k}`] = prep && tab === k;\n",
        "scriptOutputs": [
          {
            "id": "show_order",
            "label": "show_order"
          },
          {
            "id": "show_formation",
            "label": "show_formation"
          },
          {
            "id": "show_gouter",
            "label": "show_gouter"
          },
          {
            "id": "show_costumes",
            "label": "show_costumes"
          },
          {
            "id": "show_build",
            "label": "show_build"
          },
          {
            "id": "show_parking",
            "label": "show_parking"
          },
          {
            "id": "show_shop",
            "label": "show_shop"
          },
          {
            "id": "show_notebook",
            "label": "show_notebook"
          }
        ],
        "outtype-show_order": "boolean",
        "outtype-show_formation": "boolean",
        "outtype-show_gouter": "boolean",
        "outtype-show_costumes": "boolean",
        "outtype-show_build": "boolean",
        "outtype-show_parking": "boolean",
        "outtype-show_shop": "boolean",
        "outtype-show_notebook": "boolean"
      },
      "x": 410,
      "y": 280,
      "ports": [
        {
          "name": "out-show_order",
          "displayName": "show_order",
          "plug": "output",
          "type": "boolean",
          "group": "Outputs"
        },
