{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "6752a6ba-fe06-5403-85be-12db568dd17a",
  "version": 1,
  "nodes": [
    {
      "id": "empty_inputs",
      "type": "Component Inputs",
      "label": "What to say",
      "x": 40,
      "y": 60,
      "ports": [
        {
          "name": "title",
          "plug": "output",
          "type": "*",
          "index": 0
        },
        {
          "name": "body",
          "plug": "output",
          "type": "*",
          "index": 1
        },
        {
          "name": "actionLabel",
          "plug": "output",
          "type": "*",
          "index": 2
        }
      ]
    },
    {
      "id": "empty_outputs",
      "type": "Component Outputs",
      "label": "The action was pressed",
      "x": 40,
      "y": 320,
      "ports": [
        {
          "name": "Action",
          "plug": "input",
          "type": "signal",
          "index": 0
        }
      ]
    },
    {
      "id": "empty",
      "type": "Group",
      "label": "Empty state",
      "x": 480,
      "y": 40,
      "children": [
        "disc",
        "empty_title",
        "empty_body",
        "empty_action"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "flexDirection": "column",
        "alignItems": "center",
        "rowGap": "var(--space-4)",
        "backgroundColor": "var(--surface)",
        "borderRadius": "var(--radius-xl)",
        "borderStyle": "dashed",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-strong)",
        "paddingTop": "var(--space-16)",
        "paddingBottom": "var(--space-16)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)"
      }
    },
    {
      "id": "disc",
      "type": "Group",
      "label": "Icon disc",
      "parent": "empty",
      "children": [
        "disc_icon"
      ],
      "parameters": {
        "sizeMode": "contentSize",
        "backgroundColor": "var(--muted)",
        "borderRadius": "var(--radius-full)",
        "paddingTop": "var(--space-4)",
        "paddingBottom": "var(--space-4)",
        "paddingLeft": "var(--space-4)",
        "paddingRight": "var(--space-4)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "disc_icon",
      "type": "net.noodl.visual.icon",
      "label": "Icon",
      "parent": "disc",
      "parameters": {
        "iconIconSource": {
          "class": "lucide",
          "code": "icon-list-checks",
          "codeAsClass": true
        },
        "iconSize": {
          "value": 24,
          "unit": "px"
        },
        "iconColor": "var(--muted-foreground)"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "empty_title",
      "type": "Text",
      "label": "Heading",
      "parent": "empty",
      "parameters": {
        "fontSize": "var(--text-xl)",
        "fontWeight": "var(--font-semibold)",
        "color": "var(--foreground)",
        "textAlignX": "center"
      },
      "x": 100,
      "y": 400
    },
    {
      "id": "empty_body",
      "type": "Text",
      "label": "Explanation",
      "parent": "empty",
      "parameters": {
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)",
        "lineHeight": "var(--leading-relaxed)",
        "textAlignX": "center",
        "maxWidth": {
          "value": 380,
          "unit": "px"
        }
      },
      "x": 100,
      "y": 520
    },
    {
      "id": "empty_action",
      "type": "net.noodl.controls.button",
      "label": "The one action",
      "parent": "empty",
      "parameters": {
        "useLabel": true,
        "backgroundColor": "var(--primary)",
        "color": "var(--primary-foreground)",
        "borderRadius": "var(--radius-full)",
        "borderStyle": "none",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "sizeMode": "contentSize"
      },
      "x": 100,
      "y": 640
    }
  ],
  "visualRoots": [
    "empty"
  ]
}