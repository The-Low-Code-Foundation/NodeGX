    {
      "id": "list",
      "type": "For Each",
      "label": "One row per item",
      "parent": "list-box",
      "parameters": {
        "template": "/Components/Item Row"
      },
      "x": 280,
      "y": 1360
    },
    {
      "id": "rows-fn",
      "type": "JavaScriptFunction",
      "label": "The rows",
      "parameters": {
        "functionScript": "// B-list: one row per item, with its own ticks; ids stay stable so rows keep their place.\nconst items = (Array.isArray(Inputs.items) ? Inputs.items : []);\nconst ticks = (Inputs.ticks && typeof Inputs.ticks === \"object\" && !Array.isArray(Inputs.ticks) ? Inputs.ticks : {});\nOutputs.rows = items.map(function (item) { return { id: item.id, name: item.name, ticks: ticks[item.id] || [] }; });\nOutputs.empty = items.length === 0;\n"
      },
      "x": 530,
      "y": 1360,
      "ports": [
        {
          "name": "in-items",
          "displayName": "items",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-ticks",
          "displayName": "ticks",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-rows",
          "displayName": "rows",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-empty",
          "displayName": "empty",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "empty",
      "type": "Text",
      "label": "Nothing here yet",
      "parent": "shell",
      "parameters": {
        "mounted": false,
        "text": "No habits yet. Add one above to start.",
        "fontSize": "var(--text-sm)",
        "color": "var(--muted-foreground)",
        "cssClassName": "empty-line"
      },
      "x": 220,
      "y": 1480
    },
    {
      "id": "delete-fn",
      "type": "JavaScriptFunction",
      "label": "Delete an item and its ticks",
      "parameters": {
        "functionScript": "// B-delete, asking first.\nconst items = (Array.isArray(Inputs.items) ? Inputs.items : []);\nlet hit = null;\nfor (let i = 0; i < items.length; i++) if (items[i].id === Inputs.id) hit = items[i];\nif (!hit) return;\nif (!window.confirm(\"Delete this habit and its days?\".replace('%s', hit.name))) return;\nOutputs.items = items.filter(function (item) { return item.id !== hit.id; });\nconst ticks = {};\nconst old = (Inputs.ticks && typeof Inputs.ticks === \"object\" && !Array.isArray(Inputs.ticks) ? Inputs.ticks : {});\nfor (const k in old) if (k !== hit.id) ticks[k] = old[k];\nOutputs.ticks = ticks;\nOutputs.removed();\n",
        "runOnChange-in-id": false,
        "runOnChange-in-items": false,
        "runOnChange-in-ticks": false
      },
      "x": 530,
      "y": 1480,
      "ports": [
        {
          "name": "in-items",
          "displayName": "items",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-id",
          "displayName": "id",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-ticks",
          "displayName": "ticks",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-removed",
          "displayName": "removed",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-items",
          "displayName": "items",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-ticks",
          "displayName": "ticks",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
