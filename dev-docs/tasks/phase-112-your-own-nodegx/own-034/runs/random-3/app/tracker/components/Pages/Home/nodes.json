    {
      "id": "add-fn",
      "type": "JavaScriptFunction",
      "label": "Add an item",
      "parameters": {
        "functionScript": "// B-add: an empty name adds nothing.\nconst name = String(Inputs.name || '').trim();\nif (!name) { Outputs.refused(); return; }\nconst items = ((Array.isArray(Inputs.items) ? Inputs.items : [])).slice();\nitems.push({ id: 'i' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6), name: name });\nOutputs.items = items;\nOutputs.added();\n",
        "runOnChange-in-name": false,
        "runOnChange-in-items": false
      },
      "x": 530,
      "y": 1000,
      "ports": [
        {
          "name": "in-name",
          "displayName": "name",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "in-items",
          "displayName": "items",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-refused",
          "displayName": "refused",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-added",
          "displayName": "added",
          "plug": "output",
          "type": "signal",
          "group": "Outputs"
        },
        {
          "name": "out-items",
          "displayName": "items",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
