{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "8cf7a55a-8f5f-59f5-8623-f977d13d7db1",
  "version": 1,
  "nodes": [
    {
      "id": "in-2",
      "type": "Component Inputs",
      "label": "One item",
      "ports": [
        {
          "name": "name",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "ticks",
          "plug": "output",
          "type": "*"
        }
      ],
      "x": 470,
      "y": 280
    },
    {
      "id": "out",
      "type": "Component Outputs",
      "label": "What the row reports upward",
      "ports": [
        {
          "name": "Tick",
          "plug": "input",
          "type": "signal"
        },
        {
          "name": "Delete",
          "plug": "input",
          "type": "signal"
        }
      ],
      "x": 470,
      "y": 400
    },
    {
      "id": "row",
      "type": "Group",
      "label": "One item",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "flexDirection": "column",
        "rowGap": "var(--space-3)",
        "backgroundColor": "var(--surface)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border)",
        "borderRadius": "var(--radius-lg)",
        "paddingTop": "var(--space-4)",
        "paddingBottom": "var(--space-4)",
        "paddingLeft": "var(--space-4)",
        "paddingRight": "var(--space-4)",
        "cssClassName": "item-row"
      },
      "children": [
        "top",
        "stats",
        "days-row",
        "tick"
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "top",
      "type": "Group",
      "label": "Name and delete",
      "parent": "row",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "flexDirection": "row",
        "alignItems": "center",
        "columnGap": "var(--space-2)"
      },
      "children": [
        "name",
        "delete"
      ],
      "x": 100,
      "y": 160
    },
    {
      "id": "name",
      "type": "Text",
      "label": "The item's name",
      "parent": "top",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "fontSize": "var(--text-base)",
        "fontWeight": "var(--font-semibold)",
        "lineHeight": "var(--leading-snug)",
        "color": "var(--foreground)",
        "cssClassName": "item-name"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "delete",
      "type": "net.noodl.controls.button",
      "label": "Delete this item",
      "parent": "top",
      "parameters": {
        "useLabel": true,
        "label": "Delete habit",
        "sizeMode": "contentSize",
        "color": "var(--muted-foreground)",
        "backgroundColor": "transparent",
        "borderStyle": "none",
        "borderRadius": "var(--radius-md)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-medium)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)",
        "paddingLeft": "var(--space-2)",
        "paddingRight": "var(--space-2)",
        "cssClassName": "item-delete"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "stats",
      "type": "Group",
      "label": "The numbers",
      "parent": "row",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "flexDirection": "row",
        "flexWrap": "wrap",
        "alignItems": "center",
        "columnGap": "var(--space-2)",
        "rowGap": "var(--space-2)"
      },
      "children": [
        "streak-pill"
      ],
      "x": 100,
      "y": 520
    },
    {
      "id": "streak-pill",
      "type": "Group",
      "label": "streak",
      "parent": "stats",
      "parameters": {
        "sizeMode": "contentSize",
        "flexDirection": "row",
        "alignItems": "center",
        "backgroundColor": "var(--muted)",
        "borderRadius": "var(--radius-full)",
        "paddingLeft": "var(--space-3)",
        "paddingRight": "var(--space-3)",
        "paddingTop": "var(--space-1)",
        "paddingBottom": "var(--space-1)"
      },
      "children": [
        "streak-text"
      ],
      "x": 160,
      "y": 640
    },
    {
      "id": "streak-text",
      "type": "Text",
      "label": "streak, in words",
      "parent": "streak-pill",
      "parameters": {
        "sizeMode": "contentSize",
        "fontSize": "var(--text-xs)",
        "fontWeight": "var(--font-medium)",
        "color": "var(--foreground)",
        "cssClassName": "item-streak"
      },
      "x": 220,
      "y": 760
    },
    {
      "id": "streak-fn",
      "type": "JavaScriptFunction",
      "label": "streak",
      "parameters": {
        "functionScript": "// B-number: streak, from the one date file.\nconst ticks = Inputs.ticks || [];\nOutputs.value = Scripts.days.streak(ticks, Scripts.days.today());\n",
        "uses": "days.js"
      },
      "x": 470,
      "y": 1480,
      "ports": [
        {
          "name": "in-ticks",
          "displayName": "ticks",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-value",
          "displayName": "value",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "streak-format",
      "type": "String Format",
      "label": "How streak reads",
      "parameters": {
        "format": "{n} Streak"
      },
      "x": 470,
      "y": 760
    },
    {
      "id": "days-row",
      "type": "Group",
      "label": "The last 7 days",
      "parent": "row",
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "flexDirection": "row",
        "flexWrap": "wrap",
        "alignItems": "center",
        "columnGap": "var(--space-2)",
        "rowGap": "var(--space-2)"
      },
      "children": [
        "days"
      ],
      "x": 100,
      "y": 880
    },
    {
      "id": "days",
      "type": "For Each",
      "label": "One cell per day, oldest first",
      "parent": "days-row",
      "parameters": {
        "template": "/Components/Day Cell"
      },
      "x": 160,
      "y": 1000
    },
    {
      "id": "days-fn",
      "type": "JavaScriptFunction",
      "label": "The last 7 days",
      "parameters": {
        "functionScript": "// B-days: the last 7 days, oldest first, each with a stable id.\nOutputs.cells = Scripts.days.lastDays(Inputs.ticks || [], Scripts.days.today(), 7);\n",
        "uses": "days.js"
      },
      "x": 470,
      "y": 1000,
      "ports": [
        {
          "name": "in-ticks",
          "displayName": "ticks",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-cells",
          "displayName": "cells",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "tick",
      "type": "net.noodl.controls.button",
      "label": "Tick it off for today",
      "parent": "row",
      "parameters": {
        "useLabel": true,
        "label": "Mark as done",
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--primary)",
        "borderRadius": "var(--radius-md)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "backgroundColor": "var(--surface)",
        "color": "var(--primary)",
        "cssClassName": "item-tick"
      },
      "x": 100,
      "y": 1120
    },
    {
      "id": "today-fn",
      "type": "JavaScriptFunction",
      "label": "Is it done today",
      "parameters": {
        "functionScript": "// B-tick: done today or not, from the one date file.\nOutputs.doneToday = (Inputs.ticks || []).indexOf(Scripts.days.today()) !== -1;\n",
        "uses": "days.js"
      },
      "x": 470,
      "y": 1600,
      "ports": [
        {
          "name": "in-ticks",
          "displayName": "ticks",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
        {
          "name": "out-doneToday",
          "displayName": "doneToday",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
    {
      "id": "tick-label",
      "type": "Expression",
      "label": "The tick's words",
      "parameters": {
        "expression": "doneToday ? \"Done for today\" : \"Mark as done\""
      },
      "x": 470,
      "y": 1120
    },
    {
      "id": "tick-fill",
      "type": "Expression",
      "label": "Done is filled",
      "parameters": {
        "expression": "doneToday ? 'var(--primary)' : 'var(--surface)'"
      },
      "x": 470,
      "y": 1240
    },
    {
      "id": "tick-ink",
      "type": "Expression",
      "label": "Done reads on the fill",
      "parameters": {
        "expression": "doneToday ? 'var(--primary-foreground)' : 'var(--primary)'"
      },
      "x": 470,
      "y": 1360
    }
  ],
  "visualRoots": [
    "row"
  ]
}