[
  { "wait": 1500 },
  { "eval": "document.getElementById('title').hidden", "label": "title screen shows", "expect": "r => r === false" },
  { "clickSel": "#btn-new" },
  { "wait": 2500 },
  { "eval": "JSON.stringify(__game.stats())", "label": "a new captain walks the bridge", "expect": "r => r.phase === 'walk' && r.sector === 'haven' && r.credits === 1200 && r.entities >= 4" },
  { "shot": "01-bridge.png" },
  { "eval": "JSON.stringify(__game.debug.see())", "label": "at spawn the eye lands on the bridge, not on the hull's own bow block (fixed 2026-10-22)", "expect": "r => r.dist > 8 && r.color !== '#9aa3ad'" },
  { "keyDown": "KeyW", "vk": 87 },
  { "wait": 1200 },
  { "keyUp": "KeyW", "vk": 87 },
  { "eval": "JSON.stringify(__game.stats())", "label": "W walks forward onto the bridge", "expect": "r => r.phase === 'walk' && r.walker[2] < -21" },
  { "shot": "01b-bridge-walked.png" },
  { "eval": "__game.walker.yaw = Math.PI; JSON.stringify(__game.debug.see())", "label": "from the bridge, looking aft, the eye lands down the corridor, not on the main hull's bow face", "expect": "r => r.dist > 8 && r.color !== '#9aa3ad'" },
  { "eval": "__game.walker.pitch = 1.2; JSON.stringify(__game.debug.see())", "label": "the bridge ceiling is the ceiling, not the canopy band's underside", "expect": "r => r.color !== '#0d1b2a'" },
  { "eval": "__game.walker.yaw = 0; __game.walker.pitch = 0; 'ok'" },
  { "eval": "__game.debug.use('helm'); JSON.stringify(__game.stats())", "label": "helm taken", "expect": "r => r.phase === 'helm'" },
  { "keyDown": "KeyW", "vk": 87 },
  { "wait": 2500 },
  { "keyUp": "KeyW", "vk": 87 },
  { "eval": "JSON.stringify(__game.stats())", "label": "throttle up moves her", "expect": "r => r.speed > 10" },
  { "shot": "02-helm.png" },
  { "eval": "__game.debug.use('turret'); JSON.stringify(__game.stats())", "label": "in the turret", "expect": "r => r.phase === 'turret'" },
  { "wait": 300 },
  { "shot": "02b-turret.png" },
  { "eval": "__game.debug.use('tactical'); JSON.stringify(__game.stats())", "label": "tactical view", "expect": "r => r.phase === 'tactical'" },
  { "wait": 300 },
  { "shot": "03-tactical.png" },
  { "eval": "__game.setPhase('walk', { at: __game.interior.fighterPad.clone().add(new (Object.getPrototypeOf(__game.interior.spawn).constructor)(0, -1.1, -4)), yaw: Math.PI }); __game.debug.use('fighter'); JSON.stringify(__game.stats())", "label": "the Wren launches", "expect": "r => r.phase === 'fighter' && r.fighterOut === true" },
  { "wait": 800 },
  { "shot": "04-wren.png" },
  { "eval": "__game.debug.go('station', 150); __game.debug.phase('fighter'); __game.canLand()", "label": "sanity: canLand false far away", "expect": "r => r === false" },
  { "eval": "(() => { const k = __game.player.obj; k.updateMatrixWorld(); __game.fighterEnt.obj.position.copy(k.localToWorld(k.userData.bayLand.clone())); return __game.canLand(); })()", "label": "astern of the bay: can land", "expect": "r => r === true" },
  { "eval": "__game.land(); JSON.stringify(__game.stats())", "label": "landed, back in the bay", "expect": "r => r.phase === 'walk' && r.fighterOut === false" },
  { "eval": "__game.debug.go('station', 120); __game.player.speed = 0; __game.canDock()", "label": "beside the dock: can dock", "expect": "r => r === true" },
  { "eval": "__game.dock(); JSON.stringify(__game.stats())", "label": "docked on the concourse", "expect": "r => r.phase === 'dock' && r.docked === 'haven'" },
  { "wait": 500 },
  { "shot": "05-concourse.png" },
  { "eval": "__game.panel.show('missions'); __game.offers().length", "label": "the board has offers", "expect": "r => r >= 3" },
  { "eval": "__game.accept(__game.offers().find(o => o.kind === 'bounty')); __game.panel.show('trade'); __game.buy('medicine', 2); JSON.stringify(__game.stats())", "label": "accepted a bounty, bought medicine", "expect": "r => r.missions.length === 1 && r.cargo.medicine === 2 && r.credits < 1200" },
  { "shot": "06-panel-trade.png" },
  { "eval": "__game.undock(); JSON.stringify(__game.stats())", "label": "undocked", "expect": "r => r.phase === 'walk' && r.docked === null" },
  { "eval": "__game.debug.go('gate', 60); __game.canJump() ? __game.canJump().to : null", "label": "in the gate: can jump", "expect": "r => r === 'drift'" },
  { "eval": "__game.jump(__game.canJump()); 1" },
  { "wait": 2500 },
  { "eval": "JSON.stringify(__game.stats())", "label": "arrived in the Drift with Rooks about", "expect": "r => r.sector === 'drift' && r.hostiles >= 3 && r.phase === 'walk'" },
  { "shot": "07-drift.png" },
  { "eval": "__game.setPhase('walk', { at: __game.interior.fighterPad.clone().add(new (Object.getPrototypeOf(__game.interior.spawn).constructor)(0, -1.1, -4)), yaw: Math.PI }); __game.debug.use('fighter'); __game.debug.assist(true); 1" },
  { "waitFor": "__game.stats().kills >= 1", "timeout": 90000, "label": "the assist scores a kill" },
  { "eval": "JSON.stringify(__game.stats())", "label": "kill counted, standing moved", "expect": "r => r.kills >= 1 && r.standing.rooks < -10" },
  { "shot": "08-dogfight.png" },
  { "eval": "__game.debug.assist(false); __game.debug.killHostiles(); 1" },
  { "wait": 400 },
  { "eval": "JSON.stringify(__game.stats())", "label": "bounty done once three fell", "expect": "r => r.hostiles === 0 && r.missions[0].endsWith('done:3')" },
  { "eval": "__game.saveTest = 1; JSON.stringify(Object.keys(localStorage))", "label": "save exists", "expect": "r => r.includes('threadspace-save')" }
]
