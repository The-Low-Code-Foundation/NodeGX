[
 {
  "waitFor": "window.__dig && document.getElementById('start').hidden",
  "timeout": 90000,
  "label": "the game starts (auto)"
 },
 {
  "waitFor": "__dig.state().pending === 0",
  "timeout": 120000
 },
 {
  "eval": "JSON.stringify({ touch: document.body.classList.contains('touch'), w: innerWidth, h: innerHeight, shown: [...document.querySelectorAll('#hud button')].filter(b => !b.hidden && b.offsetParent).map(b => b.id || b.textContent.trim().slice(0, 6)) })",
  "expect": "r => r.touch && r.w === 844 && r.shown.includes('btnJump') && r.shown.includes('menuBtn') && !r.shown.includes('btnFire') && !r.shown.includes('btnUse') && !r.shown.includes('btnAim') && r.shown.length === 6",
  "label": "on the phone: hotbar (4), Jump and the menu, nothing else"
 },
 {
  "shot": "01-phone-hud.png"
 },
 {
  "eval": "{ const s = __dig.state(); __dig.teleport(s.pos[0], s.pos[1], s.pos[2], 0, -1.2); 'look down' }"
 },
 {
  "wait": 300
 },
 {
  "touch": [
   [
    640,
    200
   ],
   [
    640,
    200
   ],
   [
    641,
    200
   ],
   [
    640,
    201
   ]
  ],
  "ms": 1800,
  "label": "hold still on the right half"
 },
 {
  "eval": "JSON.stringify(__dig.state())",
  "expect": "s => s.edits >= 1 && s.pack.rubble >= 1",
  "label": "holding a thumb still on the view digs"
 },
 {
  "eval": "{ const s = __dig.state(); __dig.teleport(s.pos[0], s.pos[1], s.pos[2], 0, -1.0); 'look' }"
 },
 {
  "wait": 300
 },
 {
  "touch": [
   [
    640,
    200
   ],
   [
    640,
    200
   ]
  ],
  "ms": 60
 },
 {
  "waitFor": "__dig.state().pack.torches === 23",
  "timeout": 20000,
  "label": "the tap lands"
 },
 {
  "eval": "JSON.stringify({ touch: __dig.input.lastTouch, target: __dig.state().target, pos: __dig.state().pos })",
  "label": "what the tap handler saw"
 },
 {
  "eval": "JSON.stringify(__dig.state().pack)",
  "expect": "p => p.torches === 23",
  "label": "a quick tap on the view places a torch"
 },
 {
  "eval": "window.__p0 = __dig.state().pos; 'remember'"
 },
 {
  "touch": [
   [
    140,
    300
   ],
   [
    140,
    270
   ],
   [
    140,
    250
   ],
   [
    140,
    240
   ],
   [
    140,
    240
   ],
   [
    140,
    240
   ],
   [
    140,
    240
   ],
   [
    140,
    240
   ]
  ],
  "ms": 1400,
  "label": "left thumb pushes the stick forward"
 },
 {
  "eval": "{ const p = __dig.state().pos; JSON.stringify(Math.hypot(p[0] - __p0[0], p[2] - __p0[2])) }",
  "expect": "d => d > 1.5",
  "label": "the left-half stick walks the player"
 },
 {
  "clickSel": "#hotbar button",
  "nth": 2
 },
 {
  "waitFor": "__dig.state().slot === 'rifle' && !document.getElementById('btnFire').hidden",
  "timeout": 20000
 },
 {
  "eval": "JSON.stringify({ slot: __dig.state().slot, fire: !document.getElementById('btnFire').hidden, aim: !document.getElementById('btnAim').hidden })",
  "expect": "r => r.slot === 'rifle' && r.fire && r.aim",
  "label": "with the rifle in hand, Fire and Aim appear"
 },
 {
  "shot": "02-phone-rifle.png"
 },
 {
  "touchSel": "#btnFire",
  "ms": 80
 },
 {
  "waitFor": "__dig.state().pack.rounds === 11",
  "timeout": 20000,
  "label": "the shot goes off"
 },
 {
  "eval": "JSON.stringify(__dig.state().pack.rounds)",
  "expect": "n => n === 11",
  "label": "Fire fires"
 },
 {
  "clickSel": "#hotbar button",
  "nth": 3
 },
 {
  "waitFor": "__dig.state().slot === 'bow' && !document.getElementById('btnFire').hidden && document.getElementById('btnAim').hidden",
  "timeout": 20000
 },
 {
  "eval": "JSON.stringify({ slot: __dig.state().slot, fire: !document.getElementById('btnFire').hidden, aim: !document.getElementById('btnAim').hidden })",
  "expect": "r => r.slot === 'bow' && r.fire && !r.aim",
  "label": "with the bow, Fire stays and Aim goes"
 },
 {
  "eval": "{ const s = __dig.state(); __dig.teleport(s.pos[0], s.pos[1], s.pos[2], 0, 0.6); 'aim up and away' }"
 },
 {
  "touchSel": "#btnFire",
  "ms": 2600
 },
 {
  "waitFor": "__dig.state().pack.arrows === 15",
  "timeout": 20000,
  "label": "the arrow leaves the bow"
 },
 {
  "eval": "JSON.stringify(__dig.state().pack.arrows)",
  "expect": "n => n === 15",
  "label": "holding Fire draws the bow; letting go looses an arrow"
 },
 {
  "clickSel": "#hotbar button",
  "nth": 0
 },
 {
  "eval": "JSON.stringify(__dig.toRoom(1))"
 },
 {
  "waitFor": "__dig.state().pending === 0",
  "timeout": 120000
 },
 {
  "wait": 400
 },
 {
  "eval": "JSON.stringify({ use: !document.getElementById('btnUse').hidden, label: document.getElementById('btnUse').textContent })",
  "expect": "r => r.use && r.label === 'Read'",
  "label": "looking at the lectern, Use appears (Read)"
 },
 {
  "shot": "03-phone-room.png"
 },
 {
  "touchSel": "#btnUse",
  "ms": 60
 },
 {
  "wait": 300
 },
 {
  "eval": "JSON.stringify(__dig.state().panel)",
  "expect": "p => p === true",
  "label": "Use opens the stone"
 },
 {
  "shot": "04-phone-stone.png"
 },
 {
  "eval": "document.getElementById('later').click(); 'later'"
 },
 {
  "touchSel": "#menuBtn",
  "ms": 60
 },
 {
  "wait": 300
 },
 {
  "eval": "JSON.stringify({ panel: __dig.state().panel, buttons: [...document.querySelectorAll('#card .menu button')].map(b => b.textContent) })",
  "expect": "r => r.panel && r.buttons.includes('Craft') && r.buttons.includes('Trophy case') && r.buttons.includes('Controls')",
  "label": "craft, the trophy case, sound and help live in the menu"
 },
 {
  "shot": "05-phone-menu.png"
 }
]