    {
      "name": "/#__cloud__/Cloud Functions/Join Group",
      "nodes": [
        {
          "id": "jg_request",
          "type": "noodl.cloud.request",
          "label": "The caller (no parameters: nothing to forge)",
          "parameters": {
            "allowNoAuth": false
          }
        },
        {
          "id": "jg_me",
          "type": "net.noodl.user.User",
          "label": "The caller's own session"
        },
        {
          "id": "jg_invites",
          "type": "DbCollection2",
          "label": "Every invitation",
          "parameters": {
            "collectionName": "Invite",
            "runOnChange-collectionName": false,
            "runOnChange-querySettings": false
          }
        },
        {
          "id": "jg_pick",
          "type": "JavaScriptFunction",
          "label": "The group of whoever invited this address: the invitation's owner",
          "parameters": {
            "functionScript": "if (Inputs.me === undefined || Inputs.email === undefined || Inputs.invites === undefined) return;\nconst me = String(Inputs.me || '');\nconst email = String(Inputs.email || '').trim().toLowerCase();\n// The group an invitation lets you into is the person who MADE it: its owner, which the backend wrote\n// from their session and nobody can change. Never a group id the invitation carries: anyone signed in\n// can create an invitation naming any group. Your own invitations are not a way in to anything.\nconst mine = Inputs.invites\n  .filter((i) => email !== '' && String(i.withEmail || '').trim().toLowerCase() === email && String(i.owner) !== me)\n  .sort((a, b) => String(a.createdAt || '').localeCompare(String(b.createdAt || '')));\nconst invite = mine[0];\nif (!invite) {\n  // Nobody invited this address: the caller's group is their own.\n  Outputs.group = me;\n  Outputs.none();\n  return;\n}\n// Remember who took the invitation up, so its owner can take it back (Remove Member).\nawait Noodl.Records.save(invite.id || invite.objectId, { memberId: me }, { className: 'Invite' });\nOutputs.group = String(invite.owner);\nOutputs.userId = me;\nOutputs.role = 'members-of-' + String(invite.owner);\nOutputs.join();"
          }
        },
        {
          "id": "jg_join",
          "type": "noodl.cloud.addusertorole",
          "label": "Put the caller in that group's role",
          "parameters": {
            "createRole": true
          }
        },
        {
          "id": "jg_ok",
          "type": "noodl.cloud.response",
          "label": "The group this caller is in",
          "parameters": {
            "params": "group"
          }
        },
        {
          "id": "jg_fail",
          "type": "noodl.cloud.response",
          "label": "Tell the caller it went wrong",
          "parameters": {
            "status": "failure"
          }
        }
      ],
      "connections": [
        {
          "fromId": "jg_request",
          "fromProperty": "receive",
          "toId": "jg_me",
          "toProperty": "fetch"
        },
        {
