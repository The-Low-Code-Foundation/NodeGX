          "fromProperty": "receive",
          "toId": "jg_invites",
          "toProperty": "storageFetch"
        },
        {
          "fromId": "jg_me",
          "fromProperty": "id",
          "toId": "jg_pick",
          "toProperty": "in-me"
        },
        {
          "fromId": "jg_me",
          "fromProperty": "email",
          "toId": "jg_pick",
          "toProperty": "in-email"
        },
        {
          "fromId": "jg_invites",
          "fromProperty": "items",
          "toId": "jg_pick",
          "toProperty": "in-invites"
        },
        {
          "fromId": "jg_pick",
          "fromProperty": "out-role",
          "toId": "jg_join",
          "toProperty": "role"
        },
        {
          "fromId": "jg_pick",
          "fromProperty": "out-userId",
          "toId": "jg_join",
          "toProperty": "userId"
        },
        {
          "fromId": "jg_pick",
          "fromProperty": "out-join",
