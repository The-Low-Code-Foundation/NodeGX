          "toProperty": "send"
        }
      ]
    },
    {
      "name": "/#__cloud__/Cloud Functions/Remove Member",
      "nodes": [
        {
          "id": "rm_request",
          "type": "noodl.cloud.request",
          "label": "The address whose invitation the caller takes back",
          "parameters": {
            "allowNoAuth": false,
            "params": "withEmail"
          }
        },
        {
          "id": "rm_me",
          "type": "net.noodl.user.User",
          "label": "The caller's own session"
        },
        {
          "id": "rm_invites",
          "type": "DbCollection2",
          "label": "Every invitation",
          "parameters": {
            "collectionName": "Invite",
            "runOnChange-collectionName": false,
            "runOnChange-querySettings": false
          }
        },
        {
          "id": "rm_pick",
          "type": "JavaScriptFunction",
          "label": "The caller's own invitation, and the member who took it up",
          "parameters": {
            "functionScript": "if (Inputs.me === undefined || Inputs.withEmail === undefined || Inputs.invites === undefined) return;\nconst me = String(Inputs.me || '');\nconst email = String(Inputs.withEmail || '').trim().toLowerCase();\n// Only the caller's own invitations, and only the caller's own group: whatever an invitation says, the\n// role taken away is the caller's.\nconst mine = Inputs.invites.filter(\n  (i) => String(i.owner) === me && String(i.withEmail || '').trim().toLowerCase() === email\n);\nif (mine.length === 0) {\n  Outputs.reason = 'You have not invited that address.';\n  Outputs.refused();\n  return;\n}\nconst member = mine.map((i) => String(i.memberId || '')).find((m) => m !== '') || '';\nfor (const i of mine) await Noodl.Records.delete(i.id || i.objectId, { className: 'Invite' });\nif (member === '') {\n  Outputs.removed();\n  return;\n}\nOutputs.userId = member;\nOutputs.role = 'members-of-' + me;\nOutputs.remove();"
          }
        },
        {
          "id": "rm_role",
          "type": "noodl.cloud.removeuserfromrole",
          "label": "Take them out of the caller's group"
        },
        {
          "id": "rm_ok",
          "type": "noodl.cloud.response",
          "label": "Taken back"
        },
        {
          "id": "rm_fail",
          "type": "noodl.cloud.response",
          "label": "Refused, or it went wrong",
          "parameters": {
            "status": "failure"
          }
        }
      ],
      "connections": [
        {
          "fromId": "rm_request",
          "fromProperty": "receive",
          "toId": "rm_me",
          "toProperty": "fetch"
        },
        {
          "fromId": "rm_request",
          "fromProperty": "receive",
          "toId": "rm_invites",
          "toProperty": "storageFetch"
        },
        {
          "fromId": "rm_me",
          "fromProperty": "id",
          "toId": "rm_pick",
          "toProperty": "in-me"
        },
        {
          "fromId": "rm_request",
