    {
      "name": "/#__cloud__/Cloud Functions/Add To Group",
      "nodes": [
        {
          "id": "ag_request",
          "type": "noodl.cloud.request",
          "label": "A note, and the group it is for",
          "parameters": {
            "allowNoAuth": false,
            "params": "title,group"
          }
        },
        {
          "id": "ag_me",
          "type": "net.noodl.user.User",
          "label": "The caller's own session, and the roles it carries"
        },
        {
          "id": "ag_add",
          "type": "JavaScriptFunction",
          "label": "Only a member writes, and the note is the group owner's",
          "parameters": {
            "functionScript": "if (Inputs.me === undefined || Inputs.roles === undefined || Inputs.group === undefined) return;\nconst me = String(Inputs.me || '');\nconst group = String(Inputs.group || '');\nconst roles = Array.isArray(Inputs.roles) ? Inputs.roles : [];\n// The group a caller may add to: their own, or one whose role their own session carries. The role is\n// only ever granted by Join Group, from an invitation's owner, so a group id sent here proves nothing.\nif (group === '' || (group !== me && !roles.includes('members-of-' + group))) {\n  Outputs.reason = 'You are not a member of this group.';\n  Outputs.refused();\n  return;\n}\n// Created as the system, so the record's owner is the GROUP's owner (a page could never name it), and\n// its access rules are the owner and the group's role: every member reads and changes it.\nconst acl = {};\nacl[group] = { read: true, write: true };\nacl['role:members-of-' + group] = { read: true, write: true };\nconst note = await Noodl.Records.create('Note', { title: String(Inputs.title || ''), owner: group }, { acl });\nOutputs.id = note.getId();\nOutputs.added();"
          }
        },
        {
          "id": "ag_ok",
          "type": "noodl.cloud.response",
          "label": "The new note",
          "parameters": {
            "params": "id"
          }
        },
        {
          "id": "ag_fail",
          "type": "noodl.cloud.response",
          "label": "Refused, or it went wrong",
          "parameters": {
            "status": "failure"
          }
        }
      ],
      "connections": [
        {
          "fromId": "ag_request",
          "fromProperty": "receive",
          "toId": "ag_me",
          "toProperty": "fetch"
        },
        {
          "fromId": "ag_me",
          "fromProperty": "id",
          "toId": "ag_add",
          "toProperty": "in-me"
        },
        {
          "fromId": "ag_me",
          "fromProperty": "roles",
          "toId": "ag_add",
          "toProperty": "in-roles"
        },
        {
          "fromId": "ag_request",
          "fromProperty": "pm-group",
          "toId": "ag_add",
          "toProperty": "in-group"
        },
        {
          "fromId": "ag_request",
          "fromProperty": "pm-title",
          "toId": "ag_add",
          "toProperty": "in-title"
        },
        {
          "fromId": "ag_add",
          "fromProperty": "out-id",
          "toId": "ag_ok",
          "toProperty": "pm-id"
        },
        {
          "fromId": "ag_add",
          "fromProperty": "out-added",
          "toId": "ag_ok",
          "toProperty": "send"
        },
        {
          "fromId": "ag_add",
          "fromProperty": "out-reason",
          "toId": "ag_fail",
          "toProperty": "errorMessage"
        },
        {
          "fromId": "ag_add",
          "fromProperty": "out-refused",
          "toId": "ag_fail",
          "toProperty": "send"
        },
        {
          "fromId": "ag_add",
          "fromProperty": "error",
          "toId": "ag_fail",
          "toProperty": "errorMessage"
        },
        {
          "fromId": "ag_add",
          "fromProperty": "failure",
