{
  "id": "option-set",
  "title": "A fixed list as an option set: the languages, read by a dropdown, the choice stored by a Set Variable",
  "description": "A fixed list (a language, a status, a priority) lives in ONE place: a logic component under `Option sets/<Name>` holding one `Static Data` node with the list as a JSON array, published through `Component Outputs` as `items` and `count`. NodeGX Studio lists every component under `Option sets/` in Data → Option sets, where the person adds or renames an option themselves, and the NodeGX editor shows it as the Static Data node it is. A page places an instance and wires its `items` wherever the list is needed (a Dropdown here; a `For Each` of buttons works the same). The step that stores the person's choice takes the chosen row's value from the control, so no literal like \"fr\" or \"en\" is typed into a Set Variable anywhere: two steps typing two literals into one variable are a fixed list the project does not have, and the next language means editing every one of them. Each row carries `Label` (what the person reads) and `Value` (what the app stores), the two fields a Dropdown reads off each item.",
  "demonstrates": ["Static Data", "Component Outputs", "net.noodl.controls.options", "Set Variable", "Variable2"],
  "components": [
    {
      "name": "/Option sets/Languages",
      "nodes": [
        {
          "id": "options",
          "type": "Static Data",
          "label": "Languages · the options",
          "parameters": { "type": "json", "json": "[{\"Label\":\"English\",\"Value\":\"en\"},{\"Label\":\"Français\",\"Value\":\"fr\"}]" }
        },
        {
          "id": "out",
          "type": "Component Outputs",
          "label": "What the page reads",
          "ports": [
            { "name": "items", "plug": "input", "type": "array" },
            { "name": "count", "plug": "input", "type": "number" }
          ]
        }
      ],
      "connections": [
        { "fromId": "options", "fromProperty": "items", "toId": "out", "toProperty": "items" },
        { "fromId": "options", "fromProperty": "count", "toId": "out", "toProperty": "count" }
      ]
    },
    {
      "name": "/Pages/Language",
      "nodes": [
        { "id": "page", "type": "Page", "label": "Page", "parameters": { "title": "Language", "urlPath": "language" }, "children": ["body"] },
        {
          "id": "body",
          "type": "Group",
          "label": "Body",
          "parent": "page",
          "parameters": {
            "width": { "value": 100, "unit": "%" },
            "sizeMode": "contentHeight",
            "flexDirection": "column",
            "rowGap": "var(--space-3)",
            "paddingLeft": "var(--space-4)",
            "paddingRight": "var(--space-4)",
            "paddingTop": "var(--space-4)",
            "paddingBottom": "var(--space-4)"
          },
          "children": ["prompt", "picker"]
        },
        { "id": "prompt", "type": "Text", "label": "Prompt", "parent": "body", "parameters": { "text": "Language" } },
        {
          "id": "picker",
          "type": "net.noodl.controls.options",
          "label": "Language picker",
          "parent": "body",
          "parameters": { "placeholder": "Choose a language", "sizeMode": "contentHeight", "width": { "value": 100, "unit": "%" } }
        },
        { "id": "languages", "type": "/Option sets/Languages", "label": "Languages" },
        { "id": "store_language", "type": "Set Variable", "label": "Remember the language", "parameters": { "name": "language", "setWith": "string" } },
        { "id": "read_language", "type": "Variable2", "label": "Current language", "parameters": { "name": "language" } }
      ],
      "connections": [
        { "fromId": "languages", "fromProperty": "items", "toId": "picker", "toProperty": "items" },
        { "fromId": "picker", "fromProperty": "value", "toId": "store_language", "toProperty": "value" },
        { "fromId": "picker", "fromProperty": "onChange", "toId": "store_language", "toProperty": "do" },
        { "fromId": "read_language", "fromProperty": "value", "toId": "picker", "toProperty": "value" }
      ]
    }
  ]
}
