        {
          "id": "move",
          "type": "JavaScriptFunction",
          "label": "Move card",
          "parameters": {
            "functionScript": "// Runs on Dropped only: the three inputs are set just before it fires, and must not run it on their own.\nvar card = Noodl.Objects[Inputs.id];\nvar to = Inputs.list;\nif (!card || !to) return;\nvar from = card.get('list');\nif (from) Noodl.Arrays[from].remove(card);\ncard.set('list', to);\nvar dest = Noodl.Arrays[to];\nvar index = Number(Inputs.index);\nif (!isFinite(index)) index = dest.length;\ndest.addAtIndex(card, Math.max(0, Math.min(index, dest.length)));\n",
            "runOnChange-in-id": false,
            "runOnChange-in-list": false,
            "runOnChange-in-index": false
          }
        },
        {
