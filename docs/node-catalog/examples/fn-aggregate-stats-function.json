{
  "id": "fn-aggregate-stats-function",
  "title": "Server-side aggregation exposed as a cloud function",
  "description": "Aggregate Records runs a sum, min, max or average over a number column (or the distinct values of a text column) of a database class without transferring the records — it exists only in the cloud runtime, so the idiomatic shape is a small cloud function around it: Request triggers the aggregate's fetch, `fetched` sends the Response, and each name in `aggregates` gets its own Property and Operation inputs (`aggprop-<name>`, `aggop-<name>`) and its result on `agg-<name>`, returned as a response param. Here that is `totalHours`, the sum of every task's `hours`. There is no count operation: for a count, use Query Records with Fetch total count on. The browser calls the function like any cloud function and renders the statistic.",
  "demonstrates": [
    "noodl.cloud.aggregate",
    "CloudFunction2",
    "noodl.cloud.request",
    "noodl.cloud.response"
  ],
  "components": [
    {
      "name": "/Stats Screen",
      "nodes": [
        {
          "id": "root",
          "type": "Group",
          "label": "Screen",
          "parameters": {
            "flexDirection": "column"
          },
          "children": [
            "refresh_btn",
            "total_text"
          ]
        },
        {
          "id": "refresh_btn",
          "type": "net.noodl.controls.button",
          "label": "Refresh",
          "parent": "root",
          "parameters": {
            "label": "Refresh stats"
          }
        },
        {
          "id": "total_text",
          "type": "Text",
          "label": "Total hours",
          "parent": "root"
        },
        {
          "id": "call_stats",
          "type": "CloudFunction2",
          "label": "Call Task Stats",
          "parameters": {
            "function": "Cloud Functions/Task Stats"
          }
        }
      ],
      "connections": [
        {
          "fromId": "refresh_btn",
          "fromProperty": "onClick",
          "toId": "call_stats",
          "toProperty": "call"
        },
        {
          "fromId": "call_stats",
          "fromProperty": "out-totalHours",
          "toId": "total_text",
          "toProperty": "text"
        }
      ]
    },
    {
      "name": "/#__cloud__/Cloud Functions/Task Stats",
      "nodes": [
        {
          "id": "fn_request",
          "type": "noodl.cloud.request",
          "label": "Request"
        },
        {
          "id": "sum_hours",
          "type": "noodl.cloud.aggregate",
          "label": "Sum task hours",
          "parameters": {
            "collectionName": "Task",
            "aggregates": "totalHours",
            "aggprop-totalHours": "hours",
            "aggop-totalHours": "sum"
          }
        },
        {
          "id": "fn_response",
          "type": "noodl.cloud.response",
          "label": "Response",
          "parameters": {
            "params": "totalHours"
          }
        },
        {
          "id": "fn_fail_response",
          "type": "noodl.cloud.response",
          "label": "Failure response",
          "parameters": {
            "status": "failure"
          }
        }
      ],
      "connections": [
        {
          "fromId": "fn_request",
          "fromProperty": "receive",
          "toId": "sum_hours",
          "toProperty": "fetch"
        },
        {
          "fromId": "sum_hours",
          "fromProperty": "agg-totalHours",
          "toId": "fn_response",
          "toProperty": "pm-totalHours"
        },
        {
          "fromId": "sum_hours",
          "fromProperty": "fetched",
          "toId": "fn_response",
          "toProperty": "send"
        },
        {
          "fromId": "sum_hours",
          "fromProperty": "error",
          "toId": "fn_fail_response",
          "toProperty": "errorMessage"
        },
        {
          "fromId": "sum_hours",
          "fromProperty": "failure",
          "toId": "fn_fail_response",
          "toProperty": "send"
        }
      ]
    }
  ]
}
