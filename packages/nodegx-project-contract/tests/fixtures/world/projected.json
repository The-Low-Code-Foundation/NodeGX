  "collections": [
    {
      "name": "Person",
      "made": {
        "noun": "person"
      },
      "sentence": "A person is anyone we know: a member, someone who came to a session, someone we wrote to.",
      "notHeld": [
        "every exchange with the course platform is logged, and a skipped one says why",
        "nobody deletes a person; it ends"
      ],
      "description": "A person is anyone we know: a member, someone who came to a session, someone we wrote to. Not kept by the database yet: every exchange with the course platform is logged, and a skipped one says why; nobody deletes a person; it ends.",
      "columns": [
        {
          "name": "name",
          "kind": "text",
          "type": "String"
        },
        {
          "name": "email",
          "kind": "text",
          "type": "String",
          "description": "We write to them here; it can change."
        },
        {
          "name": "onTheCoursePlatformId",
          "kind": "text",
          "type": "String",
          "description": "A member also has a login on the course platform.",
          "relation": "on-the-course-platform"
        },
        {
          "name": "endedAt",
          "kind": "date",
          "type": "Date",
          "description": "A person can leave, and we keep what they did.",
          "relation": "leaves"
        }
      ],
      "checks": [],
      "indexes": [
        {
          "fields": [
            "onTheCoursePlatformId"
          ],
          "unique": true
        }
      ]
    },
    {
      "name": "Account",
      "made": {
        "noun": "account"
      },
      "sentence": "An account is what pays us: a company's membership, with the people on it.",
      "notHeld": [
        "an account's company is set once"
