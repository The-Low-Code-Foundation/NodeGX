{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opennoodl.dev/schemas/world-v1.json",
  "title": "NodeGX world",
  "description": "What a person said about their world: docs/world/nouns.json, relations.json and vocabulary.json (P116 ONT-001), verbs.json when the person has said what they do over it (ONT-006), and rules.json when they said a rule no kind asked for (ONT-013). A property graph in plain JSON: things, typed links between them, details on the links. It names no engine and no graph framework. A file is one of the three definitions; which kinds exist, and what each asks, is the pinned vocabulary's, and the validator in @nodegx/project-contract/world checks it.",
  "oneOf": [
    {
      "$ref": "#/definitions/nounsFile"
    },
    {
      "$ref": "#/definitions/relationsFile"
    },
    {
      "$ref": "#/definitions/vocabularyFile"
    },
    {
      "$ref": "#/definitions/verbsFile"
    },
    {
      "$ref": "#/definitions/rulesFile"
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "words": {
      "type": "string",
      "pattern": "\\S"
    },
    "property": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/definitions/words"
        },
        "kind": {
          "description": "P104's eleven field kinds less link and links: a link between two things is a relation.",
          "enum": [
            "text",
            "number",
            "yesno",
            "date",
            "choice",
            "file",
            "location",
            "list",
            "anything"
          ]
        },
        "sentence": {
          "$ref": "#/definitions/words"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/words"
          }
        },
        "freeWords": {
          "description": "A text the person was asked about and said is free words, not one of a fixed list (ONT-002's kind-picker question, answered).",
          "const": true
        },
        "secret": {
          "description": "ONT-011 step 2: this detail is not for everyone who can see the record (the noun's answers.secret is the yes; this is the which).",
          "const": true
        },
        "onlyWhen": {
          "description": "ONT-011 step 2: this detail matters only when another detail of the same record is set, or holds 'is'; 'required': never left empty when it matters.",
          "type": "object",
          "required": [
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/definitions/words"
            },
            "is": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "required": {
              "const": true
            }
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "choice"
          }
        }
      },
      "then": {
        "required": [
          "values"
        ]
      },
      "else": {
        "not": {
          "required": [
            "values"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "freeWords"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          }
        }
      ]
    },
    "noun": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sentence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/words"
        },
        "sentence": {
          "description": "What the person said it is.",
          "$ref": "#/definitions/words"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/property"
          }
        },
        "signsIn": {
          "description": "This noun is who signs in; at most one noun says so. Projects to a link to the app's users on its collection.",
          "const": true
        },
        "answers": {
          "description": "ONT-011 step 2: the noun's answers to its own questions (onlyOne, calledBy, history, readAloud, secret; then looksLike, maySkip, restarts), by question id.",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "$ref": "#/definitions/words"
              }
            ]
          }
        },
        "was": {
          "description": "The id this noun had before the person renamed it. A migration carries its records to the new name; a 'was' the world before does not have changes nothing.",
          "$ref": "#/definitions/id"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "from",
        "kind",
        "sentence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "from": {
          "$ref": "#/definitions/id"
        },
        "to": {
          "description": "A noun id, a list of noun ids, or another system in words \u2014 by the kind's target.",
          "oneOf": [
            {
              "$ref": "#/definitions/words"
            },
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/definitions/id"
              }
            }
          ]
        },
        "property": {
          "$ref": "#/definitions/words"
        },
        "kind": {
          "$ref": "#/definitions/id"
        },
        "sentence": {
          "description": "What the person said.",
          "$ref": "#/definitions/words"
        },
        "answers": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "$ref": "#/definitions/words"
              }
            ]
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/property"
          }
        },
        "through": {
          "description": "The answer to \"through what?\" (ONT-002) on an owned-by answered path: true \u2014 the relations from the noun that signs in to the owner, in order. The validator walks it over the nouns.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/throughStep"
          }
        }
      }
    },
    "throughStep": {
      "type": "object",
      "required": [
        "relation"
      ],
      "additionalProperties": false,
      "properties": {
        "relation": {
          "$ref": "#/definitions/id"
        },
        "back": {
          "type": "boolean"
        },
        "where": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "nounsFile": {
      "type": "object",
      "required": [
        "nouns"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "nouns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/noun"
          }
        }
      }
    },
    "relationsFile": {
      "type": "object",
      "required": [
        "relations"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relation"
          }
        }
      }
    },
    "vocabularyFile": {
      "type": "object",
      "required": [
        "vocabulary",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "vocabulary": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "verbArm": {
      "type": "object",
      "required": [
        "id",
        "when",
        "then",
        "sees"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "when": {
          "$ref": "#/definitions/words"
        },
        "then": {
          "description": "Record it and go on past the steps it skips, or stop the verb there.",
          "enum": [
            "record-and-go-on",
            "stop"
          ]
        },
        "sees": {
          "$ref": "#/definitions/words"
        },
        "skips": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "answers": {
          "type": "object",
          "required": [
            "relation",
            "question"
          ],
          "additionalProperties": false,
          "properties": {
            "relation": {
              "$ref": "#/definitions/id"
            },
            "question": {
              "$ref": "#/definitions/id"
            }
          }
        }
      }
    },
    "verbStep": {
      "type": "object",
      "required": [
        "id",
        "says",
        "does"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "says": {
          "$ref": "#/definitions/words"
        },
        "does": {
          "description": "Here: make, update, end, remove, keep. In another system: ask.",
          "enum": [
            "make",
            "update",
            "end",
            "remove",
            "keep",
            "ask"
          ]
        },
        "on": {
          "$ref": "#/definitions/id"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/words"
          }
        },
        "by": {
          "$ref": "#/definitions/words"
        },
        "system": {
          "$ref": "#/definitions/words"
        },
        "node": {
          "$ref": "#/definitions/words"
        },
        "kind": {
          "$ref": "#/definitions/words"
        },
        "fails": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/verbArm"
          }
        }
      }
    },
    "verb": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sentence",
        "runs",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/words"
        },
        "sentence": {
          "$ref": "#/definitions/words"
        },
        "when": {
          "$ref": "#/definitions/words"
        },
        "runs": {
          "enum": [
            "server",
            "app"
          ]
        },
        "about": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nouns": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/id"
              }
            },
            "relations": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/id"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/verbStep"
          }
        }
      }
    },
    "verbsFile": {
      "type": "object",
      "required": [
        "verbs"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "verbs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/verb"
          }
        }
      }
    },
    "ruleHold": {
      "description": "What the store is asked to keep, in one shape by its naming member (P116 ONT-013). Never code, a query or free text; the hand validator says which shapes exist, in words, and holds every detail to one the noun has.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "unique"
          ],
          "additionalProperties": false,
          "properties": {
            "unique": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/words"
              }
            },
            "whileEmpty": {
              "$ref": "#/definitions/words"
            }
          },
          "description": "no two records share these details"
        },
        {
          "type": "object",
          "required": [
            "setOnce"
          ],
          "additionalProperties": false,
          "properties": {
            "setOnce": {
              "$ref": "#/definitions/words"
            }
          },
          "description": "a detail written when the record is made and never changed"
        },
        {
          "type": "object",
          "required": [
            "neverEdited"
          ],
          "additionalProperties": false,
          "properties": {
            "neverEdited": {
              "const": true
            }
          },
          "description": "a record never changed once made"
        },
        {
          "type": "object",
          "required": [
            "neverDeleted"
          ],
          "additionalProperties": false,
          "properties": {
            "neverDeleted": {
              "const": true
            },
            "unless": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "description": "The old record still matches: a choice or yes/no detail and the value it holds then, as { \"status\": \"draft\" }."
            }
          },
          "description": "a record never deleted, unless it still matches"
        },
        {
          "type": "object",
          "required": [
            "frozen"
          ],
          "additionalProperties": false,
          "properties": {
            "frozen": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/words"
                  }
                },
                {
                  "const": "*"
                }
              ]
            },
            "unless": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "description": "The old record still matches: a choice or yes/no detail and the value it holds then, as { \"status\": \"draft\" }."
            },
            "except": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/words"
              }
            }
          },
          "description": "details that never change, unless the record still matches"
        },
        {
          "type": "object",
          "required": [
            "moves",
            "from"
          ],
          "additionalProperties": false,
          "properties": {
            "moves": {
              "$ref": "#/definitions/words"
            },
            "from": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "required": [
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "to": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/words"
                    }
                  }
                },
                "description": "where this old value may move to"
              }
            }
          },
          "description": "a choice that moves only as said, per old value"
        },
        {
          "type": "object",
          "required": [
            "onlyOne"
          ],
          "additionalProperties": false,
          "properties": {
            "onlyOne": {
              "const": true
            }
          },
          "description": "at most one record of it"
        },
        {
          "type": "object",
          "required": [
            "atMost",
            "of"
          ],
          "additionalProperties": false,
          "properties": {
            "atMost": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "object",
                  "required": [
                    "field"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "$ref": "#/definitions/words"
                    }
                  },
                  "description": "a limit kept on the record itself"
                }
              ]
            },
            "of": {
              "$ref": "#/definitions/id"
            },
            "per": {
              "$ref": "#/definitions/id"
            }
          },
          "description": "at most so many records of another noun on one of these (ONT-016)"
        },
        {
          "type": "object",
          "required": [
            "onlyBy",
            "changes"
          ],
          "additionalProperties": false,
          "properties": {
            "onlyBy": {
              "$ref": "#/definitions/words"
            },
            "changes": {
              "$ref": "#/definitions/words"
            },
            "to": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "description": "only a role may change a detail"
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "on",
        "says",
        "holds",
        "mutant",
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "on": {
          "$ref": "#/definitions/id",
          "description": "The noun, or the relation that is a record of its own, whose records the rule is about."
        },
        "says": {
          "$ref": "#/definitions/words",
          "description": "The person's sentence: read back, shown in the view, carried by the refusal."
        },
        "holds": {
          "$ref": "#/definitions/ruleHold"
        },
        "mutant": {
          "$ref": "#/definitions/words",
          "description": "The mistake, in words: what happens without the rule."
        },
        "from": {
          "enum": [
            "oral",
            "note",
            "census"
          ],
          "description": "The person, a note, or the census. An agent is not a source."
        }
      }
    },
    "rulesFile": {
      "type": "object",
      "required": [
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rule"
          }
        }
      }
    }
  }
}
