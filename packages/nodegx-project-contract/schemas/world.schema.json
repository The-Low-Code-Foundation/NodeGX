{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opennoodl.dev/schemas/world-v1.json",
  "title": "NodeGX world",
  "description": "What a person said about their world: docs/world/nouns.json, relations.json and vocabulary.json (P116 ONT-001). A property graph in plain JSON: things, typed links between them, details on the links. It names no engine and no graph framework. A file is one of the three definitions; which kinds exist, and what each asks, is the pinned vocabulary's, and the validator in @nodegx/project-contract/world checks it.",
  "oneOf": [
    { "$ref": "#/definitions/nounsFile" },
    { "$ref": "#/definitions/relationsFile" },
    { "$ref": "#/definitions/vocabularyFile" }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "words": {
      "type": "string",
      "pattern": "\\S"
    },
    "property": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/definitions/words" },
        "kind": {
          "description": "P104's eleven field kinds less link and links: a link between two things is a relation.",
          "enum": ["text", "number", "yesno", "date", "choice", "file", "location", "list", "anything"]
        },
        "sentence": { "$ref": "#/definitions/words" },
        "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/words" } }
      },
      "if": { "properties": { "kind": { "const": "choice" } } },
      "then": { "required": ["values"] },
      "else": { "not": { "required": ["values"] } }
    },
    "noun": {
      "type": "object",
      "required": ["id", "name", "sentence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "$ref": "#/definitions/words" },
        "sentence": { "description": "What the person said it is.", "$ref": "#/definitions/words" },
        "properties": { "type": "array", "items": { "$ref": "#/definitions/property" } }
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "from", "kind", "sentence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "from": { "$ref": "#/definitions/id" },
        "to": {
          "description": "A noun id, a list of noun ids, or another system in words — by the kind's target.",
          "oneOf": [
            { "$ref": "#/definitions/words" },
            { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/id" } }
          ]
        },
        "property": { "$ref": "#/definitions/words" },
        "kind": { "$ref": "#/definitions/id" },
        "sentence": { "description": "What the person said.", "$ref": "#/definitions/words" },
        "answers": {
          "type": "object",
          "additionalProperties": { "oneOf": [{ "type": "boolean" }, { "$ref": "#/definitions/words" }] }
        },
        "properties": { "type": "array", "items": { "$ref": "#/definitions/property" } }
      }
    },
    "nounsFile": {
      "type": "object",
      "required": ["nouns"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "nouns": { "type": "array", "items": { "$ref": "#/definitions/noun" } }
      }
    },
    "relationsFile": {
      "type": "object",
      "required": ["relations"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "relations": { "type": "array", "items": { "$ref": "#/definitions/relation" } }
      }
    },
    "vocabularyFile": {
      "type": "object",
      "required": ["vocabulary", "version"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "vocabulary": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
