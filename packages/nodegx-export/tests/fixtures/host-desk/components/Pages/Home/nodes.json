    {
      "id": "stamp",
      "type": "JavaScriptFunction",
      "label": "The stamp",
      "parameters": {
        "functionScript": "const d = new Date(0);\nOutputs.year = String(d.getUTCFullYear());\nOutputs.later = Date.now() > 1 ? 'yes' : 'no';\nOutputs.picked = Math.random() < 2 ? 'picked' : 'none';\nsetTimeout(() => {}, 0);\nOutputs.timer = 'set';\nOutputs.win = typeof window === 'object' ? 'window' : 'none';"
      },
      "ports": [
        {
          "name": "out-year",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "out-later",
          "plug": "output",
          "type": "*"
        },
        {
          "name": "out-picked",
