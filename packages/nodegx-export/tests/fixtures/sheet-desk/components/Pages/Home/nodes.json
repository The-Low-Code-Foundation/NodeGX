{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "e7a1c4d2-5b3f-4e8d-9c1a-000000000101",
  "version": 1,
  "nodes": [
    {
      "id": "page",
      "type": "Page",
      "label": "Home",
      "children": [
        "shell"
      ],
      "parameters": {
        "title": "Sheet Desk",
        "urlPath": "home"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "shell",
      "type": "Group",
      "label": "Shell",
      "parent": "page",
      "children": [
        "headline",
        "people",
        "countText",
        "csvOutText",
        "xmlErrorText",
        "feedTitleText",
        "feedCountText"
      ],
      "parameters": {
        "flexDirection": "column",
        "alignItems": "flex-start",
        "rowGap": "var(--space-3)",
        "paddingTop": "var(--space-8)",
        "paddingLeft": "var(--space-6)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "headline",
      "type": "Text",
      "label": "Headline",
      "parent": "shell",
      "parameters": {
        "text": "Sheet Desk",
        "fontSize": "var(--text-base)"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "people",
      "type": "For Each",
      "label": "One row per person",
      "parent": "shell",
      "parameters": {
        "template": "/Components/PersonRow"
      },
      "x": 100,
      "y": 360
    },
    {
      "id": "countText",
      "type": "Text",
      "label": "How many people",
      "parent": "shell",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)"
      },
      "x": 100,
      "y": 440
    },
    {
      "id": "csvOutText",
      "type": "Text",
      "label": "The CSV, written back",
      "parent": "shell",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)"
      },
      "x": 100,
      "y": 520
    },
    {
      "id": "xmlErrorText",
      "type": "Text",
      "label": "XML error",
      "parent": "shell",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)"
      },
      "x": 100,
      "y": 600
    },
    {
      "id": "feedTitleText",
      "type": "Text",
      "label": "Feed title",
      "parent": "shell",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)"
      },
      "x": 100,
      "y": 680
    },
    {
      "id": "feedCountText",
      "type": "Text",
      "label": "Feed count",
      "parent": "shell",
      "parameters": {
        "text": "",
        "fontSize": "var(--text-base)"
      },
      "x": 100,
      "y": 760
    },
    {
      "id": "sheet",
      "type": "net.noodl.ParseCSV",
      "label": "People sheet",
      "parameters": {
        "text": "name,team\nann,red\nbo,blue\n\"cy, jr\",green"
      },
      "x": 500,
      "y": 360
    },
    {
      "id": "sheetOut",
      "type": "net.noodl.ToCSV",
      "label": "Written back",
      "parameters": {
        "columns": "team, name",
        "includeHeader": false
      },
      "x": 500,
      "y": 520
    },
    {
      "id": "doc",
      "type": "net.noodl.ParseXML",
      "label": "Catalogue",
      "parameters": {
        "text": "<catalog><item sku=\"0123\">Lamp</item></catalog>",
        "alwaysArray": "item"
      },
      "x": 500,
      "y": 600
    },
    {
      "id": "news",
      "type": "net.noodl.ParseFeed",
      "label": "News",
      "parameters": {
        "text": "<rss version=\"2.0\"><channel><title>Sheet Desk News</title><link>https://sheet.example/</link><description>Two posts</description><item><title>First</title><link>https://sheet.example/1</link><pubDate>Mon, 07 Sep 2026 12:00:00 +0000</pubDate></item><item><title>Second</title><link>https://sheet.example/2</link><pubDate>Sun, 06 Sep 2026 12:00:00 +0000</pubDate></item></channel></rss>"
      },
      "x": 500,
      "y": 680
    }
  ],
  "visualRoots": [
    "page"
  ]
}
