{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "a7c10d00-0000-4000-8000-000000000189",
  "version": 1,
  "nodes": [
    {
      "id": "box",
      "type": "Group",
      "label": "Box",
