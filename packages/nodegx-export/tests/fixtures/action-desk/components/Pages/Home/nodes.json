      "children": [
        "headline",
        "actionInput",
        "dispatchBtn",
        "cancelBtn",
        "resultText",
        "refusalText",
        "waitingText",
        "countText",
        "busyText",
        "lastText",
        "greeter"
      ],
      "parameters": {
        "flexDirection": "column",
        "alignItems": "flex-start",
        "rowGap": "var(--space-3)",
        "paddingTop": "var(--space-8)",
        "paddingLeft": "var(--space-6)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "headline",
      "type": "Text",
