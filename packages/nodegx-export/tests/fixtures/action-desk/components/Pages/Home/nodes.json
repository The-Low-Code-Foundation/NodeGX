{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "a7c10d00-0000-4000-8000-000000000178",
  "version": 1,
  "nodes": [
    {
      "id": "page",
      "type": "Page",
      "label": "Home",
      "children": [
        "shell"
      ],
      "parameters": {
        "title": "Action Desk",
        "urlPath": "home"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "shell",
      "type": "Group",
      "label": "Shell",
