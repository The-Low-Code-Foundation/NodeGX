      "parameters": {
        "functionScript": "if (Inputs.item === undefined || Inputs.item === '') return;\nOutputs.item = Inputs.item;\nOutputs.runs = (Outputs.runs || 0) + 1;\nOutputs.ready();",
        "runOnChange-in-item": true
      },
