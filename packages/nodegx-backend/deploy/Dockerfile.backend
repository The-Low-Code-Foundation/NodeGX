# NodeGX backend service (WF-003).
#
# There is no build stage. The image is assembled from an artifact that
# `scripts/package-deploy.js` produced on the build machine, and the manifest
# there — not this Dockerfile — is what makes a deploy reproducible.
#
# That is a deliberate choice, not a shortcut. Building the bundle inside the
# image would mean bringing the whole monorepo and its ~1,300 hoisted packages
# into the build context to run one 50 ms esbuild, and the resulting image
# would still be assembled from whatever npm resolved that morning. Packaging
# outside and copying in gives a smaller image, a build id derived from the
# artifact's own content hash, and one artifact that serves both the container
# deploy and a plain `scp` to a VPS.
#
# Build context: packages/nodegx-backend/deploy

# Pinned to a minor: node:sqlite is the storage engine (Node >= 22.5), and the
# floating `22-alpine` tag has moved under this image before. Bump deliberately.
FROM node:22.23-alpine

# `node` (uid 1000) exists in the base image. The service writes only to the
# data volume, so nothing else needs to be writable.
RUN mkdir -p /data /app && chown -R node:node /data /app

WORKDIR /app

# P112-OWN024-DEPLOYNOSHARP: a photo's small versions (?thumb=) are made by sharp, a native module the artifact does
# not carry (cli.js loads it by plain `require`, so /app/node_modules is where it looks). Installed here for this
# image's own platform (musl); root-owned, read-only to the service. The version is the lockfile's, held by
# tests/p112-own024-deploy-sharp.test.ts.
RUN npm install --prefix /app --omit=dev --no-audit --no-fund --loglevel=error sharp@0.33.5 \
  && rm -rf /root/.npm

COPY --chown=node:node artifact/backend/cli.js /app/cli.js
COPY --chown=node:node security.production.json /app/security.production.json
COPY --chown=node:node entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Ownership of a fresh named volume is initialised from the image, so /data
# belongs to `node` and the service never needs root.
VOLUME ["/data"]

ENV NODEGX_DATA_DIR=/data \
    NODEGX_PORT=8577 \
    NODEGX_HOST=0.0.0.0 \
    NODE_ENV=production

EXPOSE 8577

# /health is the one public route (BAK-003's route table), so this needs no
# credential — and it is answered by the same dispatcher everything else goes
# through, so a passing healthcheck means the service is genuinely serving.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get({host:'127.0.0.1',port:process.env.NODEGX_PORT||8577,path:'/health',timeout:4000},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

USER node

# exec form, and the entrypoint execs node: PID 1 is the service, so `docker
# stop` delivers SIGTERM to the process that has the graceful-shutdown handler.
ENTRYPOINT ["/app/entrypoint.sh"]
