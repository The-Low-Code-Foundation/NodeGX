{
  "name": "@nodegx/preview",
  "version": "0.2.5",
  "description": "Standalone live-preview harness: renders a NodeGX (OpenNoodl) v2 project in a browser with no editor process, and reloads it when the files on disk change.",
  "license": "GPL-3.0-only",
  "homepage": "https://nodegx.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Low-Code-Foundation/NodeGX.git",
    "directory": "packages/noodl-preview"
  },
  "bin": {
    "noodl-preview": "./bin/noodl-preview.js",
    "nodegx-deploy": "./bin/nodegx-deploy.js",
    "preview": "./bin/noodl-preview.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs && node scripts/pack-runtime.mjs && node ../noodl-mcp/build-backend-copy.mjs --out dist/backend && node ../noodl-mcp/check-pack-paths.mjs",
    "postpack": "node scripts/pack-runtime.mjs --remove && node ../noodl-mcp/build-backend-copy.mjs --remove --out dist/backend",
    "in-page-check": "node scripts/in-page-check.mjs",
    "graph-target-check": "node scripts/graph-target-check.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
