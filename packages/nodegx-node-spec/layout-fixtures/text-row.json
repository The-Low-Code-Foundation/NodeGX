{
  "name": "text-row",
  "rule": "content children in a row (a padded, centred row with a gap): a Text that hugs, a Text at 100% — a fill — beside it, and a Button that hugs",
  "nodes": [
    {
      "id": "row",
      "type": "Group",
      "parameters": {
        "sizeMode": "contentHeight",
        "width": {
          "value": 360,
          "unit": "px"
        },
        "flexDirection": "row",
        "alignItems": "center",
        "columnGap": {
          "value": 12,
          "unit": "px"
        },
        "paddingTop": {
          "value": 8,
          "unit": "px"
        },
        "paddingRight": {
          "value": 12,
          "unit": "px"
        },
        "paddingBottom": {
          "value": 8,
          "unit": "px"
        },
        "paddingLeft": {
          "value": 12,
          "unit": "px"
        }
      },
      "children": [
        {
          "id": "label",
          "type": "Text",
          "parameters": {
            "text": "Name",
            "sizeMode": "contentSize"
          }
        },
        {
          "id": "grow",
          "type": "Text",
          "parameters": {
            "text": "The rest of the row, which wraps when it has to"
          }
        },
        {
          "id": "go",
          "type": "net.noodl.controls.button",
          "parameters": {
            "label": "Go"
          }
        }
      ]
    }
  ]
}
