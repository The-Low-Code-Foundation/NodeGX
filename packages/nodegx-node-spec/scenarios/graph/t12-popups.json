[
  {
    "name": "the round trip: a popup's Close Popup hands its Results back to the Show Popup that opened it — Done, then Close Results and Closed",
    "clauses": [
      "N"
    ],
    "because": "showpopup.ts `Done`: \"Fires once the popup has been opened\"; `Closed`: \"Fires when the popup was closed without a close action, after Close Results are up to date\"; closepopup.ts `results`: \"Names of values to hand back to the Show Popup node that opened this popup\"; `close`: \"Closes the popup and hands back any Results\". The popup is a DEFINITION built by name in the root scope (nodecontext.ts :1245); its params arrive as its component inputs (:1253-1255) — `go` reaches Close Popup's Close over a wire (a value `true` is a rising edge), `name` its result. WHEN each lands is the runtime's timing (the build is awaited, the close leaves at the next frame's start) — the frames the claims name were read from the recording; WHAT is answered is the sentences'",
    "definitions": {
      "Dialog": {
        "inputs": {
          "name": "value",
          "go": "value"
        },
        "outputs": {},
        "nodes": {
          "ci": {
            "type": "Component Inputs"
          },
          "cp": {
            "type": "NavigationClosePopup",
            "params": {
              "results": "name"
            }
          }
        },
        "wires": [
          {
            "from": "ci.name",
            "to": "cp.result-name"
          },
          {
            "from": "ci.go",
            "to": "cp.close"
          }
        ]
      }
    },
    "nodes": {
      "show": {
        "type": "NavigationShowPopup",
        "params": {
          "target": "Dialog",
          "popupParam-name": "A",
          "popupParam-go": true
        }
      }
    },
    "steps": [
      "settle",
      {
        "node": "show",
        "signal": "show"
      },
      "settle",
      "settle",
      "settle"
    ],
    "claims": [
      {
        "at": 2,
        "subject": "show",
        "outcome": "done",
        "count": 1
      },
      {
        "at": 3,
        "subject": "show",
        "port": "closeResult-name",
        "value": "A"
      },
      {
        "at": 3,
        "subject": "show",
        "signal": "Closed",
        "count": 1
      },
      {
        "at": 3,
        "subject": "show",
        "signal": "Dismissed",
        "count": 0
      }
    ],
    "expect": [
      {
        "t": "set",
        "port": "target",
        "value": "Dialog",
        "subject": "show"
      },
      {
        "t": "set",
        "port": "popupParam-name",
        "value": "A",
        "subject": "show"
      },
      {
        "t": "set",
        "port": "popupParam-go",
        "value": true,
        "subject": "show"
      },
      {
        "t": "settle"
      },
      {
        "t": "in",
        "port": "show",
        "subject": "show"
      },
      {
        "t": "settle"
      },
      {
        "t": "outcome",
        "port": "show",
        "value": "done",
        "subject": "show"
      },
      {
        "t": "popup",
        "op": "show",
        "params": {
          "go": true,
          "name": "A"
        },
        "stackPolicy": "replace",
        "closeOnEscape": true,
        "modal": true,
        "target": "Dialog",
        "subject": "show"
      },
      {
        "t": "settle"
      },
      {
        "t": "value",
        "port": "closeResult-name",
        "value": "A",
        "subject": "show"
      },
      {
        "t": "signal",
        "port": "Closed",
        "subject": "show"
      },
      {
        "t": "settle"
      }
    ]
  },
