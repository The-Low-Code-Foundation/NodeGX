      "a": {
        "type": "Counter"
      },
      "b": {
        "type": "Value Changed"
      },
      "c": {
        "type": "Counter"
      }
    },
    "wires": [
      {
        "from": "a.currentCount",
        "to": "b.value"
      },
      {
        "from": "b.valueChanged",
        "to": "c.increase"
      }
