[
  {
    "name": "a Function writing the value an output already holds publishes nothing: the Function it feeds does not run again",
    "clauses": [
      "N"
    ],
    "because": "simplejavascript.ts :295-305 — `value !== outputValues[prop]` (\"Some Noodl projects rely on this behavior\"); NSP-017 §5, the contract's most surprising rule: memory a-javascript-output-publishes-only-when-it-changes",
    "nodes": {
      "a": {
        "type": "JavaScriptFunction",
        "params": {
          "functionScript": "Outputs.o = Inputs.x",
          "in-x": {
            "k": 1
          }
        }
      },
      "b": {
        "type": "JavaScriptFunction",
        "params": {
          "functionScript": "this.n = (this.n || 0) + 1;\nOutputs.count = this.n;\nconst seen = Inputs.o"
        }
      }
    },
    "wires": [
      {
        "from": "a.out-o",
        "to": "b.in-o"
      }
    ],
    "steps": [
      "settle",
      {
        "node": "a",
        "signal": "run"
      },
      "settle",
      {
        "node": "a",
        "signal": "run"
      },
      "settle"
    ],
    "claims": [
      {
        "at": 1,
        "subject": "b",
        "port": "out-count",
        "value": 1
      },
      {
        "at": 2,
        "subject": "a",
        "signal": "success",
        "count": 1
      },
      {
        "at": 2,
        "subject": "b",
        "signal": "success",
        "count": 0
      },
      {
        "at": 3,
        "subject": "a",
        "signal": "success",
        "count": 1
      },
      {
        "at": 3,
        "subject": "b",
        "signal": "success",
        "count": 0
      },
      {
        "at": 3,
        "subject": "b",
        "port": "out-count",
        "absent": true
      }
    ],
    "expect": [
      {
        "t": "set",
        "port": "functionScript",
        "value": "Outputs.o = Inputs.x",
        "subject": "a"
