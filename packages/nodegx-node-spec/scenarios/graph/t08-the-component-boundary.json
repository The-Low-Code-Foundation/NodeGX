  {
    "name": "a component placed twice with different inputs: each instance's Component Inputs hands ITS value to the nodes inside it; setting one instance's input moves that instance only",
    "clauses": [
      "N"
    ],
    "because": "NSP-015 AC5 (the control that proves inputs arrive at all) and the MCP server's instruction: \"A component's interface is a `Component Inputs` node whose ports are plugged 'output' — that is the ONLY thing that makes an instance parameter arrive\" (componentinputs.ts: every output is a read of the owner's `_internal.inputValues`; componentinstance.ts `registerComponentInputPort`: the setter flags each Component Inputs' output)",
    "components": {
      "a": {
        "component": "Greeting",
        "inputs": {
          "Name": "value"
        },
        "params": {
          "Name": "Ann"
        }
      },
      "b": {
        "component": "Greeting",
        "inputs": {
          "Name": "value"
        },
        "params": {
          "Name": "Bo"
        }
      }
    },
    "nodes": {
      "ia": {
        "type": "Component Inputs",
        "in": "a"
      },
      "fa": {
        "type": "String Format",
        "in": "a",
        "params": {
          "format": "Hello {who}"
        }
      },
      "ib": {
        "type": "Component Inputs",
        "in": "b"
      },
      "fb": {
        "type": "String Format",
        "in": "b",
        "params": {
          "format": "Hello {who}"
        }
      }
    },
    "wires": [
      {
        "from": "ia.Name",
        "to": "fa.who"
      },
      {
        "from": "ib.Name",
        "to": "fb.who"
      }
    ],
    "steps": [
      "settle",
      {
        "node": "a",
        "set": "Name",
        "value": "Cy"
      },
      "settle"
    ],
    "claims": [
      {
        "at": 1,
        "subject": "ia",
        "port": "Name",
        "value": "Ann"
      },
      {
