[
  {
    "name": "Auto Connect with a URL streams: connecting, open, three events, then the end closes it",
    "params": {
      "autoConnect": true,
      "url": "https://api.example/stream"
    },
    "steps": [
      "settle",
      "settle",
      {
        "advance": 1
      },
      "settle",
      {
        "advance": 2
      },
      "settle",
      {
        "advance": 5
      },
      "settle"
    ],
    "world": {
      "network": [
        {
          "answer": {
            "status": 200,
            "chunks": [
              {
                "at": 1,
                "text": "data: hello\n\n"
              },
              {
                "at": 2,
                "text": "id: 1\ndata: {\"delta\":\"Hi\"}\n\n"
              },
              {
                "at": 4,
                "text": "event: token\ndata: x\n\n"
              },
              {
                "at": 8,
                "end": true
              }
            ]
          }
        }
      ]
    },
    "because": "sse :555-586 the frame end's pass; conn :503-586 open, frames, end; sse :693-712 values then On Message"
  },
  {
    "name": "A Connect: Done when the stream opens; the request carries the event-stream headers",
    "params": {
      "url": "https://api.example/stream"
