    "steps": [
      "settle",
      {
        "signal": "connect"
      },
      "settle",
      "settle"
    ],
    "world": {
      "network": [
        {
          "answer": {
            "status": 200,
            "chunks": []
          }
        }
      ]
    },
    "because": "sse :328-334; conn :446 Accept and Cache-Control; :519 onOpen"
  },
