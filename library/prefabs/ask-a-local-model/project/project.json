          {
            "id": "lmFence",
            "type": "JavaScriptFunction",
            "children": [],
            "label": "The fence: a choice from a list, a fixed question",
            "x": 360,
            "y": 40,
            "parameters": {
              "functionScript": "// The fence (TPL-012 §2.6). A small model cannot be TOLD to stay inside a fence, so this builds one:\n// the page sends a CHOICE from a list, never words of its own; the question is a fixed sentence\n// written here; and the answer can only be one of Answers (an enum schema, checked again after).\nvar choices = Array.isArray(Inputs.Choices) ? Inputs.Choices.map(String) : [];\nvar answers = Array.isArray(Inputs.Answers) ? Inputs.Answers.map(String) : [];\nvar choice = Inputs.Choice === undefined || Inputs.Choice === null ? '' : String(Inputs.Choice);\nvar question = Inputs.Question === undefined || Inputs.Question === null ? '' : String(Inputs.Question);\nif (!Inputs.Model || answers.length === 0 || question.indexOf('{choice}') === -1) {\n  Outputs.code = 'not_configured';\n  Outputs.refused();\n  return;\n}\nif (choices.indexOf(choice) === -1) {\n  Outputs.code = 'not_on_the_list';\n  Outputs.refused();\n  return;\n}\nOutputs.baseUrl = Inputs.BaseURL ? String(Inputs.BaseURL) : 'http://127.0.0.1:11434';\nOutputs.model = String(Inputs.Model);\nOutputs.prompt = question.split('{choice}').join(choice);\nOutputs.schema = {\n  type: 'object',\n  properties: { answer: { type: 'string', enum: answers } },\n  required: ['answer'],\n  additionalProperties: false\n};\nOutputs.ask();",
              "runOnChange-in-Choice": false,
              "runOnChange-in-Choices": false,
              "runOnChange-in-Question": false,
              "runOnChange-in-Answers": false,
              "runOnChange-in-BaseURL": false,
              "runOnChange-in-Model": false
            },
            "dynamicports": [],
            "ports": [
              {
                "name": "in-Choice",
                "plug": "input",
                "type": "*",
                "displayName": "Choice",
                "group": "Inputs"
              },
