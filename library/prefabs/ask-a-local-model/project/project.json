          {
            "id": "lmModel",
            "type": "noodl.cloud.modelrequest",
            "children": [],
            "label": "The model on this computer",
            "x": 680,
            "y": 40,
            "dynamicports": [],
            "ports": [],
            "parameters": {
              "provider": "openai-compatible",
              "baseUrl": "http://127.0.0.1:11434",
              "apiKeySecret": "LOCAL_MODEL_KEY",
              "effort": "none",
              "maxTokens": 64,
              "timeoutMs": 20000
            }
          },
          {
            "id": "lmCheck",
            "type": "JavaScriptFunction",
            "children": [],
            "label": "Only a word from Answers leaves",
            "x": 1000,
            "y": 40,
            "parameters": {
              "functionScript": "// Checked again: a server that ignores the schema can still answer with JSON naming a word that\n// is not on the list. Only a word from Answers leaves this component.\nvar answers = Array.isArray(Inputs.Answers) ? Inputs.Answers.map(String) : [];\nvar got = Inputs.json && typeof Inputs.json === 'object' ? Inputs.json.answer : undefined;\nif (typeof got !== 'string' || answers.indexOf(got) === -1) {\n  Outputs.code = 'answer_not_allowed';\n  Outputs.bad();\n  return;\n}\nOutputs.answer = got;\nOutputs.ok();",
              "runOnChange-in-json": false,
              "runOnChange-in-Answers": false
            },
            "dynamicports": [],
            "ports": [
              {
